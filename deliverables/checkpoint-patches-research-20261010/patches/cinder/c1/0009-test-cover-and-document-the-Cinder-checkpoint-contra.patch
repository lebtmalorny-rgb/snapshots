+# under the License.
+
+"""Check API examples against real WSGI/SQL/RPC responses."""
+
+import json
+import os
+from pathlib import Path
+
+from cinder.tests.functional import test_checkpoint_contract as functional
+
+
+class TestCheckpointSamples(functional.CheckpointFunctionalBase):
+    sample_dir = Path(__file__).parent / 'samples' / 'checkpoints' / 'v3.72'
+
+    def test_checkpoint_create_samples(self):
+        operation, payload = self.reserve_operation()
+        # Sort associations, retaining the actual server-generated UUIDs.
+        resources = sorted(operation['resources'],
+                           key=lambda r: r['volume_id'])
+        operation['resources'] = resources
+        operation['steps'] = [next(s for s in operation['steps']
+                                   if s['resource_id'] == resource['id'])
+                              for resource in resources]
+        subs = dict(payload, operation_id=operation['id'])
+        for index, resource in enumerate(resources):
+            subs.update({
+                'volume%s' % index: resource['volume_id'],
+                'resource%s' % index: resource['id'],
+                'snapshot%s' % index: resource['snapshot_id'],
+                'step%s' % index: operation['steps'][index]['id']})
+        request = json.loads((self.sample_dir /
+                              'checkpoint-create-request.json.tpl').read_text()
+                             % subs)
+        response = self.request('checkpoint-operations', request)
+        self.assertEqual(202, response.status_int, response.text)
+        self.assertEqual(operation['id'],
+                         response.json['checkpoint_operation']['id'])
+        template = self.sample_dir / 'checkpoint-create-response.json.tpl'
+        expected = json.loads(template.read_text() % subs)
+        self.assertEqual(expected, {'checkpoint_operation': operation})
+        if os.getenv('GENERATE_SAMPLES'):
+            destination = Path('api-ref/source/v3/samples/checkpoints')
+            destination.mkdir(parents=True, exist_ok=True)
+            for name in ('checkpoint-create-request',
+                         'checkpoint-create-response',
+                         'checkpoint-execute-request'):
+                content = (self.sample_dir / (name + '.json.tpl')).read_text()
+                (destination / (name + '.json')).write_text(content % subs)
diff --git a/cinder/tests/functional/test_checkpoint_contract.py b/cinder/tests/functional/test_checkpoint_contract.py
