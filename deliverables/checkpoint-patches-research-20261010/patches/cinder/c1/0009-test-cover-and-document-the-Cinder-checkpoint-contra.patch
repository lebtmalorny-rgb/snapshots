@@ -0,0 +1,265 @@
+# Licensed under the Apache License, Version 2.0 (the "License"); you may
+# not use this file except in compliance with the License. You may obtain
+# a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+# WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+# License for the specific language governing permissions and limitations
+# under the License.
+
+"""WSGI, SQL journal, serialized oslo RPC and fake native storage lifecycle."""
+
+import time
+
+import eventlet
+import oslo_messaging
+from oslo_serialization import jsonutils
+from oslo_utils import timeutils
+from oslo_utils import uuidutils
+import webob
+
+from cinder.api.middleware import fault
+from cinder.api.v3 import router
+from cinder import db
+from cinder import objects
+from cinder.objects import base as object_base
+from cinder import rpc
+from cinder.scheduler import manager as scheduler_manager
+from cinder.tests.unit.api import fakes
+from cinder.tests.unit.checkpoints import fake_driver
+from cinder.tests.unit.checkpoints import test_db
+from cinder.tests.unit import test
+from cinder.tests.unit import utils
+from cinder.volume import manager as volume_manager
+
+
+class CheckpointFunctionalBase(test_db.CheckpointDBHelpers, test.TestCase):
+    def setUp(self):
+        super().setUp()
+        self.prepare_volumes()
+        self.ctxt.roles = ['member']
+        self.ctxt.service_roles = ['service']
+        self.flags(enabled=True, nova_service_user_ids=[test_db.SERVICE_ID],
+                   group='checkpoint')
+        self.workers = {}
+        self.drivers = {}
+        for index, vid in enumerate(self.volumes):
+            host = 'node%s@checkpoint' % index
+            db.volume_update(self.ctxt, vid, {'host': host})
+            worker = volume_manager.VolumeManager(host=host)
+            driver = fake_driver.FakeCheckpointDriver()
+            driver.set_initialized()
+            worker.driver = driver
+            self.workers[vid] = worker
+            self.drivers[vid] = driver
+            self.mock_object(driver, 'create_snapshot', return_value=None)
+            self.mock_object(driver, 'validate_connector', return_value=None)
+            self.mock_object(driver, 'create_export', return_value=None)
+            self.mock_object(driver, 'initialize_connection', side_effect=(
+                lambda *args: {'driver_volume_type': 'fake', 'data': {}}))
+            self.mock_object(driver, 'terminate_connection',
+                             return_value=False)
+            self.mock_object(driver, 'remove_export', return_value=None)
+            db.service_create(self.ctxt.elevated(), {
+                'host': host, 'binary': 'cinder-volume',
+                'topic': 'cinder-volume',
+                'disabled': False, 'updated_at': timeutils.utcnow(),
+                'rpc_current_version': '3.21',
+                'object_current_version': '1.40'})
+            server = rpc.get_server(oslo_messaging.Target(
+                topic='cinder-volume.' + host, server='node%s' % index),
+                [worker], serializer=object_base.CinderObjectSerializer())
+            server.start()
+            self.addCleanup(self.stop_server, server)
+        scheduler = scheduler_manager.SchedulerManager()
+        self.mock_object(scheduler, '_wait_for_scheduler', return_value=None)
+        self.mock_object(scheduler.driver, 'backend_passes_filters')
+        server = rpc.get_server(oslo_messaging.Target(
+            topic='cinder-scheduler', server='scheduler'), [scheduler],
+            serializer=object_base.CinderObjectSerializer())
+        server.start()
+        self.addCleanup(self.stop_server, server)
+        app = fakes.urlmap.URLMap()
+        app['/v3'] = router.APIRouter()
+        self.app = fault.FaultWrapper(app)
+
+    @staticmethod
+    def stop_server(server):
+        server.stop()
+        server.wait()
+
+    def request(self, path, body=None, method=None, operation=None,
+                version='3.72'):
+        req = webob.Request.blank('/v3/%s/%s' % (self.ctxt.project_id, path))
+        req.method = method or ('POST' if body is not None else 'GET')
+        req.headers['Content-Type'] = 'application/json'
+        req.headers['OpenStack-API-Version'] = 'volume ' + version
+        req.environ['cinder.context'] = self.ctxt.deepcopy()
+        if operation:
+            req.headers['OpenStack-Checkpoint-Operation-ID'] = operation['id']
+            req.headers['OpenStack-Checkpoint-Generation'] = '1'
+        if body is not None:
+            req.body = jsonutils.dump_as_bytes(body)
+        return req.get_response(self.app)
+
+    def reserve_operation(self, kind='create', checkpoint_id=None):
+        payload = {'kind': kind, 'checkpoint_id': checkpoint_id or
+                   uuidutils.generate_uuid(), 'request_id':
+                   uuidutils.generate_uuid(), 'instance_uuid': self.instance,
+                   'volume_ids': self.volumes}
+        response = self.request('checkpoint-operations',
+                                {'checkpoint_operation': payload})
+        self.assertEqual(202, response.status_int, response.text)
+        return response.json['checkpoint_operation'], payload
+
+    def action(self, operation, name, outcome=None):
+        args = {'generation': operation['generation']}
+        if outcome:
+            args['outcome'] = outcome
+        response = self.request('checkpoint-operations/%s/action' %
+                                operation['id'], {name: args})
+        self.assertEqual(202, response.status_int, response.text)
+        return response.json['checkpoint_operation']
+
+    def wait_for(self, operation, status):
+        deadline = time.monotonic() + 10
+        while time.monotonic() < deadline:
+            response = self.request('checkpoint-operations/' + operation['id'])
+            self.assertEqual(200, response.status_int, response.text)
+            actual = response.json['checkpoint_operation']
+            if actual['status'] == status:
+                return actual
+            eventlet.sleep(0.01)
+        self.fail('Checkpoint did not reach %s: %s' % (status, actual))
+
+    def checkpoint(self):
+        operation, payload = self.reserve_operation()
+        self.action(operation, 'execute')
+        self.wait_for(operation, 'succeeded')
+        self.action(operation, 'release', 'commit')
+        return operation, payload
+
+    def data(self, value):
+        for vid, driver in self.drivers.items():
+            driver.data[vid] = value
+
+    def native_count(self):
+        return sum(d.native_call_count for d in self.drivers.values())
+
+    def revert(self, checkpoint):
+        operation, unused = self.reserve_operation(
+            'revert', checkpoint['checkpoint_id'])
+        original = []
+        for vid in self.volumes:
+            attachment = objects.Volume.get_by_id(
+                self.ctxt, vid).volume_attachment[0]
+            original.append(attachment.id)
+            response = self.request('attachments/' + attachment.id,
+                                    method='DELETE', operation=operation)
+            self.assertEqual(200, response.status_int, response.text)
+        self.action(operation, 'execute')
+        self.wait_for(operation, 'succeeded')
+        for vid in self.volumes:
+            response = self.request('attachments', {'attachment': {
+                'volume_uuid': vid, 'instance_uuid': self.instance,
+                'connector': {'host': 'compute-one', 'ip': '192.0.2.10'}}},
+                operation=operation)
+            self.assertEqual(200, response.status_int, response.text)
+            aid = response.json['attachment']['id']
+            self.assertNotIn(aid, original)
+            response = self.request('attachments/%s/action' % aid,
+                                    {'os-complete': {}}, operation=operation)
+            self.assertEqual(204, response.status_int, response.text)
+        self.action(operation, 'release', 'commit')
+        return operation
+
+
+class TestCheckpointContract(CheckpointFunctionalBase):
+    def test_two_checkpoints_revert_old_and_keep_new(self):
+        self.data(b'point-A')
+        first, unused = self.checkpoint()
+        self.data(b'point-B')
+        second, unused = self.checkpoint()
+        first_ids = {r['snapshot_id'] for r in first['resources']}
+        self.assertTrue(first_ids.isdisjoint(
+            r['snapshot_id'] for r in second['resources']))
+        self.data(b'current')
+        self.revert(first)
+        self.assertEqual([b'point-A'] * 2,
+                         [self.drivers[v].data[v] for v in self.volumes])
+        self.revert(second)
+        self.assertEqual([b'point-B'] * 2,
+                         [self.drivers[v].data[v] for v in self.volumes])
+        self.assertEqual([], self.locks())
+        self.assertEqual(8, self.native_count())
+
+    def test_delete_a_preserves_b_and_current_data(self):
+        self.data(b'point-A')
+        first, unused = self.checkpoint()
+        self.data(b'point-B')
+        second, unused = self.checkpoint()
+        self.data(b'current')
+        deletion, unused = self.reserve_operation(
+            'delete', first['checkpoint_id'])
+        self.action(deletion, 'execute')
+        self.wait_for(deletion, 'succeeded')
+        self.action(deletion, 'release', 'commit')
+        self.assertEqual([b'current'] * 2,
+                         [self.drivers[v].data[v] for v in self.volumes])
+        self.assertEqual({r['snapshot_id'] for r in second['resources']},
+                         {sid for d in self.drivers.values()
+                          for sid in d.snapshots})
+        self.assertEqual(2, db.quota_usage_get_all_by_project(
+            self.ctxt.elevated(), self.ctxt.project_id)['snapshots']['in_use'])
+
+    def test_cross_backend_partial_failure_holds_all_locks(self):
+        operation, unused = self.reserve_operation()
+        self.drivers[self.volumes[1]].outcomes['snapshot'].append(
+            RuntimeError('lost reply after effect'))
+        self.action(operation, 'execute')
+        self.wait_for(operation, 'recovery_required')
+        response = self.request('checkpoint-operations/%s/action' %
+                                operation['id'], {'release': {
+                                    'generation': 1, 'outcome': 'abort'}})
+        self.assertEqual(409, response.status_int, response.text)
+        self.assertEqual(sorted(self.volumes), sorted(self.locks()))
+        self.action(operation, 'execute')
+        self.action(operation, 'reconcile')
+        self.wait_for(operation, 'succeeded')
+        self.assertEqual(2, self.native_count())
+
+    def test_released_request_replay_creates_nothing(self):
+        first, payload = self.checkpoint()
+        deletion, unused = self.reserve_operation(
+            'delete', first['checkpoint_id'])
+        self.action(deletion, 'execute')
+        self.wait_for(deletion, 'succeeded')
+        self.action(deletion, 'release', 'commit')
+        response = self.request('checkpoint-operations',
+                                {'checkpoint_operation': payload})
+        self.assertEqual(202, response.status_int, response.text)
+        self.assertEqual(first['id'],
+                         response.json['checkpoint_operation']['id'])
+        self.assertEqual(4, self.native_count())
+        self.assertEqual(0, db.quota_usage_get_all_by_project(
+            self.ctxt.elevated(), self.ctxt.project_id)['snapshots']['in_use'])
+
+    def test_legacy_snapshot_api_unchanged(self):
+        host = self.workers[self.volumes[0]].host
+        volume = utils.create_volume(self.ctxt, host=host, volume_type_id=None)
+        response = self.request('snapshots', {'snapshot': {
+            'volume_id': volume.id}}, version='3.71')
+        self.assertEqual(202, response.status_int, response.text)
+        sid = response.json['snapshot']['id']
+        deadline = time.monotonic() + 10
+        while time.monotonic() < deadline:
+            status = objects.Snapshot.get_by_id(self.ctxt, sid).status
+            if status != 'creating':
+                break
+            eventlet.sleep(0.01)
+        self.assertEqual('available', status)
+        self.drivers[self.volumes[0]].create_snapshot.assert_called_once()
+        self.assertEqual(0, self.native_count())
