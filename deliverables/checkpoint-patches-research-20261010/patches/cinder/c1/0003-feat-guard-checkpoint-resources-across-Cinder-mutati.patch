+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+# WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+# License for the specific language governing permissions and limitations
+# under the License.
+
+"""Checks at API/worker boundaries; atomic admission lives in the DB layer."""
+
+import contextlib
+import inspect
+
+import decorator
+
+from cinder import db
+from cinder import exception
+
+
+def _id(resource):
+    return resource if isinstance(resource, str) else resource['id']
+
+
+def check_volume(context, volume, action, operation_id=None, generation=None):
+    db.checkpoint_resource_guard(context, _id(volume), action)
+
+
+def check_snapshot(context, snapshot, action, operation_id=None,
+                   generation=None):
+    db.checkpoint_snapshot_guard(context, _id(snapshot), action)
+
+
+def validate_operation_scope(context, operation_id, generation, volume_id,
+                             action):
+    # A header or an admin role alone never grants an internal bypass.
+    raise exception.CheckpointServiceForbidden()
+
+
+@contextlib.contextmanager
+def connection(context, volume, action):
+    """Persist a barrier for legacy calls lacking their own pending status.
+
+    The SQL transaction ends before backend I/O. Failure leaves maintenance
+    visible to checkpoint admission; it is never an automatic checkpoint
+    unlock. Existing legacy recovery applies to these unprotected volumes.
+    """
+    volume_id = _id(volume)
+    previous = db.checkpoint_connection_begin(context, volume_id, action)
+    yield
+    db.checkpoint_connection_end(context, volume_id, previous)
+
+
+def connection_worker(action, volume_arg, context_arg='context'):
+    """Cover backend I/O and preserve the signature used by coordination."""
+    @decorator.decorator
+    def guarded(function, *args, **kwargs):
+        bound = inspect.getcallargs(function, *args, **kwargs)
+        with connection(bound[context_arg], bound[volume_arg], action):
+            return function(*args, **kwargs)
+    return guarded
