+class GuardConcurrency(test_db.CheckpointDBHelpers):
+    def setUp(self):
+        super().setUp()
+        self.useFixture(config_fixture.Config()).config(
+            connection='sqlite://', group='database')
+        engine = enginefacade.writer.get_engine()
+        migration.db_sync(engine=engine)
+        self.addCleanup(sqla_api.main_context_manager.patch_engine(engine))
+        self.prepare_volumes(count=1)
+
+    def test_reserve_races_attachment(self):
+        gate = eventlet.event.Event()
+        outcomes = []
+
+        def mutate(kind):
+            ctxt = test_db.service_context()
+            gate.wait()
+            try:
+                if kind == 'checkpoint':
+                    self.reserve(ctxt=ctxt)
+                else:
+                    db.volume_attach(ctxt.elevated(), {
+                        'volume_id': self.volumes[0],
+                        'instance_uuid': self.instance,
+                        'attach_status': 'reserved'})
+                outcomes.append(kind)
+            except exception.CheckpointConflict:
+                outcomes.append(None)
+
+        pool = eventlet.GreenPool(size=2)
+        for kind in ('checkpoint', 'attachment'):
+            pool.spawn_n(mutate, kind)
+        gate.send()
+        pool.waitall()
+        self.assertEqual(2, len(outcomes))
+        self.assertEqual(1, sum(result is not None for result in outcomes))
+
+
