+@api.require_context
+@api.main_context_manager.writer
+def resource_guard(context, volume_id, action):
+    _guard_volume(context, volume_id, action)
+
+
+def _guard_snapshot(context, snapshot_id, action):
+    if action == 'read':
+        return
+    snapshot = _query(context, models.Snapshot).filter_by(
+        id=snapshot_id).first()
+    if snapshot:
+        # Ordinary snapshots of a protected volume can still be deleted
+        # between operations. Only checkpoint snapshots are long-lived refs.
+        _guard_volume(context, snapshot.volume_id, 'snapshot')
+    reference = _current(_query(context, models.CheckpointResource).filter_by(
+        snapshot_id=snapshot_id).filter(
+            models.CheckpointResource.status != 'deleted')).first()
+    if reference:
+        _conflict('protected_checkpoint_snapshot')
+
+
+@api.require_context
+@api.main_context_manager.writer
+def snapshot_guard(context, snapshot_id, action):
+    _guard_snapshot(context, snapshot_id, action)
+
+
+def guard_volume_update(context, volume_id, values):
+    # Cosmetic fields cannot release ownership or change volume identity.
+    if not set(values) - {'display_name', 'display_description', 'metadata',
+                          'updated_at', 'admin_metadata'}:
+        return
+    action = 'mutate'
+    status = values.get('status')
+    status_fields = {'status', 'previous_status', 'updated_at'}
+    if not set(values) - status_fields and isinstance(status, str):
+        if status == 'backing-up':
+            action = 'backup'
+        elif status == 'uploading':
+            action = 'upload'
+        elif status in ('available', 'in-use', 'error'):
+            volume = _current(_query(context, models.Volume).filter_by(
+                id=volume_id)).first()
+            if volume and volume.status in ('backing-up', 'uploading'):
+                action = 'backup'
+    _guard_volume(context, volume_id, action)
+
+
+def guard_attachment(context, attachment_id):
+    attachment = _query(context, models.VolumeAttachment).filter_by(
+        id=attachment_id).first()
+    if attachment:
+        _guard_volume(context, attachment.volume_id, 'attachment')
