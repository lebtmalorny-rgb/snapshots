+            response = self.request(
+                'DELETE', 'attachments/' + self.original[0], **kwargs)
+            self.assertEqual(status, response.status_int, response.text)
+        foreign = self.ctxt.deepcopy()
+        foreign.service_user_id = uuidutils.generate_uuid()
+        self.flags(nova_service_user_ids=[self.ctxt.service_user_id,
