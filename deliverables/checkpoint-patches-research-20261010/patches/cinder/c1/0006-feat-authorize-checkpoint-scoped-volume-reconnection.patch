+from cinder import objects
+from cinder.tests.unit.api import fakes
+from cinder.tests.unit.checkpoints import test_manager
+from cinder.tests.unit import test
+from cinder.tests.unit import utils
+from cinder.volume import api as volume_api
+from cinder.volume import manager as volume_manager
+from cinder.volume import rpcapi
+
+
+class TestAttachmentScope(test_manager.ManagerHelpers, test.TestCase):
+    def setUp(self):
+        super().setUp()
+        self.prepare_manager()
+        self.available_checkpoint()
+        self.payload.update(kind='revert',
+                            request_id=uuidutils.generate_uuid())
+        self.operation = self.api.reserve(self.ctxt, self.payload)
+        self.scope = self.ctxt.deepcopy()
+        self.scope.checkpoint_operation_id = self.operation.id
+        self.scope.checkpoint_generation = 1
+        self.vm = volume_manager.VolumeManager(host=self.owner.host)
+        self.vm.driver = self.driver
+        for name, result in (
+                ('validate_connector', None), ('create_export', None),
+                ('initialize_connection',
+                 {'driver_volume_type': 'fake', 'data': {}}),
+                ('terminate_connection', False), ('remove_export', None)):
+            self.mock_object(self.driver, name, return_value=result)
+        self.driver.initialize_connection.side_effect = (
+            lambda *args: {'driver_volume_type': 'fake', 'data': {}})
+        self.va = volume_api.API()
+        self.attachment_rpc = mock.Mock(spec=[
+            'assert_checkpoint_ready', 'attachment_update',
+            'attachment_delete'])
+        self.attachment_rpc.attachment_update.side_effect = (
+            self.vm.attachment_update)
+        self.attachment_rpc.attachment_delete.side_effect = (
+            self.vm.attachment_delete)
+        self.va.volume_rpcapi = self.attachment_rpc
+        self.original = [objects.Volume.get_by_id(
+            self.ctxt, vid).volume_attachment[0].id for vid in self.volumes]
+        self.app = fakes.urlmap.URLMap()
+        self.mock_object(volume_api, 'API', return_value=self.va)
+        # require_service uses the class static method, retained on the mock.
+        volume_api.API.is_service_request = self.va.is_service_request
+        self.app['/v3'] = router.APIRouter()
+        self.app = fault.FaultWrapper(self.app)
+
+    def request(self, method, path, body=None, version='3.72', ctxt=None,
+                operation_id=None, generation='1'):
+        req = webob.Request.blank('/v3/%s/%s' % (self.ctxt.project_id, path))
+        req.method = method
+        req.headers['Content-Type'] = 'application/json'
+        req.headers['OpenStack-API-Version'] = 'volume ' + version
+        req.headers['OpenStack-Checkpoint-Operation-ID'] = (
+            operation_id or self.operation.id)
+        req.headers['OpenStack-Checkpoint-Generation'] = generation
+        req.environ['cinder.context'] = (ctxt or self.ctxt).deepcopy()
+        if body is not None:
+            req.body = jsonutils.dump_as_bytes(body)
+        return req.get_response(self.app)
+
+    def disconnect(self):
+        for attachment_id in self.original:
+            response = self.request('DELETE', 'attachments/' + attachment_id)
+            self.assertEqual(200, response.status_int, response.text)
+
+    def reconnect(self, vid, instance=None):
+        return self.request('POST', 'attachments', {'attachment': {
+            'volume_uuid': vid, 'instance_uuid': instance or self.instance,
+            'connector': {'host': 'compute-one', 'ip': '192.0.2.10'}}})
+
+    def test_tenant_cannot_forge_attachment_scope(self):
+        tenant = self.ctxt.deepcopy()
+        tenant.service_user_id = None
+        tenant.service_roles = []
+        tenant.roles = ['admin', 'service']
+        response = self.request('DELETE', 'attachments/' + self.original[0],
+                                ctxt=tenant)
+        self.assertEqual(403, response.status_int, response.text)
+        self.assertEqual(self.original[0], objects.Volume.get_by_id(
+            self.ctxt, self.volumes[0]).volume_attachment[0].id)
+        self.driver.terminate_connection.assert_not_called()
+
+    def test_valid_revert_reconnect_preserves_volume_uuid(self):
+        self.disconnect()
+        self.execute(self.operation)
+        for vid in self.volumes:
+            response = self.reconnect(vid)
+            self.assertEqual(200, response.status_int, response.text)
+            attachment_id = response.json['attachment']['id']
