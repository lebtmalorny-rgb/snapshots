+def attachment(context, volume_id, action, attachment_id=None,
+               instance_uuid=None):
+    if context.checkpoint_operation_id:
+        require_service(context)
+        if action == 'reconnect' and attachment_id is None:
+            action = 'reserve_attachment'
+        db.checkpoint_attachment_scope(
+            context, context.checkpoint_operation_id,
+            context.checkpoint_generation, volume_id, action,
+            attachment_id, instance_uuid)
+    else:
+        check_volume(context, volume_id, 'attachment')
+
+
+def attachment_request(req):
+    """Accept operation scope only at the modern attachment API boundary."""
+    context = req.environ['cinder.context']
+    operation_id = req.headers.get('OpenStack-Checkpoint-Operation-ID')
+    generation = req.headers.get('OpenStack-Checkpoint-Generation')
+    context.checkpoint_operation_id = None
+    context.checkpoint_generation = None
+    if operation_id is None and generation is None:
+        return context
+    from cinder.api import microversions
+    if not req.api_version_request.matches(microversions.CHECKPOINT_CONTRACT):
+        raise exception.InvalidInput(reason='checkpoint_scope_requires_372')
+    require_service(context)
+    try:
+        operation_id = str(uuid.UUID(operation_id))
+        if not generation or not generation.isdecimal() or int(generation) < 1:
+            raise ValueError()
+        generation = int(generation)
+    except (ValueError, TypeError, AttributeError):
+        raise exception.InvalidInput(reason='invalid_checkpoint_scope')
+    context.checkpoint_operation_id = operation_id
+    context.checkpoint_generation = generation
+    return context
