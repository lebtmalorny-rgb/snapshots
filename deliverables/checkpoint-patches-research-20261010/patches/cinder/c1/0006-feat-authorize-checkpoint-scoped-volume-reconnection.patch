+def _scope(context, operation_id, generation, volume_id, action,
+           attachment_id=None, instance_uuid=None):
+    from cinder.checkpoints import guards
+    from cinder.policies import checkpoints as policy
+    guards.require_service(context)
+    context.authorize(policy.OPERATE_POLICY)
+    # Attachment writers already lock only their parent volume. Do not take
+    # the instance lock in reverse order here; release needs all volume locks.
+    volume = _lock_volumes(context, [volume_id])[0]
+    operation = _owned(context, _current(_query(
+        context, models.CheckpointOperation).filter_by(
+            id=operation_id)).first())
+    lock = _current(_query(context, models.CheckpointVolumeLock).filter_by(
+        volume_id=volume_id)).first()
+    if (type(generation) is not int or generation != operation.generation or
+            operation.status == 'released' or operation.kind != 'revert' or
+            not lock or lock.operation_id != operation_id or
+            lock.generation != generation):
+        _conflict('invalid_attachment_scope')
+    steps = _steps(context, operation_id)
+    if all(s.status == 'prepared' for s in steps):
+        stage = 'disconnect'
+    elif all(s.status == 'succeeded' for s in steps):
+        stage = 'reconnect'
+    else:
+        _conflict('attachment_phase_not_ready')
+    expected_stage = ('reconnect' if action == 'reserve_attachment'
+                      else action)
+    if expected_stage not in ('attachment', stage):
+        _conflict('attachment_phase_not_ready')
+    resource = next(r for r in _resources(context, operation.checkpoint_id)
+                    if r.volume_id == volume_id)
+    step = next(s for s in steps if s.resource_id == resource.id)
+    original = json.loads(step.original_attachment_ids_json)
+    if expected_stage == 'reconnect' and attachment_id is None:
+        if instance_uuid != operation.instance_uuid:
+            _conflict('attachment_instance_changed')
+    if action == 'reserve_attachment' and (
+            volume.status != 'available' or _attachments(context, volume_id)):
+        _conflict('attachment_conflict')
+    if instance_uuid is not None and instance_uuid != operation.instance_uuid:
+        _conflict('attachment_instance_changed')
+    if attachment_id is not None:
+        attachment = _current(_query(context, models.VolumeAttachment).
+                              filter_by(id=attachment_id)).first()
+        if (not attachment or attachment.volume_id != volume_id or
+                attachment.instance_uuid != operation.instance_uuid or
+                (stage == 'disconnect' and attachment_id not in original) or
+                (stage == 'reconnect' and attachment_id in original)):
+            _conflict('attachment_not_owned')
+    return stage, operation, volume
+
+
+@api.require_context
+@api.main_context_manager.writer
+def attachment_scope(context, operation_id, generation, volume_id, action,
+                     attachment_id=None, instance_uuid=None):
+    _scope(context, operation_id, generation, volume_id, action,
+           attachment_id, instance_uuid)
+
+
+def _context_scope(context, volume_id, action='attachment',
+                   attachment_id=None, instance_uuid=None):
+    return _scope(context, context.checkpoint_operation_id,
+                  context.checkpoint_generation, volume_id, action,
+                  attachment_id, instance_uuid)
+
+
+def guard_attachment_create(context, values):
+    volume_id = values['volume_id']
+    if context.checkpoint_operation_id:
+        stage, operation, volume = _context_scope(
+            context, volume_id, 'reconnect',
+            instance_uuid=values.get('instance_uuid'))
+        if (values.get('instance_uuid') != operation.instance_uuid or
+                _attachments(context, volume_id) or
+                volume.status != 'reserved'):
+            _conflict('attachment_conflict')
+    else:
+        _guard_volume(context, volume_id, 'attachment')
+
+
 def _guard_volume(context, volume_id, action):
+    if action == 'attachment' and context.checkpoint_operation_id:
+        _context_scope(context, volume_id)
+        return
     if action == 'read':
         return
     # Lock the same volume row used by checkpoint reserve before observing
