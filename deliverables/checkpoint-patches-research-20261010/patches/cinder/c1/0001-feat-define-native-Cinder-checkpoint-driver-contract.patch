@@ -0,0 +1,103 @@
+# Licensed under the Apache License, Version 2.0 (the "License"); you may
+# not use this file except in compliance with the License. You may obtain
+# a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+# WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+# License for the specific language governing permissions and limitations
+# under the License.
+
+"""In-memory native storage with observable effects and response faults."""
+
+import collections
+import copy
+
+from cinder.volume import configuration
+from cinder.volume import driver
+
+
+class FakeCheckpointDriver(driver.VolumeDriver):
+    VERSION = '1.0'
+
+    def __init__(self, *args, **kwargs):
+        kwargs.setdefault('configuration',
+                          configuration.Configuration(driver.volume_opts))
+        super().__init__(*args, **kwargs)
+        self.data = {}
+        self.snapshots = {}
+        self.native_calls = []
+        self.query_calls = []
+        self.results = {}
+        self.query_results = {}
+        self.outcomes = collections.defaultdict(collections.deque)
+
+    @property
+    def native_call_count(self):
+        return len(self.native_calls)
+
+    def get_checkpoint_capabilities(self, context, volume):
+        return {
+            'contract_version': 1, 'supported': True,
+            'native_snapshot': True, 'snapshot_semantics': 'row',
+            'arbitrary_inplace_revert': True,
+            'preserves_other_checkpoints': True,
+            'independent_snapshot_delete': True,
+            'operation_reconciliation': True,
+            'consistent_group_snapshot': False,
+            'driver_identity': {
+                'driver_class': 'test.FakeCheckpointDriver',
+                'driver_version': '1.0', 'profile': 'test-row-v1',
+            },
+            'unsupported_reasons': [],
+        }
+
+    def _effect(self, action, volume, snapshot, operation_id):
+        self.native_calls.append((action, volume.id, snapshot.id,
+                                  operation_id))
+        if operation_id in self.results:
+            raise AssertionError('Native effect was dispatched twice')
+        outcome = (self.outcomes[action].popleft() if self.outcomes[action]
+                   else {'status': 'succeeded'})
+        if isinstance(outcome, dict) and outcome.get('status') == (
+                'failed_no_effect'):
+            self.results[operation_id] = copy.deepcopy(outcome)
+            return outcome
+        if action == 'snapshot':
+            self.snapshots[snapshot.id] = (
+                volume.id, copy.deepcopy(self.data.get(volume.id, b'')))
+        elif action == 'revert':
+            source, data = self.snapshots[snapshot.id]
+            if source != volume.id:
+                raise AssertionError('Snapshot belongs to a different volume')
+            self.data[volume.id] = copy.deepcopy(data)
+        elif action == 'delete_snapshot':
+            self.snapshots.pop(snapshot.id, None)
+        else:
+            raise AssertionError('Unexpected native action')
+        self.results[operation_id] = {'status': 'succeeded'}
+        if isinstance(outcome, Exception):
+            # The effect completed but its reply was lost.
+            raise outcome
+        return copy.deepcopy(outcome)
+
+    def checkpoint_create_snapshot(self, context, volume, snapshot,
+                                   operation_id):
+        return self._effect('snapshot', volume, snapshot, operation_id)
+
+    def checkpoint_revert_to_snapshot(self, context, volume, snapshot,
+                                      operation_id):
+        return self._effect('revert', volume, snapshot, operation_id)
+
+    def checkpoint_delete_snapshot(self, context, volume, snapshot,
+                                   operation_id):
+        return self._effect('delete_snapshot', volume, snapshot, operation_id)
+
+    def checkpoint_query_operation(self, context, volume, snapshot,
+                                   operation_id, action):
+        self.query_calls.append((action, volume.id, snapshot.id, operation_id))
+        return copy.deepcopy(self.query_results.get(
+            operation_id,
+            self.results.get(operation_id, {'status': 'unknown'})))
diff --git a/cinder/tests/unit/checkpoints/test_contracts.py b/cinder/tests/unit/checkpoints/test_contracts.py
new file mode 100644
index 0000000..5624df3
--- /dev/null
+++ b/cinder/tests/unit/checkpoints/test_contracts.py
@@ -0,0 +1,215 @@
+# Licensed under the Apache License, Version 2.0 (the "License"); you may
+# not use this file except in compliance with the License. You may obtain
+# a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+# WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+# License for the specific language governing permissions and limitations
+# under the License.
+
+import copy
+import unittest
+from unittest import mock
+
+from oslo_config import cfg
+
+from cinder.checkpoints import config
+from cinder.checkpoints import contracts
+from cinder import exception
+from cinder.tests.unit import test
+from cinder.volume import configuration
+from cinder.volume import driver
+
+
+def supported_capabilities():
+    return {
+        'contract_version': 1,
+        'supported': True,
+        'native_snapshot': True,
+        'snapshot_semantics': 'row',
+        'arbitrary_inplace_revert': True,
+        'preserves_other_checkpoints': True,
+        'independent_snapshot_delete': True,
+        'operation_reconciliation': True,
+        'consistent_group_snapshot': False,
+        'driver_identity': {
+            'driver_class': 'test.FakeCheckpointDriver',
+            'driver_version': '1.0',
+            'profile': 'test-row-v1',
+        },
+        'unsupported_reasons': [],
+    }
+
+
+def reserve_payload():
+    return {
+        'request_id': '11111111-1111-4111-8111-111111111111',
+        'checkpoint_id': '22222222-2222-4222-8222-222222222222',
+        'instance_uuid': '33333333-3333-4333-8333-333333333333',
+        'kind': 'create',
+        'project_id': 'project-one',
+        'service_user_id': 'nova-service',
+        'volume_ids': ['44444444-4444-4444-8444-444444444444',
+                       'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa'],
+    }
+
+
+class ContractTestCase(unittest.TestCase):
+    def test_default_capabilities_are_not_admitted(self):
+        caps = contracts.unsupported_capabilities('unsupported_driver')
+        self.assertFalse(caps['supported'])
+        self.assertFalse(caps['native_snapshot'])
+        self.assertRaises(exception.CheckpointNotSupported,
+                          contracts.validate_capabilities, caps)
+
+    def test_unknown_semantics_rejected(self):
+        caps = supported_capabilities()
+        caps['snapshot_semantics'] = 'unknown'
+        self.assertRaises(exception.CheckpointNotSupported,
+                          contracts.validate_capabilities, caps)
+
+    def test_row_remains_row_and_group_support_is_optional(self):
+        result = contracts.validate_capabilities(supported_capabilities())
+        self.assertEqual('row', result['snapshot_semantics'])
+        self.assertTrue(result['supported'])
+        self.assertFalse(result['consistent_group_snapshot'])
+
+    def test_missing_false_or_non_boolean_capability_is_rejected(self):
+        for field in ('native_snapshot', 'arbitrary_inplace_revert',
+                      'preserves_other_checkpoints',
+                      'independent_snapshot_delete',
+                      'operation_reconciliation'):
+            for value in (None, False, 'true', 1):
+                with self.subTest(field=field, value=value):
+                    caps = supported_capabilities()
+                    if value is None:
+                        del caps[field]
+                    else:
+                        caps[field] = value
+                    self.assertRaises(exception.CheckpointNotSupported,
+                                      contracts.validate_capabilities, caps)
+
+    def test_missing_profile_or_bad_version_is_rejected(self):
+        for patch in ({'contract_version': True}, {'contract_version': 2},
+                      {'driver_identity': {}}, {'supported': False},
+                      {'unsupported_reasons': ['unverified_profile']},
+                      {'consistent_group_snapshot': 'false'}):
+            with self.subTest(patch=patch):
+                caps = supported_capabilities()
+                caps.update(patch)
+                self.assertRaises(exception.CheckpointNotSupported,
+                                  contracts.validate_capabilities, caps)
+
+    def test_validated_capabilities_do_not_alias_input(self):
+        caps = supported_capabilities()
+        result = contracts.validate_capabilities(caps)
+        result['driver_identity']['profile'] = 'changed'
+        self.assertEqual('test-row-v1', caps['driver_identity']['profile'])
+
+    def test_hash_is_stable_across_key_order_and_volume_order(self):
+        original = reserve_payload()
+        permuted = dict(reversed(list(original.items())))
+        permuted['volume_ids'] = list(reversed(original['volume_ids']))
+        self.assertEqual(contracts.canonical_payload_hash(original),
+                         contracts.canonical_payload_hash(permuted))
+        self.assertEqual(reserve_payload(), original)
+
+    def test_hash_normalizes_volume_uuid_spelling(self):
+        original = reserve_payload()
+        equivalent = copy.deepcopy(original)
+        equivalent['volume_ids'][1] = 'AAAAAAAAAAAA4AAA8AAAAAAAAAAAAAAA'
+        self.assertEqual(contracts.canonical_payload_hash(original),
+                         contracts.canonical_payload_hash(equivalent))
+
+    def test_hash_binds_request_identity_action_and_volume_set(self):
+        original = reserve_payload()
+        for field, value in (
+                ('request_id', '55555555-5555-4555-8555-555555555555'),
+                ('instance_uuid', '66666666-6666-4666-8666-666666666666'),
+                ('checkpoint_id', '77777777-7777-4777-8777-777777777777'),
+                ('kind', 'revert'), ('project_id', 'other-project'),
+                ('service_user_id', 'other-service'),
+                ('volume_ids', ['88888888-8888-4888-8888-888888888888'])):
+            with self.subTest(field=field):
+                changed = copy.deepcopy(original)
+                changed[field] = value
+                self.assertNotEqual(contracts.canonical_payload_hash(original),
+                                    contracts.canonical_payload_hash(changed))
+
+    def test_invalid_or_duplicate_uuid_is_not_hashed(self):
+        for ids in ([], ['not-a-uuid'],
+                    ['aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa',
+                     'AAAAAAAAAAAA4AAA8AAAAAAAAAAAAAAA']):
+            payload = reserve_payload()
+            payload['volume_ids'] = ids
+            self.assertRaises(exception.InvalidInput,
+                              contracts.canonical_payload_hash, payload)
+
+    def test_driver_result_preserves_pending_reference(self):
+        result = contracts.validate_driver_result({
+            'status': 'pending', 'backend_reference': 'job-17'})
+        self.assertEqual('pending', result['status'])
+        self.assertEqual('job-17', result['backend_reference'])
+
+    def test_invalid_driver_result_is_unknown_not_success(self):
+        for value in (None, True, {}, {'status': 'available'},
+                      {'status': 'succeeded', 'password': 'secret'},
+                      {'status': 'succeeded', 'error_code': 'backend_failed'},
+                      {'status': 'unknown', 'error_code': '/secret/password'}):
+            with self.subTest(value=value):
+                self.assertEqual(
+                    {'status': 'unknown',
+                     'error_code': 'invalid_driver_result'},
+                    contracts.validate_driver_result(value))
+
+    def test_confirmed_driver_results_preserved(self):
+        for value in ({'status': 'succeeded'},
+                      {'status': 'unknown'},
+                      {'status': 'failed_no_effect',
+                       'error_code': 'backend_rejected'}):
+            self.assertEqual(value, contracts.validate_driver_result(value))
+
+    def test_config_defaults_disable_new_operations_and_service_access(self):
+        conf = cfg.ConfigOpts()
+        conf.register_opts(config.checkpoint_opts, group='checkpoint')
+        self.assertFalse(conf.checkpoint.enabled)
+        self.assertEqual([], conf.checkpoint.nova_service_user_ids)
+        self.assertRaises(ValueError, conf.set_override,
+                          'max_volumes_per_operation', 0,
+                          group='checkpoint')
+
+
+class DefaultDriverContractTestCase(test.TestCase):
+    def setUp(self):
+        super().setUp()
+        self.driver = driver.VolumeDriver(configuration=
+                                          configuration.Configuration(
+                                              driver.volume_opts))
+
+    def test_default_driver_is_unsupported(self):
+        caps = self.driver.get_checkpoint_capabilities(None, None)
+        self.assertFalse(caps['native_snapshot'])
+        self.assertRaises(exception.CheckpointNotSupported,
+                          contracts.validate_capabilities, caps)
