+class CheckpointConflict(CinderException):
+    message = _("Checkpoint operation conflict: %(reason)s")
+    code = 409
+    safe = True
+
+
+class CheckpointNotSupported(CheckpointConflict):
+    message = _("Native checkpoint contract is not supported: %(reason)s")
+
+
+class CheckpointOperationNotFound(CinderException):
+    message = _("Checkpoint operation was not found.")
+    code = 404
+    safe = True
+
+
+class CheckpointServiceForbidden(CinderException):
+    message = _("A trusted checkpoint service identity is required.")
+    code = 403
+    safe = True
+
+
 class VolumeDriverException(CinderException):
     message = _("Volume driver reported an error: %(message)s")
 
