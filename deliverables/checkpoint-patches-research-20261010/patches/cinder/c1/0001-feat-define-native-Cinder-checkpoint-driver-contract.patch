+from oslo_config import cfg
+
+
+checkpoint_opts = [
+    cfg.BoolOpt('enabled', default=False,
+                help='Allow creation of new native instance checkpoints. '
+                     'Existing protection and recovery remain active when '
+                     'disabled.'),
+    cfg.ListOpt('nova_service_user_ids', default=[],
+                help='Keystone service user IDs allowed to operate instance '
+                     'checkpoints. An empty list denies service access.'),
+    cfg.IntOpt('reconcile_interval', default=60, min=1,
+               help='Seconds between read-only checkpoint reconciliation.'),
+    cfg.IntOpt('max_volumes_per_operation', default=64, min=1, max=64,
+               help='Maximum number of volumes in one checkpoint operation.'),
+]
+
+CONF = cfg.CONF
+CONF.register_opts(checkpoint_opts, group='checkpoint')
diff --git a/cinder/checkpoints/contracts.py b/cinder/checkpoints/contracts.py
new file mode 100644
index 0000000..fa233e7
--- /dev/null
+++ b/cinder/checkpoints/contracts.py
@@ -0,0 +1,124 @@
+# Licensed under the Apache License, Version 2.0 (the "License"); you may
+# not use this file except in compliance with the License. You may obtain
+# a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+# WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+# License for the specific language governing permissions and limitations
+# under the License.
+
+"""Validate the version-one native checkpoint contract.
+
+Driver capability declarations are necessary, but verification of the actual
+volume and its model/firmware/transport profile remains the driver's duty.
+Unknown capabilities deny admission; unknown outcomes retain ownership.
+"""
+
+import copy
+import hashlib
+import json
+import re
+import uuid
+
+from cinder import exception
+
+
+REQUIRED_CAPABILITIES = (
+    'native_snapshot', 'arbitrary_inplace_revert',
+    'preserves_other_checkpoints', 'independent_snapshot_delete',
+    'operation_reconciliation',
+)
+RESULT_STATES = ('succeeded', 'pending', 'failed_no_effect', 'unknown')
+_CODE = re.compile(r'[a-z][a-z0-9_]{0,63}\Z')
+
+
+def unsupported_capabilities(reason: str) -> dict:
+    """Return an explicit denial without guessing legacy driver semantics."""
+    if not isinstance(reason, str) or not _CODE.fullmatch(reason):
+        reason = 'unsupported_driver'
+    return dict(
+        dict.fromkeys(REQUIRED_CAPABILITIES, False),
+        contract_version=1, supported=False, snapshot_semantics='unknown',
+        consistent_group_snapshot=False, driver_identity={},
+        unsupported_reasons=[reason])
+
+
+def validate_capabilities(value: dict) -> dict:
+    """Return an independent, validated capability document or deny access."""
+    def deny():
+        raise exception.CheckpointNotSupported(
+            reason='unverified_capabilities')
+
+    if not isinstance(value, dict):
+        deny()
+    if type(value.get('contract_version')) is not int:
+        deny()
+    if value['contract_version'] != 1 or value.get('supported') is not True:
+        deny()
+    if any(value.get(key) is not True for key in REQUIRED_CAPABILITIES):
+        deny()
+    if value.get('snapshot_semantics') not in ('cow', 'row'):
+        deny()
+    if type(value.get('consistent_group_snapshot')) is not bool:
+        deny()
+    if value.get('unsupported_reasons') != []:
+        deny()
+    identity = value.get('driver_identity')
+    if not isinstance(identity, dict):
+        deny()
+    for key in ('driver_class', 'driver_version', 'profile'):
+        if (not isinstance(identity.get(key), str) or
+                not identity[key].strip() or len(identity[key]) > 255):
+            deny()
+    allowed = set(REQUIRED_CAPABILITIES) | {
+        'contract_version', 'supported', 'snapshot_semantics',
+        'consistent_group_snapshot', 'driver_identity', 'unsupported_reasons',
+    }
+    if set(value) != allowed or set(identity) != {
+            'driver_class', 'driver_version', 'profile'}:
+        deny()
+    return copy.deepcopy(value)
+
+
+def canonical_payload_hash(payload: dict) -> str:
+    """Bind a request to its identity, operation and canonical volume set."""
+    try:
+        if not isinstance(payload, dict):
+            raise ValueError()
+        value = copy.deepcopy(payload)
+        for key in ('request_id', 'checkpoint_id', 'instance_uuid'):
+            value[key] = str(uuid.UUID(value[key]))
+        volumes = value['volume_ids']
+        if not isinstance(volumes, list) or not 1 <= len(volumes) <= 64:
+            raise ValueError()
+        volumes = [str(uuid.UUID(volume_id)) for volume_id in volumes]
+        if len(set(volumes)) != len(volumes):
+            raise ValueError()
+        value['volume_ids'] = sorted(volumes)
+        encoded = json.dumps(value, sort_keys=True, separators=(',', ':'),
+                             ensure_ascii=True, allow_nan=False)
+    except (KeyError, TypeError, ValueError, AttributeError):
+        raise exception.InvalidInput(reason='invalid_checkpoint_payload')
+    return hashlib.sha256(encoded.encode('utf-8')).hexdigest()
+
+
+def validate_driver_result(value: dict) -> dict:
+    """Never interpret malformed backend responses as no effect or success."""
+    unknown = {'status': 'unknown', 'error_code': 'invalid_driver_result'}
+    if not isinstance(value, dict) or value.get('status') not in RESULT_STATES:
+        return unknown
+    if set(value) - {'status', 'backend_reference', 'error_code'}:
+        return unknown
+    if 'backend_reference' in value:
+        ref = value['backend_reference']
+        if not isinstance(ref, str) or not ref or len(ref) > 1024:
+            return unknown
+    if 'error_code' in value:
+        code = value['error_code']
+        if (not isinstance(code, str) or not _CODE.fullmatch(code) or
+                value['status'] == 'succeeded'):
+            return unknown
+    return copy.deepcopy(value)
