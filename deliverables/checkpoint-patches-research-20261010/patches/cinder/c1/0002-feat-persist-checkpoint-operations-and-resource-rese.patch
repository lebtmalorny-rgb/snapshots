+class ConcurrencyTests(CheckpointDBTests):
+    def setUp(self):
+        super().setUp()
+        self.useFixture(config_fixture.Config()).config(
+            connection='sqlite://', group='database')
+        engine = enginefacade.writer.get_engine()
+        migration.db_sync(engine=engine)
+        self.addCleanup(sqla_api.main_context_manager.patch_engine(engine))
+
+    def race(self, requests):
+        gate = eventlet.event.Event()
+        pool = eventlet.GreenPool(size=2)
+        results = []
+
+        def reserve(values, volumes):
+            gate.wait()
+            try:
+                result = self.reserve(values, volumes, service_context())
+            except exception.CheckpointConflict:
+                result = None
+            results.append(result)
+
+        for values, volumes in requests:
+            pool.spawn_n(reserve, values, volumes)
+        gate.send()
+        pool.waitall()
+        self.assertEqual(2, len(results))
+        return [result for result in results if result]
+
+    def test_two_reservations_have_one_winner(self):
+        self.prepare_volumes()
+        winners = self.race([(self.values(), self.volumes),
+                             (self.values(), self.volumes)])
+        self.assertEqual(1, len(winners))
+        self.assertEqual(sorted(self.volumes), sorted(self.locks()))
+
+    def test_disjoint_sets_for_one_instance_have_one_winner(self):
+        self.prepare_volumes()
+        winners = self.race([(self.values(), self.volumes[:1]),
+                             (self.values(), self.volumes[1:])])
+        self.assertEqual(1, len(winners))
+        self.assertEqual(1, len(self.locks()))
+
+    def test_identical_concurrent_request_returns_same_operation(self):
+        self.prepare_volumes()
+        values = self.values()
+        winners = self.race([(values, self.volumes),
+                             (copy.deepcopy(values), self.volumes)])
+        self.assertEqual(2, len(winners))
+        self.assertEqual(winners[0]['id'], winners[1]['id'])
+
+
+class TestCheckpointMySQL(ConcurrencyTests,
