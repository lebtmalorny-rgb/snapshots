+class TestCheckpointObjects(test_db.CheckpointDBHelpers, test.TestCase):
+    def test_operation_wire_roundtrip_preserves_step_identity(self):
+        self.prepare_volumes()
+        operation = self.reserve()
+        obj = objects.CheckpointOperation.get_by_id(self.ctxt, operation['id'])
+        restored = base.CinderObject.obj_from_primitive(
+            obj.obj_to_primitive(), context=self.ctxt)
+        self.assertEqual(obj.id, restored.id)
+        self.assertEqual(obj.generation, restored.generation)
+        self.assertEqual(operation['steps'][0]['id'], restored.steps[0].id)
+        self.assertEqual(operation['resources'][0]['snapshot_id'],
+                         restored.resources[0].snapshot_id)
+
+    def test_new_objects_have_models_and_can_be_listed(self):
+        self.prepare_volumes()
+        operation = self.reserve()
+        for name in ('CheckpointInstance', 'CheckpointOperation',
+                     'CheckpointResource', 'CheckpointStep',
+                     'CheckpointVolumeLock'):
+            obj_type = getattr(objects, name)
+            model = db.get_model_for_versioned_object(obj_type)
+            self.assertIsNotNone(model)
+            records = getattr(objects, name + 'List').get_all(self.ctxt)
+            self.assertGreater(len(records), 0)
+            self.assertTrue(all(isinstance(item, obj_type)
+                                for item in records))
+        self.assertEqual(operation['id'],
+                         objects.CheckpointOperationList.get_all(
+                             self.ctxt)[0].id)
