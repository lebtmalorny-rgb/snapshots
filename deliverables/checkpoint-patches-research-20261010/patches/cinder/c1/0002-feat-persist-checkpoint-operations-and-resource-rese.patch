+import copy
+import json
+
+import eventlet
+from oslo_config import fixture as config_fixture
+from oslo_db.sqlalchemy import enginefacade
+from oslo_db.sqlalchemy import test_fixtures
+from oslo_utils import uuidutils
+from oslotest import base as test_base
+
+from cinder import context
+from cinder import db
+from cinder.db import migration
+from cinder.db.sqlalchemy import api as sqla_api
+from cinder.db.sqlalchemy import models
+from cinder import exception
+from cinder.tests.unit.checkpoints.test_contracts import supported_capabilities
+from cinder.tests.unit import fake_constants as fake
+from cinder.tests.unit import test
+from cinder.tests.unit import utils
+
+
+SERVICE_ID = 'eeeeeeee-eeee-4eee-8eee-eeeeeeeeeeee'
+
+
+def service_context():
+    return context.RequestContext(fake.USER_ID, fake.PROJECT_ID,
+                                  service_user_id=SERVICE_ID, is_admin=False)
+
+
+class CheckpointDBHelpers:
+    def prepare_volumes(self, count=2):
+        self.ctxt = service_context()
+        self.instance = uuidutils.generate_uuid()
+        self.volumes = []
+        for unused in range(count):
+            volume = utils.create_volume(self.ctxt, volume_type_id=None)
+            utils.attach_volume(self.ctxt, volume, self.instance,
+                                'compute-one', '/dev/vda')
+            self.volumes.append(volume.id)
+
+    def values(self, kind='create', checkpoint_id=None, volumes=None):
+        return {
+            'request_id': uuidutils.generate_uuid(),
+            'checkpoint_id': checkpoint_id or uuidutils.generate_uuid(),
+            'instance_uuid': self.instance,
+            'kind': kind,
+            'capabilities': {v: supported_capabilities()
+                             for v in (volumes or self.volumes)},
+        }
+
+    def reserve(self, values=None, volumes=None, ctxt=None):
+        return db.checkpoint_reserve(ctxt or self.ctxt,
+                                     values or self.values(),
+                                     volumes or self.volumes)
+
+    def locks(self):
+        with sqla_api.main_context_manager.reader.using(self.ctxt):
+            return [row.volume_id for row in self.ctxt.session.query(
+                models.CheckpointVolumeLock).all()]
+
+    def succeed(self, operation):
+        for step in operation['steps']:
+            self.assertTrue(db.checkpoint_step_claim(
+                self.ctxt, step['id'], operation['generation'], 'worker-one'))
+            db.checkpoint_step_finish(self.ctxt, step['id'], 1,
+                                      {'status': 'succeeded'})
+
+
+class CheckpointDBTests(CheckpointDBHelpers):
+    def test_reserve_is_all_or_nothing(self):
+        self.prepare_volumes()
+        self.reserve(volumes=[self.volumes[1]])
+        self.assertRaises(exception.CheckpointConflict, self.reserve)
+        self.assertEqual([self.volumes[1]], self.locks())
+
+    def test_replay_after_release_returns_tombstone(self):
+        self.prepare_volumes()
+        values = self.values()
+        original = self.reserve(values)
+        db.checkpoint_release(self.ctxt, original['id'], 1, 'abort')
+        replay = self.reserve(values)
+        self.assertEqual(original['id'], replay['id'])
+        self.assertEqual('released', replay['status'])
+        self.assertEqual([], self.locks())
+
+    def test_released_tombstone_survives_removed_volume(self):
+        self.prepare_volumes(count=1)
+        values = self.values()
+        original = self.reserve(values)
+        db.checkpoint_release(self.ctxt, original['id'], 1, 'abort')
+        db.volume_destroy(self.ctxt.elevated(), self.volumes[0])
+        self.assertEqual(original['id'], self.reserve(values)['id'])
+        self.assertEqual('released', db.checkpoint_release(
+            self.ctxt, original['id'], 1, 'abort')['status'])
+
+    def test_changed_payload_cannot_reuse_request_id(self):
+        self.prepare_volumes()
+        values = self.values()
+        self.reserve(values)
