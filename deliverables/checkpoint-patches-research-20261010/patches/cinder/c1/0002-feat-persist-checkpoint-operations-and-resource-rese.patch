diff --git a/cinder/db/sqlalchemy/checkpoints.py b/cinder/db/sqlalchemy/checkpoints.py
new file mode 100644
index 0000000..ebe88bc
--- /dev/null
+++ b/cinder/db/sqlalchemy/checkpoints.py
@@ -0,0 +1,474 @@
+# Licensed under the Apache License, Version 2.0 (the "License"); you may
+# not use this file except in compliance with the License. You may obtain
+# a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+# WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+# License for the specific language governing permissions and limitations
+# under the License.
+
+"""Checkpoint journal transitions.
+
+Always lock instance, then sorted volumes, before changing journal ownership.
+Admission uses current reads, including on MySQL REPEATABLE READ. No backend
+call belongs in any of these short transactions. Journal rows are tombstones;
+only temporary volume-lock rows are physically removed.
+"""
+
+import json
+import uuid
+
+from oslo_db import api as oslo_db_api
+from oslo_utils import timeutils
+from oslo_utils import uuidutils
+
+from cinder.checkpoints import contracts
+from cinder.db.sqlalchemy import api
+from cinder.db.sqlalchemy import models
+from cinder import exception
+
+
+PHASES = {'create': 'snapshot', 'revert': 'revert',
+          'delete': 'delete_snapshot'}
+IDENTITY = ('project_id', 'user_id', 'service_user_id')
+
+
+def _conflict(reason):
+    raise exception.CheckpointConflict(reason=reason)
+
+
+def _query(context, model):
+    return context.session.query(model).filter_by(deleted=False)
+
+
+def _current(query):
+    return query.populate_existing().with_for_update()
+
+
+def _identity(context):
+    identity = {key: getattr(context, key, None) for key in IDENTITY}
+    if not all(identity.values()):
+        raise exception.CheckpointServiceForbidden()
+    return identity
+
+
+def _owned(context, row):
+    if row is None or any(getattr(context, key, None) != row[key]
+                          for key in IDENTITY):
+        raise exception.CheckpointOperationNotFound()
+    return row
+
+
+def _operation(context, operation_id):
+    return _owned(context, _query(context, models.CheckpointOperation).
+                  filter_by(id=operation_id).first())
+
+
+def _resources(context, checkpoint_id, lock=False):
+    query = _query(context, models.CheckpointResource).filter_by(
+        checkpoint_id=checkpoint_id).order_by(models.CheckpointResource.id)
+    return (_current(query) if lock else query).all()
+
+
+def _steps(context, operation_id):
+    return _query(context, models.CheckpointStep).filter_by(
+        operation_id=operation_id).order_by(models.CheckpointStep.id).all()
+
+
+def _as_dict(context, operation):
+    context.session.flush()
+    result = dict(operation)
+    result['resources'] = [dict(r) for r in _resources(
+        context, operation.checkpoint_id)]
+    result['steps'] = [dict(s) for s in _steps(context, operation.id)]
+    return result
+
+
+def _lock_volumes(context, volume_ids):
+    volumes = []
+    for volume_id in sorted(volume_ids):
+        volume = _current(_query(context, models.Volume).filter_by(
+            id=volume_id)).first()
+        if volume is None or volume.project_id != context.project_id:
+            raise exception.VolumeNotFound(volume_id=volume_id)
+        volumes.append(volume)
+    return volumes
+
+
+def _locked_operation(context, operation_id, generation):
+    old = _operation(context, operation_id)
+    if type(generation) is not int or generation != old.generation:
+        _conflict('stale_generation')
+    # A released journal entry is immutable and independent of live volumes.
+    if old.status == 'released':
+        return old, None, []
+    instance = _current(_query(context, models.CheckpointInstance).filter_by(
+        instance_uuid=old.instance_uuid)).one()
+    volumes = _lock_volumes(context, json.loads(instance.volume_ids_json))
+    operation = _owned(context, _current(_query(
+        context, models.CheckpointOperation).filter_by(id=operation_id)).one())
+    if type(generation) is not int or generation != operation.generation:
+        _conflict('stale_generation')
+    if operation.status != 'released':
+        if instance.active_operation_id != operation_id:
+            _conflict('operation_not_owner')
+        locks = _current(_query(context, models.CheckpointVolumeLock).
+                         filter_by(operation_id=operation_id)).all()
+        if (sorted(lock.volume_id for lock in locks) !=
+                sorted(volume.id for volume in volumes) or
+                any(lock.generation != generation for lock in locks)):
+            _conflict('operation_not_owner')
+    return operation, instance, volumes
+
+
+def _attachments(context, volume_id):
+    return _current(_query(context, models.VolumeAttachment).filter_by(
+        volume_id=volume_id)).all()
+
+
+def _check_volume(context, volume, instance_uuid, kind):
+    if (volume.status not in ('available', 'in-use') or volume.multiattach or
+            volume.group_id or volume.consistencygroup_id or
+            volume.migration_status or volume.replication_status not in
+            (None, 'disabled', 'not-capable')):
+        _conflict('unsupported_volume_state')
+    attachments = _attachments(context, volume.id)
+    if (len(attachments) > 1 or (kind == 'create' and len(attachments) != 1)
+            or any(a.attach_status != 'attached' or
+                   a.instance_uuid != instance_uuid for a in attachments)):
+        _conflict('attachment_conflict')
+    pending = _current(_query(context, models.Snapshot).filter(
+        models.Snapshot.volume_id == volume.id,
+        models.Snapshot.status != 'available')).first()
+    if pending:
+        _conflict('snapshot_in_progress')
+    return [a.id for a in attachments]
+
+
+def _replay(context, operation, payload_hash):
+    _owned(context, operation)
+    if operation.payload_hash != payload_hash:
+        _conflict('request_payload_changed')
+    return _as_dict(context, operation)
+
+
+@api.require_context
+@oslo_db_api.wrap_db_retry(
+    max_retries=5, retry_on_deadlock=True, exception_checker=api._is_duplicate)
+@api.main_context_manager.writer
+def reserve(context, values, volume_ids):
+    identity = _identity(context)
+    payload = {key: values.get(key) for key in
+               ('request_id', 'checkpoint_id', 'instance_uuid', 'kind')}
+    payload.update(identity, volume_ids=volume_ids)
+    payload_hash = contracts.canonical_payload_hash(payload)
+    for key in ('request_id', 'checkpoint_id', 'instance_uuid'):
+        payload[key] = str(uuid.UUID(payload[key]))
+    volume_ids = sorted(str(uuid.UUID(v)) for v in volume_ids)
+    kind = payload['kind']
+    if kind not in PHASES:
+        raise exception.InvalidInput(reason='invalid_checkpoint_kind')
+    request_query = _query(context, models.CheckpointOperation).filter_by(
+        project_id=context.project_id, request_id=payload['request_id'])
+    previous = request_query.first()
+    if previous:
+        return _replay(context, previous, payload_hash)
+
+    instance = _current(_query(context, models.CheckpointInstance).filter_by(
+        instance_uuid=payload['instance_uuid'])).first()
+    if instance is None:
+        instance = models.CheckpointInstance(
+            instance_uuid=payload['instance_uuid'],
+            project_id=context.project_id,
+            volume_ids_json=json.dumps(volume_ids))
+        context.session.add(instance)
+        # A competing insert rolls back and retries the entire transaction.
+        context.session.flush()
+    if instance.project_id != context.project_id:
+        raise exception.CheckpointOperationNotFound()
+    previous = _current(request_query).first()
+    if previous:
+        return _replay(context, previous, payload_hash)
+    if instance.active_operation_id:
+        _conflict('instance_operation_active')
+    live = _current(_query(context, models.CheckpointResource).filter(
+        models.CheckpointResource.instance_uuid == instance.instance_uuid,
+        models.CheckpointResource.status != 'deleted')).all()
+    if live and json.loads(instance.volume_ids_json) != volume_ids:
+        _conflict('volume_set_changed')
+    instance.volume_ids_json = json.dumps(volume_ids)
+    volumes = _lock_volumes(context, volume_ids)
+    attachments = {}
+    for volume in volumes:
+        if _current(_query(context, models.CheckpointVolumeLock).filter_by(
+                volume_id=volume.id)).first():
+            _conflict('volume_operation_active')
+        references = _current(_query(context, models.CheckpointResource).
+                              filter_by(volume_id=volume.id).filter(
+            models.CheckpointResource.status != 'deleted')).all()
+        if any(r.instance_uuid != instance.instance_uuid or
+               r.project_id != context.project_id for r in references):
+            _conflict('volume_owned_by_other_instance')
+        attachments[volume.id] = _check_volume(context, volume,
+                                               instance.instance_uuid, kind)
+
+    checkpoint_id = payload['checkpoint_id']
+    resources = _resources(context, checkpoint_id, lock=True)
+    if kind == 'create':
+        if _current(_query(context, models.CheckpointOperation).filter_by(
+                create_checkpoint_id=checkpoint_id)).first():
+            _conflict('checkpoint_id_reused')
+        for volume in volumes:
+            caps = contracts.validate_capabilities(
+                values.get('capabilities', {}).get(volume.id))
+            resource = models.CheckpointResource(
+                id=uuidutils.generate_uuid(), project_id=context.project_id,
+                instance_uuid=instance.instance_uuid,
+                checkpoint_id=checkpoint_id, volume_id=volume.id,
+                snapshot_id=uuidutils.generate_uuid(), volume_size=volume.size,
+                backend_profile=caps['driver_identity']['profile'],
+                capabilities_json=json.dumps(caps, sort_keys=True),
+                status='creating')
+            context.session.add(resource)
+            api.snapshot_create(context, {
+                'id': resource.snapshot_id, 'volume_id': volume.id,
+                'project_id': context.project_id, 'user_id': context.user_id,
+                'status': 'creating', 'progress': '0%',
+                'volume_size': volume.size,
+                'volume_type_id': volume.volume_type_id,
+                'encryption_key_id': volume.encryption_key_id})
+            resources.append(resource)
+    elif (not resources or
+          sorted(r.volume_id for r in resources) != volume_ids or
+          any(r.project_id != context.project_id or
+              r.instance_uuid != instance.instance_uuid or
+              r.status != 'available' for r in resources)):
+        _conflict('checkpoint_resource_mismatch')
+
+    operation = models.CheckpointOperation(
+        id=uuidutils.generate_uuid(), **identity,
+        request_id=payload['request_id'], checkpoint_id=checkpoint_id,
+        create_checkpoint_id=checkpoint_id if kind == 'create' else None,
+        instance_uuid=instance.instance_uuid, kind=kind,
+        payload_hash=payload_hash, generation=1, status='reserved')
+    context.session.add(operation)
+    context.session.flush()
+    instance.active_operation_id = operation.id
+    for resource in resources:
+        context.session.add(models.CheckpointStep(
+            id=uuidutils.generate_uuid(), operation_id=operation.id,
+            resource_id=resource.id, phase=PHASES[kind], generation=1,
+            status='prepared', quota_reservations_json='[]',
+            original_attachment_ids_json=json.dumps(
+                attachments[resource.volume_id])))
+        context.session.add(models.CheckpointVolumeLock(
+            volume_id=resource.volume_id, operation_id=operation.id,
+            generation=1))
+    return _as_dict(context, operation)
+
+
+@api.require_context
+@api.main_context_manager.reader
+def get(context, operation_id):
+    return _as_dict(context, _operation(context, operation_id))
+
+
+@api.require_context
+@api.main_context_manager.reader
+def get_all(context, filters=None, marker=None, limit=None):
+    query = _query(context, models.CheckpointOperation).filter_by(
+        **_identity(context))
+    filters = filters or {}
+    if set(filters) - {'checkpoint_id', 'instance_uuid', 'status'}:
+        raise exception.InvalidInput(reason='invalid_checkpoint_filter')
+    query = query.filter_by(**filters)
+    if marker:
+        _operation(context, marker)
+        query = query.filter(models.CheckpointOperation.id > marker)
+    query = query.order_by(models.CheckpointOperation.id)
+    if limit is not None:
+        if type(limit) is not int or limit < 1:
+            raise exception.InvalidInput(reason='invalid_limit')
+        query = query.limit(limit)
+    return [_as_dict(context, row) for row in query.all()]
+
+
+def _step_operation(context, step_id, generation):
+    step = _query(context, models.CheckpointStep).filter_by(id=step_id).first()
+    if step is None:
+        raise exception.CheckpointOperationNotFound()
+    operation, instance, volumes = _locked_operation(
+        context, step.operation_id, generation)
+    step = _current(_query(context, models.CheckpointStep).filter_by(
+        id=step_id)).one()
+    if step.generation != generation:
+        _conflict('stale_generation')
+    return step, operation
+
+
+@api.require_context
+@api.main_context_manager.writer
+def step_claim(context, step_id, generation, executor_id):
+    step, operation = _step_operation(context, step_id, generation)
+    if operation.status == 'released' or step.status != 'prepared':
+        return False
+    if not isinstance(executor_id, str) or not 0 < len(executor_id) <= 255:
+        raise exception.InvalidInput(reason='invalid_executor_id')
+    step.status = 'dispatching'
+    step.executor_id = executor_id
+    operation.status = 'running'
+    return True
+
+
+def _update_operation(context, operation):
+    statuses = {s.status for s in _steps(context, operation.id)}
+    if statuses & {'unknown', 'dispatching', 'pending'}:
+        operation.status = 'recovery_required'
+    elif statuses == {'succeeded'}:
+        operation.status = 'succeeded'
+    elif 'failed_no_effect' in statuses:
+        operation.status = 'failed'
+    else:
+        operation.status = 'running'
+
+
+@api.require_context
+@api.main_context_manager.writer
+def step_finish(context, step_id, generation, result):
+    step, operation = _step_operation(context, step_id, generation)
+    result = contracts.validate_driver_result(result)
+    if operation.status == 'released':
+        return dict(step)
+    if step.status in ('succeeded', 'failed_no_effect'):
+        if result['status'] != step.status:
+            _conflict('terminal_step_result_changed')
+        return dict(step)
+    if step.status == 'prepared':
+        _conflict('step_not_dispatched')
+    step.status = result['status']
+    step.backend_reference = result.get('backend_reference',
+                                        step.backend_reference)
+    step.error_code = result.get('error_code')
+    if step.status == 'succeeded':
+        resource = _current(_query(context, models.CheckpointResource).
+                            filter_by(id=step.resource_id)).one()
+        snapshot = _query(context, models.Snapshot).filter_by(
+            id=resource.snapshot_id).first()
+        if step.phase == 'snapshot':
+            resource.status = 'available'
+            if snapshot:
+                snapshot.status = 'available'
+                snapshot.progress = '100%'
+        elif step.phase == 'delete_snapshot':
+            resource.status = 'deleted'
+            if snapshot:
+                snapshot.status = 'deleted'
+                snapshot.deleted = True
+                snapshot.deleted_at = timeutils.utcnow()
+    context.session.flush()
+    _update_operation(context, operation)
+    return dict(step)
+
+
+@api.require_context
+@api.main_context_manager.writer
+def release(context, operation_id, generation, outcome):
+    if outcome not in ('commit', 'abort'):
+        raise exception.InvalidInput(reason='invalid_release_outcome')
+    operation, instance, volumes = _locked_operation(
+        context, operation_id, generation)
+    if operation.status == 'released':
+        if outcome != operation.release_outcome:
+            _conflict('release_outcome_changed')
+        return _as_dict(context, operation)
+    steps = _steps(context, operation_id)
+    if outcome == 'commit':
+        if any(s.status != 'succeeded' for s in steps):
+            _conflict('unconfirmed_result')
+        if operation.kind == 'revert':
+            for volume in volumes:
+                attachments = _attachments(context, volume.id)
+                if (len(attachments) != 1 or any(
+                        a.instance_uuid != instance.instance_uuid or
+                        a.attach_status != 'attached' for a in attachments)):
+                    _conflict('reattachment_required')
+    else:
+        if any(s.status not in ('prepared', 'failed_no_effect')
+               for s in steps):
+            _conflict('effect_not_cleaned')
+        if operation.kind == 'create':
+            for resource in _resources(context, operation.checkpoint_id,
+                                       lock=True):
+                resource.status = 'deleted'
+                snapshot = _query(context, models.Snapshot).filter_by(
+                    id=resource.snapshot_id).first()
+                if snapshot:
+                    snapshot.deleted = True
+                    snapshot.deleted_at = timeutils.utcnow()
+                    snapshot.status = 'deleted'
+    _query(context, models.CheckpointVolumeLock).filter_by(
+        operation_id=operation_id, generation=generation).delete(
+            synchronize_session=False)
+    instance.active_operation_id = None
+    operation.status = 'released'
+    operation.release_outcome = outcome
+    return _as_dict(context, operation)
+
+
+@api.require_context
+@api.main_context_manager.writer
+def resource_guard(context, volume_id, action):
+    if action == 'read':
+        return
+    _lock_volumes(context, [volume_id])
+    active = _current(_query(context, models.CheckpointVolumeLock).filter_by(
+        volume_id=volume_id)).first()
+    if active:
+        _conflict('volume_operation_active')
+    # These source-only operations are allowed between reservations. Their
+    # pending status is checked again by checkpoint admission.
+    if action in ('snapshot', 'backup', 'clone', 'upload'):
+        return
+    reference = _current(_query(context, models.CheckpointResource).filter_by(
+        volume_id=volume_id).filter(
+            models.CheckpointResource.status != 'deleted')).first()
+    if reference:
+        _conflict('volume_has_checkpoints')
+
+
+RECORD_TYPES = {name: getattr(models, name) for name in (
+    'CheckpointInstance', 'CheckpointOperation', 'CheckpointResource',
+    'CheckpointStep', 'CheckpointVolumeLock')}
+
+
+@api.require_context
+@api.main_context_manager.reader
+def records(context, name, record_id=None):
+    """Read-only OVO projections with the same ownership as the operation."""
+    model = RECORD_TYPES[name]
+    owned = _query(context, models.CheckpointOperation).filter_by(
+        **_identity(context))
+    query = _query(context, model)
+    if name == 'CheckpointOperation':
+        query = owned
+    elif name in ('CheckpointStep', 'CheckpointVolumeLock'):
+        query = query.filter(model.operation_id.in_(
+            owned.with_entities(models.CheckpointOperation.id)))
+    elif name == 'CheckpointResource':
+        query = query.filter(model.checkpoint_id.in_(
+            owned.with_entities(models.CheckpointOperation.checkpoint_id)))
+    else:
+        query = query.filter(model.instance_uuid.in_(
+            owned.with_entities(models.CheckpointOperation.instance_uuid)))
+    key = ('instance_uuid' if name == 'CheckpointInstance' else
+           'volume_id' if name == 'CheckpointVolumeLock' else 'id')
+    if record_id:
+        query = query.filter(getattr(model, key) == record_id)
+    rows = query.order_by(getattr(model, key)).all()
+    if record_id and not rows:
+        raise exception.CheckpointOperationNotFound()
+    return [(_as_dict(context, row) if name == 'CheckpointOperation'
+             else dict(row)) for row in rows]
