+                        base.CinderObjectDictCompat):
+    @classmethod
+    def get_by_id(cls, context, id, *args, **kwargs):
+        row = db.checkpoint_records(context, cls.obj_name(), id)[0]
+        return cls._from_db_object(context, cls(context), row)
+
+    @classmethod
+    def _from_db_object(cls, context, obj, row):
+        for name in obj.fields:
+            if name == 'resources':
+                obj.resources = [objects.CheckpointResource._from_db_object(
+                    context, objects.CheckpointResource(context), item)
+                    for item in row[name]]
+            elif name == 'steps':
+                obj.steps = [objects.CheckpointStep._from_db_object(
+                    context, objects.CheckpointStep(context), item)
+                    for item in row[name]]
+            else:
+                obj[name] = row.get(name)
+        obj._context = context
+        obj.obj_reset_changes()
+        return obj
+
+    def conditional_update(self, *args, **kwargs):
+        raise exception.ObjectActionError(
+            action='conditional_update', reason='read-only checkpoint object')
