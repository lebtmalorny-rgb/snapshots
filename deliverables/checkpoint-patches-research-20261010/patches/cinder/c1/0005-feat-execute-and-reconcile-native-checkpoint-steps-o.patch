+from types import SimpleNamespace
+from unittest import mock
+
+import oslo_messaging
+from oslo_utils import timeutils
+
+from cinder.checkpoints import manager
+from cinder import db
+from cinder.db.sqlalchemy import api as sqla_api
+from cinder.db.sqlalchemy import models
+from cinder import exception
+from cinder import objects
+from cinder.tests.unit.checkpoints import fake_driver
+from cinder.tests.unit.checkpoints import test_api
+from cinder.tests.unit import test
+from cinder.volume import rpcapi
+
+
+class ManagerHelpers(test_api.APIHelpers):
+    def prepare_manager(self):
+        self.prepare_api()
+        self.driver = fake_driver.FakeCheckpointDriver()
+        self.driver.set_initialized()
+        self.owner = SimpleNamespace(
+            driver=self.driver, host='worker@backend', cluster=None,
+            _revert_to_snapshot_generic=mock.Mock())
+        for vid in self.volumes:
+            db.volume_update(self.ctxt, vid, {'host': self.owner.host})
+        self.manager = manager.CheckpointManager(self.owner)
+        self.rpc.get_checkpoint_capabilities.side_effect = (
+            lambda ctxt, vid, host: self.manager.capabilities(ctxt, vid))
+
+    def read(self, operation):
+        return self.api.get(self.ctxt, operation.id)
+
+    def execute(self, operation):
+        for step in operation.steps:
+            self.manager.execute(self.ctxt, step.id, operation.generation)
+
+    def available_checkpoint(self):
+        operation = self.api.reserve(self.ctxt, self.payload)
+        self.execute(operation)
+        self.api.action(self.ctxt, operation.id, 'release', 1, 'commit')
+        return operation
+
+    def detach_for_worker_test(self):
+        # Simulate the authorized Nova attachment workflow; its implementation
+        # and API authorization are tested in test_attachment_scope.
+        with sqla_api.main_context_manager.writer.using(self.ctxt):
+            self.ctxt.session.query(models.VolumeAttachment).filter(
+                models.VolumeAttachment.volume_id.in_(self.volumes)).update(
+                    {'deleted': True}, synchronize_session=False)
+            self.ctxt.session.query(models.Volume).filter(
+                models.Volume.id.in_(self.volumes)).update(
+                    {'status': 'available', 'attach_status': 'detached'},
+                    synchronize_session=False)
+
+
+class TestCheckpointManager(ManagerHelpers, test.TestCase):
+    def setUp(self):
+        super().setUp()
+        self.prepare_manager()
+
+    def test_lost_reply_never_reexecutes(self):
+        operation = self.api.reserve(self.ctxt, self.payload)
+        step = operation.steps[0]
+        self.driver.outcomes['snapshot'].append(RuntimeError('secret-token'))
+        self.manager.execute(self.ctxt, step.id, 1)
+        self.assertEqual('recovery_required', self.read(operation).status)
+        self.manager.execute(self.ctxt, step.id, 1)
+        self.assertEqual(1, self.driver.native_call_count)
+        self.manager.reconcile(self.ctxt, step.id, 1)
+        self.assertEqual(1, self.driver.native_call_count)
+        actual = next(s for s in self.read(operation).steps if s.id == step.id)
+        self.assertEqual('succeeded', actual.status)
+        self.assertNotIn('secret-token', str(actual))
+        self.assertEqual(sorted(self.volumes), sorted(self.locks()))
+
+    def test_two_rpc_deliveries_have_one_claim(self):
+        operation = self.api.reserve(self.ctxt, self.payload)
+        self.execute(operation)
+        self.execute(operation)
+        self.assertEqual(2, self.driver.native_call_count)
+        self.assertEqual('succeeded', self.read(operation).status)
+
+    def test_pending_and_partial_outcomes_hold_all_locks(self):
+        operation = self.api.reserve(self.ctxt, self.payload)
+        self.driver.outcomes['snapshot'].append({'status': 'pending'})
+        self.execute(operation)
+        self.assertEqual('recovery_required', self.read(operation).status)
+        self.assertRaises(exception.CheckpointConflict, self.api.action,
+                          self.ctxt, operation.id, 'release', 1, 'commit')
+        for step in operation.steps:
+            self.manager.reconcile(self.ctxt, step.id, 1)
+        self.assertEqual(2, self.driver.native_call_count)
+        self.assertEqual('succeeded', self.read(operation).status)
+        self.assertEqual(sorted(self.volumes), sorted(self.locks()))
+
+    def test_malformed_reply_is_unknown_and_safe(self):
+        operation = self.api.reserve(self.ctxt, self.payload)
+        self.driver.outcomes['snapshot'].append({'secret': 'token'})
+        self.execute(operation)
+        self.assertEqual('recovery_required', self.read(operation).status)
+        step = next(s for s in self.read(operation).steps
+                    if s.status == 'unknown')
+        self.assertEqual('invalid_driver_result', step.error_code)
+
+    def test_partial_failure_retains_every_volume_lock(self):
+        operation = self.api.reserve(self.ctxt, self.payload)
+        self.driver.outcomes['snapshot'].append({'status': 'failed_no_effect'})
+        self.execute(operation)
+        self.assertEqual('failed', self.read(operation).status)
+        self.assertRaises(exception.CheckpointConflict, self.api.action,
+                          self.ctxt, operation.id, 'release', 1, 'abort')
+        self.assertEqual(sorted(self.volumes), sorted(self.locks()))
+        self.assertEqual(1, len(self.driver.snapshots))
+
+    def test_stale_generation_and_wrong_worker_have_no_effect(self):
+        operation = self.api.reserve(self.ctxt, self.payload)
+        self.assertRaises(exception.CheckpointConflict, self.manager.execute,
+                          self.ctxt, operation.steps[0].id, 2)
+        self.owner.host = 'different@backend'
+        self.assertRaises(exception.CheckpointConflict, self.execute,
+                          operation)
+        self.assertEqual(0, self.driver.native_call_count)
+
+    def test_changed_driver_profile_has_no_effect(self):
+        operation = self.api.reserve(self.ctxt, self.payload)
+        caps = self.driver.get_checkpoint_capabilities(self.ctxt, None)
+        caps['driver_identity']['profile'] = 'other-profile'
+        self.mock_object(self.driver, 'get_checkpoint_capabilities',
+                         return_value=caps)
+        self.assertRaises(exception.CheckpointConflict, self.execute,
+                          operation)
+        self.assertEqual(0, self.driver.native_call_count)
+
+    def test_native_failure_never_calls_copy_fallback(self):
+        created = self.available_checkpoint()
+        self.payload.update(kind='revert', request_id=created.checkpoint_id)
+        operation = self.api.reserve(self.ctxt, self.payload)
+        self.assertRaises(exception.CheckpointConflict, self.execute,
+                          operation)
+        self.assertEqual(2, self.driver.native_call_count)
+        self.detach_for_worker_test()
+        self.driver.outcomes['revert'].append(RuntimeError('lost reply'))
+        self.execute(operation)
+        self.assertEqual('recovery_required', self.read(operation).status)
+        self.owner._revert_to_snapshot_generic.assert_not_called()
+        self.assertRaises(exception.CheckpointConflict, self.api.action,
+                          self.ctxt, operation.id, 'release', 1, 'abort')
+
+    def test_missing_snapshot_is_not_proof_of_backend_absence(self):
+        operation = self.api.reserve(self.ctxt, self.payload)
+        step = operation.steps[0]
+        self.driver.outcomes['snapshot'].append(RuntimeError('lost'))
+        self.manager.execute(self.ctxt, step.id, 1)
+        resource = next(r for r in operation.resources
+                        if r.id == step.resource_id)
+        with sqla_api.main_context_manager.writer.using(self.ctxt):
+            self.ctxt.session.query(models.Snapshot).filter_by(
+                id=resource.snapshot_id).update({'deleted': True})
+        self.assertRaises(exception.CheckpointConflict, self.manager.reconcile,
+                          self.ctxt, step.id, 1)
+        self.assertEqual('recovery_required', self.read(operation).status)
+        self.assertEqual(1, self.driver.native_call_count)
+
+
+class TestCheckpointRPCGate(ManagerHelpers, test.TestCase):
+    def setUp(self):
+        super().setUp()
+        self.prepare_manager()
+        self.real_rpc = rpcapi.VolumeAPI()
+        self.volume = objects.Volume.get_by_id(self.ctxt, self.volumes[0])
+        self.service = db.service_create(self.ctxt.elevated(), {
+            'host': self.owner.host, 'binary': 'cinder-volume',
+            'topic': 'cinder-volume', 'disabled': False,
+            'rpc_current_version': '3.21', 'object_current_version': '1.40',
+            'updated_at': timeutils.utcnow()})
+        self.mock_object(self.real_rpc.client, 'can_send_version',
+                         return_value=True)
+
+    def test_rpc_320_rejected_before_reserve(self):
+        db.service_update(self.ctxt.elevated(), self.service.id,
+                          {'rpc_current_version': '3.20'})
+        self.api.rpc = self.real_rpc
+        self.assertRaises(exception.CheckpointNotSupported, self.api.reserve,
+                          self.ctxt, self.payload)
+        self.assertEqual([], self.locks())
+        self.assertEqual(0, self.driver.native_call_count)
+
+    def test_old_object_cap_and_unconfirmed_target_rejected(self):
+        db.service_update(self.ctxt.elevated(), self.service.id,
+                          {'object_current_version': '1.39'})
+        self.assertRaises(exception.CheckpointNotSupported,
+                          self.real_rpc.assert_checkpoint_ready,
+                          self.ctxt, self.volume)
+        self.volume.host = 'absent@backend'
+        self.assertRaises(exception.ServiceUnavailable,
+                          self.real_rpc.assert_checkpoint_ready,
+                          self.ctxt, self.volume)
+
+    def test_current_target_and_versions_are_accepted(self):
+        self.real_rpc.assert_checkpoint_ready(self.ctxt, self.volume)
+
+    def test_capability_transport_failure_is_unavailable(self):
+        client = self.mock_object(self.real_rpc, '_get_cctxt')
+        client.return_value.call.side_effect = (
+            oslo_messaging.MessagingTimeout())
+        error = self.assertRaises(
+            exception.ServiceUnavailable,
+            self.real_rpc.get_checkpoint_capabilities,
+            self.ctxt, self.volume.id, self.owner.host)
+        self.assertEqual(503, error.code)
+
+    def test_new_rpcs_pin_321(self):
+        client = self.mock_object(self.real_rpc, '_get_cctxt')
+        for method, kind, kwargs in (
+                ('get_checkpoint_capabilities', 'call',
+                 {'volume_id': self.volume.id}),
+                ('execute_checkpoint_step', 'cast',
+                 {'step_id': self.volume.id, 'generation': 1}),
+                ('reconcile_checkpoint_step', 'cast',
+                 {'step_id': self.volume.id, 'generation': 1})):
+            getattr(self.real_rpc, method)(
+                self.ctxt, host=self.owner.host, **kwargs)
+            client.assert_called_with(self.owner.host, version='3.21')
+            getattr(client.return_value, kind).assert_called_with(
+                self.ctxt, method, **kwargs)
