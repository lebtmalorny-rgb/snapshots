+    def assert_checkpoint_ready(self, ctxt, volume):
+        services = objects.ServiceList.get_all_by_binary(
+            ctxt.elevated(), self.BINARY)
+        target = volume_utils.extract_host(volume.service_topic_queue or '')
+        matching = [service for service in services if
+                    volume_utils.extract_host(service.cluster_name or
+                                              service.host or '') == target]
+        if not matching or not any(
+                s.is_up and not s.disabled for s in matching):
+            raise exception.CheckpointBackendUnavailable()
+        if not self.client.can_send_version('3.21'):
+            raise exception.CheckpointNotSupported(
+                reason='rpc_upgrade_required')
+        # Read actual service advertisements, not fallback-to-local or cached
+        # RPC defaults. Every participating volume service must be upgraded.
+        for service in services:
+            try:
+                ready = (versionutils.is_compatible(
+                    '3.21', service.rpc_current_version or '', same_major=True)
+                    and versionutils.is_compatible(
+                        '1.40', service.object_current_version or '',
+                        same_major=True))
+            except (ValueError, TypeError):
+                ready = False
+            if not ready:
+                raise exception.CheckpointNotSupported(
+                    reason='service_upgrade_required')
+        if not versionutils.is_compatible(
+                '1.40', self.determine_obj_version_cap(), same_major=True):
+            raise exception.CheckpointNotSupported(reason='object_cap_too_old')
+
+    @rpc.assert_min_rpc_version('3.21')
