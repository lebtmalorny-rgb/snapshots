+"""Native checkpoint dispatch. Claims precede I/O and never expire."""
+
+import json
+
+from cinder.checkpoints import contracts
+from cinder.checkpoints import guards
+from cinder import db
+from cinder import exception
+from cinder import objects
+from cinder.policies import checkpoints as policy
+from cinder.volume import volume_utils
+
+
+class CheckpointManager:
+    def __init__(self, volume_manager):
+        self.owner = volume_manager
+
+    def _volume(self, context, volume_id):
+        volume = objects.Volume.get_by_id(context, volume_id)
+        if volume.project_id != context.project_id:
+            raise exception.VolumeNotFound(volume_id=volume_id)
+        if (volume_utils.extract_host(volume.host or '') !=
+                volume_utils.extract_host(self.owner.host)):
+            raise exception.CheckpointConflict(reason='wrong_backend_worker')
+        if not self.owner.driver.initialized:
+            raise exception.CheckpointBackendUnavailable()
+        return volume
+
+    def capabilities(self, context, volume_id):
+        guards.require_service(context)
+        context.authorize(policy.READ_POLICY)
+        volume = self._volume(context, volume_id)
+        try:
+            return contracts.validate_capabilities(
+                self.owner.driver.get_checkpoint_capabilities(context, volume))
+        except Exception:
+            return contracts.unsupported_capabilities(
+                'unverified_capabilities')
+
+    def _load(self, context, step_id, generation):
+        guards.require_service(context)
+        context.authorize(policy.OPERATE_POLICY)
+        step = objects.CheckpointStep.get_by_id(context, step_id)
+        operation = objects.CheckpointOperation.get_by_id(
+            context, step.operation_id)
+        if (type(generation) is not int or generation != operation.generation
+                or generation != step.generation):
+            raise exception.CheckpointConflict(reason='stale_generation')
+        return step, operation
+
+    def _preflight(self, context, step, operation):
+        resource = next(r for r in operation.resources
+                        if r.id == step.resource_id)
+        volume = self._volume(context, resource.volume_id)
+        current = contracts.validate_capabilities(
+            self.capabilities(context, volume.id))
+        saved = json.loads(resource.capabilities_json)
+        if current['driver_identity'] != saved['driver_identity']:
+            raise exception.CheckpointConflict(reason='driver_profile_changed')
+        try:
+            snapshot = objects.Snapshot.get_by_id(
+                context, resource.snapshot_id)
+        except exception.SnapshotNotFound:
+            raise exception.CheckpointConflict(
+                reason='snapshot_record_missing')
+        if (snapshot.volume_id != volume.id or
+                snapshot.project_id != operation.project_id or
+                snapshot.volume_size != resource.volume_size or
+                volume.size != resource.volume_size):
+            raise exception.CheckpointConflict(reason='snapshot_mismatch')
+        if step.phase == 'revert' and snapshot.status != 'available':
+            raise exception.CheckpointConflict(reason='snapshot_not_available')
+        return volume, snapshot
+
+    def execute(self, context, step_id, generation):
+        step, operation = self._load(context, step_id, generation)
+        if operation.status == 'released' or step.status != 'prepared':
+            return
+        volume, snapshot = self._preflight(context, step, operation)
+        if not db.checkpoint_step_claim(context, step_id, generation,
+                                        self.owner.host):
+            return
+        methods = {
+            'snapshot': self.owner.driver.checkpoint_create_snapshot,
+            'revert': self.owner.driver.checkpoint_revert_to_snapshot,
+            'delete_snapshot': self.owner.driver.checkpoint_delete_snapshot,
+        }
+        try:
+            result = methods[step.phase](context, volume, snapshot, step_id)
+        except Exception:
+            # A transport or driver exception does not prove no effect.
+            # Do not copy backend messages, which may contain credentials.
+            result = {'status': 'unknown', 'error_code': 'driver_exception'}
+        db.checkpoint_step_finish(context, step_id, generation, result)
+
+    def reconcile(self, context, step_id, generation):
+        step, operation = self._load(context, step_id, generation)
+        if (operation.status == 'released' or step.status not in
+                ('dispatching', 'pending', 'unknown')):
+            return
+        volume, snapshot = self._preflight(context, step, operation)
+        try:
+            result = self.owner.driver.checkpoint_query_operation(
+                context, volume, snapshot, step_id, step.phase)
+        except Exception:
+            result = {'status': 'unknown', 'error_code': 'query_exception'}
+        db.checkpoint_step_finish(context, step_id, generation, result)
diff --git a/cinder/db/sqlalchemy/checkpoints.py b/cinder/db/sqlalchemy/checkpoints.py
index 6bfc77d..523d633 100644
--- a/cinder/db/sqlalchemy/checkpoints.py
+++ b/cinder/db/sqlalchemy/checkpoints.py
@@ -362,12 +362,33 @@ def step_claim(context, step_id, generation, executor_id):
         return False
     if not isinstance(executor_id, str) or not 0 < len(executor_id) <= 255:
         raise exception.InvalidInput(reason='invalid_executor_id')
+    _dispatch_state(context, operation, step)
     step.status = 'dispatching'
     step.executor_id = executor_id
     operation.status = 'running'
     return True
 
 
+def _dispatch_state(context, operation, step):
+    # Recheck the entire volume set while holding the admission row locks.
+    # Never start a partial revert while another disk is still attached.
+    for resource in _resources(context, operation.checkpoint_id):
+        volume = _query(context, models.Volume).filter_by(
+            id=resource.volume_id).one()
+        attachments = _attachments(context, volume.id)
+        if operation.kind == 'revert':
+            if volume.status != 'available' or attachments:
+                _conflict('revert_requires_disconnected_volumes')
+        elif (volume.status not in ('available', 'in-use') or
+              len(attachments) > 1 or any(
+                  a.instance_uuid != operation.instance_uuid or
+                  a.attach_status != 'attached' for a in attachments)):
+            _conflict('attachment_conflict')
+        elif operation.kind == 'create' and step.phase == 'snapshot':
+            if len(attachments) != 1 or volume.status != 'in-use':
+                _conflict('attachment_conflict')
+
+
 def _update_operation(context, operation):
     statuses = {s.status for s in _steps(context, operation.id)}
     if statuses & {'unknown', 'dispatching', 'pending'}:
