diff --git a/cinder/checkpoints/guards.py b/cinder/checkpoints/guards.py
index 28696f0..099334b 100644
--- a/cinder/checkpoints/guards.py
+++ b/cinder/checkpoints/guards.py
@@ -13,6 +13,7 @@
 """Checks at API/worker boundaries; atomic admission lives in the DB layer."""
 
 import contextlib
+import contextvars
 import inspect
 import uuid
 
@@ -23,6 +24,33 @@ from cinder import db
 from cinder import exception
 
 
+_CONNECTIONS = contextvars.ContextVar(
+    'checkpoint_legacy_barriers', default=frozenset())
+_MAINTENANCE_RESETS = contextvars.ContextVar(
+    'checkpoint_maintenance_resets', default=frozenset())
+
+
+def owns_barrier(volume_id):
+    return volume_id in _CONNECTIONS.get()
+
+
+def resetting_maintenance(volume_id):
+    return volume_id in _MAINTENANCE_RESETS.get()
+
+
+@contextlib.contextmanager
+def maintenance_reset(volume_id):
+    """Only the authorized admin reset controller may recover maintenance.
+
+    This does not bypass a checkpoint lock or resource reference.
+    """
+    token = _MAINTENANCE_RESETS.set(_MAINTENANCE_RESETS.get() | {volume_id})
+    try:
+        yield
+    finally:
+        _MAINTENANCE_RESETS.reset(token)
+
+
 def _id(resource):
     return resource if isinstance(resource, str) else resource['id']
 
@@ -44,7 +72,7 @@ def validate_operation_scope(context, operation_id, generation, volume_id,
 
 
 @contextlib.contextmanager
-def connection(context, volume, action):
+def connection(context, volume, action, claim=False):
     """Persist a barrier for legacy calls lacking their own pending status.
 
     The SQL transaction ends before backend I/O. Failure leaves maintenance
@@ -52,17 +80,26 @@ def connection(context, volume, action):
     unlock. Existing legacy recovery applies to these unprotected volumes.
     """
     volume_id = _id(volume)
-    previous = db.checkpoint_connection_begin(context, volume_id, action)
-    yield
-    db.checkpoint_connection_end(context, volume_id, previous)
+    owned = _CONNECTIONS.get()
+    if volume_id in owned:
+        yield
+        return
+    previous = db.checkpoint_connection_begin(context, volume_id, action,
+                                              claim)
+    token = _CONNECTIONS.set(owned | {volume_id})
+    try:
+        yield
+        db.checkpoint_connection_end(context, volume_id, previous)
+    finally:
+        _CONNECTIONS.reset(token)
 
 
-def connection_worker(action, volume_arg, context_arg='context'):
+def connection_worker(action, volume_arg, context_arg='context', claim=False):
     """Cover backend I/O and preserve the signature used by coordination."""
     @decorator.decorator
     def guarded(function, *args, **kwargs):
         bound = inspect.getcallargs(function, *args, **kwargs)
-        with connection(bound[context_arg], bound[volume_arg], action):
+        with connection(bound[context_arg], bound[volume_arg], action, claim):
             return function(*args, **kwargs)
     return guarded
 
