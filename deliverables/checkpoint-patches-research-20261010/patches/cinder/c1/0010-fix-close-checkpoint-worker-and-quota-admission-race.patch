+    def test_reserve_races_retype_worker_claim(self):
+        gate = eventlet.event.Event()
+        outcomes = []
+
+        def mutate(kind):
+            ctxt = test_db.service_context()
+            gate.wait()
+            try:
+                if kind == 'checkpoint':
+                    self.reserve(ctxt=ctxt)
+                else:
+                    db.checkpoint_connection_begin(
+                        ctxt, self.volumes[0], 'retype', True)
+                outcomes.append(kind)
+            except exception.CheckpointConflict:
+                outcomes.append(None)
+
+        pool = eventlet.GreenPool(size=2)
+        for kind in ('checkpoint', 'retype'):
+            pool.spawn_n(mutate, kind)
+        gate.send()
+        pool.waitall()
+        self.assertEqual(2, len(outcomes))
+        self.assertEqual(1, sum(value is not None for value in outcomes))
