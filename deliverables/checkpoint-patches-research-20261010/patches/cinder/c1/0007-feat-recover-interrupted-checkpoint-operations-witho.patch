@@ -117,3 +124,21 @@ class CheckpointManager:
         except Exception:
             result = {'status': 'unknown', 'error_code': 'query_exception'}
         db.checkpoint_step_finish(context, step_id, generation, result)
+
+    def recover_pending(self, context):
+        if not self.owner.driver.initialized:
+            return
+        for row in db.checkpoint_pending(context, self.owner.host):
+            # Internal read-only recovery reconstructs the journal owner; it
+            # never renews ownership, dispatches an effect or removes a lock.
+            owner = cinder_context.RequestContext(
+                project_id=row['project_id'], user_id=row['user_id'],
+                service_user_id=row['service_user_id'], roles=['member'],
+                service_roles=(
+                    config.CONF.keystone_authtoken.service_token_roles))
+            try:
+                self.reconcile(owner, row['step_id'], row['generation'])
+            except Exception:
+                # The journal remains authoritative. Never log driver text.
+                LOG.warning('Checkpoint reconciliation deferred for step %s',
+                            row['step_id'])
