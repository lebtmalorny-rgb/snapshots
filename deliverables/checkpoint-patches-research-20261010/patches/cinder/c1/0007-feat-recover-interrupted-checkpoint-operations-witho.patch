+import datetime
+from unittest import mock
+
+from oslo_utils import timeutils
+from oslo_utils import uuidutils
+
+from cinder.checkpoints import manager
+from cinder import context
+from cinder import db
+from cinder.db.sqlalchemy import api as sqla_api
+from cinder.db.sqlalchemy import models
+from cinder import exception
+from cinder import objects
+from cinder.tests.unit.checkpoints import test_manager
+from cinder.tests.unit import test
+from cinder.volume import manager as volume_manager
+
+
+class TestRecovery(test_manager.ManagerHelpers, test.TestCase):
+    def setUp(self):
+        super().setUp()
+        self.prepare_manager()
+        self.rpc.execute_checkpoint_step.side_effect = (
+            lambda ctxt, step, gen, host: self.manager.execute(
+                ctxt, step, gen))
+        self.rpc.reconcile_checkpoint_step.side_effect = (
+            lambda ctxt, step, gen, host: self.manager.reconcile(
+                ctxt, step, gen))
+
+    def test_restart_after_native_effect_only_queries(self):
+        operation = self.api.reserve(self.ctxt, self.payload)
+        self.driver.outcomes['snapshot'].append(RuntimeError('secret'))
+        self.execute(operation)
+        restarted = manager.CheckpointManager(self.owner)
+        restarted.recover_pending(context.get_admin_context())
+        self.assertEqual(2, self.driver.native_call_count)
+        self.assertEqual(1, len(self.driver.query_calls))
+        self.assertEqual('succeeded', self.read(operation).status)
+        self.assertEqual(sorted(self.volumes), sorted(self.locks()))
+
+    def test_disable_retains_guards_and_recovery(self):
+        operation = self.api.reserve(self.ctxt, self.payload)
+        self.driver.outcomes['snapshot'].append({'status': 'pending'})
+        self.execute(operation)
+        self.flags(enabled=False, group='checkpoint')
+        self.manager.recover_pending(context.get_admin_context())
+        self.assertEqual('succeeded', self.read(operation).status)
+        self.assertRaises(exception.CheckpointConflict, db.volume_update,
+                          self.ctxt, self.volumes[0], {'status': 'available'})
+        self.assertEqual(sorted(self.volumes), sorted(self.locks()))
+
+    def test_claim_without_effect_never_dispatches_during_recovery(self):
+        operation = self.api.reserve(self.ctxt, self.payload)
+        db.checkpoint_step_claim(self.ctxt, operation.steps[0].id, 1,
+                                 self.owner.host)
+        self.manager.recover_pending(context.get_admin_context())
+        self.assertEqual(0, self.driver.native_call_count)
+        self.assertEqual('recovery_required', self.read(operation).status)
+        self.assertEqual(sorted(self.volumes), sorted(self.locks()))
+
+    def test_cleanup_is_repeatable_and_releases_quota_once(self):
+        operation = self.api.reserve(self.ctxt, self.payload)
+        self.driver.outcomes['snapshot'].extend([
+            {'status': 'succeeded'}, {'status': 'failed_no_effect'}])
+        self.execute(operation)
+        self.api.action(self.ctxt, operation.id, 'cleanup', 1)
+        self.api.action(self.ctxt, operation.id, 'cleanup', 1)
+        self.assertEqual(3, self.driver.native_call_count)
+        self.assertEqual({}, self.driver.snapshots)
+        self.assertEqual(0, self.usage()['snapshots']['in_use'])
+        self.api.action(self.ctxt, operation.id, 'release', 1, 'abort')
+        self.api.action(self.ctxt, operation.id, 'release', 1, 'abort')
+        self.assertEqual(0, self.usage()['snapshots']['in_use'])
+        self.assertEqual([], self.locks())
+        self.assertEqual(operation.id,
+                         self.api.reserve(self.ctxt, self.payload).id)
+
+    def test_cleanup_unknown_result_queries_without_second_delete(self):
+        operation = self.api.reserve(self.ctxt, self.payload)
+        self.execute(operation)
+        self.driver.outcomes['delete_snapshot'].append(RuntimeError('lost'))
+        self.api.action(self.ctxt, operation.id, 'cleanup', 1)
+        self.api.action(self.ctxt, operation.id, 'cleanup', 1)
+        self.assertEqual(4, self.driver.native_call_count)
+        self.assertRaises(exception.CheckpointConflict, self.api.action,
+                          self.ctxt, operation.id, 'release', 1, 'abort')
+        self.manager.recover_pending(context.get_admin_context())
+        self.api.action(self.ctxt, operation.id, 'release', 1, 'abort')
+        self.assertEqual(4, self.driver.native_call_count)
+        self.assertEqual(0, self.usage()['snapshots']['in_use'])
+
+    def test_unknown_create_forbids_cleanup(self):
+        operation = self.api.reserve(self.ctxt, self.payload)
+        self.driver.outcomes['snapshot'].append(RuntimeError('lost'))
+        self.execute(operation)
+        self.assertRaises(exception.CheckpointConflict, self.api.action,
+                          self.ctxt, operation.id, 'cleanup', 1)
+        self.assertEqual(2, self.driver.native_call_count)
+        self.assertEqual(2, self.usage()['snapshots']['in_use'])
+
+    def test_abort_before_effect_releases_snapshot_and_gb_quota(self):
+        operation = self.api.reserve(self.ctxt, self.payload)
+        charged_gb = self.usage()['gigabytes']['in_use']
+        self.flags(no_snapshot_gb_quota=True)
+        self.api.action(self.ctxt, operation.id, 'release', 1, 'abort')
+        self.assertEqual(0, self.usage()['snapshots']['in_use'])
+        self.assertEqual(charged_gb - 2, self.usage()['gigabytes']['in_use'])
+        self.assertEqual(0, self.driver.native_call_count)
+
+    def test_cleanup_cancels_prepared_steps(self):
+        operation = self.api.reserve(self.ctxt, self.payload)
+        self.manager.execute(self.ctxt, operation.steps[0].id, 1)
+        self.api.action(self.ctxt, operation.id, 'cleanup', 1)
+        self.execute(operation)
+        self.assertEqual(2, self.driver.native_call_count)
+        self.api.action(self.ctxt, operation.id, 'release', 1, 'abort')
+        self.assertEqual(0, self.usage()['snapshots']['in_use'])
+
+    def test_delete_releases_only_its_checkpoint_quota(self):
+        first = self.available_checkpoint()
+        self.payload.update(request_id=uuidutils.generate_uuid(),
+                            checkpoint_id=uuidutils.generate_uuid())
+        second = self.available_checkpoint()
+        self.payload.update(kind='delete',
+                            request_id=uuidutils.generate_uuid(),
+                            checkpoint_id=first.checkpoint_id)
+        deletion = self.api.reserve(self.ctxt, self.payload)
+        self.execute(deletion)
+        self.api.action(self.ctxt, deletion.id, 'release', 1, 'commit')
+        self.assertEqual(2, self.usage()['snapshots']['in_use'])
+        self.assertEqual({r.snapshot_id for r in second.resources},
+                         set(self.driver.snapshots))
+        self.api.action(self.ctxt, deletion.id, 'execute', 1)
+        self.assertEqual(6, self.driver.native_call_count)
+
+    def test_quota_failure_rolls_back_and_recovers_by_query(self):
+        self.available_checkpoint()
+        self.payload.update(kind='delete',
+                            request_id=uuidutils.generate_uuid())
+        operation = self.api.reserve(self.ctxt, self.payload)
+        original_commit = sqla_api.reservation_commit
+
+        def commit_then_fail(*args, **kwargs):
+            original_commit(*args, **kwargs)
+            raise RuntimeError('simulated DB failure before journal commit')
+
+        with mock.patch.object(sqla_api, 'reservation_commit',
+                               side_effect=commit_then_fail):
+            self.assertRaises(RuntimeError, self.manager.execute,
+                              self.ctxt, operation.steps[0].id, 1)
+        self.assertEqual(2, self.usage()['snapshots']['in_use'])
+        self.assertEqual('dispatching', next(
+            s for s in self.read(operation).steps
+            if s.id == operation.steps[0].id).status)
+        self.manager.recover_pending(context.get_admin_context())
+        self.assertEqual(1, self.usage()['snapshots']['in_use'])
+        self.assertEqual(3, self.driver.native_call_count)
+        self.manager.recover_pending(context.get_admin_context())
+        self.assertEqual(1, self.usage()['snapshots']['in_use'])
+
+    def test_released_tombstone_survives_ordinary_purge(self):
+        operation = self.api.reserve(self.ctxt, self.payload)
+        self.api.action(self.ctxt, operation.id, 'release', 1, 'abort')
+        old = timeutils.utcnow() - datetime.timedelta(days=30)
+        with sqla_api.main_context_manager.writer.using(self.ctxt):
+            self.ctxt.session.query(models.Snapshot).filter_by(
+                deleted=True).update({'deleted_at': old})
+        db.purge_deleted_rows(self.ctxt.elevated(), 1)
+        self.assertEqual(operation.id,
+                         self.api.reserve(self.ctxt, self.payload).id)
+        self.assertEqual(0, self.usage()['snapshots']['in_use'])
+        self.assertEqual(0, self.driver.native_call_count)
+
+    def test_partial_revert_cannot_release(self):
+        self.available_checkpoint()
+        self.payload.update(kind='revert',
+                            request_id=uuidutils.generate_uuid())
+        operation = self.api.reserve(self.ctxt, self.payload)
+        self.detach_for_worker_test()
+        self.driver.outcomes['revert'].append(RuntimeError('lost'))
+        self.execute(operation)
+        self.assertRaises(exception.CheckpointConflict, self.api.action,
+                          self.ctxt, operation.id, 'release', 1, 'abort')
+        self.assertRaises(exception.CheckpointConflict, self.api.action,
+                          self.ctxt, operation.id, 'cleanup', 1)
+        self.assertEqual(sorted(self.volumes), sorted(self.locks()))
+
+    def test_expired_wait_does_not_unlock_and_purge_retains_journal(self):
+        operation = self.api.reserve(self.ctxt, self.payload)
+        self.driver.outcomes['snapshot'].append({'status': 'pending'})
+        self.execute(operation)
+        pending = next(s for s in self.read(operation).steps
+                       if s.status == 'pending')
+        self.driver.query_results[pending.id] = {'status': 'unknown'}
+        yesterday = timeutils.utcnow() - datetime.timedelta(days=30)
+        with sqla_api.main_context_manager.writer.using(self.ctxt):
+            for model in (models.CheckpointOperation, models.CheckpointStep):
+                self.ctxt.session.query(model).update(
+                    {'created_at': yesterday, 'updated_at': yesterday})
+        db.purge_deleted_rows(self.ctxt.elevated(), 1)
+        self.manager.recover_pending(context.get_admin_context())
+        self.assertEqual(sorted(self.volumes), sorted(self.locks()))
+        self.assertEqual('recovery_required', self.read(operation).status)
+
+    def test_legacy_cleanup_does_not_change_checkpoint_snapshot(self):
+        operation = self.api.reserve(self.ctxt, self.payload)
+        snapshot = objects.Snapshot.get_by_id(
+            self.ctxt, operation.resources[0].snapshot_id)
+        vm = volume_manager.VolumeManager(host=self.owner.host)
+        vm.driver = self.driver
+        vm._do_cleanup(self.ctxt.elevated(), snapshot)
+        self.assertEqual('creating', objects.Snapshot.get_by_id(
+            self.ctxt, snapshot.id).status)
+        self.assertEqual(0, self.driver.native_call_count)
