@@ -486,6 +504,104 @@ def release(context, operation_id, generation, outcome):
     return _as_dict(context, operation)
 
 
+def _release_quota(context, resource):
+    create_operation = _query(context, models.CheckpointOperation).filter_by(
+        create_checkpoint_id=resource.checkpoint_id).one()
+    source = _current(_query(context, models.CheckpointStep).filter_by(
+        operation_id=create_operation.id, resource_id=resource.id,
+        phase='snapshot')).one()
+    journal = json.loads(source.quota_reservations_json)
+    if not isinstance(journal, dict) or journal.get('released'):
+        return
+    deltas = journal.get('deltas', {})
+    if deltas:
+        usages = api._get_quota_usages(
+            context, resource.project_id, resources=deltas)
+        if set(usages) != set(deltas):
+            _conflict('quota_usage_missing')
+        # Negative reservations need no quota-limit admission. Create and
+        # commit stock reservation rows in this writer transaction, so an
+        # effect result, quota release and resource tombstone commit together.
+        ids = []
+        for name, delta in deltas.items():
+            row = api._reservation_create(
+                context, uuidutils.generate_uuid(), usages[name],
+                resource.project_id, name, -delta,
+                timeutils.utcnow() + datetime.timedelta(hours=1))
+            ids.append(row.uuid)
+        api.reservation_commit(context, ids, project_id=resource.project_id)
+        journal['release_reservations'] = ids
+    journal['released'] = True
+    source.quota_reservations_json = json.dumps(journal, sort_keys=True)
+    snapshot = _query(context, models.Snapshot).filter_by(
+        id=resource.snapshot_id).first()
+    if snapshot:
+        snapshot.use_quota = False
+
+
+@api.require_context
+@api.main_context_manager.writer
+def cleanup(context, operation_id, generation):
+    operation, instance, volumes = _locked_operation(
+        context, operation_id, generation)
+    if operation.status == 'released':
+        return _as_dict(context, operation)
+    if operation.kind != 'create':
+        _conflict('cleanup_only_for_create')
+    steps = _steps(context, operation_id)
+    originals = [s for s in steps if s.phase == 'snapshot']
+    if any(s.status in ('dispatching', 'pending', 'unknown')
+           for s in originals):
+        _conflict('create_outcome_unknown')
+    resources = {r.id: r for r in _resources(
+        context, operation.checkpoint_id, lock=True)}
+    for step in originals:
+        resource = resources[step.resource_id]
+        if step.status in ('prepared', 'failed_no_effect'):
+            step.status = 'failed_no_effect'
+            step.error_code = step.error_code or 'cancelled_before_dispatch'
+            _release_quota(context, resource)
+            resource.status = 'deleted'
+            snapshot = _query(context, models.Snapshot).filter_by(
+                id=resource.snapshot_id).first()
+            if snapshot:
+                snapshot.status = 'deleted'
+                snapshot.deleted = True
+                snapshot.deleted_at = timeutils.utcnow()
+        elif not any(s.resource_id == resource.id and
+                     s.phase == 'delete_snapshot' for s in steps):
+            context.session.add(models.CheckpointStep(
+                id=uuidutils.generate_uuid(), operation_id=operation_id,
+                resource_id=resource.id, phase='delete_snapshot',
+                generation=generation, status='prepared',
+                quota_reservations_json='[]',
+                original_attachment_ids_json=(
+                    step.original_attachment_ids_json)))
+    context.session.flush()
+    _update_operation(context, operation)
+    return _as_dict(context, operation)
+
+
+@api.require_admin_context
+@api.main_context_manager.reader
+def pending(context, host):
+    step = models.CheckpointStep
+    operation = models.CheckpointOperation
+    resource = models.CheckpointResource
+    volume = models.Volume
+    query = context.session.query(step, operation).join(
+        operation, operation.id == step.operation_id).join(
+            resource, resource.id == step.resource_id).join(
+                volume, volume.id == resource.volume_id)
+    query = query.filter(
+        operation.status != 'released',
+        step.status.in_(('dispatching', 'pending', 'unknown')),
+        api._filter_host(volume.host, host))
+    return [dict(step_id=step.id, generation=step.generation,
+                 **{key: getattr(operation, key) for key in IDENTITY})
+            for step, operation in query.all()]
+
+
 def _scope(context, operation_id, generation, volume_id, action,
            attachment_id=None, instance_uuid=None):
     from cinder.checkpoints import guards
