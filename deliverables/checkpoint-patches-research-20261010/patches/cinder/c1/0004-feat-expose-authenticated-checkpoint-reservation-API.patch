+class TestCheckpointPolicy(test.TestCase):
+    def test_project_members_and_admins_only(self):
+        for role in ('admin', 'member', 'reader', 'service'):
+            for rule in checkpoints.list_rules():
+                ctxt = context.RequestContext(fake.USER_ID, fake.PROJECT_ID,
+                                              roles=[role], is_admin=False)
+                if role in ('admin', 'member'):
+                    self.assertTrue(ctxt.authorize(rule.name))
+                else:
+                    self.assertRaises(exception.PolicyNotAuthorized,
+                                      ctxt.authorize, rule.name)
+                self.assertRaises(exception.PolicyNotAuthorized,
+                                  ctxt.authorize, rule.name,
+                                  target={'project_id': fake.PROJECT2_ID})
