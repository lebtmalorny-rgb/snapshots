+
+"""Project policy complements mandatory verified Nova service identity."""
+
+from oslo_policy import policy
+
+
+READ_POLICY = 'checkpoint:read'
+OPERATE_POLICY = 'checkpoint:operate'
+_MEMBER = '(role:member or role:admin) and project_id:%(project_id)s'
+
+checkpoint_policies = [
+    policy.DocumentedRuleDefault(
+        name=READ_POLICY, check_str=_MEMBER,
+        description='Read native checkpoint operations and capabilities.',
+        operations=[
+            {'method': 'GET', 'path': '/checkpoint-operations'},
+            {'method': 'GET', 'path': '/checkpoint-operations/{id}'},
+            {'method': 'GET',
+             'path': '/volumes/{id}/checkpoint-capabilities'}]),
+    policy.DocumentedRuleDefault(
+        name=OPERATE_POLICY, check_str=_MEMBER,
+        description='Reserve and operate native volume checkpoints.',
+        operations=[
+            {'method': 'POST', 'path': '/checkpoint-operations'},
+            {'method': 'POST', 'path': '/checkpoint-operations/{id}/action'}]),
+]
+
+
+def list_rules():
+    return checkpoint_policies
