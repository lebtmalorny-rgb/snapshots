+from cinder.tests.unit.api import fakes
+from cinder.tests.unit.checkpoints import test_api
+from cinder.tests.unit import test
+
+
+class TestCheckpoints(test_api.APIHelpers, test.TestCase):
+    def setUp(self):
+        super().setUp()
+        self.prepare_api()
+        self.mock_object(api, 'API', return_value=self.api)
+        self.application = fakes.urlmap.URLMap()
+        self.application['/v3'] = router.APIRouter()
+        self.application = fault.FaultWrapper(self.application)
+
+    def request(self, body=None, path='checkpoint-operations', method='POST',
+                version='3.72', ctxt=None):
+        request = webob.Request.blank(
+            '/v3/%s/%s' % ((ctxt or self.ctxt).project_id, path))
+        request.method = method
+        request.headers['Content-Type'] = 'application/json'
+        request.headers['OpenStack-API-Version'] = 'volume ' + version
+        request.environ['cinder.context'] = ctxt or self.ctxt
+        if body is not None:
+            request.body = jsonutils.dump_as_bytes(body)
+        return request.get_response(self.application)
+
+    def test_service_reserve_get_and_list_hide_backend_details(self):
+        response = self.request({'checkpoint_operation': self.payload})
+        self.assertEqual(202, response.status_int, response.text)
+        operation = response.json['checkpoint_operation']
+        self.assertEqual(1, operation['generation'])
+        self.assertEqual(2, len(operation['resources']))
+        for text in ('service_user_id', 'payload_hash', 'backend_reference',
+                     'capabilities_json', 'quota_reservations', 'provider'):
+            self.assertNotIn(text, response.text)
+        response = self.request(
+            path='checkpoint-operations/' + operation['id'], method='GET')
+        self.assertEqual(200, response.status_int, response.text)
+        response = self.request(path='checkpoint-operations', method='GET')
+        self.assertEqual(200, response.status_int, response.text)
+        self.assertEqual(operation['id'],
+                         response.json['checkpoint_operations'][0]['id'])
+
+    def test_tenant_service_role_is_not_service_token(self):
+        ctxt = self.ctxt.deepcopy()
+        ctxt.roles = ['admin', 'member', 'service']
+        ctxt.is_admin = True
+        ctxt.service_roles = None
+        ctxt.service_user_id = None
+        response = self.request({'checkpoint_operation': self.payload},
+                                ctxt=ctxt)
+        self.assertEqual(403, response.status_int, response.text)
+        self.assertEqual([], self.locks())
+
+    def test_unknown_fields_duplicate_and_invalid_volumes_rejected(self):
+        for key, value in (('snapshot_ids', []), ('volume_ids', []),
+                           ('volume_ids', self.volumes * 2),
+                           ('volume_ids', [uuidutils.generate_uuid()
+                                           for unused in range(65)]),
+                           ('volume_ids', ['not-a-uuid'])):
+            payload = copy.deepcopy(self.payload)
+            payload[key] = value
+            response = self.request({'checkpoint_operation': payload})
+            self.assertEqual(400, response.status_int, response.text)
+        self.rpc.get_checkpoint_capabilities.assert_not_called()
+        self.assertEqual([], self.locks())
+
+    def test_old_version_does_not_call_new_logic(self):
+        response = self.request({'checkpoint_operation': self.payload},
+                                version='3.71')
+        self.assertEqual(404, response.status_int, response.text)
+        self.assertEqual([], self.locks())
+        self.rpc.get_checkpoint_capabilities.assert_not_called()
+
+    def test_wrong_project_and_changed_request(self):
+        ctxt = self.ctxt.elevated()
+        ctxt.project_id = uuidutils.generate_uuid()
+        response = self.request({'checkpoint_operation': self.payload},
+                                ctxt=ctxt)
+        self.assertEqual(404, response.status_int, response.text)
+        self.assertEqual(202, self.request(
+            {'checkpoint_operation': self.payload}).status_int)
+        self.payload['volume_ids'] = self.volumes[:1]
+        response = self.request({'checkpoint_operation': self.payload})
+        self.assertEqual(409, response.status_int, response.text)
+
+    def test_capabilities_specific_volume_and_unknown_filters(self):
+        response = self.request(path='volumes/%s/checkpoint-capabilities' %
+                                self.volumes[0], method='GET')
+        self.assertEqual(200, response.status_int, response.text)
+        self.assertTrue(response.json['checkpoint_capabilities']['supported'])
+        response = self.request(path='checkpoint-operations?project_id=other',
+                                method='GET')
+        self.assertEqual(400, response.status_int, response.text)
+
+    def test_action_requires_exact_generation_and_one_action(self):
+        response = self.request({'checkpoint_operation': self.payload})
+        self.assertEqual(202, response.status_int, response.text)
+        opid = response.json['checkpoint_operation']['id']
+        for body in ({'execute': {'generation': True}},
+                     {'execute': {'generation': 0}},
+                     {'execute': {'generation': 1, 'force': True}},
+                     {'execute': {'generation': 1},
+                      'reconcile': {'generation': 1}}):
+            response = self.request(
+                body, path='checkpoint-operations/%s/action' % opid)
+            self.assertEqual(400, response.status_int, response.text)
+        response = self.request({'execute': {'generation': 2}},
+                                path='checkpoint-operations/%s/action' % opid)
+        self.assertEqual(409, response.status_int, response.text)
+        self.rpc.execute_checkpoint_step.assert_not_called()
+
+    def test_quota_failure_is_413_and_leaves_no_partial_reservation(self):
+        db.quota_create(self.ctxt.elevated(), self.ctxt.project_id,
+                        'snapshots', 1)
+        response = self.request({'checkpoint_operation': self.payload})
+        self.assertEqual(413, response.status_int, response.text)
+        self.assertEqual([], self.locks())
+        self.assertEqual(0, self.usage()['snapshots']['reserved'])
