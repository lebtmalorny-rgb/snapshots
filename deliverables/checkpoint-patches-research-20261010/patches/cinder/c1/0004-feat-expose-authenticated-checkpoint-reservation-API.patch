+# distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+# WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+# License for the specific language governing permissions and limitations
+# under the License.
+
+"""Strict service API schemas for the private checkpoint extension."""
+
+from cinder.api.validation import parameter_types
+
+
+payload = {
+    'type': 'object',
+    'properties': {
+        'request_id': parameter_types.uuid,
+        'checkpoint_id': parameter_types.uuid,
+        'instance_uuid': parameter_types.uuid,
+        'kind': {'type': 'string', 'enum': ['create', 'revert', 'delete']},
+        'volume_ids': {'type': 'array', 'items': parameter_types.uuid,
+                       'minItems': 1, 'maxItems': 64, 'uniqueItems': True},
+    },
+    'required': ['request_id', 'checkpoint_id', 'instance_uuid', 'kind',
+                 'volume_ids'],
+    'additionalProperties': False,
+}
+create = {
+    'type': 'object',
+    'properties': {'checkpoint_operation': payload},
+    'required': ['checkpoint_operation'],
+    'additionalProperties': False,
+}
+generation = {'type': 'integer', 'minimum': 1}
+action = {
+    'type': 'object',
+    'minProperties': 1,
+    'maxProperties': 1,
+    'properties': {
+        name: {'type': 'object',
+               'properties': {'generation': generation},
+               'required': ['generation'], 'additionalProperties': False}
+        for name in ('execute', 'cleanup', 'reconcile')
+    },
+    'additionalProperties': False,
+}
+action['properties']['release'] = {
+    'type': 'object',
+    'properties': {'generation': generation,
+                   'outcome': {'enum': ['commit', 'abort']}},
+    'required': ['generation', 'outcome'],
+    'additionalProperties': False,
+}
diff --git a/cinder/api/v3/checkpoints.py b/cinder/api/v3/checkpoints.py
