index 0000000..51d8936
--- /dev/null
+++ b/cinder/api/v3/checkpoints.py
@@ -0,0 +1,73 @@
+# Licensed under the Apache License, Version 2.0 (the "License"); you may
+# not use this file except in compliance with the License. You may obtain
+# a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+# WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+# License for the specific language governing permissions and limitations
+# under the License.
+
+"""Private 3.72 checkpoint service API."""
+
+from http import HTTPStatus
+
+from cinder.api import common
+from cinder.api import microversions as mv
+from cinder.api.openstack import wsgi
+from cinder.api.schemas import checkpoints as schema
+from cinder.api.v3.views import checkpoints as views
+from cinder.api import validation
+from cinder.checkpoints import api
+from cinder import exception
+
+
+class CheckpointController(wsgi.Controller):
+    def __init__(self):
+        self.api = api.API()
+        self.view = views.ViewBuilder()
+        super().__init__()
+
+    @wsgi.Controller.api_version(mv.CHECKPOINT_CONTRACT)
+    @wsgi.response(HTTPStatus.ACCEPTED)
+    @validation.schema(schema.create)
+    def create(self, req, body):
+        operation = self.api.reserve(req.environ['cinder.context'],
+                                     body['checkpoint_operation'])
+        return {'checkpoint_operation': self.view.detail(operation)}
+
+    @wsgi.Controller.api_version(mv.CHECKPOINT_CONTRACT)
+    def show(self, req, id):
+        operation = self.api.get(req.environ['cinder.context'], id)
+        return {'checkpoint_operation': self.view.detail(operation)}
+
+    @wsgi.Controller.api_version(mv.CHECKPOINT_CONTRACT)
+    def index(self, req):
+        params = dict(req.params)
+        if set(params) - {'checkpoint_id', 'instance_uuid', 'status',
+                          'marker', 'limit'}:
+            raise exception.InvalidInput(reason='invalid_checkpoint_filter')
+        marker, limit, unused_offset = common.get_pagination_params(params)
+        operations = self.api.list(req.environ['cinder.context'], params,
+                                   marker, limit)
+        return self.view.index(req, operations)
+
+    @wsgi.Controller.api_version(mv.CHECKPOINT_CONTRACT)
+    def capabilities(self, req, id):
+        return {'checkpoint_capabilities': self.api.capabilities(
+            req.environ['cinder.context'], id)}
+
+    @wsgi.Controller.api_version(mv.CHECKPOINT_CONTRACT)
+    @wsgi.response(HTTPStatus.ACCEPTED)
+    @validation.schema(schema.action)
+    def operate(self, req, id, body):
+        name, args = next(iter(body.items()))
+        operation = self.api.action(req.environ['cinder.context'], id,
+                                    name, **args)
+        return {'checkpoint_operation': self.view.detail(operation)}
+
+
+def create_resource():
+    return wsgi.Resource(CheckpointController())
