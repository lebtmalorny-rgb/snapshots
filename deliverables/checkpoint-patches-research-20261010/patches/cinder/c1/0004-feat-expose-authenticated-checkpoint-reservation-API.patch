+
+"""Allowlisted public fields without backend references or identities."""
+
+from cinder.api import common
+
+
+class ViewBuilder(common.ViewBuilder):
+    @staticmethod
+    def detail(operation):
+        result = {key: operation[key] for key in (
+            'id', 'request_id', 'checkpoint_id', 'instance_uuid', 'kind',
+            'generation', 'status', 'release_outcome', 'error_code')}
+        result['resources'] = [
+            {key: resource[key] for key in (
+                'id', 'volume_id', 'snapshot_id', 'volume_size', 'status')}
+            for resource in operation.resources]
+        result['steps'] = [
+            {key: step[key] for key in (
+                'id', 'resource_id', 'phase', 'generation', 'status',
+                'error_code')}
+            for step in operation.steps]
+        return result
+
+    def index(self, request, operations):
+        result = {'checkpoint_operations': [self.detail(op)
+                                            for op in operations]}
+        links = self._get_collection_links(request, operations,
+                                           'checkpoint-operations')
+        if links:
+            result['checkpoint_operations_links'] = links
+        return result
diff --git a/cinder/checkpoints/api.py b/cinder/checkpoints/api.py
new file mode 100644
index 0000000..381c83e
--- /dev/null
+++ b/cinder/checkpoints/api.py
@@ -0,0 +1,167 @@
+# Licensed under the Apache License, Version 2.0 (the "License"); you may
+# not use this file except in compliance with the License. You may obtain
+# a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+# WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+# License for the specific language governing permissions and limitations
+# under the License.
+
+"""Project and service scoped API; the worker performs backend I/O."""
+
+import uuid
+
+from cinder.api.schemas import checkpoints as schema
+from cinder.api.validation import validators
+from cinder.checkpoints import config
+from cinder.checkpoints import contracts
+from cinder.checkpoints import guards
+from cinder import db
+from cinder import exception
+from cinder import objects
+from cinder.policies import checkpoints as policy
+from cinder import quota
+from cinder import quota_utils
+from cinder.volume import rpcapi as volume_rpcapi
+
+
+CONF = config.CONF
+QUOTAS = quota.QUOTAS
+
+
+class API:
+    def __init__(self, rpc=None):
+        self.rpc = rpc if rpc is not None else volume_rpcapi.VolumeAPI()
+
+    def _authorize(self, context, operate=False):
+        guards.require_service(context)
+        context.authorize(policy.OPERATE_POLICY if operate else
+                          policy.READ_POLICY)
+
+    def _volume(self, context, volume_id):
+        volume = objects.Volume.get_by_id(context, volume_id)
+        if volume.project_id != context.project_id:
+            raise exception.VolumeNotFound(volume_id=volume_id)
+        return volume
+
+    @staticmethod
+    def _object(context, row):
+        return objects.CheckpointOperation._from_db_object(
+            context, objects.CheckpointOperation(context), row)
+
+    def capabilities(self, context, volume_id):
+        self._authorize(context)
+        volume = self._volume(context, volume_id)
+        self.rpc.assert_checkpoint_ready(context, volume)
+        result = self.rpc.get_checkpoint_capabilities(
+            context, volume.id, volume.service_topic_queue)
+        try:
+            return contracts.validate_capabilities(result)
+        except exception.CheckpointNotSupported:
+            # Do not forward arbitrary driver data or exception messages.
+            return contracts.unsupported_capabilities(
+                'unverified_capabilities')
+
+    def reserve(self, context, payload):
+        self._authorize(context, operate=True)
+        validators._SchemaValidator(schema.payload).validate(payload)
+        identity = {key: getattr(context, key) for key in
+                    ('project_id', 'user_id', 'service_user_id')}
+        payload_hash = contracts.canonical_payload_hash(dict(payload,
+                                                             **identity))
+        values = {key: str(uuid.UUID(payload[key])) for key in
+                  ('request_id', 'checkpoint_id', 'instance_uuid')}
+        values['kind'] = payload['kind']
+        volume_ids = sorted(str(uuid.UUID(v)) for v in payload['volume_ids'])
+        existing = db.checkpoint_get_all(
+            context, {'request_id': values['request_id']})
+        if existing:
+            if existing[0]['payload_hash'] != payload_hash:
+                raise exception.CheckpointConflict(
+                    reason='request_payload_changed')
+            return self._object(context, existing[0])
+        if values['kind'] == 'create' and not CONF.checkpoint.enabled:
+            raise exception.CheckpointNotSupported(reason='feature_disabled')
+        if len(volume_ids) > CONF.checkpoint.max_volumes_per_operation:
+            raise exception.InvalidInput(reason='too_many_checkpoint_volumes')
+        # Check ownership of the whole set before querying any backend.
+        volumes = [self._volume(context, vid) for vid in volume_ids]
+        values['capabilities'] = {}
+        for volume in volumes:
+            self.rpc.assert_checkpoint_ready(context, volume)
+            result = self.rpc.get_checkpoint_capabilities(
+                context, volume.id, volume.service_topic_queue)
+            values['capabilities'][volume.id] = (
+                contracts.validate_capabilities(result))
+        reservations = []
+        values['quota_reservations'] = {}
+        try:
+            if values['kind'] == 'create':
+                for volume in volumes:
+                    deltas = {'snapshots': 1}
+                    if not CONF.no_snapshot_gb_quota:
+                        deltas['gigabytes'] = volume.size
+                    QUOTAS.add_volume_type_opts(context, deltas,
+                                                volume.volume_type_id)
+                    try:
+                        reserved = QUOTAS.reserve(context, **deltas)
+                    except exception.OverQuota as error:
+                        quota_utils.process_reserve_over_quota(
+                            context, error, resource='snapshots',
+                            size=volume.size)
+                    values['quota_reservations'][volume.id] = reserved
+                    reservations.extend(reserved)
+            row = db.checkpoint_reserve(context, values, volume_ids)
+        except Exception:
+            QUOTAS.rollback(context, reservations)
+            raise
+        # A concurrent exact replay returns its original journal. Any quota
+        # reservations made by this losing request have no matching journal.
+        # Rolling back already committed IDs is a no-op in the quota DB API.
+        QUOTAS.rollback(context, reservations)
+        return self._object(context, row)
+
+    def get(self, context, operation_id):
+        self._authorize(context)
+        return self._object(context, db.checkpoint_get(context, operation_id))
+
+    def list(self, context, filters, marker=None, limit=None):
+        self._authorize(context)
+        if set(filters) - {'checkpoint_id', 'instance_uuid', 'status'}:
+            raise exception.InvalidInput(reason='invalid_checkpoint_filter')
+        if limit == 0:
+            return []
+        return [self._object(context, row) for row in db.checkpoint_get_all(
+            context, filters, marker, limit)]
+
+    def action(self, context, operation_id, name, generation, outcome=None):
+        self._authorize(context, operate=True)
+        args = {'generation': generation}
+        if outcome is not None:
+            args['outcome'] = outcome
+        validators._SchemaValidator(schema.action).validate({name: args})
+        operation = self.get(context, operation_id)
+        if operation.generation != generation:
+            raise exception.CheckpointConflict(reason='stale_generation')
+        if name == 'release':
+            return self._object(context, db.checkpoint_release(
+                context, operation_id, generation, outcome))
+        if operation.status == 'released':
+            return operation
+        if name == 'cleanup':
+            raise exception.CheckpointConflict(reason='cleanup_not_prepared')
+        resources = {resource.id: resource for resource in operation.resources}
+        for step in operation.steps:
+            volume = self._volume(
+                context, resources[step.resource_id].volume_id)
+            self.rpc.assert_checkpoint_ready(context, volume)
+            if name == 'execute':
+                self.rpc.execute_checkpoint_step(context, step.id, generation,
+                                                 volume.service_topic_queue)
+            else:
+                self.rpc.reconcile_checkpoint_step(
+                    context, step.id, generation, volume.service_topic_queue)
+        return self.get(context, operation_id)
