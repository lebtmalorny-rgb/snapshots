+from cinder.tests.unit import test
+from cinder.tests.unit import utils
+
+
+class APIHelpers(test_db.CheckpointDBHelpers):
+    def prepare_api(self):
+        self.prepare_volumes()
+        self.ctxt.roles = ['member']
+        self.ctxt.service_roles = ['service']
+        self.flags(enabled=True, nova_service_user_ids=[test_db.SERVICE_ID],
+                   group='checkpoint')
+        self.rpc = mock.Mock(spec=[
+            'assert_checkpoint_ready', 'get_checkpoint_capabilities',
+            'execute_checkpoint_step', 'reconcile_checkpoint_step'])
+        self.rpc.get_checkpoint_capabilities.return_value = (
+            test_contracts.supported_capabilities())
+        self.api = api.API(rpc=self.rpc)
+        self.payload = {key: value for key, value in self.values().items()
+                        if key != 'capabilities'}
+        self.payload['volume_ids'] = self.volumes
+
+    def usage(self):
+        return db.quota_usage_get_all_by_project(
+            self.ctxt.elevated(), self.ctxt.project_id)
+
+
+class TestCheckpointAPI(APIHelpers, test.TestCase):
+    def setUp(self):
+        super().setUp()
+        self.prepare_api()
+
+    def test_reservation_creates_snapshots_and_accounts_quota_once(self):
+        operation = self.api.reserve(self.ctxt, self.payload)
+        self.assertIsInstance(operation, objects.CheckpointOperation)
+        self.assertEqual(2, self.usage()['snapshots']['in_use'])
+        self.assertEqual(0, self.usage()['snapshots']['reserved'])
+        for resource in operation.resources:
+            snap = objects.Snapshot.get_by_id(self.ctxt, resource.snapshot_id)
+            self.assertEqual(resource.volume_id, snap.volume_id)
+            self.assertEqual('creating', snap.status)
+        self.assertTrue(all(json.loads(step.quota_reservations_json)
+                            for step in operation.steps))
+        again = self.api.reserve(self.ctxt, copy.deepcopy(self.payload))
+        self.assertEqual(operation.id, again.id)
+        self.assertEqual(2, self.usage()['snapshots']['in_use'])
+        self.assertEqual(0, self.usage()['snapshots']['reserved'])
+
+    def test_conflicting_reservation_leaves_no_quota_or_snapshots(self):
+        snap = utils.create_snapshot(self.ctxt, self.volumes[1],
+                                     status='creating')
+        self.assertRaises(exception.CheckpointConflict,
+                          self.api.reserve, self.ctxt, self.payload)
+        self.assertEqual([], self.locks())
+        self.assertEqual(0, self.usage()['snapshots']['reserved'])
+        snapshots = objects.SnapshotList.get_all_by_project(
+            self.ctxt, self.ctxt.project_id, {})
+        self.assertEqual([snap.id], [s.id for s in snapshots])
+
+    def test_policy_and_verified_service_both_required(self):
+        for attr, value in (('service_user_id', None),
+                            ('service_user_id', uuidutils.generate_uuid()),
+                            ('service_roles', []), ('roles', ['service'])):
+            ctxt = self.ctxt.deepcopy()
+            setattr(ctxt, attr, value)
+            self.assertRaises(exception.NotAuthorized, self.api.reserve,
+                              ctxt, self.payload)
+        self.assertEqual([], self.locks())
+        self.rpc.get_checkpoint_capabilities.assert_not_called()
+
+    def test_disabled_feature_allows_existing_read_and_exact_replay(self):
+        operation = self.api.reserve(self.ctxt, self.payload)
+        config.CONF.set_override('enabled', False, group='checkpoint')
+        self.assertEqual(operation.id,
+                         self.api.get(self.ctxt, operation.id).id)
+        self.assertEqual(operation.id,
+                         self.api.reserve(self.ctxt, self.payload).id)
+        changed = copy.deepcopy(self.payload)
+        changed['request_id'] = uuidutils.generate_uuid()
+        self.assertRaises(exception.CheckpointNotSupported,
+                          self.api.reserve, self.ctxt, changed)
+
+    def test_foreign_project_denied_before_backend_detail(self):
+        ctxt = self.ctxt.elevated()
+        ctxt.project_id = uuidutils.generate_uuid()
+        self.assertRaises(exception.VolumeNotFound, self.api.reserve,
+                          ctxt, self.payload)
+        self.rpc.get_checkpoint_capabilities.assert_not_called()
+
+    def test_rpc_gate_before_any_reservation(self):
+        self.rpc.assert_checkpoint_ready.side_effect = (
+            exception.CheckpointNotSupported(reason='upgrade_required'))
+        self.assertRaises(exception.CheckpointNotSupported,
+                          self.api.reserve, self.ctxt, self.payload)
+        self.assertEqual([], self.locks())
+        self.assertNotIn('snapshots', self.usage())
+
+    def test_changed_request_conflicts_without_new_effects(self):
+        self.api.reserve(self.ctxt, self.payload)
+        self.payload['volume_ids'] = self.volumes[:1]
+        self.assertRaises(exception.CheckpointConflict,
+                          self.api.reserve, self.ctxt, self.payload)
+        self.assertEqual(2, self.usage()['snapshots']['in_use'])
+
+    def test_untrusted_driver_output_fails_before_db(self):
+        self.rpc.get_checkpoint_capabilities.return_value = {'supported': True}
+        self.assertRaises(exception.CheckpointNotSupported,
+                          self.api.reserve, self.ctxt, self.payload)
+        self.assertEqual([], self.locks())
+
+    def test_service_identity_survives_rpc_context_roundtrip(self):
+        restored = context.RequestContext.from_dict(self.ctxt.to_dict())
+        self.assertEqual(self.ctxt.service_user_id, restored.service_user_id)
+        self.assertEqual(self.ctxt.service_roles, restored.service_roles)
