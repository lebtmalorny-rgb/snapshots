+                 self.service_path + '/attachments/' + self.original[0],
+                 self.service_path + '/volumes/' + self.volumes[0] +
+                 '/capabilities')
+        for read, write in ((True, False), (False, True)):
+            policy.set_rules(oslo_policy.Rules.from_dict({
+                'checkpoint:continuation_read': (
+                    'role:service' if read else '!'),
+                'checkpoint:continue': 'role:service' if write else '!'}),
+                overwrite=False)
+            for path in paths:
+                with self.subTest(read=read, path=path):
+                    response = self.request_as(self.service_ctx, 'GET', path)
