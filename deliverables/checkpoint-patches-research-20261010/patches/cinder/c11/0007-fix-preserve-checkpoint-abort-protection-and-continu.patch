diff --git a/api-ref/source/checkpoint-continuation.inc b/api-ref/source/checkpoint-continuation.inc
index dcb0280..db0f95d 100644
--- a/api-ref/source/checkpoint-continuation.inc
+++ b/api-ref/source/checkpoint-continuation.inc
@@ -44,9 +44,13 @@ do not bypass the check. A missing or foreign operation returns 404.
 
 All service paths optionally accept ``/v3/{service_project_id}/``. The project
 must be the authenticated service project; it cannot select a tenant owner.
+The read and continue policy rules are independent: every GET requires
+``checkpoint:continuation_read`` and every mutation requires
+``checkpoint:continue``, in addition to mandatory identity and grant checks.
 There is no service collection/list route. GET returns 200 with the same safe
 ``checkpoint_operation`` view and continuation binding, including released
-tombstones. A revoked grant cannot be read or continued.
+tombstones. Their operation identity/generation/release state is immutable;
+the nested resources reflect the current shared C1 resource journal. A revoked grant cannot be read or continued.
 
 Continue an operation
 ~~~~~~~~~~~~~~~~~~~~~
@@ -100,7 +104,9 @@ returns its stored result. Changed payload or a second UUID for the same
 action returns 409. Delete is restricted to original attachments before disk
 revert; reconnect is allowed after every disk step succeeds. Complete requires
 a successful update. The legacy attachment-header bypass is forbidden for a
-delegated operation. Release rejects unfinished attachment requests.
+delegated operation. Release rejects unfinished attachment requests. Abort also rejects a
+successful original-attachment delete even before disk steps are dispatched;
+no compensating reconnect is assumed.
 
 Read an attachment request
 ~~~~~~~~~~~~~~~~~~~~~~~~~~
diff --git a/cinder/checkpoints/continuation.py b/cinder/checkpoints/continuation.py
index 9447435..9b0d416 100644
--- a/cinder/checkpoints/continuation.py
+++ b/cinder/checkpoints/continuation.py
@@ -32,9 +32,23 @@ def require_executor(context) -> str:
             'service' not in context.roles or subject not in
             config.CONF.checkpoint.nova_service_user_ids):
         raise exception.CheckpointServiceForbidden()
-    context.authorize(policies.CONTINUE_POLICY,
-                      target={'project_id': context.project_id,
-                              'user_id': subject})
+    return subject
+
+
+READ_ACTIONS = ('read', 'capabilities', 'attachment_read')
+WRITE_ACTIONS = ('execute', 'reconcile', 'cleanup', 'release', 'attachment')
+
+
+def require_policy(context, action) -> str:
+    subject = require_executor(context)
+    if action in READ_ACTIONS:
+        name = policies.CONTINUATION_READ_POLICY
+    elif action in WRITE_ACTIONS:
+        name = policies.CONTINUE_POLICY
+    else:
+        raise exception.InvalidInput(reason='invalid_continuation_action')
+    context.authorize(name, target={'project_id': context.project_id,
+                                    'user_id': subject})
     return subject
 
 
