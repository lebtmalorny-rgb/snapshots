+# License for the specific language governing permissions and limitations
+# under the License.
+
+"""Private service-only routes; no initial reserve or collection methods."""
+
+from http import HTTPStatus
+
+from cinder.api import microversions as mv
+from cinder.api.openstack import wsgi
+from cinder.api.schemas import checkpoint_continuation as schema
+from cinder.api import validation
+from cinder.checkpoints import continuation_api
+
+
+class CheckpointContinuationController(wsgi.Controller):
+    def __init__(self):
+        self.api = continuation_api.ContinuationAPI()
+        super().__init__()
+
+    @wsgi.Controller.api_version(mv.CHECKPOINT_CONTINUATION)
+    def show(self, req, id):
+        return {'checkpoint_operation': self.api.get(
+            req.environ['cinder.context'], id)}
+
+    @wsgi.Controller.api_version(mv.CHECKPOINT_CONTINUATION)
+    @wsgi.response(HTTPStatus.ACCEPTED)
+    @validation.schema(schema.action)
+    def operate(self, req, id, body):
+        name, args = next(iter(body.items()))
+        return {'checkpoint_operation': self.api.action(
+            req.environ['cinder.context'], id, name, **args)}
+
+    @wsgi.Controller.api_version(mv.CHECKPOINT_CONTINUATION)
+    def capabilities(self, req, id, volume_id):
+        return {'checkpoint_capabilities': self.api.capabilities(
+            req.environ['cinder.context'], id, volume_id)}
+
+
+def create_resource():
+    return wsgi.Resource(CheckpointContinuationController())
