+from cinder.api.v3 import router
+from cinder.checkpoints import api
+from cinder.checkpoints import continuation_api
+from cinder import db
+from cinder.db.sqlalchemy import models
+from cinder.tests.unit.api import fakes
+from cinder.tests.unit.checkpoints import test_continuation_db
+from cinder.tests.unit.checkpoints import test_contracts
+from cinder.tests.unit.checkpoints import test_db
+from cinder.tests.unit import test
+
+
+class CheckpointContinuationAPITest(test_continuation_db.ContinuationHelpers,
+                                    test.TestCase):
+    def setUp(self):
+        super().setUp()
+        self.prepare_continuation()
+        self.operation = self.api.reserve_with_continuation(
+            self.ctxt, self.payload)
+        self.service_path = ('/checkpoint-service-operations/' +
+                             uuids.nova_operation)
+        self.reserve_body = {'checkpoint_operation': self.payload}
+        self.service_rpc = mock.Mock(spec=[
+            'assert_checkpoint_continuation_ready',
+            'get_checkpoint_continuation_capabilities',
+            'execute_checkpoint_continuation',
+            'reconcile_checkpoint_continuation'])
+        query = self.service_rpc.get_checkpoint_continuation_capabilities
+        query.return_value = test_contracts.supported_capabilities()
+        self.service_api = continuation_api.ContinuationAPI(
+            rpc=self.service_rpc)
+        self.mock_object(api, 'API', return_value=self.api)
+        self.mock_object(continuation_api, 'ContinuationAPI',
+                         return_value=self.service_api)
+        self.application = fakes.urlmap.URLMap()
+        self.application['/v3'] = router.APIRouter()
+        self.application = fault.FaultWrapper(self.application)
+        self.foreign_service = self.service_ctx.deepcopy()
+        self.foreign_service.user_id = uuids.foreign_service
+        self.flags(nova_service_user_ids=[test_db.SERVICE_ID,
+                                          uuids.foreign_service],
+                   group='checkpoint')
+
+    def request_as(self, ctx, method, path, body=None, version='3.73'):
+        request = webob.Request.blank('/v3' + path)
+        request.method = method
+        request.headers['Content-Type'] = 'application/json'
+        request.headers['OpenStack-API-Version'] = 'volume ' + version
+        request.environ['cinder.context'] = ctx
+        if body is not None:
+            request.body = jsonutils.dump_as_bytes(body)
+        return request.get_response(self.application)
+
+    def test_service_lookup_keeps_original_owner_and_hides_journal(self):
+        response = self.request_as(self.service_ctx, 'GET', self.service_path)
+        self.assertEqual(200, response.status_int, response.text)
+        operation = response.json['checkpoint_operation']
+        self.assertEqual(self.operation.id, operation['id'])
+        self.assertEqual(dict(version=1,
+                              nova_operation_id=uuids.nova_operation,
+                              owner_project_id=self.ctxt.project_id,
+                              actor_user_id=self.ctxt.user_id,
+                              executor_service_user_id=test_db.SERVICE_ID,
+                              generation=1), operation['continuation'])
+        for name in ('payload_hash', 'backend_reference', 'capabilities_json',
+                     'quota_reservations', 'connection_info'):
+            self.assertNotIn(name, response.text)
+
+    def test_foreign_service_cannot_read_grant(self):
+        response = self.request_as(self.foreign_service, 'GET',
+                                   self.service_path)
+        self.assertEqual(404, response.status_int, response.text)
+        self.rpc.execute_checkpoint_step.assert_not_called()
+        self.service_rpc.execute_checkpoint_continuation.assert_not_called()
+
+    def test_service_cannot_reserve_new_operation(self):
+        response = self.request_as(self.service_ctx, 'POST',
+                                   '/checkpoint-operations', self.reserve_body)
+        self.assertEqual(403, response.status_int, response.text)
+        self.assertEqual(1, self.count(models.CheckpointOperation))
+
+    def test_373_reserve_replay_returns_the_same_continuation(self):
+        response = self.request_as(self.ctxt, 'POST', '/checkpoint-operations',
+                                   self.reserve_body)
+        self.assertEqual(202, response.status_int, response.text)
+        result = response.json['checkpoint_operation']
+        self.assertEqual(self.operation.id, result['id'])
+        self.assertEqual(uuids.nova_operation,
+                         result['continuation']['nova_operation_id'])
+        self.assertEqual(1, self.count(models.CheckpointContinuationGrant))
+        self.assertEqual(2, self.usage()['snapshots']['in_use'])
+
+    def test_372_has_no_new_routes_or_delegation_fields(self):
+        response = self.request_as(self.ctxt, 'POST', '/checkpoint-operations',
+                                   self.reserve_body, version='3.72')
+        self.assertEqual(400, response.status_int, response.text)
+        response = self.request_as(self.service_ctx, 'GET', self.service_path,
+                                   version='3.72')
+        self.assertEqual(404, response.status_int, response.text)
+
+    def test_373_without_delegation_keeps_legacy_path(self):
+        db.checkpoint_release(self.ctxt, self.operation.id, 1, 'abort')
+        legacy = {key: value for key, value in self.payload.items()
+                  if key not in ('nova_operation_id',
+                                 'allow_service_continuation')}
+        legacy.update(request_id=uuids.legacy_request,
+                      checkpoint_id=uuids.legacy_checkpoint)
+        response = self.request_as(self.ctxt, 'POST', '/checkpoint-operations',
+                                   {'checkpoint_operation': legacy})
+        self.assertEqual(202, response.status_int, response.text)
+        self.assertNotIn('continuation', response.json['checkpoint_operation'])
+        self.assertEqual(1, self.count(models.CheckpointContinuationGrant))
+
+    def test_unknown_uuid_and_foreign_volume_do_not_dispatch(self):
+        paths = ['/checkpoint-service-operations/' + uuids.unknown,
+                 self.service_path + '/volumes/' + uuids.foreign_volume +
+                 '/capabilities']
+        for path in paths:
+            response = self.request_as(self.service_ctx, 'GET', path)
+            self.assertEqual(404, response.status_int, response.text)
+        self.service_rpc.get_checkpoint_continuation_capabilities.\
+            assert_not_called()
+        self.assertEqual(2, len(self.locks()))
+
+    def test_capabilities_use_scoped_rpc(self):
+        path = (self.service_path + '/volumes/' + self.volumes[0] +
+                '/capabilities')
+        response = self.request_as(self.service_ctx, 'GET', path)
+        self.assertEqual(200, response.status_int, response.text)
+        self.assertTrue(response.json['checkpoint_capabilities']['supported'])
+        query = self.service_rpc.get_checkpoint_continuation_capabilities
+        args = query.call_args.args
+        self.assertEqual((self.service_ctx, uuids.nova_operation,
+                          self.volumes[0]), args[:3])
+
+    def test_changed_generation_and_closed_action_shape(self):
+        for body, status in (({'execute': {'generation': 2}}, 409),
+                             ({'execute': {'generation': True}}, 400),
+                             ({'execute': {'generation': 1, 'force': True}},
+                              400), ({'release': {'generation': 1}}, 400)):
+            response = self.request_as(self.service_ctx, 'POST',
+                                       self.service_path + '/action', body)
+            self.assertEqual(status, response.status_int, response.text)
+        self.service_rpc.execute_checkpoint_continuation.assert_not_called()
+
+    def test_execute_uses_continuation_rpc_with_service_subject(self):
+        response = self.request_as(self.service_ctx, 'POST',
+                                   self.service_path + '/action',
+                                   {'execute': {'generation': 1}})
+        self.assertEqual(202, response.status_int, response.text)
+        execute = self.service_rpc.execute_checkpoint_continuation
+        self.assertTrue(execute.called)
+        for call in execute.call_args_list:
+            self.assertEqual((self.service_ctx, uuids.nova_operation, 1),
+                             call.args[:3])
+        self.rpc.execute_checkpoint_step.assert_not_called()
+
+    def test_release_reply_loss_is_resolved_by_read_only_tombstone(self):
+        response = self.request_as(self.service_ctx, 'POST',
+                                   self.service_path + '/action',
+                                   {'release': {'generation': 1,
+                                                'outcome': 'abort'}})
+        self.assertEqual(202, response.status_int, response.text)
+        response = self.request_as(self.service_ctx, 'GET', self.service_path)
+        self.assertEqual(200, response.status_int, response.text)
+        self.assertEqual('released',
+                         response.json['checkpoint_operation']['status'])
+        for action in ('execute', 'reconcile', 'cleanup'):
+            response = self.request_as(self.service_ctx, 'POST',
+                                       self.service_path + '/action',
+                                       {action: {'generation': 1}})
+            self.assertEqual(409, response.status_int, response.text)
+        self.assertEqual(0, self.usage()['snapshots']['in_use'])
+        self.assertEqual([], self.locks())
+
+    def test_service_project_url_does_not_select_owner(self):
+        response = self.request_as(self.service_ctx, 'GET',
+                                   '/' + self.service_ctx.project_id +
+                                   self.service_path)
+        self.assertEqual(200, response.status_int, response.text)
+        response = self.request_as(self.service_ctx, 'GET',
+                                   '/' + self.ctxt.project_id +
+                                   self.service_path)
+        self.assertEqual(400, response.status_int, response.text)
+
+    def test_no_service_collection_or_unbound_resource_routes(self):
+        for path in ('/checkpoint-service-operations',
+                     self.service_path + '/volumes',
+                     self.service_path + '/attachments'):
+            response = self.request_as(self.service_ctx, 'GET', path)
+            self.assertEqual(404, response.status_int, response.text)
