diff --git a/cinder/checkpoints/continuation_api.py b/cinder/checkpoints/continuation_api.py
new file mode 100644
index 0000000..a304f30
--- /dev/null
+++ b/cinder/checkpoints/continuation_api.py
@@ -0,0 +1,84 @@
+# Licensed under the Apache License, Version 2.0 (the "License"); you may
+# not use this file except in compliance with the License. You may obtain
+# a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+# WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+# License for the specific language governing permissions and limitations
+# under the License.
+
+"""Service orchestration restricted to a previously delegated operation."""
+
+from cinder.api.schemas import checkpoint_continuation as schema
+from cinder.api.v3.views import checkpoints as views
+from cinder.api.validation import validators
+from cinder.checkpoints import continuation
+from cinder.checkpoints import continuation_contracts
+from cinder.checkpoints import contracts
+from cinder import db
+from cinder import exception
+from cinder import objects
+from cinder.volume import rpcapi
+
+
+def _id(value):
+    try:
+        return continuation_contracts._uuid(value)
+    except ValueError:
+        raise exception.InvalidInput(reason='invalid_checkpoint_identifier')
+
+
+class ContinuationAPI:
+    def __init__(self, rpc=None):
+        self.rpc = rpc if rpc is not None else rpcapi.VolumeAPI()
+
+    def get(self, context, nova_operation_id):
+        row = db.checkpoint_continuation_get(context, _id(nova_operation_id))
+        return views.ViewBuilder.continuation(row['operation'], row)
+
+    def _volumes(self, context, scope, action):
+        rows = db.checkpoint_continuation_volumes(
+            context, scope.nova_operation_id, scope.generation, action)
+        return [objects.Volume._from_db_object(
+            context, objects.Volume(context), row) for row in rows]
+
+    def action(self, context, nova_operation_id, name, generation,
+               outcome=None):
+        args = {'generation': generation}
+        if outcome is not None:
+            args['outcome'] = outcome
+        validators._SchemaValidator(schema.action).validate({name: args})
+        scope = continuation.authorize(context, _id(nova_operation_id),
+                                       generation, name)
+        if name in ('release', 'cleanup'):
+            db.checkpoint_continuation_transition(
+                context, nova_operation_id, generation, name, outcome)
+            if name == 'release':
+                return self.get(context, nova_operation_id)
+        volumes = self._volumes(context, scope, name)
+        for volume in volumes:
+            self.rpc.assert_checkpoint_continuation_ready(context, volume)
+        hosts = sorted({volume.service_topic_queue for volume in volumes})
+        method = (self.rpc.reconcile_checkpoint_continuation if
+                  name == 'reconcile' else
+                  self.rpc.execute_checkpoint_continuation)
+        for host in hosts:
+            method(context, nova_operation_id, generation, host)
+        return self.get(context, nova_operation_id)
+
+    def capabilities(self, context, nova_operation_id, volume_id):
+        scope = continuation.authorize(context, _id(nova_operation_id), 1,
+                                       'capabilities', _id(volume_id))
+        volume = next(v for v in self._volumes(context, scope, 'capabilities')
+                      if v.id == volume_id)
+        self.rpc.assert_checkpoint_continuation_ready(context, volume)
+        result = self.rpc.get_checkpoint_continuation_capabilities(
+            context, nova_operation_id, volume_id, volume.service_topic_queue)
+        try:
+            return contracts.validate_capabilities(result)
+        except exception.CheckpointNotSupported:
+            return contracts.unsupported_capabilities(
+                'unverified_capabilities')
