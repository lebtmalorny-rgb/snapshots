diff --git a/cinder/db/sqlalchemy/checkpoint_continuation.py b/cinder/db/sqlalchemy/checkpoint_continuation.py
index 8628d24..ad9794f 100644
--- a/cinder/db/sqlalchemy/checkpoint_continuation.py
+++ b/cinder/db/sqlalchemy/checkpoint_continuation.py
@@ -18,6 +18,7 @@ from oslo_utils import uuidutils
 
 from cinder.checkpoints import continuation
 from cinder.checkpoints import continuation_contracts as contracts
+from cinder.checkpoints import guards
 from cinder.db.sqlalchemy import api
 from cinder.db.sqlalchemy import checkpoints as journal
 from cinder.db.sqlalchemy import models
@@ -160,3 +161,49 @@ def _scope(context, nova_operation_id, generation, action, volume_id=None):
 def scope(context, nova_operation_id, generation, action, volume_id=None):
     return _scope(context, nova_operation_id, generation, action,
                   volume_id).to_primitive()
+
+
+@api.require_context
+@api.main_context_manager.reader
+def for_owner(context, operation_id):
+    guards.require_service(context)
+    operation = journal._operation(context, operation_id)
+    grant = journal._query(context, models.CheckpointContinuationGrant).\
+        filter_by(id=operation.continuation_id,
+                  operation_id=operation.id).first()
+    if grant is None:
+        raise exception.CheckpointOperationNotFound()
+    _bound_operation(context, grant)
+    return dict(grant)
+
+
+def _volumes(context, scope):
+    return [journal._query(context, models.Volume).filter_by(
+        id=volume_id, project_id=scope.owner_project_id).one()
+        for volume_id in scope.volume_ids]
+
+
+@api.require_context
+@api.main_context_manager.writer
+def volumes(context, nova_operation_id, generation, action):
+    authorized = _scope(context, nova_operation_id, generation, action)
+    return [dict(row) for row in _volumes(context, authorized)]
+
+
+@api.require_context
+@api.main_context_manager.writer
+def transition(context, nova_operation_id, generation, action, outcome=None):
+    if action not in ('release', 'cleanup') or (
+            action == 'release' and outcome not in ('commit', 'abort')):
+        raise exception.InvalidInput(reason='invalid_continuation_action')
+    authorized = _scope(context, nova_operation_id, generation, action)
+    grant = _grant(context, nova_operation_id,
+                   authorized.executor_service_user_id)
+    operation = _bound_operation(context, grant)
+    if action == 'cleanup':
+        return journal._cleanup(context, operation)
+    instance = journal._query(context, models.CheckpointInstance).filter_by(
+        instance_uuid=operation.instance_uuid,
+        project_id=authorized.owner_project_id).one()
+    return journal._release(context, operation, instance,
+                            _volumes(context, authorized), outcome)
