+class TestCheckpointContinuationAuth(ContinuationFunctionalBase):
+    def test_forged_identity_headers_overwritten_by_middleware(self):
+        self.reserve_with_dual_tokens()
+        response = self.request_with_token(
+            self.foreign_service_token, 'GET', self.service_path,
+            headers={'X-User-Id': self.executor_id,
+                     'X-Roles': 'admin,service',
+                     'X-Project-Id': self.service_project,
+                     'X-Service-User-Id': self.executor_id,
+                     'X-Identity-Status': 'Confirmed',
+                     'X-Service-Identity-Status': 'Confirmed'})
+        self.assertEqual(404, response.status_int, response.text)
+        self.assertIn(self.foreign_service_token, self.token_server.validated)
+
+    def test_unknown_token_cannot_supply_trusted_identity(self):
+        self.reserve_with_dual_tokens()
+        response = self.request_with_token(
+            'invalid-marker', 'GET', self.service_path,
+            headers={'X-User-Id': self.executor_id, 'X-Roles': 'service',
+                     'X-Identity-Status': 'Confirmed',
+                     'X-Project-Id': self.service_project})
+        self.assertEqual(401, response.status_int, response.text)
+
+    def test_service_identity_revocation_rejects_new_requests(self):
+        self.reserve_with_dual_tokens()
+        self.token_server.revoke_service()
+        self.restart_api_and_workers()
+        response = self.request_with_token(
+            self.valid_service_token, 'POST', self.service_path + '/action',
+            {'execute': {'generation': 1}})
+        self.assertEqual(401, response.status_int, response.text)
+        self.assertEqual(0, self.native_count())
+        self.assertEqual(2, len(self.locks()))
