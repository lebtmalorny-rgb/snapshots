+# License for the specific language governing permissions and limitations
+# under the License.
+
+import json
+import os
+from pathlib import Path
+
+from cinder.tests.functional import checkpoint_continuation_fixture as fixture
+
+
+class TestContinuationSamples(fixture.ContinuationFunctionalBase):
+    sample_dir = (Path(__file__).parent / 'samples' / 'checkpoints' / 'v3.73')
+
+    def test_delegated_reserve_samples_match_actual_response(self):
+        operation = self.reserve_with_dual_tokens()
+        resources = sorted(operation['resources'],
+                           key=lambda r: r['volume_id'])
+        operation['resources'] = resources
+        operation['steps'] = [next(s for s in operation['steps']
+                                   if s['resource_id'] == resource['id'])
+                              for resource in resources]
+        subs = dict(self.reserve_body['checkpoint_operation'],
+                    operation_id=operation['id'],
+                    owner_project_id=self.ctxt.project_id,
+                    actor_user_id=self.actor_id,
+                    executor_service_user_id=self.executor_id)
+        for index, resource in enumerate(resources):
+            subs.update({
+                'volume%s' % index: resource['volume_id'],
+                'resource%s' % index: resource['id'],
+                'snapshot%s' % index: resource['snapshot_id'],
+                'step%s' % index: operation['steps'][index]['id']})
+        sample = self.sample_dir / 'checkpoint-create-response.json.tpl'
+        self.assertEqual(json.loads(sample.read_text() % subs),
+                         {'checkpoint_operation': operation})
+        sample = self.sample_dir / 'checkpoint-create-request.json.tpl'
+        response = self.request_with_token(
+            self.user_token, 'POST', '/checkpoint-operations',
+            json.loads(sample.read_text() % subs),
+            service_token=self.valid_service_token)
+        self.assertEqual(202, response.status_int, response.text)
+        self.assertEqual(operation['id'],
+                         response.json['checkpoint_operation']['id'])
+        if os.getenv('GENERATE_SAMPLES'):
+            output = Path('api-ref/source/v3/samples/checkpoint-continuation')
+            output.mkdir(parents=True, exist_ok=True)
+            for name in ('checkpoint-create-request',
+                         'checkpoint-create-response'):
+                template = self.sample_dir / (name + '.json.tpl')
+                (output / (name + '.json')).write_text(
+                    template.read_text() % subs)
