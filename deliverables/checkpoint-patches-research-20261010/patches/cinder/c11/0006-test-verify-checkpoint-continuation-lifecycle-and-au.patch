+
+"""Test-only HTTP fixture using auth middleware, SQL and serialized RPC."""
+
+import argparse
+import json
+from pathlib import Path
+import signal
+import time
+from unittest import mock
+
+import eventlet
+from eventlet import wsgi as eventlet_wsgi
+from keystoneauth1 import fixture as token_fixture
+from keystonemiddleware import auth_token
+from oslo_serialization import jsonutils
+from oslo_utils.fixture import uuidsentinel as uuids
+from oslo_utils import uuidutils
+from requests_mock.contrib import fixture as requests_fixture
+import webob
+
+from cinder.api.middleware import auth
+from cinder.api.middleware import fault
+from cinder.api.v3 import router
+from cinder import db
+from cinder.db.sqlalchemy import api as sqla_api
+from cinder.db.sqlalchemy import models
+from cinder import objects
+from cinder.objects import base as object_base
+from cinder import rpc
+from cinder.tests.functional import test_checkpoint_contract
+from cinder.tests.unit.api import fakes
+from cinder.tests.unit.checkpoints import test_db
+from cinder.volume import manager as volume_manager
+
+
+class TokenServer:
+    """Controlled Keystone HTTP responder, never a trusted-context injector."""
+    def __init__(self, owner):
+        self.owner = owner
+        self.expired_user = False
+        self.revoked_service = False
+        self.validated = []
+        self.http = owner.useFixture(requests_fixture.Fixture())
+        self.http.register_uri('GET', 'http://keystone.test/v3/auth/tokens',
+                               json=self.validate)
+
+    def validate(self, request, response):
+        marker = request.headers.get('X-Subject-Token')
+        self.validated.append(marker)
+        identities = {
+            self.owner.user_token: (self.owner.actor_id,
+                                    self.owner.ctxt.project_id, 'member'),
+            self.owner.valid_service_token: (self.owner.executor_id,
+                                             self.owner.service_project,
+                                             'service'),
+            self.owner.foreign_service_token: (uuids.foreign_service,
+                                               self.owner.service_project,
+                                               'service'),
+        }
+        if (marker not in identities or
+                marker == self.owner.user_token and self.expired_user or
+                marker == self.owner.valid_service_token and
+                self.revoked_service):
+            response.status_code = 404
+            return {'error': {'message': 'fixture token rejected'}}
+        user_id, project_id, role = identities[marker]
+        token = token_fixture.V3Token(user_id=user_id, project_id=project_id)
+        token.add_role(name=role)
+        return token
+
+    def expire_user_token(self):
+        self.expired_user = True
+
+    def revoke_service(self):
+        self.revoked_service = True
+
+
+class ContinuationFunctionalBase(
+        test_checkpoint_contract.CheckpointFunctionalBase):
+    user_token = 'c11-test-user-marker'
+    valid_service_token = 'c11-test-service-marker'
+    foreign_service_token = 'c11-test-foreign-service-marker'
+
+    def setUp(self):
+        self.rpc_servers = []
+        factory = rpc.get_server
+
+        def record(target, endpoints, **kwargs):
+            server = factory(target, endpoints, **kwargs)
+            self.rpc_servers.append((target, endpoints, server))
+            return server
+
+        with mock.patch.object(rpc, 'get_server', side_effect=record):
+            super().setUp()
+        self.actor_id = self.ctxt.user_id
+        self.executor_id = test_db.SERVICE_ID
+        self.service_project = uuids.service_project
+        self.flags(nova_service_user_ids=[self.executor_id,
+                                          uuids.foreign_service],
+                   group='checkpoint')
+        for service in objects.ServiceList.get_all_by_binary(
+                self.ctxt.elevated(), 'cinder-volume'):
+            db.service_update(self.ctxt.elevated(), service.id, {
+                'rpc_current_version': '3.22',
+                'object_current_version': '1.41',
+                'uuid': uuidutils.generate_uuid()})
+        # Initial fixtures must represent connected VM disks, including their
+        # original connector. No backend effects run during this setup.
+        with sqla_api.main_context_manager.writer.using(self.ctxt):
+            self.ctxt.session.query(models.VolumeAttachment).filter(
+                models.VolumeAttachment.volume_id.in_(self.volumes)).update({
+                    'connector': json.dumps({'host': 'compute-one',
+                                             'ip': '192.0.2.10'})},
+                    synchronize_session=False)
+        self.token_server = TokenServer(self)
+        self.build_authenticated_app()
+
+    def build_authenticated_app(self):
+        rpc.LAST_RPC_VERSIONS.clear()
+        rpc.LAST_OBJ_VERSIONS.clear()
+        app = fakes.urlmap.URLMap()
+        app['/v3'] = router.APIRouter()
+        pipeline = auth.CinderKeystoneContext(fault.FaultWrapper(app))
+        self.authenticated_app = auth_token.AuthProtocol(pipeline, {
+            'auth_type': 'admin_token',
+            'endpoint': 'http://keystone.test/v3',
+            'token': 'c11-test-validation-marker',
+            'www_authenticate_uri': 'http://keystone.test/v3',
+            'auth_version': 'v3', 'token_cache_time': '0',
+            'service_token_roles': ['service'],
+            'service_token_roles_required': True,
+        })
+
+    def restart_api_and_workers(self):
+        replacements = []
+        for target, endpoints, server in self.rpc_servers:
+            if not isinstance(endpoints[0], volume_manager.VolumeManager):
+                replacements.append((target, endpoints, server))
+                continue
+            self.stop_server(server)
+            worker = volume_manager.VolumeManager(host=endpoints[0].host)
+            worker.driver = endpoints[0].driver
+            for vid, previous in list(self.workers.items()):
+                if previous is endpoints[0]:
+                    self.workers[vid] = worker
+            server = rpc.get_server(target, [worker],
+                                    serializer=object_base.
+                                    CinderObjectSerializer())
+            server.start()
+            self.addCleanup(self.stop_server, server)
+            replacements.append((target, [worker], server))
+        self.rpc_servers = replacements
+        self.build_authenticated_app()
+
+    def request_with_token(self, token, method, path, body=None,
+                           headers=None, service_token=None):
+        request = webob.Request.blank('/v3' + path)
+        request.method = method
+        request.headers.update({
+            'Content-Type': 'application/json',
+            'OpenStack-API-Version': 'volume 3.73', 'X-Auth-Token': token})
+        if service_token:
+            request.headers['X-Service-Token'] = service_token
+        if headers:
+            request.headers.update(headers)
+        if body is not None:
+            request.body = jsonutils.dump_as_bytes(body)
+        return request.get_response(self.authenticated_app)
+
+    def reserve_with_dual_tokens(self, kind='create', checkpoint_id=None):
+        self.nova_operation_id = uuidutils.generate_uuid()
+        self.service_path = ('/checkpoint-service-operations/' +
+                             self.nova_operation_id)
+        self.reserve_body = {'checkpoint_operation': {
+            'request_id': uuidutils.generate_uuid(),
+            'checkpoint_id': checkpoint_id or uuidutils.generate_uuid(),
+            'instance_uuid': self.instance, 'kind': kind,
+            'volume_ids': self.volumes,
+            'nova_operation_id': self.nova_operation_id,
+            'allow_service_continuation': True}}
+        response = self.request_with_token(
+            self.user_token, 'POST', '/checkpoint-operations',
+            self.reserve_body, service_token=self.valid_service_token)
+        self.assertEqual(202, response.status_int, response.text)
+        return response.json['checkpoint_operation']
+
+    def service_action(self, name, outcome=None):
+        args = {'generation': 1}
+        if outcome:
+            args['outcome'] = outcome
+        response = self.request_with_token(
+            self.valid_service_token, 'POST', self.service_path + '/action',
+            {name: args})
+        self.assertEqual(202, response.status_int, response.text)
+        return response.json['checkpoint_operation']
+
+    def wait_service(self, status, suffix='', field='checkpoint_operation'):
+        deadline = time.monotonic() + 10
+        while time.monotonic() < deadline:
+            response = self.request_with_token(
+                self.valid_service_token, 'GET', self.service_path + suffix)
+            self.assertEqual(200, response.status_int, response.text)
+            actual = response.json[field]
+            if actual['status'] == status:
+                return actual
+            eventlet.sleep(0.01)
+        self.fail('Continuation did not reach %s: %s' % (status, actual))
+
+    def service_checkpoint(self):
+        operation = self.reserve_with_dual_tokens()
+        self.service_action('execute')
+        self.wait_service('succeeded')
+        self.service_action('release', 'commit')
+        return operation
+
+    def attachment_request(self, action, volume_id, attachment_id=None,
+                           reply_loss=False):
+        body = {'attachment_request': {
+            'id': uuidutils.generate_uuid(), 'generation': 1,
+            'volume_id': volume_id, 'action': action,
+            'attachment_id': attachment_id,
+            'connector': {'host': 'compute-one', 'ip': '192.0.2.10'}
+            if action == 'update' else None,
+            'mountpoint': '/dev/vda' if action == 'update' else None}}
+        response = self.request_with_token(
+            self.valid_service_token, 'POST',
+            self.service_path + '/attachment-requests', body)
+        self.assertEqual(202, response.status_int, response.text)
+        child_id = body['attachment_request']['id']
+        observed = self.wait_service(
+            'succeeded', '/attachment-requests/' + child_id,
+            'attachment_request')
+        if reply_loss:
+            # Discard the original response. Retry exactly the durable UUID;
+            # the server may have finished the operation before this replay.
+            replay = self.request_with_token(
+                self.valid_service_token, 'POST',
+                self.service_path + '/attachment-requests', body)
+            self.assertEqual(202, replay.status_int, replay.text)
+            self.assertEqual(observed, replay.json['attachment_request'])
+        return observed
+
+    def service_revert(self, reply_loss=False):
+        originals = []
+        for vid in self.volumes:
+            aid = objects.Volume.get_by_id(
+                self.ctxt, vid).volume_attachment[0].id
+            originals.append(aid)
+            self.attachment_request('delete', vid, aid, reply_loss)
+        self.service_action('execute')
+        self.wait_service('succeeded')
+        for vid in self.volumes:
+            created = self.attachment_request(
+                'create', vid, reply_loss=reply_loss)
+            aid = created['attachment_id']
+            self.assertNotIn(aid, originals)
+            self.attachment_request('update', vid, aid, reply_loss)
+            response = self.request_with_token(
+                self.valid_service_token, 'GET',
+                self.service_path + '/attachments/' + aid)
+            self.assertEqual(200, response.status_int, response.text)
+            self.assertIsInstance(
+                response.json['attachment']['connection_info'], dict)
+            self.attachment_request('complete', vid, aid, reply_loss)
+        self.service_action('release', 'commit')
+
+    def serialized_journals(self):
+        with sqla_api.main_context_manager.reader.using(self.ctxt):
+            return str({model.__tablename__: [dict(row) for row in
+                       self.ctxt.session.query(model).all()]
+                        for model in (models.CheckpointOperation,
+                                      models.CheckpointStep,
+                                      models.CheckpointContinuationGrant,
+                                      models.CheckpointAttachmentIntent)})
+
+
+def serve_fixture(bind_host, port, ready_path):
+    fixture = ContinuationFunctionalBase()
+    listener = None
+    try:
+        fixture.setUp()
+        listener = eventlet.listen((bind_host, port))
+        host, selected_port = listener.getsockname()[:2]
+        manifest = {
+            'endpoint': 'http://%s:%s/v3' % (host, selected_port),
+            'user_token': fixture.user_token,
+            'service_token': fixture.valid_service_token,
+            'foreign_service_token': fixture.foreign_service_token,
+            'owner_project_id': fixture.ctxt.project_id,
+            'actor_user_id': fixture.actor_id,
+            'executor_service_user_id': fixture.executor_id,
+            'service_project_id': fixture.service_project,
+            'instance_uuid': fixture.instance, 'volume_ids': fixture.volumes,
+        }
+        Path(ready_path).write_text(json.dumps(manifest))
+
+        def terminate(signum, frame):
+            raise SystemExit(0)
+
+        signal.signal(signal.SIGTERM, terminate)
+        eventlet_wsgi.server(listener, fixture.authenticated_app,
+                             log_output=False)
+    finally:
+        if listener:
+            listener.close()
+        fixture.tearDown()
+        fixture.doCleanups()
+
+
+if __name__ == '__main__':
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--host', default='127.0.0.1')
+    parser.add_argument('--port', type=int, default=0)
+    parser.add_argument('--ready', required=True)
+    args = parser.parse_args()
+    serve_fixture(args.host, args.port, args.ready)
