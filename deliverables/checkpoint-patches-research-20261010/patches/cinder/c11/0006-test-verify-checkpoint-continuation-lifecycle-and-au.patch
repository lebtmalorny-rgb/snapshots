+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import time
+from urllib import request as http
+
+from oslo_utils import uuidutils
+
+from cinder import db
+from cinder.tests.functional.checkpoint_continuation_fixture import (  # noqa
+    ContinuationFunctionalBase)
+from cinder.tests.unit import test
+
+
+class TestCheckpointContinuation(ContinuationFunctionalBase):
+    def test_expired_user_restart_service_completes_same_operation(self):
+        accepted = self.reserve_with_dual_tokens()
+        self.token_server.expire_user_token()
+        self.restart_api_and_workers()
+        response = self.request_with_token(
+            self.valid_service_token, 'GET', self.service_path)
+        operation = response.json['checkpoint_operation']
+        self.assertEqual(200, response.status_int, response.text)
+        self.assertEqual(accepted['id'], operation['id'])
+        self.assertEqual(self.actor_id,
+                         operation['continuation']['actor_user_id'])
+        self.service_action('execute')
+        self.wait_service('succeeded')
+        self.service_action('reconcile')
+        self.service_action('release', 'commit')
+        self.assertEqual(2, self.native_count())
+        self.assertEqual([], self.locks())
+        self.assertNotIn(self.user_token, self.serialized_journals())
+        self.assertNotIn(self.valid_service_token, self.serialized_journals())
+        denied = self.request_with_token(
+            self.user_token, 'POST', '/checkpoint-operations',
+            self.reserve_body)
+        self.assertEqual(401, denied.status_int, denied.text)
+
+    def test_service_only_missing_grant_cannot_reserve(self):
+        self.reserve_with_dual_tokens()
+        response = self.request_with_token(
+            self.valid_service_token, 'POST', '/checkpoint-operations',
+            self.reserve_body)
+        self.assertEqual(403, response.status_int, response.text)
+        response = self.request_with_token(
+            self.valid_service_token, 'GET',
+            '/checkpoint-service-operations/' + uuidutils.generate_uuid())
+        self.assertEqual(404, response.status_int, response.text)
+
+    def test_attachment_response_loss_full_revert(self):
+        self.data(b'point-A')
+        checkpoint = self.service_checkpoint()
+        self.data(b'current')
+        self.reserve_with_dual_tokens('revert', checkpoint['checkpoint_id'])
+        self.token_server.expire_user_token()
+        self.service_revert(reply_loss=True)
+        self.assertEqual([b'point-A'] * 2,
+                         [self.drivers[v].data[v] for v in self.volumes])
+        self.assertEqual([], self.locks())
+        self.assertEqual(4, self.native_count())
+        self.assertNotIn('auth_password', self.serialized_journals())
+        for driver in self.drivers.values():
+            self.assertEqual(1, driver.initialize_connection.call_count)
+            self.assertEqual(1, driver.terminate_connection.call_count)
+
+    def test_create_delete_two_backends_keep_other_checkpoint(self):
+        self.data(b'point-A')
+        first = self.service_checkpoint()
+        self.data(b'point-B')
+        second = self.service_checkpoint()
+        self.data(b'current')
+        self.reserve_with_dual_tokens('delete', first['checkpoint_id'])
+        self.service_action('execute')
+        self.wait_service('succeeded')
+        self.service_action('release', 'commit')
+        self.assertEqual([b'current'] * 2,
+                         [self.drivers[v].data[v] for v in self.volumes])
+        self.assertEqual({r['snapshot_id'] for r in second['resources']},
+                         {sid for d in self.drivers.values()
+                          for sid in d.snapshots})
+        self.assertEqual(2, db.quota_usage_get_all_by_project(
+            self.ctxt.elevated(), self.ctxt.project_id)['snapshots']['in_use'])
+
+
+class TestContinuationHTTPFixture(test.TestCase):
+    def test_separate_process_serves_actual_authenticated_cinder(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            ready = Path(temporary) / 'ready.json'
+            log = Path(temporary) / 'server.log'
+            with log.open('w') as output:
+                process = subprocess.Popen([
+                    sys.executable, '-m',
+                    'cinder.tests.functional.checkpoint_continuation_fixture',
+                    '--ready', str(ready)], stdout=output,
+                    stderr=subprocess.STDOUT, env=dict(os.environ))
+                try:
+                    deadline = time.monotonic() + 30
+                    while not ready.exists() and time.monotonic() < deadline:
+                        if process.poll() is not None:
+                            self.fail(log.read_text())
+                        time.sleep(0.02)
+                    self.assertTrue(ready.exists(), log.read_text())
+                    fixture = json.loads(ready.read_text())
+                    nova_id = uuidutils.generate_uuid()
+                    body = {'checkpoint_operation': {
+                        'request_id': uuidutils.generate_uuid(),
+                        'checkpoint_id': uuidutils.generate_uuid(),
+                        'instance_uuid': fixture['instance_uuid'],
+                        'volume_ids': fixture['volume_ids'], 'kind': 'create',
+                        'nova_operation_id': nova_id,
+                        'allow_service_continuation': True}}
+                    headers = {'Content-Type': 'application/json',
+                               'OpenStack-API-Version': 'volume 3.73',
+                               'X-Auth-Token': fixture['user_token'],
+                               'X-Service-Token': fixture['service_token']}
+                    url = fixture['endpoint'] + '/checkpoint-operations'
+                    with http.urlopen(http.Request(
+                            url, json.dumps(body).encode(), headers),
+                            timeout=10) as response:
+                        self.assertEqual(202, response.status)
+                        accepted = json.load(response)['checkpoint_operation']
+                    headers['X-Auth-Token'] = fixture['service_token']
+                    headers.pop('X-Service-Token')
+                    url = (fixture['endpoint'] +
+                           '/checkpoint-service-operations/' + nova_id)
+                    with http.urlopen(http.Request(url, headers=headers),
+                                      timeout=10) as response:
+                        operation = json.load(response)['checkpoint_operation']
+                    self.assertEqual(accepted['id'], operation['id'])
+                    self.assertEqual(
+                        fixture['actor_user_id'],
+                        operation['continuation']['actor_user_id'])
+                finally:
+                    process.terminate()
+                    try:
+                        process.wait(timeout=15)
+                    except subprocess.TimeoutExpired:
+                        process.kill()
+                        process.wait(timeout=5)
+                self.assertEqual(0, process.returncode, log.read_text())
