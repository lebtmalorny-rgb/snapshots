+            self.service_ctx, self.scope, self.original[0])
+        self.assertEqual(expected, attachment['connection_info'])
+        self.assertEqual(self.volumes[0], attachment['volume_id'])
+        result = self.submit(self.request_for('delete', self.original[0]))
+        self.assertNotIn('test-sensitive', str(result.to_primitive()))
+        self.assertRaises(exception.CheckpointOperationNotFound,
+                          self.intents.get_attachment, self.service_ctx,
+                          self.scope, uuids.foreign_attachment)
+
