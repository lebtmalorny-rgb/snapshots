+
+"""Durable attachment intent submission, separated from backend dispatch."""
+
+import json
+
+from cinder.checkpoints import continuation_contracts as contracts
+from cinder import db
+
+
+class AttachmentIntents:
+    def submit(self, context, scope, request):
+        return contracts.AttachmentResult.from_primitive(
+            db.checkpoint_attachment_intent_prepare(
+                context, scope.to_primitive(), request.to_primitive()))
+
+    def get(self, context, scope, child_id):
+        return contracts.AttachmentResult.from_primitive(
+            db.checkpoint_attachment_intent_get(
+                context, scope.to_primitive(), child_id))
+
+    def get_attachment(self, context, scope, attachment_id):
+        row = db.checkpoint_continuation_attachment(
+            context, scope.to_primitive(), attachment_id)
+        # Match the stock Cinder attachment detail names without constructing
+        # VolumeAttachment OVO, whose loader may run an online data migration.
+        return dict(id=row['id'], volume_id=row['volume_id'],
+                    instance=row['instance_uuid'], status=row['attach_status'],
+                    attach_mode=row['attach_mode'],
+                    attached_at=row['attach_time'],
+                    detached_at=row['detach_time'],
+                    connection_info=json.loads(row['connection_info'])
+                    if row['connection_info'] else None)
