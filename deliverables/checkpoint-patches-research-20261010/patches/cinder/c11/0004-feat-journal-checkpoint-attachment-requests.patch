+class AttachmentRaceTests(AttachmentHelpers,
+                          test_continuation_db.ContinuationRaceSetup):
+    def setUp(self):
+        super().setUp()
+        self.prepare_attachments()
+        self.enter_reconnect()
+
+    def test_two_sessions_create_exactly_one_attachment(self):
+        gate = eventlet.event.Event()
+
+        def create():
+            ctxt = self.service_ctx.deepcopy()
+            gate.wait()
+            return self.intents.submit(ctxt, self.scope, self.create_request)
+
+        tasks = [eventlet.spawn(create) for unused in range(2)]
+        gate.send()
+        self.assertEqual(tasks[0].wait().attachment_id,
+                         tasks[1].wait().attachment_id)
+        self.assertEqual(1, self.count_volume_attachments(self.volumes[0]))
+        self.assertEqual(1, self.count_attachment_intents('create'))
+
