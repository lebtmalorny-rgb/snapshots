diff --git a/cinder/db/sqlalchemy/checkpoint_continuation.py b/cinder/db/sqlalchemy/checkpoint_continuation.py
index ad9794f..33ce102 100644
--- a/cinder/db/sqlalchemy/checkpoint_continuation.py
+++ b/cinder/db/sqlalchemy/checkpoint_continuation.py
@@ -14,6 +14,7 @@
 
 import json
 
+from oslo_db import api as oslo_db_api
 from oslo_utils import uuidutils
 
 from cinder.checkpoints import continuation
@@ -207,3 +208,229 @@ def transition(context, nova_operation_id, generation, action, outcome=None):
         project_id=authorized.owner_project_id).one()
     return journal._release(context, operation, instance,
                             _volumes(context, authorized), outcome)
+
+
+def _checked_scope(context, primitive, action='attachment'):
+    supplied = contracts.ContinuationScope.from_primitive(primitive)
+    current = _scope(context, supplied.nova_operation_id,
+                     supplied.generation, action)
+    if supplied != current:
+        raise exception.CheckpointOperationNotFound()
+    return current
+
+
+def _intent(context, scope, child_id):
+    row = journal._current(journal._query(
+        context, models.CheckpointAttachmentIntent).filter_by(
+            id=child_id, operation_id=scope.operation_id,
+            generation=scope.generation)).first()
+    if row is None or row.volume_id not in scope.volume_ids:
+        raise exception.CheckpointOperationNotFound()
+    return row
+
+
+def _result(row):
+    return contracts.AttachmentResult(
+        id=row.id, operation_id=row.operation_id, generation=row.generation,
+        volume_id=row.volume_id, action=row.action, status=row.status,
+        attachment_id=row.result_attachment_id or row.target_attachment_id,
+        error_code=row.error_code).to_primitive()
+
+
+def _cycle(context, scope, volume_id, action):
+    return journal._query(
+        context, models.CheckpointAttachmentIntent).filter_by(
+        operation_id=scope.operation_id, generation=scope.generation,
+        volume_id=volume_id, action=action).first()
+
+
+def _attachment_scope(context, scope, volume_id, action, attachment_id=None):
+    if scope.kind != 'revert' or volume_id not in scope.volume_ids:
+        raise exception.CheckpointOperationNotFound()
+    steps = journal._steps(context, scope.operation_id)
+    if steps and all(step.status == 'prepared' for step in steps):
+        stage = 'disconnect'
+    elif steps and all(step.status == 'succeeded' for step in steps):
+        stage = 'reconnect'
+    else:
+        journal._conflict('attachment_phase_not_ready')
+    expected = ('disconnect' if action == 'delete' else 'reconnect')
+    if action != 'read' and stage != expected:
+        journal._conflict('attachment_phase_not_ready')
+    volume = journal._query(context, models.Volume).filter_by(
+        id=volume_id, project_id=scope.owner_project_id).one()
+    if action == 'create':
+        if volume.status != 'available' or journal._attachments(
+                context, volume_id):
+            journal._conflict('attachment_conflict')
+        return volume, None
+    row = journal._current(journal._query(
+        context, models.VolumeAttachment).filter_by(
+            id=attachment_id, volume_id=volume_id,
+            instance_uuid=scope.instance_uuid)).first()
+    if row is None:
+        raise exception.CheckpointOperationNotFound()
+    if stage == 'disconnect':
+        resource = next(resource for resource in journal._resources(
+            context, scope.checkpoint_id) if resource.volume_id == volume_id)
+        step = next(step for step in steps if step.resource_id == resource.id)
+        if row.id not in json.loads(step.original_attachment_ids_json):
+            raise exception.CheckpointOperationNotFound()
+    else:
+        created = _cycle(context, scope, volume_id, 'create')
+        if (created is None or created.status != 'succeeded' or
+                created.result_attachment_id != row.id):
+            raise exception.CheckpointOperationNotFound()
+    return volume, row
+
+
+@api.require_context
+@oslo_db_api.wrap_db_retry(
+    max_retries=5, retry_on_deadlock=True, exception_checker=api._is_duplicate)
+@api.main_context_manager.writer
+def attachment_prepare(context, scope, request):
+    scope = _checked_scope(context, scope)
+    request = contracts.AttachmentRequest.from_primitive(request)
+    if (request.generation != scope.generation or
+            request.volume_id not in scope.volume_ids):
+        raise exception.CheckpointOperationNotFound()
+    payload_hash = contracts.body_hash(request.to_primitive())
+    previous = journal._current(journal._query(
+        context, models.CheckpointAttachmentIntent).filter_by(
+            id=request.id)).first()
+    if previous is not None:
+        if previous.operation_id != scope.operation_id:
+            raise exception.CheckpointOperationNotFound()
+        if previous.request_hash != payload_hash:
+            journal._conflict('request_payload_changed')
+        return _result(previous)
+    if _cycle(context, scope, request.volume_id, request.action) is not None:
+        journal._conflict('attachment_action_already_registered')
+    volume, attachment = _attachment_scope(
+        context, scope, request.volume_id, request.action,
+        request.attachment_id)
+    if request.action == 'complete':
+        updated = _cycle(context, scope, request.volume_id, 'update')
+        if (updated is None or updated.status != 'succeeded' or
+                updated.target_attachment_id != attachment.id or
+                attachment.attach_status != 'attaching' or
+                not attachment.connection_info):
+            journal._conflict('attachment_connection_not_confirmed')
+    row = models.CheckpointAttachmentIntent(
+        id=request.id, operation_id=scope.operation_id,
+        generation=scope.generation, volume_id=request.volume_id,
+        action=request.action, request_hash=payload_hash,
+        target_attachment_id=request.attachment_id,
+        connector_json=json.dumps(request.to_primitive()['connector'],
+                                  sort_keys=True)
+        if request.connector is not None else None,
+        mountpoint=request.mountpoint, status='prepared')
+    context.session.add(row)
+    if request.action == 'create':
+        volume.status = 'reserved'
+        attachment = api._attachment_insert(context, {
+            'id': uuidutils.generate_uuid(), 'volume_id': volume.id,
+            'instance_uuid': scope.instance_uuid, 'attach_status': 'reserved',
+            'attach_mode': 'rw'})
+        row.result_attachment_id = attachment.id
+        row.status = 'succeeded'
+    elif request.action == 'complete':
+        attachment.attach_status = 'attached'
+        volume.status = 'in-use'
+        volume.attach_status = 'attached'
+        row.result_attachment_id = attachment.id
+        row.status = 'succeeded'
+    context.session.flush()
+    return _result(row)
+
+
+@api.require_context
+@api.main_context_manager.writer
+def attachment_get(context, scope, child_id):
+    scope = _checked_scope(context, scope, 'read')
+    return _result(_intent(context, scope, child_id))
+
+
+def _intent_scope(context, child_id):
+    executor = continuation.require_executor(context)
+    row = journal._query(context, models.CheckpointAttachmentIntent).filter_by(
+        id=child_id).first()
+    if row is None:
+        raise exception.CheckpointOperationNotFound()
+    grant = journal._query(
+        context, models.CheckpointContinuationGrant).filter_by(
+            operation_id=row.operation_id,
+            executor_service_user_id=executor).first()
+    if grant is None:
+        raise exception.CheckpointOperationNotFound()
+    scope = _scope(context, grant.nova_operation_id, row.generation,
+                   'attachment')
+    return scope, _intent(context, scope, child_id)
+
+
+@api.require_context
+@api.main_context_manager.writer
+def attachment_claim(context, child_id, executor_id):
+    scope, row = _intent_scope(context, child_id)
+    if row.status != 'prepared':
+        return None
+    volume, attachment = _attachment_scope(
+        context, scope, row.volume_id, row.action, row.target_attachment_id)
+    if (not isinstance(executor_id, str) or not executor_id or
+            len(executor_id) > 255 or
+            volume.host.split('#')[0] != executor_id.split('#')[0]):
+        journal._conflict('wrong_attachment_executor')
+    row.executor_id = executor_id
+    row.status = 'dispatching'
+    context.session.flush()
+    return dict(row)
+
+
+@api.require_context
+@api.main_context_manager.writer
+def attachment_finish(context, child_id, result):
+    scope, row = _intent_scope(context, child_id)
+    result = contracts.AttachmentResult.from_primitive(result)
+    expected = contracts.AttachmentResult.from_primitive(_result(row))
+    if any(getattr(result, key) != getattr(expected, key) for key in (
+            'id', 'operation_id', 'generation', 'volume_id', 'action',
+            'attachment_id')):
+        journal._conflict('attachment_result_scope_changed')
+    if row.status in ('succeeded', 'failed_no_effect'):
+        if result != expected:
+            journal._conflict('terminal_attachment_result_changed')
+        return _result(row)
+    if (row.status == 'prepared' or
+            result.status not in ('pending', 'unknown', 'failed_no_effect')):
+        journal._conflict('attachment_result_not_confirmed')
+    row.status, row.error_code = result.status, result.error_code
+    context.session.flush()
+    return _result(row)
+
+
+@api.require_context
+@api.main_context_manager.writer
+def current_attachment(context, scope, attachment_id):
+    scope = _checked_scope(context, scope)
+    row = journal._query(context, models.VolumeAttachment).filter_by(
+        id=attachment_id, instance_uuid=scope.instance_uuid).first()
+    if row is None or row.volume_id not in scope.volume_ids:
+        raise exception.CheckpointOperationNotFound()
+    volume, row = _attachment_scope(context, scope, row.volume_id,
+                                    'read', attachment_id)
+    # Do not instantiate an attachment OVO here: its loader mutates old specs.
+    return dict(row)
+
+
+def check_attachment_release(context, operation):
+    intents = journal._current(journal._query(
+        context, models.CheckpointAttachmentIntent).filter_by(
+            operation_id=operation.id)).all()
+    if any(row.status not in ('succeeded', 'failed_no_effect')
+           for row in intents):
+        journal._conflict('attachment_result_not_confirmed')
+    completed = {row.volume_id for row in intents
+                 if row.action == 'complete' and row.status == 'succeeded'}
+    if any(row.action == 'create' and row.status == 'succeeded' and
+           row.volume_id not in completed for row in intents):
+        journal._conflict('attachment_complete_required')
