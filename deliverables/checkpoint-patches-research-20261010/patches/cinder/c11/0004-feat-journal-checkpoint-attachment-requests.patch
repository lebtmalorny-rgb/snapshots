+                          dataclasses.replace(self.create_request,
+                                              id=uuids.another_child))
+        self.assertEqual(1, self.count_volume_attachments(self.volumes[0]))
+
+    def test_reconnect_waits_for_all_disk_results(self):
+        self.assertRaises(exception.CheckpointConflict, self.submit,
+                          self.create_request)
+        self.assertEqual(0, self.count_attachment_intents('create'))
+
+    def test_disconnect_accepts_only_original_attachment(self):
+        wrong = self.request_for('delete', self.original[1])
+        self.assertRaises(exception.CheckpointOperationNotFound,
+                          self.submit, wrong)
+        request = self.request_for('delete', self.original[0])
