+class AttachmentHelpers:
+    def prepare_attachments(self):
+        legacy = {key: value for key, value in self.payload.items()
+                  if key not in ('nova_operation_id',
+                                 'allow_service_continuation')}
+        create = self.api.reserve(self.ctxt, legacy)
+        self.succeed(db.checkpoint_get(self.ctxt, create.id))
+        db.checkpoint_release(self.ctxt, create.id, 1, 'commit')
+        self.payload.update(kind='revert', request_id=uuids.revert_request,
+                            nova_operation_id=uuids.nova_operation,
+                            allow_service_continuation=True)
+        self.operation = self.api.reserve_with_continuation(
+            self.ctxt, self.payload)
+        self.service_ctx = context.RequestContext(
+            test_db.SERVICE_ID, uuids.service_project,
+            roles=['service'], is_admin=False)
+        self.scope = continuation.authorize(
+            self.service_ctx, uuids.nova_operation, 1, 'attachment')
+        self.intents = attachment_intents.AttachmentIntents()
+        self.original = [objects.Volume.get_by_id(
+            self.ctxt, vid).volume_attachment[0].id for vid in self.volumes]
+        self.create_request = contracts.validate_attachment(
+            test_continuation_contracts.attachment_request(
+                volume_id=self.volumes[0]))
+
+    def enter_reconnect(self):
+        # DB fixture models a confirmed disconnect; the original scoped HTTP
+        # workflow and driver effects are exercised in test_attachment_scope.
+        with sqla_api.main_context_manager.writer.using(self.ctxt):
+            self.ctxt.session.query(models.VolumeAttachment).filter(
+                models.VolumeAttachment.volume_id.in_(self.volumes)).update(
+                    {'deleted': True}, synchronize_session=False)
+            self.ctxt.session.query(models.Volume).filter(
+                models.Volume.id.in_(self.volumes)).update(
+                    {'status': 'available', 'attach_status': 'detached'},
+                    synchronize_session=False)
+        self.succeed(db.checkpoint_get(self.ctxt, self.operation.id))
+
+    def count_volume_attachments(self, volume_id):
+        with sqla_api.main_context_manager.reader.using(self.ctxt):
+            return self.ctxt.session.query(models.VolumeAttachment).filter_by(
+                volume_id=volume_id, deleted=False).count()
+
+    def count_attachment_intents(self, action):
+        with sqla_api.main_context_manager.reader.using(self.ctxt):
+            return self.ctxt.session.query(
+                models.CheckpointAttachmentIntent).filter_by(
+                    operation_id=self.operation.id, action=action).count()
+
+    def submit(self, request):
+        return self.intents.submit(self.service_ctx, self.scope, request)
+
+    def request_for(self, action, attachment_id, **changes):
+        values = test_continuation_contracts.attachment_request(
+            id=getattr(uuids, action + '_child'), action=action,
+            attachment_id=attachment_id, volume_id=self.volumes[0], **changes)
+        return contracts.validate_attachment(values)
