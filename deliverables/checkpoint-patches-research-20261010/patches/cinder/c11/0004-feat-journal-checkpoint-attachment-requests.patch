+    def test_unknown_delete_holds_lock_and_cannot_be_claimed_again(self):
+        result = self.submit(self.request_for('delete', self.original[0]))
+        host = objects.Volume.get_by_id(self.ctxt, self.volumes[0]).host
+        self.assertIsNotNone(db.checkpoint_attachment_intent_claim(
+            self.service_ctx, result.id, host))
+        unknown = dataclasses.replace(result, status='unknown',
+                                      error_code='attachment_result_unknown')
+        db.checkpoint_attachment_intent_finish(
+            self.service_ctx, result.id, unknown.to_primitive())
+        self.assertIsNone(db.checkpoint_attachment_intent_claim(
+            self.service_ctx, result.id, host))
+        self.assertEqual('unknown', self.intents.get(
+            self.service_ctx, self.scope, result.id).status)
+        self.assertRaises(exception.CheckpointConflict,
+                          db.checkpoint_continuation_transition,
+                          self.service_ctx, uuids.nova_operation, 1,
+                          'release', 'abort')
+        self.assertEqual(2, len(self.locks()))
+
+    def test_forged_scope_does_not_reserve_attachment(self):
+        self.enter_reconnect()
+        forged = dataclasses.replace(self.scope, actor_user_id=uuids.attacker)
+        self.assertRaises(exception.CheckpointOperationNotFound,
+                          self.intents.submit, self.service_ctx, forged,
+                          self.create_request)
+        self.assertEqual(0, self.count_volume_attachments(self.volumes[0]))
+
+    def test_attachment_current_read_is_scoped_and_transient(self):
+        expected = {'driver_volume_type': 'fake', 'secret': 'test-sensitive'}
+        with sqla_api.main_context_manager.writer.using(self.ctxt):
+            row = self.ctxt.session.query(models.VolumeAttachment).filter_by(
+                id=self.original[0]).one()
+            row.connection_info = json.dumps(expected)
