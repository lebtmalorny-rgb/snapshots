+    def test_changed_connector_does_not_create_second_intent(self):
+        self.enter_reconnect()
+        attachment_id = self.submit(self.create_request).attachment_id
+        request = self.request_for('update', attachment_id,
+                                   connector={'host': 'compute-one'})
+        accepted = self.submit(request)
+        self.assertEqual('prepared', accepted.status)
+        changed = dataclasses.replace(request,
+                                      connector={'host': 'other-compute'})
+        self.assertRaises(exception.CheckpointConflict, self.submit, changed)
+        observed = self.intents.get(self.service_ctx, self.scope, accepted.id)
+        self.assertEqual(accepted.id, observed.id)
+        self.assertEqual(1, self.count_attachment_intents('update'))
+
+    def test_new_id_for_same_action_is_rejected(self):
+        self.enter_reconnect()
