+    def test_create_reply_loss_reuses_attachment(self):
+        self.enter_reconnect()
+        first = self.submit(self.create_request)
+        replay = self.submit(self.create_request)
+        self.assertEqual('succeeded', first.status)
+        self.assertEqual(first.attachment_id, replay.attachment_id)
+        self.assertEqual(1, self.count_volume_attachments(first.volume_id))
+        self.assertEqual(1, self.count_attachment_intents('create'))
+        volume = objects.Volume.get_by_id(self.ctxt, first.volume_id)
+        self.assertEqual('reserved', volume.status)
+        self.assertEqual(self.instance,
+                         volume.volume_attachment[0].instance_uuid)
