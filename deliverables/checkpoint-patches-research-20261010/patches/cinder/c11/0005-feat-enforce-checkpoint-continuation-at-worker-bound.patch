     if any(row.action == 'create' and row.status == 'succeeded' and
            row.volume_id not in completed for row in intents):
         journal._conflict('attachment_complete_required')
+
+
+def check_legacy_grant(context, operation):
+    grant = journal._current(journal._query(
+        context, models.CheckpointContinuationGrant).filter_by(
+            id=operation.continuation_id, operation_id=operation.id)).first()
+    _bound_operation(context, grant)
+
+
+def _volume_data(row):
+    data = dict(row)
+    for name in ('volume_metadata', 'volume_admin_metadata',
+                 'volume_glance_metadata'):
+        data[name] = [dict(item) for item in getattr(row, name)
+                      if not item.deleted]
+    if row.volume_type is not None:
+        data['volume_type'] = dict(row.volume_type)
+        data['volume_type']['extra_specs'] = [
+            dict(item) for item in row.volume_type.extra_specs
+            if not item.deleted]
+    return data
+
+
+@api.require_context
+@api.main_context_manager.writer
+def resources(context, scope):
+    scope = _checked_scope(context, scope, 'capabilities')
+    volumes = {row.id: _volume_data(row) for row in _volumes(context, scope)}
+    snapshots = {}
+    for resource in journal._resources(context, scope.checkpoint_id):
+        row = journal._query(context, models.Snapshot).filter_by(
+            id=resource.snapshot_id, volume_id=resource.volume_id,
+            project_id=scope.owner_project_id).first()
+        if row is None:
+            continue
+        snapshots[row.id] = dict(row)
+        snapshots[row.id]['snapshot_metadata'] = [dict(item) for item in
+                                                  row.snapshot_metadata
+                                                  if not item.deleted]
+    return {'volumes': volumes, 'snapshots': snapshots}
+
+
+def _bound_step(context, scope, step_id):
+    step = journal._current(journal._query(
+        context, models.CheckpointStep).filter_by(
+            id=step_id, operation_id=scope.operation_id,
+            generation=scope.generation)).first()
+    if step is None:
+        raise exception.CheckpointOperationNotFound()
+    operation = journal._query(context, models.CheckpointOperation).filter_by(
+        id=scope.operation_id).one()
+    return step, operation
+
+
+@api.require_context
+@api.main_context_manager.writer
+def step_claim(context, scope, step_id, executor_id):
+    scope = _checked_scope(context, scope, 'execute')
+    step, operation = _bound_step(context, scope, step_id)
+    resource = journal._query(context, models.CheckpointResource).filter_by(
+        id=step.resource_id, checkpoint_id=scope.checkpoint_id).one()
+    volume = journal._query(context, models.Volume).filter_by(
+        id=resource.volume_id, project_id=scope.owner_project_id).one()
+    if (not isinstance(executor_id, str) or
+            volume.host.split('#')[0] != executor_id.split('#')[0]):
+        journal._conflict('wrong_backend_worker')
+    return journal._step_claim(context, step, operation, executor_id)
+
+
+@api.require_context
+@api.main_context_manager.writer
+def step_finish(context, scope, step_id, result):
+    scope = _checked_scope(context, scope, 'reconcile')
+    step, operation = _bound_step(context, scope, step_id)
+    return journal._step_finish(context, step, operation, result)
+
+
+def _dispatched_attachment(context, scope, child_id, executor_id):
+    scope = _checked_scope(context, scope)
+    row = _intent(context, scope, child_id)
+    if row.status != 'dispatching' or row.executor_id != executor_id:
+        journal._conflict('attachment_not_dispatched')
+    volume, attachment = _attachment_scope(
+        context, scope, row.volume_id, row.action, row.target_attachment_id)
+    if volume.host.split('#')[0] != executor_id.split('#')[0]:
+        journal._conflict('wrong_backend_worker')
+    return row, volume, attachment
+
+
+@api.require_context
+@api.main_context_manager.writer
+def export_update(context, scope, child_id, executor_id, values):
+    row, volume, attachment = _dispatched_attachment(
+        context, scope, child_id, executor_id)
+    # Export providers may update these normal volume fields. Never accept
+    # generic model updates that could change ownership or admission state.
+    if (row.action != 'update' or not isinstance(values, dict) or
+            set(values) - {'provider_location', 'provider_auth', 'provider_id'}
+            or any(value is not None and not isinstance(value, str)
+                   for value in values.values())):
+        raise exception.InvalidInput(reason='invalid_export_update')
+    volume.update(values)
+    context.session.flush()
+    return _volume_data(volume)
+
+
+@api.require_context
+@api.main_context_manager.writer
+def attachment_success(context, scope, child_id, executor_id,
+                       connection_info=None):
+    row, volume, attachment = _dispatched_attachment(
+        context, scope, child_id, executor_id)
+    if row.action == 'update':
+        if (not isinstance(connection_info, dict) or
+                not connection_info.get('driver_volume_type')):
+            raise exception.InvalidInput(reason='invalid_connection_info')
+        attachment.connection_info = json.dumps(connection_info,
+                                                allow_nan=False)
+        attachment.connector = row.connector_json
+        attachment.mountpoint = row.mountpoint
+        attachment.attached_host = json.loads(row.connector_json).get('host')
+        attachment.attach_status = 'attaching'
+        attachment.attach_time = timeutils.utcnow()
+        volume.attach_status = 'attaching'
+    elif row.action == 'delete' and connection_info is None:
+        attachment.deleted = True
+        attachment.deleted_at = timeutils.utcnow()
+        attachment.detach_time = timeutils.utcnow()
+        attachment.attach_status = 'detached'
+        attachment.connection_info = None
+        attachment.connector = None
+        volume.status = 'available'
+        volume.attach_status = 'detached'
+    else:
+        raise exception.InvalidInput(reason='invalid_attachment_action')
+    row.status = 'succeeded'
+    row.error_code = None
+    row.result_attachment_id = attachment.id
+    context.session.flush()
+    return _result(row)
