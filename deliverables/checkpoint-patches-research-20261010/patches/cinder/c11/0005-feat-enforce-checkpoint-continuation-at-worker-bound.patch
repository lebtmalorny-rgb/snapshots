+class WorkerHelpers(test_continuation_db.ContinuationHelpers):
+    def prepare_workers(self):
+        self.prepare_continuation()
+        self.owners = []
+        self.workers = []
+        for index, vid in enumerate(self.volumes):
+            driver = fake_driver.FakeCheckpointDriver()
+            driver.set_initialized()
+            owner = SimpleNamespace(driver=driver,
+                                    host='worker%d@backend' % index)
+            owner._parse_connection_options = (
+                lambda ctx, vol, conn, owner=owner:
+                volume_manager.VolumeManager._parse_connection_options(
+                    owner, ctx, vol, conn))
+            db.volume_update(self.ctxt, vid, {'host': owner.host})
+            self.owners.append(owner)
+            self.workers.append(
+                continuation_manager.ContinuationManager(owner))
+        self.worker = self.workers[0]
+        self.driver = self.owners[0].driver
+        self.service_ctx.checkpoint_continuation_id = uuids.nova_operation
+        self.service_ctx = context.RequestContext.from_dict(
+            self.service_ctx.to_dict())
+
+    def revoke_grant(self):
+        with sqla_api.main_context_manager.writer.using(self.ctxt):
+            self.ctxt.session.query(models.CheckpointContinuationGrant).filter(
+                models.CheckpointContinuationGrant.nova_operation_id ==
+                uuids.nova_operation).update({'state': 'revoked',
+                                              'revision': 2})
+
