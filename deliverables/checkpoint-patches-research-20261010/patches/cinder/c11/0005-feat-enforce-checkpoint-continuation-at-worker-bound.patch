diff --git a/cinder/checkpoints/continuation_manager.py b/cinder/checkpoints/continuation_manager.py
new file mode 100644
index 0000000..31b4f59
--- /dev/null
+++ b/cinder/checkpoints/continuation_manager.py
@@ -0,0 +1,228 @@
+# Licensed under the Apache License, Version 2.0 (the "License"); you may
+# not use this file except in compliance with the License. You may obtain
+# a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+# WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+# License for the specific language governing permissions and limitations
+# under the License.
+
+"""Grant-checked workers; backend effects are dispatched at most once."""
+
+import dataclasses
+import json
+
+from cinder.checkpoints import continuation
+from cinder.checkpoints import continuation_contracts as envelopes
+from cinder.checkpoints import contracts
+from cinder import db
+from cinder import exception
+from cinder import objects
+from cinder.volume import volume_utils
+
+
+class ContinuationManager:
+    def __init__(self, volume_manager):
+        self.owner = volume_manager
+
+    def _scope(self, context, nova_operation_id, generation, action):
+        reference = context.checkpoint_continuation_id
+        if reference is not None and reference != nova_operation_id:
+            raise exception.CheckpointOperationNotFound()
+        return continuation.authorize(context, nova_operation_id, generation,
+                                      action)
+
+    def _volume(self, context, scope, volume_id, data=None):
+        if data is None:
+            data = db.checkpoint_continuation_resources(
+                context, scope.to_primitive())
+        row = data['volumes'].get(volume_id)
+        if row is None:
+            raise exception.CheckpointOperationNotFound()
+        if (volume_utils.extract_host(row['host'] or '') !=
+                volume_utils.extract_host(self.owner.host)):
+            raise exception.CheckpointConflict(reason='wrong_backend_worker')
+        if not self.owner.driver.initialized:
+            raise exception.CheckpointBackendUnavailable()
+        volume = objects.Volume._from_db_object(
+            context, objects.Volume(context), row,
+            expected_attrs=['metadata', 'volume_type',
+                            'volume_type.extra_specs', 'glance_metadata'])
+        # The stock admin-metadata loader may delete a legacy temporary key.
+        # Read the explicit scoped data without invoking that migration.
+        volume.admin_metadata = {item['key']: item['value'] for item in
+                                 row['volume_admin_metadata']}
+        if row.get('volume_type') is None:
+            volume.volume_type = None
+        volume.obj_reset_changes()
+        return volume
+
+    def capabilities(self, context, nova_operation_id, volume_id):
+        scope = self._scope(context, nova_operation_id, 1, 'capabilities')
+        volume = self._volume(context, scope, volume_id)
+        return self._capabilities(context, volume)
+
+    def _capabilities(self, context, volume):
+        try:
+            return contracts.validate_capabilities(
+                self.owner.driver.get_checkpoint_capabilities(context, volume))
+        except Exception:
+            return contracts.unsupported_capabilities(
+                'unverified_capabilities')
+
+    def _preflight(self, context, scope, volume, resource):
+        current = contracts.validate_capabilities(
+            self._capabilities(context, volume))
+        saved = json.loads(resource['capabilities_json'])
+        if current['driver_identity'] != saved['driver_identity']:
+            raise exception.CheckpointConflict(reason='driver_profile_changed')
+        if volume.size != resource['volume_size']:
+            raise exception.CheckpointConflict(reason='snapshot_mismatch')
+
+    def _run(self, context, nova_operation_id, generation, query):
+        action = 'reconcile' if query else 'execute'
+        scope = self._scope(context, nova_operation_id, generation, action)
+        operation = db.checkpoint_continuation_get(
+            context, nova_operation_id)['operation']
+        data = db.checkpoint_continuation_resources(
+            context, scope.to_primitive())
+        resources = {r['id']: r for r in operation['resources']}
+        for step in operation['steps']:
+            statuses = ('dispatching', 'pending', 'unknown') if query else (
+                'prepared',)
+            if step['status'] not in statuses:
+                continue
+            resource = resources[step['resource_id']]
+            volume_row = data['volumes'][resource['volume_id']]
+            if (volume_utils.extract_host(volume_row['host'] or '') !=
+                    volume_utils.extract_host(self.owner.host)):
+                continue
+            volume = self._volume(context, scope, resource['volume_id'], data)
+            self._preflight(context, scope, volume, resource)
+            row = data['snapshots'].get(resource['snapshot_id'])
+            if (row is None or row['volume_size'] != volume.size or
+                    (step['phase'] == 'revert' and
+                     row['status'] != 'available')):
+                raise exception.CheckpointConflict(reason='snapshot_mismatch')
+            snapshot = objects.Snapshot._from_db_object(
+                context, objects.Snapshot(context), row,
+                expected_attrs=['metadata'])
+            snapshot.volume = volume
+            if query:
+                # Read-only query may confirm the original request ID, but
+                # must never claim prepared work or dispatch a new effect.
+                try:
+                    result = self.owner.driver.checkpoint_query_operation(
+                        context, volume, snapshot, step['id'], step['phase'])
+                except Exception:
+                    result = {'status': 'unknown',
+                              'error_code': 'query_exception'}
+            else:
+                if not db.checkpoint_continuation_step_claim(
+                        context, scope.to_primitive(), step['id'],
+                        self.owner.host):
+                    continue
+                method = {
+                    'snapshot': self.owner.driver.checkpoint_create_snapshot,
+                    'revert': self.owner.driver.checkpoint_revert_to_snapshot,
+                    'delete_snapshot':
+                        self.owner.driver.checkpoint_delete_snapshot,
+                }[step['phase']]
+                try:
+                    result = method(context, volume, snapshot, step['id'])
+                except Exception:
+                    result = {'status': 'unknown',
+                              'error_code': 'driver_exception'}
+            db.checkpoint_continuation_step_finish(
+                context, scope.to_primitive(), step['id'], result)
+
+    def execute(self, context, nova_operation_id, generation):
+        self._run(context, nova_operation_id, generation, False)
+
+    def reconcile(self, context, nova_operation_id, generation):
+        self._run(context, nova_operation_id, generation, True)
+
+    def query_attachment(self, context, nova_operation_id, child_id,
+                         generation):
+        scope = self._scope(context, nova_operation_id, generation, 'read')
+        result = db.checkpoint_attachment_intent_get(
+            context, scope.to_primitive(), child_id)
+        self._volume(context, scope, result['volume_id'])
+        return result
+
+    def execute_attachment(self, context, nova_operation_id, child_id,
+                           generation):
+        scope = self._scope(context, nova_operation_id, generation,
+                            'attachment')
+        result = envelopes.AttachmentResult.from_primitive(
+            db.checkpoint_attachment_intent_get(
+                context, scope.to_primitive(), child_id))
+        volume = self._volume(context, scope, result.volume_id)
+        if result.status != 'prepared':
+            return
+        operation = db.checkpoint_continuation_get(
+            context, nova_operation_id)['operation']
+        resource = next(r for r in operation['resources']
+                        if r['volume_id'] == volume.id)
+        self._preflight(context, scope, volume, resource)
+        attachment = db.checkpoint_continuation_attachment(
+            context, scope.to_primitive(), result.attachment_id)
+        intent = db.checkpoint_attachment_intent_claim(
+            context, child_id, self.owner.host)
+        if intent is None:
+            return
+        try:
+            if result.action == 'update':
+                connector = json.loads(intent['connector_json'])
+                connector['mode'] = 'rw'
+                self.owner.driver.validate_connector(connector)
+                model_update = self.owner.driver.create_export(
+                    context, volume, connector)
+                if model_update:
+                    db.checkpoint_continuation_export_update(
+                        context, scope.to_primitive(), child_id,
+                        self.owner.host, model_update)
+                    volume.update(model_update)
+                connection = self.owner.driver.initialize_connection(
+                    volume, connector)
+                if (not isinstance(connection, dict) or
+                        not isinstance(connection.get('data'), dict) or
+                        not isinstance(connection.get('driver_volume_type'),
+                                       str) or
+                        not connection['driver_volume_type']):
+                    raise ValueError('invalid_connection_info')
+                connection = self.owner._parse_connection_options(
+                    context, volume, connection)
+                data = connection.pop('data')
+                data.update(connection)
+                data['attachment_id'] = result.attachment_id
+                data['enforce_multipath'] = connector.get(
+                    'enforce_multipath', False)
+            elif result.action == 'delete':
+                connector = json.loads(attachment['connector']) if (
+                    attachment['connector']) else None
+                if not connector:
+                    # An attached VM disk without its original connector is
+                    # not proof that there is no backend connection.
+                    raise ValueError('original_connector_missing')
+                shared = self.owner.driver.terminate_connection(
+                    volume, connector, force=False)
+                if shared is True:
+                    raise ValueError('unexpected_shared_connection')
+                self.owner.driver.remove_export(context, volume)
+                data = None
+            else:
+                raise ValueError('invalid_attachment_action')
+            db.checkpoint_attachment_intent_success(
+                context, scope.to_primitive(), child_id, self.owner.host, data)
+        except Exception:
+            # No compensation and no second dispatch after an uncertain I/O.
+            # Never journal or log an exception message or connection secrets.
+            unknown = dataclasses.replace(
+                result, status='unknown',
+                error_code='attachment_result_unknown')
+            db.checkpoint_attachment_intent_finish(
+                context, child_id, unknown.to_primitive())
