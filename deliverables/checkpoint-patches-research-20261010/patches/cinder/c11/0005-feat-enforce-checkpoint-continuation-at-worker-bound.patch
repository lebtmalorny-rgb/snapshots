+                                       self.updated.id, 1)
+
+    def query_update(self):
+        return self.worker.query_attachment(
+            self.service_ctx, uuids.nova_operation, self.updated.id, 1)
+
+    def test_unknown_update_is_never_redispatched(self):
+        self.prepare_update()
+        self.driver.initialize_connection.side_effect = TimeoutError('secret')
+        self.execute_update()
+        self.execute_update()
+        self.assertEqual('unknown', self.query_update()['status'])
+        self.assertEqual(1, self.driver.initialize_connection.call_count)
+        self.assertEqual(1, self.driver.create_export.call_count)
+        self.driver.remove_export.assert_not_called()
+        self.assertEqual(2, len(self.locks()))
+
+    def test_revocation_between_api_and_worker_prevents_effect(self):
+        self.prepare_update()
+        self.revoke_grant()
+        self.assertRaises(exception.CheckpointServiceForbidden,
+                          self.execute_update)
+        self.driver.initialize_connection.assert_not_called()
+        self.driver.create_export.assert_not_called()
+
+    def test_wrong_host_or_child_operation_cannot_dispatch(self):
+        self.prepare_update()
+        self.assertRaises(exception.CheckpointConflict,
+                          self.workers[1].execute_attachment,
+                          self.service_ctx, uuids.nova_operation,
+                          self.updated.id, 1)
+        self.assertRaises(exception.CheckpointOperationNotFound,
+                          self.worker.execute_attachment,
+                          self.service_ctx, uuids.foreign_operation,
+                          self.updated.id, 1)
+        self.driver.initialize_connection.assert_not_called()
+
+    def test_successful_update_connection_is_only_in_attachment(self):
+        self.prepare_update()
