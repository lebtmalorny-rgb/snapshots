+class ContinuationRPCGateTest(WorkerHelpers, test.TestCase):
+    def setUp(self):
+        super().setUp()
+        self.prepare_workers()
+        self.real_rpc = rpcapi.VolumeAPI()
+        self.services = [db.service_create(self.ctxt.elevated(), {
+            'host': owner.host, 'binary': 'cinder-volume',
+            'topic': 'cinder-volume', 'disabled': False,
+            'rpc_current_version': '3.22', 'object_current_version': '1.41',
+            'updated_at': timeutils.utcnow()}) for owner in self.owners]
+        self.mock_object(self.real_rpc.client, 'can_send_version',
+                         return_value=True)
+        self.volume = objects.Volume.get_by_id(self.ctxt, self.volumes[0])
+
+    def test_rpc_321_and_objects_140_rejected_before_reserve(self):
+        self.api.rpc = self.real_rpc
+        for fields in ({'rpc_current_version': '3.21'},
+                       {'rpc_current_version': '3.22',
+                        'object_current_version': '1.40'}):
+            db.service_update(
+                self.ctxt.elevated(), self.services[0].id, fields)
+            self.assertRaises(exception.CheckpointNotSupported,
+                              self.api.reserve_with_continuation,
+                              self.ctxt, self.payload)
+            self.assertEqual([], self.locks())
+            self.assertEqual(
+                0, self.count(models.CheckpointContinuationGrant))
+
+    def test_object_cap_and_rpc_cap_are_checked(self):
+        self.mock_object(self.real_rpc, 'determine_obj_version_cap',
+                         return_value='1.40')
+        self.assertRaises(exception.CheckpointNotSupported,
+                          self.real_rpc.assert_checkpoint_continuation_ready,
+                          self.service_ctx, self.volume)
+        self.real_rpc.determine_obj_version_cap.return_value = '1.41'
+        self.real_rpc.client.can_send_version.return_value = False
+        self.assertRaises(exception.CheckpointNotSupported,
+                          self.real_rpc.assert_checkpoint_continuation_ready,
+                          self.service_ctx, self.volume)
+
+    def test_new_rpcs_pin_322_and_preserve_subject(self):
+        client = self.mock_object(self.real_rpc, '_get_cctxt')
+        for method, kind, kwargs in (
+                ('get_checkpoint_continuation_capabilities', 'call',
+                 {'volume_id': self.volume.id}),
+                ('execute_checkpoint_continuation', 'cast', {'generation': 1}),
+                ('reconcile_checkpoint_continuation', 'cast',
+                 {'generation': 1}),
+                ('execute_checkpoint_attachment', 'cast',
+                 {'generation': 1, 'child_id': uuids.child}),
+                ('query_checkpoint_attachment', 'call',
+                 {'generation': 1, 'child_id': uuids.child})):
+            kwargs['nova_operation_id'] = uuids.nova_operation
+            getattr(self.real_rpc, method)(
+                self.service_ctx, host=self.owners[0].host, **kwargs)
+            client.assert_called_with(self.owners[0].host, version='3.22')
+            getattr(client.return_value, kind).assert_called_with(
+                self.service_ctx, method, **kwargs)
