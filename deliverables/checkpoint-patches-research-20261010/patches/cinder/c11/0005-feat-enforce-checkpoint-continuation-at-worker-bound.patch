+class ContinuationWorkerTest(WorkerHelpers, test.TestCase):
+    def setUp(self):
+        super().setUp()
+        self.prepare_workers()
+        self.operation = self.api.reserve_with_continuation(
+            self.ctxt, self.payload)
+
+    def test_two_hosts_duplicate_delivery_dispatch_once(self):
+        for worker in self.workers:
+            for unused in range(2):
+                worker.execute(self.service_ctx, uuids.nova_operation, 1)
+        self.assertEqual('succeeded', self.grant()['operation']['status'])
+        self.assertEqual(
+            [1, 1], [o.driver.native_call_count for o in self.owners])
+        self.assertEqual(uuids.nova_operation,
+                         self.service_ctx.checkpoint_continuation_id)
+
+    def test_unknown_step_query_never_reexecutes(self):
+        self.driver.outcomes['snapshot'].append(TimeoutError('not-public'))
+        self.worker.execute(self.service_ctx, uuids.nova_operation, 1)
+        self.worker.execute(self.service_ctx, uuids.nova_operation, 1)
+        self.worker.reconcile(self.service_ctx, uuids.nova_operation, 1)
+        self.assertEqual(1, self.driver.native_call_count)
+        self.assertEqual(1, len(self.driver.query_calls))
+        self.assertNotIn('not-public', str(self.grant()))
+
+    def test_revoked_grant_blocks_both_service_and_legacy_worker(self):
+        self.revoke_grant()
+        self.assertRaises(exception.CheckpointServiceForbidden,
+                          self.worker.execute, self.service_ctx,
+                          uuids.nova_operation, 1)
+        legacy = manager.CheckpointManager(self.owners[0])
+        self.assertRaises(exception.CheckpointServiceForbidden,
+                          legacy.execute, self.ctxt,
+                          self.operation.steps[0].id, 1)
+        self.assertEqual(0, self.driver.native_call_count)
+
+    def test_late_delivery_after_release_has_no_effect(self):
+        db.checkpoint_continuation_transition(
+            self.service_ctx, uuids.nova_operation, 1, 'release', 'abort')
+        self.assertRaises(exception.CheckpointConflict,
+                          self.worker.execute, self.service_ctx,
+                          uuids.nova_operation, 1)
+        self.assertEqual('released', self.grant()['operation']['status'])
+        self.assertEqual(0, self.driver.native_call_count)
+
+    def test_allowlist_removal_and_stale_generation_prevent_effect(self):
+        self.assertRaises(exception.CheckpointConflict,
+                          self.worker.execute, self.service_ctx,
+                          uuids.nova_operation, 2)
+        self.flags(nova_service_user_ids=[], group='checkpoint')
+        self.assertRaises(exception.CheckpointServiceForbidden,
+                          self.worker.execute, self.service_ctx,
+                          uuids.nova_operation, 1)
+        self.assertEqual(0, self.driver.native_call_count)
+
+    def test_wrong_host_and_uninitialized_capability_are_rejected(self):
+        self.assertRaises(exception.CheckpointConflict,
+                          self.worker.capabilities, self.service_ctx,
+                          uuids.nova_operation, self.volumes[1])
+        self.driver._initialized = False
+        self.assertRaises(exception.CheckpointBackendUnavailable,
+                          self.worker.capabilities, self.service_ctx,
+                          uuids.nova_operation, self.volumes[0])
+
+    def test_forged_scope_cannot_claim_step(self):
+        scope = continuation.authorize(self.service_ctx, uuids.nova_operation,
+                                       1, 'execute')
+        forged = dataclasses.replace(scope, owner_project_id=uuids.attacker)
+        self.assertRaises(exception.CheckpointOperationNotFound,
+                          db.checkpoint_continuation_step_claim,
+                          self.service_ctx, forged.to_primitive(),
+                          self.operation.steps[0].id, self.owners[0].host)
+        self.assertEqual(0, self.driver.native_call_count)
