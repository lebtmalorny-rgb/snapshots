+        'executor_service_user_id': fields.StringField(),
+        'generation': fields.IntegerField(),
+        'revision': fields.IntegerField(),
+        'state': fields.StringField(),
+        'payload_hash': fields.StringField(),
+    }
+
+    @classmethod
+    def get_by_nova_operation(cls, context, nova_operation_id):
+        return cls._from_db_object(context, cls(context),
+                                   db.checkpoint_continuation_get(
+                                       context, nova_operation_id))
+
+    def save(self):
+        raise exception.ObjectActionError(
+            action='save', reason='read-only checkpoint continuation grant')
+
+
+@base.CinderObjectRegistry.register
+class CheckpointContinuationGrantList(base.ObjectListBase, base.CinderObject):
+    VERSION = '1.0'
+
+    fields = {
+        'objects': fields.ListOfObjectsField('CheckpointContinuationGrant')}
