+class ContinuationHelpers(test_api.APIHelpers):
+    def prepare_continuation(self):
+        self.prepare_api()
+        self.payload.update(nova_operation_id=uuids.nova_operation,
+                            allow_service_continuation=True)
+        self.service_ctx = context.RequestContext(
+            test_db.SERVICE_ID, uuids.service_project, roles=['service'],
+            is_admin=False)
+
+    def count(self, model):
+        with sqla_api.main_context_manager.reader.using(self.ctxt):
+            return self.ctxt.session.query(model).filter_by(
+                deleted=False).count()
+
+    def grant(self):
+        return db.checkpoint_continuation_get(self.service_ctx,
+                                              uuids.nova_operation)
+
