+class ContinuationRaceTests(test_db.CheckpointDBHelpers):
+    def setUp(self):
+        super().setUp()
+        cfg = self.useFixture(config_fixture.Config())
+        cfg.config(auth_url='http://keystone.test/v3',
+                   group='keystone_authtoken')
+        cfg.conf([], project='cinder', default_config_files=[])
+        policy.reset()
+        self.addCleanup(policy.reset)
+        cfg.config(connection='sqlite://', group='database')
+        cfg.config(enabled=True, nova_service_user_ids=[test_db.SERVICE_ID],
+                   group='checkpoint')
+        engine = enginefacade.writer.get_engine()
+        migration.db_sync(engine=engine)
+        self.addCleanup(sqla_api.main_context_manager.patch_engine(engine))
+        self.prepare_volumes()
+        self.ctxt.roles = ['member']
+        self.ctxt.service_roles = ['service']
+        self.payload = {key: value for key, value in self.values().items()
+                        if key != 'capabilities'}
+        self.payload.update(volume_ids=self.volumes,
+                            nova_operation_id=uuids.nova_operation,
+                            allow_service_continuation=True)
+        rpc = mock.Mock(spec=['assert_checkpoint_ready',
+                              'get_checkpoint_capabilities'])
+        rpc.get_checkpoint_capabilities.return_value = (
+            test_contracts.supported_capabilities())
+        self.api = api.API(rpc=rpc)
+
+    def test_two_connections_same_nova_uuid_one_winner(self):
+        gate = eventlet.event.Event()
+
+        def reserve(payload):
+            ctxt = self.ctxt.deepcopy()
+            gate.wait()
+            try:
+                return self.api.reserve_with_continuation(ctxt, payload).id
+            except exception.CheckpointConflict:
+                return None
+
+        changed = dict(self.payload, request_id=uuids.other_request,
+                       checkpoint_id=uuids.other_checkpoint)
+        tasks = [eventlet.spawn(reserve, payload)
+                 for payload in (self.payload, changed)]
+        gate.send()
+        results = [task.wait() for task in tasks]
+        self.assertEqual(1, sum(result is not None for result in results))
+        with sqla_api.main_context_manager.reader.using(self.ctxt):
+            self.assertEqual(1, self.ctxt.session.query(
+                models.CheckpointContinuationGrant).count())
+            self.assertEqual(1, self.ctxt.session.query(
+                models.CheckpointOperation).count())
+        usage = db.quota_usage_get_all_by_project(self.ctxt.elevated(),
+                                                  self.ctxt.project_id)
+        self.assertEqual(2, usage['snapshots']['in_use'])
+        self.assertEqual(0, usage['snapshots']['reserved'])
+        self.assertEqual(sorted(self.volumes), sorted(self.locks()))
+
+    def test_identical_concurrent_reserve_returns_same_grant(self):
+        gate = eventlet.event.Event()
+
+        def reserve():
+            ctxt = self.ctxt.deepcopy()
+            gate.wait()
+            return self.api.reserve_with_continuation(
+                ctxt, copy.deepcopy(self.payload)).id
+
+        tasks = [eventlet.spawn(reserve) for unused in range(2)]
+        gate.send()
+        self.assertEqual(tasks[0].wait(), tasks[1].wait())
+        usage = db.quota_usage_get_all_by_project(self.ctxt.elevated(),
+                                                  self.ctxt.project_id)
+        self.assertEqual(2, usage['snapshots']['in_use'])
+        self.assertEqual(0, usage['snapshots']['reserved'])
+
