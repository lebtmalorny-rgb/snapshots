+class ContinuationDBTest(ContinuationHelpers, test.TestCase):
+    def setUp(self):
+        super().setUp()
+        self.prepare_continuation()
+
+    def test_reply_loss_keeps_one_owner_and_one_charge(self):
+        first = self.api.reserve_with_continuation(self.ctxt, self.payload)
+        second = self.api.reserve_with_continuation(self.ctxt, self.payload)
+        row = self.grant()
+        self.assertEqual(first.id, second.id)
+        self.assertEqual(first.id, row['operation_id'])
+        self.assertEqual(first.continuation_id, row['id'])
+        self.assertEqual(self.ctxt.user_id, row['actor_user_id'])
+        self.assertEqual(self.ctxt.project_id, row['owner_project_id'])
+        self.assertEqual(1, self.count(models.CheckpointOperation))
+        self.assertEqual(1, self.count(models.CheckpointContinuationGrant))
+        self.assertEqual(2, self.usage()['snapshots']['in_use'])
+        self.assertEqual(0, self.usage()['snapshots']['reserved'])
+
+    def test_grant_insert_failure_rolls_back_reserve(self):
+        def fail(mapper, connection, target):
+            raise RuntimeError('injected_grant_insert_failure')
+
+        sa.event.listen(models.CheckpointContinuationGrant, 'before_insert',
+                        fail)
+        self.addCleanup(sa.event.remove, models.CheckpointContinuationGrant,
+                        'before_insert', fail)
+        self.assertRaises(RuntimeError, self.api.reserve_with_continuation,
+                          self.ctxt, self.payload)
+        for model in (models.CheckpointOperation, models.CheckpointResource,
+                      models.CheckpointContinuationGrant, models.Snapshot):
+            self.assertEqual(0, self.count(model))
+        self.assertEqual([], self.locks())
+        self.assertEqual(0, self.usage()['snapshots']['in_use'])
+        self.assertEqual(0, self.usage()['snapshots']['reserved'])
+
+    def test_changed_actor_or_payload_conflicts(self):
+        self.api.reserve_with_continuation(self.ctxt, self.payload)
+        for fields in ({'nova_operation_id': uuids.other_operation},
+                       {'volume_ids': self.volumes[:1]},
+                       {'checkpoint_id': uuids.other_checkpoint}):
+            self.assertRaises(exception.CheckpointConflict,
+                              self.api.reserve_with_continuation, self.ctxt,
+                              dict(self.payload, **fields))
+        other = self.ctxt.deepcopy()
+        other.user_id = uuids.other_actor
+        self.assertRaises(exception.CheckpointOperationNotFound,
+                          self.api.reserve_with_continuation, other,
+                          self.payload)
+        self.assertEqual(1, self.count(models.CheckpointOperation))
+        self.assertEqual(2, self.usage()['snapshots']['in_use'])
+
+    def test_legacy_reserve_cannot_gain_grant_by_replay(self):
+        legacy = {key: value for key, value in self.payload.items()
+                  if key not in ('nova_operation_id',
+                                 'allow_service_continuation')}
+        first = self.api.reserve(self.ctxt, legacy)
+        self.assertIsNone(first.continuation_id)
+        self.assertRaises(exception.CheckpointConflict,
+                          self.api.reserve_with_continuation, self.ctxt,
+                          self.payload)
+        self.assertEqual(0, self.count(models.CheckpointContinuationGrant))
+
+    def test_released_grant_is_read_only(self):
+        operation = self.api.reserve_with_continuation(self.ctxt, self.payload)
+        db.checkpoint_release(self.ctxt, operation.id, 1, 'abort')
+        row = self.grant()
+        self.assertEqual('released', row['state'])
+        self.assertEqual('released', row['operation']['status'])
+        self.assertEqual(operation.id, self.api.reserve_with_continuation(
+            self.ctxt, self.payload).id)
+        for action in ('execute', 'cleanup', 'capabilities'):
+            self.assertRaises(exception.CheckpointConflict,
+                              db.checkpoint_continuation_scope,
+                              self.service_ctx, uuids.nova_operation, 1,
+                              action)
+        self.assertEqual(operation.id, db.checkpoint_continuation_scope(
+            self.service_ctx, uuids.nova_operation, 1, 'read')['operation_id'])
+        self.assertEqual([], self.locks())
+        changed = dict(self.payload, request_id=uuids.another_request,
+                       checkpoint_id=uuids.another_checkpoint)
+        self.assertRaises(exception.CheckpointConflict,
+                          self.api.reserve_with_continuation,
+                          self.ctxt, changed)
+        self.assertEqual(1, self.count(models.CheckpointOperation))
+        self.assertEqual(0, self.usage()['snapshots']['in_use'])
+        self.assertEqual(0, self.usage()['snapshots']['reserved'])
+
+    def test_scope_is_bound_without_changing_service_context(self):
+        operation = self.api.reserve_with_continuation(self.ctxt, self.payload)
+        before = self.service_ctx.to_dict()
+        primitive = db.checkpoint_continuation_scope(
+            self.service_ctx, uuids.nova_operation, 1, 'execute')
+        scope = contracts.ContinuationScope.from_primitive(primitive)
+        self.assertEqual(operation.id, scope.operation_id)
+        self.assertEqual(self.ctxt.user_id, scope.actor_user_id)
+        self.assertEqual(test_db.SERVICE_ID, scope.executor_service_user_id)
+        self.assertEqual(tuple(sorted(self.volumes)), scope.volume_ids)
+        self.assertEqual(before, self.service_ctx.to_dict())
+        self.assertRaises(exception.CheckpointOperationNotFound,
+                          db.checkpoint_get, self.service_ctx, operation.id)
+
+    def test_foreign_service_generation_and_resource_are_denied(self):
+        self.api.reserve_with_continuation(self.ctxt, self.payload)
+        other = self.service_ctx.deepcopy()
+        other.user_id = uuids.other_service
+        self.flags(nova_service_user_ids=[test_db.SERVICE_ID,
+                                          uuids.other_service],
+                   group='checkpoint')
+        self.assertRaises(exception.CheckpointOperationNotFound,
+                          db.checkpoint_continuation_get, other,
+                          uuids.nova_operation)
+        self.assertRaises(exception.CheckpointOperationNotFound,
+                          db.checkpoint_continuation_scope, self.service_ctx,
+                          uuids.nova_operation, 1, 'capabilities',
+                          uuids.other_volume)
+        for generation in (True, 0, 2):
+            self.assertRaises(exception.CheckpointConflict,
+                              db.checkpoint_continuation_scope,
+                              self.service_ctx, uuids.nova_operation,
+                              generation, 'execute')
+        self.assertEqual(2, len(self.locks()))
+
+    def test_revoked_grant_does_not_release_resources(self):
+        self.api.reserve_with_continuation(self.ctxt, self.payload)
+        with sqla_api.main_context_manager.writer.using(self.ctxt):
+            grant = self.ctxt.session.query(
+                models.CheckpointContinuationGrant).one()
+            grant.state = 'revoked'
+            grant.revision += 1
+        self.assertRaises(exception.CheckpointServiceForbidden,
+                          db.checkpoint_continuation_scope, self.service_ctx,
+                          uuids.nova_operation, 1, 'execute')
+        self.assertEqual(2, len(self.locks()))
+        self.assertEqual(2, self.usage()['snapshots']['in_use'])
+
+    def test_db_reserve_requires_verified_dual_identity_for_grant(self):
+        values = self.values()
+        values.update(nova_operation_id=uuids.nova_operation,
+                      allow_service_continuation=True)
+        untrusted = self.ctxt.deepcopy()
+        untrusted.service_roles = []
+        self.assertRaises(exception.CheckpointServiceForbidden,
+                          db.checkpoint_reserve, untrusted, values,
+                          self.volumes)
+        self.assertEqual(0, self.count(models.CheckpointContinuationGrant))
+        self.assertEqual([], self.locks())
+
+    def test_db_reserve_requires_explicit_delegation(self):
+        values = self.values()
+        values.update(nova_operation_id=uuids.nova_operation,
+                      allow_service_continuation=False)
+        self.assertRaises(exception.InvalidInput, db.checkpoint_reserve,
+                          self.ctxt, values, self.volumes)
+        self.assertEqual([], self.locks())
+
+    def test_delegated_operation_cannot_downconvert(self):
+        operation = self.api.reserve_with_continuation(self.ctxt, self.payload)
+        self.assertRaises(exception.ObjectActionError,
+                          operation.obj_to_primitive, target_version='1.0')
+        operation.continuation_id = None
+        primitive = operation.obj_to_primitive(target_version='1.0')
+        self.assertNotIn('continuation_id', primitive['versioned_object.data'])
+        grant = objects.CheckpointContinuationGrant.get_by_nova_operation(
+            self.service_ctx, uuids.nova_operation)
+        self.assertEqual(self.ctxt.user_id, grant.actor_user_id)
+        self.assertRaises(exception.ObjectActionError, grant.save)
