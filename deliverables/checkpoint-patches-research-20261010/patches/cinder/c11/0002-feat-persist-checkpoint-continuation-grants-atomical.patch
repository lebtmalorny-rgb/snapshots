diff --git a/cinder/db/sqlalchemy/checkpoint_continuation.py b/cinder/db/sqlalchemy/checkpoint_continuation.py
new file mode 100644
index 0000000..8628d24
--- /dev/null
+++ b/cinder/db/sqlalchemy/checkpoint_continuation.py
@@ -0,0 +1,162 @@
+# Licensed under the Apache License, Version 2.0 (the "License"); you may
+# not use this file except in compliance with the License. You may obtain
+# a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+# WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+# License for the specific language governing permissions and limitations
+# under the License.
+
+"""Owner-scoped grant queries. Never replace the authenticated context."""
+
+import json
+
+from oslo_utils import uuidutils
+
+from cinder.checkpoints import continuation
+from cinder.checkpoints import continuation_contracts as contracts
+from cinder.db.sqlalchemy import api
+from cinder.db.sqlalchemy import checkpoints as journal
+from cinder.db.sqlalchemy import models
+from cinder import exception
+from cinder.policies import checkpoints as policies
+
+
+def _grant(context, nova_operation_id, executor, lock=False):
+    query = journal._query(
+        context, models.CheckpointContinuationGrant).filter_by(
+            nova_operation_id=nova_operation_id,
+            executor_service_user_id=executor)
+    return (journal._current(query) if lock else query).first()
+
+
+def _bound_operation(context, grant, lock=False):
+    if grant is None:
+        raise exception.CheckpointOperationNotFound()
+    query = journal._query(context, models.CheckpointOperation).filter_by(
+        id=grant.operation_id, continuation_id=grant.id,
+        project_id=grant.owner_project_id, user_id=grant.actor_user_id,
+        service_user_id=grant.executor_service_user_id,
+        generation=grant.generation, payload_hash=grant.payload_hash)
+    operation = (journal._current(query) if lock else query).first()
+    if operation is None:
+        raise exception.CheckpointOperationNotFound()
+    if grant.state == 'revoked':
+        raise exception.CheckpointServiceForbidden()
+    if grant.state not in ('active', 'released'):
+        raise exception.CheckpointServiceForbidden()
+    if (grant.state == 'released') != (operation.status == 'released'):
+        journal._conflict('continuation_state_mismatch')
+    return operation
+
+
+def check_reserve(context, payload, payload_hash):
+    """Called within the original reserve transaction, with dual identity."""
+    previous = _grant(context, payload['nova_operation_id'],
+                      context.service_user_id)
+    if previous is not None:
+        if (previous.owner_project_id != context.project_id or
+                previous.actor_user_id != context.user_id):
+            raise exception.CheckpointOperationNotFound()
+        if previous.payload_hash != payload_hash:
+            journal._conflict('request_payload_changed')
+        return journal._as_dict(context, _bound_operation(context, previous))
+
+
+def insert_grant(context, operation, nova_operation_id):
+    """Commit snapshots, quota, grant and locks in the same transaction."""
+    grant = models.CheckpointContinuationGrant(
+        id=uuidutils.generate_uuid(), operation_id=operation.id,
+        nova_operation_id=nova_operation_id,
+        owner_project_id=operation.project_id, actor_user_id=operation.user_id,
+        executor_service_user_id=operation.service_user_id,
+        generation=operation.generation, revision=1, state='active',
+        payload_hash=operation.payload_hash)
+    context.session.add(grant)
+    context.session.flush()
+    operation.continuation_id = grant.id
+
+
+def mark_released(context, operation):
+    if operation.continuation_id is not None:
+        grant = journal._current(journal._query(
+            context, models.CheckpointContinuationGrant).filter_by(
+                id=operation.continuation_id,
+                operation_id=operation.id)).one()
+        grant.state = 'released'
+        grant.revision += 1
+
+
+@api.require_context
+@api.main_context_manager.reader
+def get(context, nova_operation_id):
+    executor = continuation.require_executor(context)
+    context.authorize(policies.CONTINUATION_READ_POLICY)
+    grant = _grant(context, nova_operation_id, executor)
+    operation = _bound_operation(context, grant)
+    return dict(grant, operation=journal._as_dict(context, operation))
+
+
+def _scope(context, nova_operation_id, generation, action, volume_id=None):
+    executor = continuation.require_executor(context)
+    if action not in ('read', 'execute', 'reconcile', 'cleanup', 'release',
+                      'capabilities', 'attachment'):
+        raise exception.InvalidInput(reason='invalid_continuation_action')
+    grant = _grant(context, nova_operation_id, executor)
+    operation = _bound_operation(context, grant)
+    if type(generation) is not int or generation != operation.generation:
+        journal._conflict('stale_generation')
+    if operation.status != 'released':
+        # Match C1 lock order: instance, sorted volumes, operation, then grant.
+        instance = journal._current(journal._query(
+            context, models.CheckpointInstance).filter_by(
+                instance_uuid=operation.instance_uuid,
+                project_id=grant.owner_project_id)).one()
+        volume_ids = json.loads(instance.volume_ids_json)
+        for vid in sorted(volume_ids):
+            volume = journal._current(journal._query(
+                context, models.Volume).filter_by(
+                    id=vid, project_id=grant.owner_project_id)).first()
+            if volume is None:
+                raise exception.VolumeNotFound(volume_id=vid)
+        operation = _bound_operation(context, grant, lock=True)
+        grant = _grant(context, nova_operation_id, executor, lock=True)
+        operation = _bound_operation(context, grant)
+        if operation.status != 'released':
+            locks = journal._current(journal._query(
+                context, models.CheckpointVolumeLock).filter_by(
+                    operation_id=operation.id)).all()
+            if (instance.active_operation_id != operation.id or
+                    sorted(row.volume_id for row in locks) !=
+                    sorted(volume_ids) or
+                    any(row.generation != generation for row in locks)):
+                journal._conflict('operation_not_owner')
+    if grant.state == 'released' and action != 'read':
+        journal._conflict('continuation_released')
+    resources = journal._resources(context, operation.checkpoint_id)
+    if any(row.project_id != grant.owner_project_id or
+           row.instance_uuid != operation.instance_uuid for row in resources):
+        raise exception.CheckpointOperationNotFound()
+    volume_ids = tuple(sorted(row.volume_id for row in resources))
+    if volume_id is not None and volume_id not in volume_ids:
+        raise exception.CheckpointOperationNotFound()
+    return contracts.ContinuationScope(
+        grant_id=grant.id, operation_id=operation.id,
+        nova_operation_id=grant.nova_operation_id,
+        owner_project_id=grant.owner_project_id,
+        actor_user_id=grant.actor_user_id,
+        executor_service_user_id=grant.executor_service_user_id,
+        instance_uuid=operation.instance_uuid,
+        checkpoint_id=operation.checkpoint_id, kind=operation.kind,
+        generation=generation, volume_ids=volume_ids,
+        grant_revision=grant.revision)
+
+
+@api.require_context
+@api.main_context_manager.writer
+def scope(context, nova_operation_id, generation, action, volume_id=None):
+    return _scope(context, nova_operation_id, generation, action,
+                  volume_id).to_primitive()
