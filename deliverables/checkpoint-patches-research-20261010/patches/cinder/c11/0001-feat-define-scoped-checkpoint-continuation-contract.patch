index 0000000..1f10ec7
--- /dev/null
+++ b/cinder/checkpoints/continuation_contracts.py
@@ -0,0 +1,248 @@
+# Licensed under the Apache License, Version 2.0 (the "License"); you may
+# not use this file except in compliance with the License. You may obtain
+# a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+# WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+# License for the specific language governing permissions and limitations
+# under the License.
+
+"""Closed continuation envelopes; a serialized scope is never authority."""
+
+from collections.abc import Mapping
+import dataclasses
+import hashlib
+import json
+from types import MappingProxyType
+import uuid
+
+
+ACTIONS = ('create', 'update', 'complete', 'delete')
+STATUSES = ('prepared', 'dispatching', 'pending', 'succeeded',
+            'failed_no_effect', 'unknown')
+ERROR_CODES = frozenset((
+    'driver_exception', 'query_exception', 'invalid_driver_result',
+    'cancelled_before_dispatch', 'attachment_result_unknown',
+    'request_payload_changed', 'continuation_revoked',
+))
+_CONNECTOR_STRINGS = frozenset((
+    'host', 'ip', 'initiator', 'platform', 'os_type', 'nqn', 'uuid',
+    'system uuid',
+))
+_CONNECTOR_BOOLS = frozenset(('multipath', 'enforce_multipath',
+                             'nvme_native_multipath'))
+_CONNECTOR_LISTS = frozenset(('wwpns', 'wwnns'))
+_RESERVE_KEYS = frozenset(('request_id', 'checkpoint_id', 'instance_uuid',
+                           'kind', 'volume_ids'))
+_DELEGATION_KEYS = frozenset(('nova_operation_id',
+                              'allow_service_continuation'))
+
+
+def _uuid(value):
+    if not isinstance(value, str):
+        raise ValueError('invalid_uuid')
+    try:
+        if str(uuid.UUID(value)) == value:
+            return value
+    except (ValueError, AttributeError):
+        pass
+    raise ValueError('invalid_uuid')
+
+
+def _text(value, maximum=255):
+    if (not isinstance(value, str) or not value.strip() or
+            len(value) > maximum or '\x00' in value):
+        raise ValueError('invalid_string')
+    return value
+
+
+def _generation(value):
+    if type(value) is not int or value != 1:
+        raise ValueError('invalid_generation')
+
+
+def _volumes(values):
+    if not isinstance(values, (list, tuple)) or not 1 <= len(values) <= 64:
+        raise ValueError('invalid_volumes')
+    result = tuple(sorted(_uuid(value) for value in values))
+    if len(set(result)) != len(result):
+        raise ValueError('duplicate_volume')
+    return result
+
+
+def _kind(value):
+    if value not in ('create', 'revert', 'delete'):
+        raise ValueError('invalid_kind')
+
+
+def _connector(value):
+    if not isinstance(value, Mapping) or not value:
+        raise ValueError('invalid_connector')
+    if set(value) - _CONNECTOR_STRINGS - _CONNECTOR_BOOLS - _CONNECTOR_LISTS:
+        raise ValueError('invalid_connector_fields')
+    result = {}
+    for key, item in value.items():
+        if key in _CONNECTOR_STRINGS:
+            result[key] = _text(item, 1024)
+        elif key in _CONNECTOR_BOOLS:
+            if type(item) is not bool:
+                raise ValueError('invalid_connector_boolean')
+            result[key] = item
+        else:
+            if not isinstance(item, (list, tuple)) or not 1 <= len(item) <= 64:
+                raise ValueError('invalid_connector_list')
+            result[key] = tuple(_text(entry, 255) for entry in item)
+    return MappingProxyType(result)
+
+
+def _primitive(value):
+    if isinstance(value, Mapping):
+        return {key: _primitive(item) for key, item in value.items()}
+    if isinstance(value, (tuple, list)):
+        return [_primitive(item) for item in value]
+    return value
+
+
+class _Envelope:
+    def to_primitive(self):
+        return dict(schema_version=1, **{
+            field.name: _primitive(getattr(self, field.name))
+            for field in dataclasses.fields(self)})
+
+    @classmethod
+    def from_primitive(cls, value):
+        keys = {field.name for field in dataclasses.fields(cls)}
+        if (not isinstance(value, dict) or
+                set(value) != keys | {'schema_version'} or
+                type(value['schema_version']) is not int or
+                value['schema_version'] != 1):
+            raise ValueError('invalid_envelope')
+        return cls(**{key: value[key] for key in keys})
+
+
+@dataclasses.dataclass(frozen=True)
+class ContinuationScope(_Envelope):
+    grant_id: str
+    operation_id: str
+    nova_operation_id: str
+    owner_project_id: str
+    actor_user_id: str
+    executor_service_user_id: str
+    instance_uuid: str
+    checkpoint_id: str
+    kind: str
+    generation: int
+    volume_ids: tuple[str, ...]
+    grant_revision: int
+
+    def __post_init__(self):
+        for key in ('grant_id', 'operation_id', 'nova_operation_id',
+                    'instance_uuid', 'checkpoint_id'):
+            _uuid(getattr(self, key))
+        for key in ('owner_project_id', 'actor_user_id',
+                    'executor_service_user_id'):
+            _text(getattr(self, key))
+        _kind(self.kind)
+        _generation(self.generation)
+        if type(self.grant_revision) is not int or self.grant_revision < 0:
+            raise ValueError('invalid_grant_revision')
+        object.__setattr__(self, 'volume_ids', _volumes(self.volume_ids))
+
+
+@dataclasses.dataclass(frozen=True)
+class AttachmentRequest(_Envelope):
+    id: str
+    generation: int
+    volume_id: str
+    action: str
+    attachment_id: str | None
+    connector: dict | None
+    mountpoint: str | None
+
+    def __post_init__(self):
+        _uuid(self.id)
+        _uuid(self.volume_id)
+        _generation(self.generation)
+        if self.action not in ACTIONS:
+            raise ValueError('invalid_action')
+        if self.action == 'create':
+            if any(value is not None for value in (
+                    self.attachment_id, self.connector, self.mountpoint)):
+                raise ValueError('invalid_create_fields')
+        else:
+            _uuid(self.attachment_id)
+            if self.action == 'update':
+                object.__setattr__(self, 'connector',
+                                   _connector(self.connector))
+                if self.mountpoint is not None:
+                    _text(self.mountpoint)
+            elif self.connector is not None or self.mountpoint is not None:
+                raise ValueError('invalid_action_fields')
+
+
+@dataclasses.dataclass(frozen=True)
+class AttachmentResult(_Envelope):
+    id: str
+    operation_id: str
+    generation: int
+    volume_id: str
+    action: str
+    status: str
+    attachment_id: str | None
+    error_code: str | None
+
+    def __post_init__(self):
+        for key in ('id', 'operation_id', 'volume_id'):
+            _uuid(getattr(self, key))
+        _generation(self.generation)
+        if self.action not in ACTIONS or self.status not in STATUSES:
+            raise ValueError('invalid_result')
+        if self.attachment_id is not None or self.status == 'succeeded':
+            _uuid(self.attachment_id)
+        if (self.error_code is not None and
+                (self.error_code not in ERROR_CODES or
+                 self.status == 'succeeded')):
+            raise ValueError('invalid_error_code')
+
+
+def validate_attachment(value: dict) -> AttachmentRequest:
+    keys = {field.name for field in dataclasses.fields(AttachmentRequest)}
+    if not isinstance(value, dict) or set(value) != keys:
+        raise ValueError('invalid_attachment_request')
+    return AttachmentRequest(**value)
+
+
+def validate_reserve_373(payload: dict) -> dict:
+    if not isinstance(payload, dict):
+        raise ValueError('invalid_reserve')
+    keys = set(payload)
+    if keys not in (_RESERVE_KEYS, _RESERVE_KEYS | _DELEGATION_KEYS):
+        raise ValueError('invalid_reserve_fields')
+    for key in ('request_id', 'checkpoint_id', 'instance_uuid'):
+        _uuid(payload[key])
+    _kind(payload['kind'])
+    if 'nova_operation_id' in payload:
+        _uuid(payload['nova_operation_id'])
+        if payload['allow_service_continuation'] is not True:
+            raise ValueError('explicit_delegation_required')
+    if not isinstance(payload['volume_ids'], list):
+        raise ValueError('invalid_volumes')
+    return dict(payload, volume_ids=list(_volumes(payload['volume_ids'])))
+
+
+def body_hash(value: dict) -> str:
+    """Use the C1 JSON encoding for arbitrary closed continuation bodies."""
+    if not isinstance(value, dict):
+        raise ValueError('invalid_hash_body')
+    value = dict(value)
+    if 'volume_ids' in value:
+        value['volume_ids'] = list(_volumes(value['volume_ids']))
+    try:
+        encoded = json.dumps(value, sort_keys=True, separators=(',', ':'),
+                             ensure_ascii=True, allow_nan=False)
+    except (TypeError, ValueError):
+        raise ValueError('invalid_hash_body') from None
+    return hashlib.sha256(encoded.encode('utf-8')).hexdigest()
