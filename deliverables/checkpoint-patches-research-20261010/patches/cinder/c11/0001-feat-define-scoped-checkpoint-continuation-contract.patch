+# distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+# WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+# License for the specific language governing permissions and limitations
+# under the License.
+
+import copy
+import dataclasses
+import json
+import operator
+from unittest import mock
+
+from oslo_utils.fixture import uuidsentinel as uuids
+
+from cinder.checkpoints import config
+from cinder.checkpoints import continuation
+from cinder.checkpoints import continuation_contracts as contracts
+from cinder.checkpoints import contracts as legacy_contracts
+from cinder import context
+from cinder import exception
+from cinder.policies import checkpoints as policies
+from cinder.tests.unit import test
+
+
+def attachment_request(**changes):
+    value = dict(id=uuids.child, generation=1, volume_id=uuids.volume,
+                 action='create', attachment_id=None, connector=None,
+                 mountpoint=None)
+    value.update(changes)
+    return value
+
+
+def reserve_payload(**changes):
+    value = dict(request_id=uuids.nova_operation,
+                 checkpoint_id=uuids.checkpoint, instance_uuid=uuids.instance,
+                 kind='create', volume_ids=[uuids.volume, uuids.volume2],
+                 nova_operation_id=uuids.nova_operation,
+                 allow_service_continuation=True)
+    value.update(changes)
+    return value
+
+
+def scope_payload(**changes):
+    value = dict(schema_version=1, grant_id=uuids.grant,
+                 operation_id=uuids.operation,
+                 nova_operation_id=uuids.nova_operation,
+                 owner_project_id=uuids.project, actor_user_id=uuids.actor,
+                 executor_service_user_id=uuids.service,
+                 instance_uuid=uuids.instance, checkpoint_id=uuids.checkpoint,
+                 kind='revert', generation=1,
+                 volume_ids=[uuids.volume, uuids.volume2], grant_revision=0)
+    value.update(changes)
+    return value
+
+
+class ContinuationContractTest(test.TestCase):
+    def test_boolean_generation_is_not_one(self):
+        self.assertRaises(ValueError, contracts.validate_attachment,
+                          attachment_request(generation=True))
+
+    def test_extra_fields_and_action_specific_shape_rejected(self):
+        invalid = [dict(untrusted='value'), dict(action='unknown'),
+                   dict(attachment_id=uuids.attachment),
+                   dict(connector={'host': 'compute-one'}),
+                   dict(mountpoint='/dev/vdb'), dict(action='update'),
+                   dict(action='complete'), dict(action='delete'),
+                   dict(action='update', attachment_id=uuids.attachment,
+                        connector={'host': 'compute-one', 'password': 'x'}),
+                   dict(action='update', attachment_id=uuids.attachment,
+                        connector={'host': 'compute-one', 'multipath': 1}),
+                   dict(action='update', attachment_id=uuids.attachment,
+                        connector={'wwpns': 'not-a-list'}),
+                   dict(action='delete', attachment_id=uuids.attachment,
+                        connector={})]
+        for fields in invalid:
+            with self.subTest(fields=fields):
+                self.assertRaises(ValueError, contracts.validate_attachment,
+                                  attachment_request(**fields))
+
+    def test_valid_actions_round_trip_as_json(self):
+        cases = [attachment_request(), attachment_request(
+            action='update', attachment_id=uuids.attachment,
+            connector={'host': 'compute-one', 'ip': '192.0.2.10',
+                       'multipath': True, 'enforce_multipath': False,
+                       'system uuid': uuids.system, 'wwpns': ['abc'],
+                       'wwnns': ['def'], 'platform': 'x86_64',
+                       'os_type': 'linux2', 'initiator': 'iqn.example',
+                       'nqn': 'nqn.example', 'uuid': uuids.system},
+            mountpoint='/dev/vdb')]
+        cases.extend(attachment_request(action=action,
+                                        attachment_id=uuids.attachment)
+                     for action in ('complete', 'delete'))
+        for value in cases:
+            with self.subTest(action=value['action']):
+                request = contracts.validate_attachment(value)
+                primitive = request.to_primitive()
+                self.assertEqual(dict(value, schema_version=1), primitive)
+                self.assertEqual(request, contracts.AttachmentRequest.
+                                 from_primitive(json.loads(
+                                     json.dumps(primitive))))
+
+    def test_immutable_request_cannot_change_connector_after_hash(self):
+        value = attachment_request(
+            action='update', attachment_id=uuids.attachment,
+            connector={'host': 'compute-one', 'wwpns': ['abc']})
+        request = contracts.validate_attachment(value)
+        expected = request.to_primitive()
+        value['connector']['wwpns'].append('def')
+        exported = request.to_primitive()
+        exported['connector']['host'] = 'other-compute'
+        self.assertEqual(expected, request.to_primitive())
+        self.assertRaises(TypeError, operator.setitem, request.connector,
+                          'host', 'other-compute')
+        self.assertRaises(AttributeError, getattr,
+                          request.connector['wwpns'], 'append')
+        self.assertRaises(dataclasses.FrozenInstanceError, setattr,
+                          request, 'action', 'delete')
+        changed = dataclasses.replace(request, connector={'host': 'other'})
+        self.assertNotEqual(request.to_primitive(), changed.to_primitive())
+
+    def test_noncanonical_uuid_and_missing_fields_rejected(self):
+        for value in ('not-a-uuid', uuids.child.upper(),
+                      uuids.child.replace('-', ''), None, 1):
+            with self.subTest(value=value):
+                self.assertRaises(ValueError, contracts.validate_attachment,
+                                  attachment_request(id=value))
+        body = attachment_request()
+        del body['mountpoint']
+        self.assertRaises(ValueError, contracts.validate_attachment, body)
+
+    def test_direct_constructor_also_validates(self):
+        self.assertRaises(ValueError, contracts.AttachmentRequest,
+                          **attachment_request(generation=2))
+
+    def test_versioned_envelopes_are_closed(self):
+        valid = dict(attachment_request(), schema_version=1)
+        for fields in ({'schema_version': True}, {'schema_version': 2},
+                       {'scope': {}}, {'connection_info': {}}):
+            with self.subTest(fields=fields):
+                self.assertRaises(ValueError,
+                                  contracts.AttachmentRequest.from_primitive,
+                                  dict(valid, **fields))
+        self.assertRaises(ValueError,
+                          contracts.AttachmentRequest.from_primitive,
+                          attachment_request())
+
+    def test_scope_preserves_actor_and_orders_volumes(self):
+        value = scope_payload()
+        scope = contracts.ContinuationScope.from_primitive(value)
+        self.assertEqual(uuids.actor, scope.actor_user_id)
+        self.assertEqual(uuids.service, scope.executor_service_user_id)
+        self.assertEqual(tuple(sorted(value['volume_ids'])), scope.volume_ids)
+        self.assertEqual(scope, contracts.ContinuationScope.from_primitive(
+            json.loads(json.dumps(scope.to_primitive()))))
+        value['volume_ids'].append(uuids.volume3)
+        self.assertEqual(2, len(scope.volume_ids))
+
+    def test_scope_invalid_generation_revision_identity_or_volume_set(self):
+        for fields in ({'generation': True}, {'grant_revision': True},
+                       {'grant_revision': -1}, {'actor_user_id': ''},
+                       {'owner_project_id': 'x' * 256}, {'volume_ids': []},
+                       {'volume_ids': [uuids.volume, uuids.volume]},
+                       {'schema_version': 2}, {'unexpected': 1}):
+            with self.subTest(fields=fields):
+                self.assertRaises(ValueError,
+                                  contracts.ContinuationScope.from_primitive,
+                                  scope_payload(**fields))
+
+    def test_reserve_delegation_is_explicit_and_paired(self):
+        valid = reserve_payload()
+        self.assertEqual(sorted(valid['volume_ids']),
+                         contracts.validate_reserve_373(valid)['volume_ids'])
+        legacy = {key: value for key, value in valid.items()
+                  if key not in ('nova_operation_id',
+                                 'allow_service_continuation')}
+        self.assertNotIn('nova_operation_id',
+                         contracts.validate_reserve_373(legacy))
+        for fields in ({'nova_operation_id': uuids.nova_operation},
+                       {'allow_service_continuation': True}):
+            self.assertRaises(ValueError, contracts.validate_reserve_373,
+                              dict(legacy, **fields))
+        for value in (False, 1, 'true', None):
+            self.assertRaises(ValueError, contracts.validate_reserve_373,
+                              dict(valid, allow_service_continuation=value))
+
+    def test_reserve_rejects_identity_injection_and_bad_volume_set(self):
+        for fields in ({'actor_user_id': uuids.other},
+                       {'service_user_id': uuids.service},
+                       {'volume_ids': [uuids.volume, uuids.volume]},
+                       {'volume_ids': []}, {'kind': 'attach'},
+                       {'instance_uuid': 'not-a-uuid'}):
+            with self.subTest(fields=fields):
+                self.assertRaises(ValueError, contracts.validate_reserve_373,
+                                  reserve_payload(**fields))
+
+    def test_body_hash_uses_c1_canonical_form_and_binds_delegation(self):
+        value = reserve_payload()
+        reordered = dict(reversed(list(value.items())))
+        reordered['volume_ids'] = list(reversed(value['volume_ids']))
+        expected = contracts.body_hash(value)
+        self.assertEqual(expected, contracts.body_hash(reordered))
+        self.assertEqual(expected,
+                         legacy_contracts.canonical_payload_hash(value))
+        changed = dict(value, nova_operation_id=uuids.other_operation)
+        self.assertNotEqual(expected, contracts.body_hash(changed))
+        self.assertEqual(reserve_payload(), value)
+        self.assertRaises(ValueError, contracts.body_hash,
+                          {'connector': {'number': float('nan')}})
+
+    def test_attachment_hash_binds_connector_and_target(self):
+        value = attachment_request(action='update',
+                                   attachment_id=uuids.attachment,
+                                   connector={'host': 'compute-one'})
+        expected = contracts.body_hash(value)
+        changed = copy.deepcopy(value)
+        changed['connector']['host'] = 'compute-two'
+        self.assertNotEqual(expected, contracts.body_hash(changed))
+        changed = dict(value, attachment_id=uuids.other_attachment)
+        self.assertNotEqual(expected, contracts.body_hash(changed))
+
+    def test_attachment_result_has_no_sensitive_fields(self):
