+"""Authenticate the executor independently of the original operation actor."""
+
+from cinder.checkpoints import config
+from cinder import exception
+from cinder.policies import checkpoints as policies
+
+
+def require_executor(context) -> str:
+    """Policy cannot override mandatory token subject, role and allowlist.
+
+    Call only with a context produced by the authentication middleware or
+    the trusted RPC context serializer. Client-supplied scope fields do not
+    establish identity, and secondary service-token identity is not used.
+    Feature disablement does not prevent recovery of existing operations.
+    """
+    subject = context.user_id
+    if (not subject or not context.project_id or
+            'service' not in context.roles or subject not in
+            config.CONF.checkpoint.nova_service_user_ids):
+        raise exception.CheckpointServiceForbidden()
+    context.authorize(policies.CONTINUE_POLICY,
+                      target={'project_id': context.project_id,
+                              'user_id': subject})
+    return subject
diff --git a/cinder/checkpoints/continuation_contracts.py b/cinder/checkpoints/continuation_contracts.py
