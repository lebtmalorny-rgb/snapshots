Subject: [PATCH 1/3] fix: normalize checkpoint attachment connection
 information

---
 nova/tests/unit/volume/test_checkpoints.py | 49 ++++++++++++++++++++++
 nova/volume/checkpoints.py                 |  7 ++++
 2 files changed, 56 insertions(+)

diff --git a/nova/tests/unit/volume/test_checkpoints.py b/nova/tests/unit/volume/test_checkpoints.py
index 73832eb..f3c2d99 100644
--- a/nova/tests/unit/volume/test_checkpoints.py
+++ b/nova/tests/unit/volume/test_checkpoints.py
@@ -182,6 +182,55 @@ class CheckpointClientTest(test.NoDBTestCase):
             'volume 3.73', request.headers['OpenStack-API-Version']
         )
 
+    def attachment_response(self, connection_info):
+        return dict(
+            id=uuids.attachment, volume_id=uuids.volume,
+            instance=self.op.instance_uuid, status='attaching',
+            attach_mode='rw', attached_at=None, detached_at=None,
+            connection_info=connection_info,
+        )
+
+    def test_attachment_flat_wire_data_is_normalized_for_volume_driver(self):
+        value = self.attachment_response(dict(
+            driver_volume_type='iscsi', attachment_id=uuids.attachment,
+            volume_id=uuids.volume, target_portal='192.0.2.66:3260',
+            target_iqn='iqn.2026-10.invalid.test:volume', target_lun=0,
+        ))
+        self.respond('GET', self.url + '/attachments/' + uuids.attachment,
+                     json={'attachment': value})
+        result = self.client.get_attachment(
+            self.recovery, self.op.uuid, uuids.attachment)
+        self.assertEqual('iscsi', result['connection_info']['driver_volume_type'])
+        self.assertEqual(uuids.volume, result['connection_info']['data']['volume_id'])
+        self.assertEqual('192.0.2.66:3260',
+                         result['connection_info']['data']['target_portal'])
+        self.assertNotIn('attachment_id', result['connection_info']['data'])
+        for name in value.keys() - {'connection_info'}:
+            self.assertEqual(value[name], result[name])
+        self.assertEqual(['GET'], [r.method for r in self.http.request_history])
+        self.assertEqual('service-marker',
+                         self.http.last_request.headers['X-Auth-Token'])
+
+    def test_attachment_translation_does_not_mutate_response(self):
+        value = self.attachment_response(dict(
+            driver_volume_type='iscsi', attachment_id=uuids.attachment,
+            volume_id=uuids.volume, target_portals=['192.0.2.66:3260']))
+        original = copy.deepcopy(value)
+        with mock.patch.object(self.client, '_fetch', return_value=(value, 'nova-service')):
+            result = self.client.get_attachment(
+                self.recovery, self.op.uuid, uuids.attachment)
+        result['connection_info']['data']['target_portals'].append('192.0.2.67:3260')
+        self.assertEqual(original, value)
+
+    def test_attachment_without_connection_data_preserves_state(self):
+        for connection in (None, {}):
+            with self.subTest(connection=connection):
+                value = self.attachment_response(connection)
+                self.respond('GET', self.url + '/attachments/' + uuids.attachment,
+                             json={'attachment': value})
+                self.assertEqual(value, self.client.get_attachment(
+                    self.recovery, self.op.uuid, uuids.attachment))
+
     def test_missing_grant_does_not_fall_back_to_reserve(self):
         self.respond('GET', self.url, status_code=404, json={})
         self.assertRaises(
diff --git a/nova/volume/checkpoints.py b/nova/volume/checkpoints.py
index 1d6f1fe..44406c5 100644
--- a/nova/volume/checkpoints.py
+++ b/nova/volume/checkpoints.py
@@ -17,6 +17,7 @@ own service authentication and addresses the delegated operation UUID. No
 response URL, serialized context, bearer, or connection secret is persisted.
 """
 
+import copy
 import functools
 import re
 from urllib import parse
@@ -672,4 +673,10 @@ class CheckpointClient:
                 type(value['connection_info']) is dict
             )
         )
+        if value['connection_info'] is not None:
+            # Cinder attachment details use flat connection data. Preserve the
+            # attachment identity/status needed by the checkpoint coordinator
+            # while using Nova's standard translation for volume drivers.
+            translated = cinder._translate_attachment_ref(copy.deepcopy(value))
+            value = dict(value, connection_info=translated['connection_info'])
         return value
