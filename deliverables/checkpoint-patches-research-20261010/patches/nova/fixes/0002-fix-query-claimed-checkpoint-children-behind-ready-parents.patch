+    def interrupt_ready_save(self, after_receipt):
+        """Leave the exact durable parent/child shape of a killed worker."""
+        class Interrupted(BaseException):
+            pass
+
+        self.patch(coordinator.Coordinator, 'max_transitions', 1)
+        created = self.create()
+        self.drive_until(created, lambda: any(
+            s.phase == 'runtime_save' and s.status == 'ready'
+            for s in self.rows(created)))
+        parent = next(s for s in self.rows(created)
+                      if s.phase == 'runtime_save')
+        original = staging.RuntimeRecord.finish
+
+        def interrupted(record, result):
+            if after_receipt:
+                original(record, result)
+            raise Interrupted()
+
+        with context.target_cell(self.ctx, self.cells[0]) as ctx:
+            continuation = objects.CheckpointEffect.continuation(
+                ctx, parent.uuid)
+            instance = objects.Instance.get_by_uuid(ctx, self.servers[0])
+            engine = compute_v2.ComputeV2(self.drivers[0], instance.host)
+            with mock.patch.object(staging.RuntimeRecord, 'finish',
+                                   interrupted):
+                self.assertRaises(
+                    Interrupted, engine.continue_step, ctx, instance,
+                    created['operation']['id'], 1, parent.uuid,
+                    continuation['journal_revision'])
+            self.assertIsNone(objects.CheckpointEffect.continuation(
+                ctx, parent.uuid))
+            save = next(r for r in objects.CheckpointEffect.get_children(
+                ctx, parent.uuid) if r['action'] == 'save')
+            self.assertEqual('dispatching', save['status'])
+        self.assertEqual('ready', next(s for s in self.rows(created)
+                                     if s.phase == 'runtime_save').status)
+        return created
+
+    def test_ready_parent_queries_claimed_child_with_runtime_receipt(self):
+        created = self.interrupt_ready_save(after_receipt=True)
+        self.recover()
+        self.assertEqual('succeeded', next(s for s in self.rows(created)
+                                         if s.phase == 'runtime_save').status)
+        self.assertEqual(1, self.drivers[0].backend.calls['save'])
+        self.drive_until(created, lambda: self.operation(created)['state'] ==
+                         'succeeded')
+        self.assertEqual(1, self.drivers[0].backend.calls['save'])
+
+    def test_ready_parent_queries_claimed_child_without_runtime_receipt(self):
+        created = self.interrupt_ready_save(after_receipt=False)
+        before = dict(self.drivers[0].backend.calls)
+        self.recover()
+        self.recover()
+        self.assertEqual('unknown', next(s for s in self.rows(created)
+                                       if s.phase == 'runtime_save').status)
+        self.assertEqual('recovery_required', self.operation(created)['state'])
+        self.assertEqual(before, dict(self.drivers[0].backend.calls))
+        self.assertGreater(self.usage()['artifact_bytes'], 0)
+
     def add_disk(self):
 
