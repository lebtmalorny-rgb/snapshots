index c18030242966d6e6087ef4333c59e9d265c0b1d7..e80024267bb0bb9e240ed563e0decd336e1f9980 100644
--- a/nova/checkpoints/compute.py
+++ b/nova/checkpoints/compute.py
@@ -13,6 +13,7 @@
 """Compute journal consumer using remotable Nova objects for persistence."""
 
 from nova.checkpoints import contracts as c
+from nova.checkpoints import contracts_v2 as v2
 from nova.checkpoints import guards
 from nova.checkpoints import workflow
 from nova import conf
@@ -25,6 +26,63 @@ class ComputeExecutor:
         self.driver = driver
         self.host = host
 
+    @staticmethod
+    def check_probe_binding(context, instance, purpose, checkpoint_id,
+                            operation_id):
+        c._require(purpose in ('create', 'revert', 'delete', 'recover'))
+        c._require(context.project_id == instance.project_id)
+        if purpose in ('revert', 'delete'):
+            c._uuid(checkpoint_id)
+        if purpose == 'recover':
+            c._uuid(operation_id)
+        if operation_id is not None:
+            c._uuid(operation_id)
+            operation = objects.InstanceCheckpointOperation.get_by_uuid(
+                context, operation_id)
+            c._require(operation.instance_uuid == instance.uuid and
+                        operation.project_id == instance.project_id and
+                        operation.host == instance.host and
+                        operation.node == instance.node)
+            if checkpoint_id is not None:
+                c._require(checkpoint_id == operation.checkpoint_id)
+            checkpoint_id = operation.checkpoint_id
+        if checkpoint_id is not None:
+            c._uuid(checkpoint_id)
+            checkpoint = objects.InstanceCheckpoint.get_by_uuid(
+                context, checkpoint_id)
+            c._require(checkpoint.instance_uuid == instance.uuid and
+                        checkpoint.project_id == instance.project_id)
+            if purpose == 'revert' and operation_id is None:
+                c._require(checkpoint.status == 'available')
+
+    def probe_v2(self, context, instance, manifest, purpose,
+                 checkpoint_id=None, operation_id=None):
+        if operation_id is None and not conf.CONF.checkpoint.enabled:
+            return v2.unsupported('disabled')
+        try:
+            self.check_probe_binding(context, instance, purpose, checkpoint_id,
+                                     operation_id)
+            c._require(instance.host == self.host and
+                        manifest.get('host') == self.host and
+                        manifest.get('node') == instance.node and
+                        manifest.get('instance_uuid') == instance.uuid)
+            current = objects.InstanceCheckpointOperation.device_manifest(
+                context, instance.uuid)
+            c._require(c.device_fingerprint(current) ==
+                        c.device_fingerprint(manifest))
+            value = self.driver.checkpoint_probe_v2(
+                context, instance, current, purpose,
+                checkpoint_id=checkpoint_id, operation_id=operation_id)
+            probe = v2.validate_probe(value)
+            if probe.supported and probe.fingerprint != (
+                    c.device_fingerprint(current)):
+                return v2.unsupported('identity_changed')
+            return probe
+        except (ValueError, exception.NotFound, exception.CheckpointConflict):
+            return v2.unsupported('identity_changed')
+        except Exception:
+            return v2.unsupported('executor_unavailable')
+
     def probe(self, context, instance, manifest, existing=False):
         if not existing and not conf.CONF.checkpoint.enabled:
             return c.unsupported('disabled')
diff --git a/nova/checkpoints/contracts_v2.py b/nova/checkpoints/contracts_v2.py
new file mode 100644
index 0000000000000000000000000000000000000000..e7716fd8c600e094275eeddcaeea712518d6f2eb
--- /dev/null
+++ b/nova/checkpoints/contracts_v2.py
@@ -0,0 +1,401 @@
+# Licensed under the Apache License, Version 2.0 (the "License"); you may
+# not use this file except in compliance with the License. You may obtain
+# a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+# WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+# License for the specific language governing permissions and limitations
+# under the License.
+
+"""Strict v2 shapes. Only the cell journal can establish effect authority."""
+
+from collections.abc import Mapping
+import dataclasses
+import re
+
+from nova.checkpoints import contracts as v1
+from nova.checkpoints import workflow_v2 as workflow
+
+REASONS = v1.REASONS | frozenset(('store_unavailable', 'profile_unverified',
+                                 'authorization_required', 'artifact_corrupt'))
+
+
+def validate_generation(value):
+    v1._integer(value, minimum=1, maximum=1)
+
+
+def public_reason(value):
+    return {'store_unavailable': 'executor_unavailable',
+            'profile_unverified': 'unsupported_profile',
+            'authorization_required': 'recovery_required',
+            'artifact_corrupt': 'recovery_required'}.get(
+                value, v1.reason_code(value))
+
+
+def _safe_payload(value):
+    if isinstance(value, Mapping):
+        forbidden = {'xml', 'saved_xml', 'connection_info', 'auth_token',
+                     'user_token', 'password', 'auth_password', 'secret',
+                     'ram_path', 'path', 'bearer', 'connector'}
+        v1._require(not (set(value) & forbidden))
+        for item in value.values():
+            _safe_payload(item)
+    elif isinstance(value, (tuple, list)):
+        for item in value:
+            _safe_payload(item)
+
+
+class _Contract(v1._Contract):
+    def to_primitive(self):
+        value = super().to_primitive()
+        value['schema_version'] = 2
+        return value
+
+    @classmethod
+    def from_primitive(cls, value):
+        names = {field.name for field in dataclasses.fields(cls)}
+        v1._keys(value, names | {'schema_version'})
+        v1._integer(value['schema_version'], minimum=2, maximum=2)
+        values = {key: v1._json(value[key]) for key in names}
+        if cls is AdmissionV2:
+            values['key'] = v1.RequestKey.from_primitive(values['key'])
+        return cls(**values)
+
+
+@dataclasses.dataclass(frozen=True)
+class Binding(_Contract):
+    deployment_id: str
+    cell_uuid: str
+    project_id: str
+    instance_uuid: str
+    checkpoint_id: str
+    host: str
+    node: str
+    executor_id: str
+    db_fingerprint: str
+    runtime_fingerprint: str
+    runtime_profile_id: str
+    store_profile_id: str
+    staging_profile_id: str
+
+    def _validate(self):
+        for name in ('deployment_id', 'cell_uuid', 'instance_uuid',
+                     'checkpoint_id', 'runtime_profile_id',
+                     'store_profile_id', 'staging_profile_id'):
+            v1._uuid(getattr(self, name))
+        for name in ('project_id', 'host', 'node', 'executor_id'):
+            v1._string(getattr(self, name))
+        v1._digest(self.db_fingerprint)
+        v1._digest(self.runtime_fingerprint)
+
+
+@dataclasses.dataclass(frozen=True)
+class ArtifactRef(_Contract):
+    id: str
+    kind: str
+    logical_id: str
+    bytes: int
+    checksum: str
+    location: str
+
+    def _validate(self):
+        v1._uuid(self.id)
+        v1._require(self.kind in ('ram', 'runtime', 'config'))
+        v1._require(self.location in ('staging', 'shared'))
+        v1._require(type(self.logical_id) is str and re.fullmatch(
+            '[A-Za-z0-9_-]{1,255}', self.logical_id))
+        v1._integer(self.bytes, minimum=1)
+        v1._digest(self.checksum)
+
+
+@dataclasses.dataclass(frozen=True)
+class ProbeV2(_Contract):
+    supported: bool
+    reasons: tuple
+    executor_id: str
+    executor_profile: str
+    fingerprint: str
+    device_manifest: dict
+    artifact_upper_bound: int
+    runtime_fingerprint: str
+    runtime_profile_id: str
+    store_profile_id: str
+    staging_profile_id: str
+    save_bytes_limit: int
+    restore_bytes_limit: int
+    contract_version: int = 2
+
+    def _validate(self):
+        v1._require(type(self.supported) is bool)
+        v1._require(type(self.reasons) is tuple and all(
+            type(code) is str and code in REASONS for code in self.reasons))
+        v1._integer(self.contract_version, minimum=2, maximum=2)
+        identities = ('executor_id', 'executor_profile', 'fingerprint',
+                      'runtime_fingerprint', 'runtime_profile_id',
+                      'store_profile_id', 'staging_profile_id')
+        if self.supported:
+            v1._require(not self.reasons)
+            v1._string(self.executor_id)
+            v1._require(self.executor_profile == v1.PROFILE)
+            v1._require(self.fingerprint == v1.device_fingerprint(
+                self.device_manifest))
+            v1._digest(self.runtime_fingerprint)
+            for name in identities[-3:]:
+                v1._uuid(getattr(self, name))
+            for name in ('artifact_upper_bound', 'save_bytes_limit',
+                         'restore_bytes_limit'):
+                v1._integer(getattr(self, name), minimum=1)
+            v1._require(self.artifact_upper_bound >= self.save_bytes_limit)
+        else:
+            v1._require(bool(self.reasons))
+            v1._require(all(getattr(self, key) == '' for key in identities))
+            v1._require(isinstance(self.device_manifest, Mapping) and
+                        not self.device_manifest)
+            for name in ('artifact_upper_bound', 'save_bytes_limit',
+                         'restore_bytes_limit'):
+                v1._integer(getattr(self, name), maximum=0)
+
+
+def unsupported(reason='executor_unsupported'):
+    reason = reason if type(reason) is str and reason in REASONS else (
+        'invalid_executor_result')
+    return ProbeV2(False, (reason,), '', '', '', {}, 0, '', '', '', '', 0, 0)
+
+
+def validate_probe(value):
+    try:
+        return ProbeV2.from_primitive(value)
+    except (ValueError, TypeError, KeyError, AttributeError):
+        return unsupported('invalid_executor_result')
+
+
+@dataclasses.dataclass(frozen=True)
+class AdmissionV2(_Contract):
+    key: v1.RequestKey
+    operation_id: str
+    checkpoint_id: str
+    cell_uuid: str
+    host: str
+    node: str
+    fingerprint: str
+    device_manifest: dict
+    artifact_upper_bound: int
+    executor_id: str
+    name: str
+    runtime_fingerprint: str
+    runtime_profile_id: str
+    store_profile_id: str
+    staging_profile_id: str
+    save_bytes_limit: int
+    restore_bytes_limit: int
+
+    def _validate(self):
+        v1.Admission._validate(self)
+        v1._digest(self.runtime_fingerprint)
+        for name in ('runtime_profile_id', 'store_profile_id',
+                     'staging_profile_id'):
+            v1._uuid(getattr(self, name))
+        for name in ('save_bytes_limit', 'restore_bytes_limit'):
+            v1._integer(getattr(self, name), minimum=1)
+        v1._require(self.artifact_upper_bound >= self.save_bytes_limit)
+
+
+def decode_admission(value):
+    v1._require(isinstance(value, Mapping))
+    version = value.get('schema_version')
+    v1._integer(version, minimum=1, maximum=2)
+    cls = v1.Admission if version == 1 else AdmissionV2
+    return cls.from_primitive(value)
+
+
+@dataclasses.dataclass(frozen=True)
+class ChildIntent(_Contract):
+    id: str
+    parent_step_id: str
+    operation_id: str
+    generation: int
+    action: str
+    resource_id: str
+    executor_id: str
+    payload_hash: str
+    payload: dict
+
+    def _validate(self):
+        for name in ('id', 'parent_step_id', 'operation_id', 'resource_id'):
+            v1._uuid(getattr(self, name))
+        validate_generation(self.generation)
+        v1._require(self.action in workflow.ACTIONS)
+        v1._string(self.executor_id)
+        v1._digest(self.payload_hash)
+        v1._require(
+            self.payload_hash == v1.canonical_payload_hash(self.payload))
+        _safe_payload(self.payload)
+
+
+@dataclasses.dataclass(frozen=True)
+class StepIntentV2(_Contract):
+    id: str
+    operation_id: str
+    generation: int
+    phase: str
+    executor_id: str
+    payload_hash: str
+    payload: dict
+
+    def _validate(self):
+        v1._uuid(self.id)
+        v1._uuid(self.operation_id)
+        validate_generation(self.generation)
+        v1._require(self.phase in workflow.PHASES)
+        v1._string(self.executor_id)
+        v1._digest(self.payload_hash)
+        v1._require(
+            self.payload_hash == v1.canonical_payload_hash(self.payload))
+        _safe_payload(self.payload)
+        v1._keys(self.payload, ('binding', 'kind', 'generation', 'budgets',
+                               'children', 'prior', 'resources'))
+        Binding.from_primitive(self.payload['binding'])
+        v1._require(self.payload['kind'] in ('create', 'revert', 'delete',
+                                            'cleanup'))
+        validate_generation(self.payload['generation'])
+        v1._ids(self.payload['children'])
+
+
+@dataclasses.dataclass(frozen=True)
+class Continuation(_Contract):
+    step_id: str
+    journal_revision: int
+    next_child_id: str
+
+    def _validate(self):
+        v1._uuid(self.step_id)
+        v1._integer(self.journal_revision, minimum=1)
+        v1._uuid(self.next_child_id)
+
+
+@dataclasses.dataclass(frozen=True)
+class TemporaryProof(_Contract):
+    ticket_id: str
+    operation_id: str
+    cell_uuid: str
+    version: int
+    kind: str
+    closed_child_ids: tuple
+
+    def _validate(self):
+        for name in ('ticket_id', 'operation_id', 'cell_uuid'):
+            v1._uuid(getattr(self, name))
+        v1._integer(self.version, minimum=1)
+        v1._require(self.kind in ('cancelled_before_write', 'staging_deleted'))
+        v1._ids(self.closed_child_ids)
+
+
+@dataclasses.dataclass(frozen=True)
+class EffectResult(_Contract):
+    status: str
+    evidence: dict
+    error_code: str | None
+
+    def _validate(self):
+        v1._require(self.status in ('pending', 'succeeded', 'failed_no_effect',
+                                    'failed_with_effects', 'unknown', 'ready'))
+        v1._require(isinstance(self.evidence, Mapping))
+        v1._require(self.error_code is None or (
+            type(self.error_code) is str and self.error_code in REASONS))
+        if self.status in ('succeeded', 'ready'):
+            v1._require(self.error_code is None)
+        _safe_payload(self.evidence)
+
+
+def _artifacts(value, location=None):
+    v1._require(type(value) in (list, tuple) and bool(value))
+    artifacts = [ArtifactRef.from_primitive(item) for item in value]
+    v1._ids([item.id for item in artifacts], nonempty=True)
+    if location:
+        v1._require(all(item.location == location for item in artifacts))
+
+
+def _success(phase, evidence):
+    if phase in ('artifact_publish_shared', 'artifact_stage'):
+        v1._keys(evidence, ('artifacts',))
+        location = (
+            'shared' if phase == 'artifact_publish_shared' else 'staging')
+        _artifacts(evidence['artifacts'], location)
+    elif phase == 'runtime_save':
+        v1._keys(evidence, ('writes_stopped', 'artifacts'))
+        v1._require(evidence['writes_stopped'] is True)
+        _artifacts(evidence['artifacts'], 'staging')
+    elif phase == 'staging_cleanup':
+        v1._keys(evidence, ('artifact_ids', 'deleted_artifact_ids',
+                           'late_effect_impossible'))
+        v1._same_ids(
+            evidence['artifact_ids'], evidence['deleted_artifact_ids'])
+        v1._require(evidence['late_effect_impossible'] is True)
+    else:
+        v1._success_evidence(phase, evidence)
+
+
+def _validate(value, success, parent=False):
+    result = EffectResult.from_primitive(value)
+    evidence = result.evidence
+    if result.status == 'succeeded':
+        success(evidence)
+    elif result.status == 'ready':
+        v1._require(parent)
+        v1._keys(evidence, ('step_id', 'journal_revision', 'next_child_id'))
+        Continuation(**evidence)
+    elif result.status == 'failed_no_effect':
+        v1._keys(evidence, ('no_effect', 'late_effect_impossible'))
+        v1._require(evidence['no_effect'] is True and
+                    evidence['late_effect_impossible'] is True and
+                    result.error_code is not None)
+    elif result.status == 'failed_with_effects':
+        v1._keys(evidence, ('resource_ids', 'terminal_child_ids',
+                           'late_effect_impossible'))
+        v1._ids(evidence['resource_ids'], nonempty=True)
+        v1._ids(evidence['terminal_child_ids'], nonempty=True)
+        v1._require(evidence['late_effect_impossible'] is True and
+                    result.error_code is not None)
+    else:
+        v1._keys(evidence, ())
+    return result
+
+
+def validate_result(phase, value):
+    try:
+        v1._require(phase in workflow.PHASES)
+        return _validate(value, lambda e: _success(phase, e), parent=True)
+    except (ValueError, TypeError, KeyError, AttributeError):
+        return EffectResult('unknown', {}, 'invalid_executor_result')
+
+
+def _child_success(action, evidence):
+    if action in ('restore_paused', 'unpause'):
+        v1._keys(evidence, ('fingerprint', 'power_state'))
+        v1._digest(evidence['fingerprint'])
+        v1._require(evidence['power_state'] == (
+            'PAUSED' if action == 'restore_paused' else 'RUNNING'))
+    elif action in ('save', 'stop', 'reserve', 'release', 'inspect'):
+        _success({'save': 'runtime_save', 'stop': 'runtime_stop',
+                  'reserve': 'cinder_reserve', 'release': 'cinder_release',
+                  'inspect': 'preflight'}[action], evidence)
+    elif action in ('publish', 'download', 'copy_config'):
+        v1._keys(evidence, ('artifact',))
+        artifact = ArtifactRef.from_primitive(evidence['artifact'])
+        v1._require(artifact.location == (
+            'shared' if action == 'publish' else 'staging'))
+    else:
+        # Until the owning adapter defines its closed success shape, a new
+        # action cannot accidentally pass on an empty/opaque success marker.
+        raise ValueError('Unimplemented checkpoint child evidence')
+
+
+def validate_child_result(action, value):
+    try:
+        v1._require(action in workflow.ACTIONS)
+        return _validate(value, lambda e: _child_success(action, e))
+    except (ValueError, TypeError, KeyError, AttributeError):
+        return EffectResult('unknown', {}, 'invalid_executor_result')
diff --git a/nova/checkpoints/coordinator.py b/nova/checkpoints/coordinator.py
index ece178cf02d4774cf929b7172154ddf2c0a86a22..1186980ec015134c85c7a1b72266f96100545942 100644
--- a/nova/checkpoints/coordinator.py
+++ b/nova/checkpoints/coordinator.py
@@ -12,7 +12,9 @@
 
 """Conductor coordination; cell/RPC/API DB transitions are separate calls."""
 
+from nova.checkpoints import compute as checkpoint_compute
 from nova.checkpoints import contracts as c
+from nova.checkpoints import contracts_v2 as v2
 from nova.checkpoints import quota
 from nova.compute import rpcapi
 from nova import conf
@@ -78,6 +80,44 @@ class Coordinator:
         except Exception:
             return c.unsupported('executor_unavailable')
 
+    def probe_v2(self, context, instance_uuid, purpose, checkpoint_id=None,
+                 operation_id=None):
+        if operation_id is None and not conf.CONF.checkpoint.enabled:
+            return v2.unsupported('disabled')
+        try:
+            cell = self._cell(context, instance_uuid)
+            with nova_context.target_cell(context, cell) as ctx:
+                instance = objects.Instance.get_by_uuid(ctx, instance_uuid)
+                checkpoint_compute.ComputeExecutor.check_probe_binding(
+                    ctx, instance, purpose, checkpoint_id, operation_id)
+                if operation_id is not None:
+                    operation = (
+                        objects.InstanceCheckpointOperation.get_by_uuid(
+                            ctx, operation_id))
+                    c._require(operation.cell_uuid == cell.uuid)
+                service = objects.Service.get_by_host_and_binary(
+                    ctx, instance.host, 'nova-compute')
+                if service.version < 70:
+                    return v2.unsupported('incompatible_service')
+                manifest = objects.InstanceCheckpointOperation.device_manifest(
+                    ctx, instance_uuid)
+                value = self.compute_rpc.checkpoint_probe_v2(
+                    ctx, instance, manifest, purpose,
+                    checkpoint_id=checkpoint_id, operation_id=operation_id)
+                probe = v2.validate_probe(value)
+                if probe.supported and probe.fingerprint != (
+                        c.device_fingerprint(manifest)):
+                    return v2.unsupported('identity_changed')
+                return probe
+        except exception.CheckpointNotSupported:
+            return v2.unsupported('incompatible_service')
+        except exception.CheckpointUnavailable:
+            return v2.unsupported('cell_unavailable')
+        except (ValueError, exception.NotFound, exception.CheckpointConflict):
+            return v2.unsupported('identity_changed')
+        except Exception:
+            return v2.unsupported('executor_unavailable')
+
     def run(
         self, context, instance_uuid, operation_id, generation, recovery=False
     ):
diff --git a/nova/checkpoints/workflow_v2.py b/nova/checkpoints/workflow_v2.py
new file mode 100644
index 0000000000000000000000000000000000000000..580d274fccfad5842b6a92cc00942f28f30c2acd
--- /dev/null
+++ b/nova/checkpoints/workflow_v2.py
@@ -0,0 +1,39 @@
+# Licensed under the Apache License, Version 2.0 (the "License"); you may
+# not use this file except in compliance with the License. You may obtain
+# a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+# WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+# License for the specific language governing permissions and limitations
+# under the License.
+
+"""V2 ordering keeps both RAM copies charged until the writer is fenced."""
+
+CREATE = ('preflight', 'cinder_reserve', 'runtime_save', 'disk_snapshot',
+          'artifact_publish_shared', 'runtime_restore_current',
+          'staging_cleanup', 'cinder_release')
+REVERT = ('preflight', 'cinder_reserve', 'artifact_stage', 'runtime_stop',
+          'volume_disconnect', 'disk_revert', 'volume_reconnect',
+          'runtime_restore_checkpoint', 'staging_cleanup', 'cinder_release')
+DELETE = ('cinder_reserve', 'disk_snapshot_delete', 'artifact_delete',
+          'cinder_release')
+CLEANUP = ('cleanup_runtime_restore_current', 'cleanup_disk_snapshots',
+           'cleanup_artifacts', 'staging_cleanup', 'cleanup_cinder_release')
+PHASES = frozenset(CREATE + REVERT + DELETE + CLEANUP)
+ACTIONS = frozenset(('inspect', 'reserve', 'reserve_staging', 'copy_config',
+                     'save', 'submit_disk_operation', 'publish', 'download',
+                     'delete', 'stop', 'restore_paused', 'unpause',
+                     'host_disconnect', 'attachment_delete',
+                     'attachment_create', 'attachment_update', 'host_connect',
+                     'bdm_update', 'attachment_complete', 'release'))
+
+
+def steps_for(kind):
+    try:
+        return {'create': CREATE, 'revert': REVERT, 'delete': DELETE,
+                'cleanup': CLEANUP}[kind]
+    except (KeyError, TypeError):
+        raise ValueError('Invalid checkpoint workflow') from None
