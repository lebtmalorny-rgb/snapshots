+class ProfilesTest(test.NoDBTestCase):
+    def test_profile_requires_exact_observation_and_qualification_digest(self):
+        observed = {'mount_identity': 'mount-one'}
+        record = profiles.ProfileMatch(
+            uuids.store, 'store', v1.canonical_payload_hash(observed),
+            'b' * 64, observed, {'max_bytes': 8192})
+        group = profiles.ProfileSet((record,))
+        self.assertEqual(record, group.match(observed))
+        self.assertIsNone(group.match({'mount_identity': 'mount-two'}))
+        self.assertRaises(ValueError, dataclasses.replace, record,
+                          qualification_sha256='')
+        self.assertRaises(ValueError, dataclasses.replace, record,
+                          identity_sha256='c' * 64)
+        self.assertRaises(ValueError, dataclasses.replace, record,
+                          limits={'max_bytes': True})
+
+    def test_profile_file_is_closed_and_cannot_be_group_writable(self):
+        with tempfile.TemporaryDirectory() as root:
+            path = os.path.join(root, 'profiles.json')
+            with open(path, 'w') as stream:
+                jsonutils.dump({'schema_version': 1, 'records': []}, stream)
+            os.chmod(path, 0o600)
+            self.assertIsNone(profiles.load(path).match({}))
+            os.chmod(path, 0o666)
+            self.assertRaises(ValueError, profiles.load, path)
+            os.chmod(path, 0o600)
+            with open(path, 'w') as stream:
+                jsonutils.dump({'schema_version': 1, 'records': [],
+                           'qualified': True}, stream)
+            self.assertRaises(ValueError, profiles.load, path)
