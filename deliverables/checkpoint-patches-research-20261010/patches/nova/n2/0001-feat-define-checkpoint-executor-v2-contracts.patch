+"""Root-controlled component allowlist; records alone never prove readiness."""
+
+from collections.abc import Mapping
+import dataclasses
+import os
+import stat
+
+from oslo_serialization import jsonutils
+
+from nova.checkpoints import contracts as c
+
+
+@dataclasses.dataclass(frozen=True)
+class ProfileMatch:
+    id: str
+    kind: str
+    identity_sha256: str
+    qualification_sha256: str
+    observed: dict
+    limits: dict
+
+    def __post_init__(self):
+        c._uuid(self.id)
+        c._require(self.kind in ('runtime', 'store', 'staging'))
+        c._digest(self.identity_sha256)
+        c._digest(self.qualification_sha256)
+        c._require(isinstance(self.observed, Mapping) and bool(self.observed))
+        c._require(self.identity_sha256 == c.canonical_payload_hash(
+            self.observed))
+        c._require(isinstance(self.limits, Mapping) and bool(self.limits))
+        for key, value in self.limits.items():
+            c._string(key)
+            c._integer(value, minimum=1)
+        for name in ('observed', 'limits'):
+            object.__setattr__(self, name, c._freeze(c._json(
+                getattr(self, name))))
+
+
+@dataclasses.dataclass(frozen=True)
+class ProfileSet:
+    records: tuple
+
+    def __post_init__(self):
+        c._require(type(self.records) is tuple and all(
+            type(item) is ProfileMatch for item in self.records))
+        c._ids([item.id for item in self.records])
+
+    def match(self, observed):
+        digest = c.canonical_payload_hash(observed)
+        matches = [r for r in self.records if r.identity_sha256 == digest and
+                   r.observed == c._freeze(c._json(observed))]
+        # Ambiguous records are not permission to choose whichever is easier.
+        return matches[0] if len(matches) == 1 else None
+
+
+def _unique_pairs(pairs):
+    value = {}
+    for key, item in pairs:
+        c._require(key not in value)
+        value[key] = item
+    return value
+
+
+def load(path):
+    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+    with os.fdopen(descriptor, 'r') as stream:
+        info = os.fstat(stream.fileno())
+        c._require(stat.S_ISREG(info.st_mode) and info.st_uid == 0 and
+                   not (info.st_mode & 0o022) and info.st_size <= 1024 * 1024)
+        value = jsonutils.loads(stream.read(1024 * 1024 + 1),
+                           object_pairs_hook=_unique_pairs)
+    c._keys(value, ('schema_version', 'records'))
+    c._integer(value['schema_version'], minimum=1, maximum=1)
+    c._require(type(value['records']) is list)
+    fields = {item.name for item in dataclasses.fields(ProfileMatch)}
+    records = []
+    for record in value['records']:
+        c._keys(record, fields)
+        records.append(ProfileMatch(**record))
+    return ProfileSet(tuple(records))
