+class ContractsV2Test(test.NoDBTestCase):
+    def test_generation_and_closed_ready_evidence(self):
+        good = dict(step_id=uuids.step, journal_revision=1,
+                    next_child_id=uuids.child)
+        self.assertEqual('ready', v2.validate_result(
+            'runtime_save', result('ready', good)).status)
+        for delta in ({'force': True}, {'journal_revision': True},
+                      {'next_child_id': 'bad'}):
+            self.assertEqual('unknown', v2.validate_result(
+                'runtime_save', result('ready', dict(good, **delta))).status)
+        for value in (True, False, 0, 2, '1'):
+            self.assertRaises(ValueError, v2.validate_generation, value)
+        self.assertEqual('unknown', v2.validate_child_result(
+            'save', result('ready', good)).status)
+
+    def test_failed_results_cannot_hide_residues(self):
+        self.assertEqual('failed_no_effect', v2.validate_result(
+            'runtime_save', result('failed_no_effect', dict(
+                no_effect=True, late_effect_impossible=True),
+                'executor_rejected')).status)
+        partial = dict(resource_ids=[uuids.ram],
+                       terminal_child_ids=[uuids.child],
+                       late_effect_impossible=True)
+        self.assertEqual('failed_with_effects', v2.validate_result(
+            'runtime_save', result('failed_with_effects', partial,
+                                   'resources_remaining')).status)
+        for evidence in ({}, dict(partial, late_effect_impossible=False),
+                         dict(partial, resource_ids=[uuids.ram, uuids.ram])):
+            self.assertEqual('unknown', v2.validate_result(
+                'runtime_save', result('failed_with_effects', evidence,
+                                       'resources_remaining')).status)
+        self.assertEqual('unknown', v2.validate_result(
+            'runtime_save', result('unknown', partial)).status)
+
+    def test_restore_child_is_paused_but_parent_must_be_running(self):
+        evidence = dict(fingerprint='a' * 64, power_state='PAUSED')
+        self.assertEqual('succeeded', v2.validate_child_result(
+            'restore_paused', result('succeeded', evidence)).status)
+        self.assertEqual('unknown', v2.validate_result(
+            'runtime_restore_checkpoint', result('succeeded', evidence)
+        ).status)
