+# under the License.
+
+import copy
+import hashlib
+import os
+from pathlib import Path
+import tempfile
+from unittest import mock
+
+from oslo_serialization import jsonutils
+from oslo_utils.fixture import uuidsentinel as uuids
+
+from nova.checkpoints import contracts as c
+from nova.checkpoints import qualification as q
+from nova import test
+from nova.virt.libvirt.checkpoints import profiles
+
+
+class QualificationTest(test.NoDBTestCase):
+    def setUp(self):
+        super().setUp()
+        directory = tempfile.TemporaryDirectory()
+        self.addCleanup(directory.cleanup)
+        self.root = Path(directory.name)
+        self.measured = {
+            kind: dict(kind=kind, test_only=True)
+            for kind in ('runtime', 'store', 'staging')
+        }
+        self.report = dict(
+            schema_version=1,
+            scope='components',
+            measured=self.measured,
+            metrics=dict(pause_milliseconds=1500, peak_bytes=4096),
+            checks={},
+        )
+        for name in q.COMPONENT_CHECKS:
+            evidence = dict(
+                check=name,
+                status='pass',
+                measured_sha256=c.canonical_payload_hash(self.measured),
+                artifacts=[
+                    dict(
+                        path='capture.txt',
+                        sha256=hashlib.sha256(
+                            b'captured output'
+                        ).hexdigest(),
+                    )
+                ],
+            )
+            (self.root / 'capture.txt').write_bytes(b'captured output')
+            path = self.root / (name + '.json')
+            path.write_text(jsonutils.dumps(evidence))
+            self.report['checks'][name] = dict(
+                status='pass',
+                evidence=[
+                    dict(
+                        path=path.name,
+                        sha256=hashlib.sha256(
+                            path.read_bytes()
+                        ).hexdigest(),
+                    )
+                ],
+            )
+
+    def validate(self):
+        return q.validate_report(self.report, str(self.root))
+
+    def test_components_report_is_not_stack_acceptance(self):
+        result = self.validate()
+        self.assertTrue(result['qualified'])
+        self.assertFalse(result['stack_qualified'])
+        self.report['scope'] = 'stack'
+        self.assertFalse(self.validate()['qualified'])
+
+    def test_skipped_required_check_never_qualifies_profile(self):
+        name = q.COMPONENT_CHECKS[0]
+        self.report['checks'][name]['status'] = 'skipped'
+        result = self.validate()
+        self.assertFalse(result['qualified'])
+        self.assertIn(name, result['unverified'])
+
+    def test_missing_evidence_never_qualifies_profile(self):
+        (self.root / (q.COMPONENT_CHECKS[0] + '.json')).unlink()
+        self.assertFalse(self.validate()['qualified'])
+
+    def test_modified_or_missing_raw_capture_never_qualifies(self):
+        (self.root / 'capture.txt').write_bytes(b'changed')
+        self.assertFalse(self.validate()['qualified'])
+
+    def test_claimed_qualified_and_partial_checks_are_not_trusted(self):
+        self.report['qualified'] = True
+        self.report['stack_qualified'] = True
+        self.report['checks'].pop(q.COMPONENT_CHECKS[0])
+        self.assertFalse(self.validate()['qualified'])
+
+    def test_evidence_is_bound_to_measured_tuple(self):
+        self.report['measured']['runtime']['version'] = 'changed'
+        self.assertFalse(self.validate()['qualified'])
+
+    def test_symlink_and_parent_traversal_cannot_supply_evidence(self):
+        name = q.COMPONENT_CHECKS[0]
+        source = self.root / (name + '.json')
+        link = self.root / 'linked.json'
+        os.symlink(source, link)
+        self.report['checks'][name]['evidence'][0]['path'] = link.name
+        self.assertFalse(self.validate()['qualified'])
+        self.report['checks'][name]['evidence'][0]['path'] = (
+            '../' + self.root.name + '/' + source.name
+        )
+        self.assertFalse(self.validate()['qualified'])
+
+    def test_summarize_rejects_invalid_status_and_missing_required(self):
+        self.assertRaises(ValueError, q.summarize, {}, ('required',))
+        self.assertRaises(
+            ValueError, q.summarize, dict(required='ok'), ('required',)
+        )
+        self.assertEqual(
+            dict(qualified=False, unverified=['writer_hard_limit']),
+            q.summarize(
+                dict(
+                    libvirt_repeat_restore='pass',
+                    writer_hard_limit='skipped',
+                ),
+                ('libvirt_repeat_restore', 'writer_hard_limit'),
+            ),
+        )
+
+    def test_negative_or_bool_measurements_rejected(self):
+        for value in (-1, True):
+            self.report['metrics']['peak_bytes'] = value
+            self.assertRaises(ValueError, self.validate)
+
+    def test_profile_tuple_mismatch_is_unsupported(self):
+        observed = self.measured['runtime']
+        profile = profiles.ProfileMatch(
+            uuids.runtime,
+            'runtime',
+            c.canonical_payload_hash(observed),
+            'a' * 64,
+            observed,
+            dict(max_bytes=4096),
+        )
+        changed = dict(observed, version='different')
+        self.assertIsNone(profiles.ProfileSet((profile,)).match(changed))
+
+    def test_inspect_never_changes_vm_or_creates_allowlist(self):
+        config = self.root / 'nova.conf'
+        config.write_text(
+            '[checkpoint]\nprofile_file=/no-profile\n'
+            'store_root=/no-store\nstaging_root=/no-staging\n'
+            '[libvirt]\nconnection_uri=qemu:///system\n'
+        )
+        with mock.patch.object(
+            q,
+            '_runtime',
+            return_value=copy.deepcopy(self.measured['runtime']),
+        ) as runtime:
+            result = q.inspect(str(config))
+        runtime.assert_called_once_with('qemu:///system')
+        self.assertFalse(result['qualified'])
+        self.assertFalse(result['stack_qualified'])
+        self.assertNotIn('records', result)
+        self.assertTrue(
+            all(
+                v['status'] == 'skipped' for v in result['checks'].values()
+            )
+        )
+
+    def test_runtime_inspection_uses_readonly_connection_and_closes(self):
+        libvirt = mock.Mock()
+        connection = mock.Mock()
+        connection.getCapabilities.return_value = '<capabilities/>'
+        connection.getURI.return_value = 'qemu:///system'
+        connection.getLibVersion.return_value = 11010000
+        connection.getVersion.return_value = 9002000
+        libvirt.openReadOnly.return_value = connection
+        libvirt.open.side_effect = AssertionError('write connection')
+        with mock.patch.dict('sys.modules', libvirt=libvirt):
+            value = q._runtime('qemu:///system')
+        libvirt.openReadOnly.assert_called_once_with('qemu:///system')
+        libvirt.open.assert_not_called()
+        self.assertEqual(11010000, value['libvirt_version'])
+        connection.close.assert_called_once_with()
+        self.assertEqual(
+            {
+                'getCapabilities',
+                'getLibVersion',
+                'getVersion',
+                'getURI',
+                'close',
+            },
+            {call[0] for call in connection.mock_calls},
+        )
+
+    def test_stack_evidence_binds_target_and_metrics(self):
+        self.report['scope'] = 'stack'
+        self.report['target'] = dict(
+            instance_uuid=uuids.instance,
+            host='compute',
+            volume_ids=[uuids.volume],
+        )
+        for name in q.STACK_CHECKS:
+            value = dict(
+                check=name,
+                status='pass',
+                measured_sha256=c.canonical_payload_hash(self.measured),
+                target_sha256=c.canonical_payload_hash(
+                    self.report['target']
+                ),
+                artifacts=[
+                    dict(
+                        path='capture.txt',
+                        sha256=hashlib.sha256(
+                            b'captured output'
+                        ).hexdigest(),
+                    )
+                ],
+            )
+            if name == 'pause_and_peak_bytes':
+                value['metrics_sha256'] = c.canonical_payload_hash(
+                    self.report['metrics']
+                )
+            path = self.root / (name + '.json')
+            path.write_text(jsonutils.dumps(value))
+            self.report['checks'][name] = dict(
+                status='pass',
+                evidence=[
+                    dict(
+                        path=path.name,
+                        sha256=hashlib.sha256(
+                            path.read_bytes()
+                        ).hexdigest(),
+                    )
+                ],
+            )
+        self.assertTrue(self.validate()['stack_qualified'])
+        self.report['metrics']['peak_bytes'] += 1
+        self.assertFalse(self.validate()['stack_qualified'])
+        self.report['target']['instance_uuid'] = uuids.foreign
+        self.assertFalse(self.validate()['stack_qualified'])
