new file mode 100644
index 0000000000000000000000000000000000000000..bb4b30e2aa788f592ec9a535d723cf200454fe30
--- /dev/null
+++ b/nova/checkpoints/qualification.py
@@ -0,0 +1,348 @@
+# Licensed under the Apache License, Version 2.0 (the "License"); you may
+# not use this file except in compliance with the License. You may obtain
+# a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+# WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+# License for the specific language governing permissions and limitations
+# under the License.
+
+"""Read-only observations and evidence validation, without VM mutation."""
+
+import configparser
+import contextlib
+import hashlib
+from importlib import metadata
+import os
+from pathlib import PurePosixPath
+import platform
+import stat
+
+from oslo_serialization import jsonutils
+
+from nova.checkpoints import contracts as c
+
+COMPONENT_CHECKS = (
+    'libvirt_repeat_restore',
+    'paused_before_unpause',
+    'writer_hard_limit',
+    'nas_durability',
+    'partial_publish',
+    'namespace_isolation',
+    'crypto_at_rest',
+    'crypto_transport',
+    'no_cleartext_spill',
+    'xml_device_identity',
+    'pinned_path_reopen',
+)
+STACK_CHECKS = (
+    'cinder_c11_scope',
+    'backend_d_profile',
+    'ab_lifecycle',
+    'ram_and_all_disk_markers',
+    'uuid_preserved',
+    'partial_revert',
+    'expired_user_after_restart',
+    'current_neutron_bindings',
+    'pause_and_peak_bytes',
+    'late_writer_fenced',
+)
+STATUSES = ('pass', 'fail', 'skipped')
+MAX_JSON = 1024 * 1024
+MAX_CAPTURE = 256 * 1024 * 1024
+
+
+def summarize(checks, required):
+    c._require(type(checks) is dict and type(required) is tuple)
+    c._require(set(required) <= set(checks))
+    c._require(all(status in STATUSES for status in checks.values()))
+    unverified = sorted(
+        name for name in required if checks[name] != 'pass'
+    )
+    return dict(qualified=not unverified, unverified=unverified)
+
+
+@contextlib.contextmanager
+def _directory(path):
+    parts = PurePosixPath(path).parts
+    c._require(parts and parts[0] == '/' and '..' not in parts)
+    descriptor = os.open('/', os.O_RDONLY | os.O_DIRECTORY)
+    try:
+        for part in parts[1:]:
+            next_fd = os.open(
+                part,
+                os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
+                dir_fd=descriptor,
+            )
+            os.close(descriptor)
+            descriptor = next_fd
+        yield descriptor
+    finally:
+        os.close(descriptor)
+
+
+def _read(root, relative, maximum):
+    c._require(type(relative) is str and relative and '\\' not in relative)
+    parts = relative.split('/')
+    c._require(all(part not in ('', '.', '..') for part in parts))
+    with _directory(root) as directory:
+        descriptor = os.dup(directory)
+        try:
+            for part in parts[:-1]:
+                next_fd = os.open(
+                    part,
+                    os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
+                    dir_fd=descriptor,
+                )
+                os.close(descriptor)
+                descriptor = next_fd
+            source = os.open(
+                parts[-1],
+                os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
+                dir_fd=descriptor,
+            )
+            with os.fdopen(source, 'rb') as stream:
+                info = os.fstat(stream.fileno())
+                c._require(
+                    stat.S_ISREG(info.st_mode) and
+                    info.st_nlink == 1 and
+                    info.st_size <= maximum
+                )
+                value = stream.read(maximum + 1)
+                c._require(len(value) <= maximum)
+                return value
+        finally:
+            os.close(descriptor)
+
+
+def _evidence(root, item, maximum):
+    c._keys(item, ('path', 'sha256'))
+    c._digest(item['sha256'])
+    value = _read(root, item['path'], maximum)
+    c._require(hashlib.sha256(value).hexdigest() == item['sha256'])
+    return value
+
+
+def validate_report(report, evidence_root):
+    c._require(type(report) is dict)
+    required_fields = {
+        'schema_version',
+        'scope',
+        'measured',
+        'checks',
+        'metrics',
+    }
+    optional_fields = {
+        'qualified',
+        'stack_qualified',
+        'unverified',
+        'target',
+    }
+    c._require(
+        required_fields <= set(report) <= required_fields | optional_fields
+    )
+    c._integer(report['schema_version'], minimum=1, maximum=1)
+    c._require(report['scope'] in ('components', 'stack'))
+    measured = report['measured']
+    c._keys(measured, ('runtime', 'store', 'staging'))
+    for kind, value in measured.items():
+        c._require(
+            type(value) is dict and
+            value.get('kind') == kind and
+            len(value) > 1
+        )
+    digest = c.canonical_payload_hash(measured)
+    c._keys(report['metrics'], ('pause_milliseconds', 'peak_bytes'))
+    c._integer(report['metrics']['peak_bytes'], minimum=0)
+    pause = report['metrics']['pause_milliseconds']
+    c._integer(pause, minimum=0)
+    required = COMPONENT_CHECKS + (
+        STACK_CHECKS if report['scope'] == 'stack' else ()
+    )
+    checks = report['checks']
+    c._require(
+        type(checks) is dict and
+        set(checks) <= set(COMPONENT_CHECKS + STACK_CHECKS)
+    )
+    statuses = {name: 'skipped' for name in required}
+    for name, check in checks.items():
+        c._keys(check, ('status', 'evidence'))
+        c._require(
+            check['status'] in STATUSES and type(check['evidence']) is list
+        )
+        statuses[name] = check['status']
+        if check['status'] != 'pass':
+            continue
+        try:
+            c._require(bool(check['evidence']))
+            for reference in check['evidence']:
+                value = jsonutils.loads(
+                    _evidence(evidence_root, reference, MAX_JSON)
+                )
+                fields = {
+                    'check',
+                    'status',
+                    'measured_sha256',
+                    'artifacts',
+                }
+                if name in STACK_CHECKS:
+                    fields.add('target_sha256')
+                if name == 'pause_and_peak_bytes':
+                    fields.add('metrics_sha256')
+                c._keys(value, fields)
+                if name in STACK_CHECKS:
+                    c._require(
+                        value['target_sha256'] ==
+                        c.canonical_payload_hash(report['target'])
+                    )
+                if name == 'pause_and_peak_bytes':
+                    c._require(
+                        value['metrics_sha256'] ==
+                        c.canonical_payload_hash(report['metrics'])
+                    )
+                c._require(
+                    value['check'] == name and
+                    value['status'] == 'pass' and
+                    value['measured_sha256'] == digest and
+                    type(value['artifacts']) is list and
+                    bool(value['artifacts'])
+                )
+                for capture in value['artifacts']:
+                    _evidence(evidence_root, capture, MAX_CAPTURE)
+        except (OSError, ValueError, KeyError, TypeError):
+            statuses[name] = 'fail'
+    result = summarize(statuses, required)
+    if report['scope'] == 'stack':
+        try:
+            target = report['target']
+            c._keys(target, ('instance_uuid', 'host', 'volume_ids'))
+            c._uuid(target['instance_uuid'])
+            c._string(target['host'])
+            c._ids(target['volume_ids'], nonempty=True)
+        except (ValueError, KeyError, TypeError):
+            result['qualified'] = False
+            result['unverified'].append('explicit_target')
+    # A human-reviewed evidence set can qualify components. It is neither an
+    # automated physical test nor proof of authenticity of operator captures.
+    return dict(
+        report,
+        **dict(
+            result,
+            stack_qualified=report['scope'] == 'stack' and
+            result['qualified'],
+        ),
+    )
+
+
+def _versions():
+    packages = {}
+    for name in ('libvirt-python', 'os-brick', 'nova', 'os-vif'):
+        try:
+            packages[name] = metadata.version(name)
+        except metadata.PackageNotFoundError:
+            packages[name] = None
+    return dict(
+        kernel_release=platform.release(),
+        architecture=platform.machine(),
+        packages=packages,
+    )
+
+
+def _runtime(uri):
+    # No driver construction, RPC, domain lookup or write connection. A report
+    # must add the tested machine/shape observation from the disposable VM.
+    c._require(uri == 'qemu:///system')
+    import libvirt
+
+    connection = libvirt.openReadOnly(uri)
+    try:
+        return dict(
+            kind='runtime',
+            **_versions(),
+            libvirt_uri=connection.getURI(),
+            libvirt_version=connection.getLibVersion(),
+            qemu_version=connection.getVersion(),
+            capabilities_sha256=hashlib.sha256(
+                connection.getCapabilities().encode()
+            ).hexdigest(),
+        )
+    finally:
+        connection.close()
+
+
+def _mount(path, kind):
+    import nova.privsep.checkpoint
+
+    c._require(
+        type(path) is str and
+        path.startswith('/') and
+        os.path.normpath(path) == path
+    )
+    mount = nova.privsep.checkpoint._mount(path)
+    with _directory(path) as fd:
+        marker = nova.privsep.checkpoint._marker(fd)
+        c._require(marker['kind'] == kind)
+        info = os.fstat(fd)
+        c._require(
+            mount['device'] ==
+            '%s:%s' % (os.major(info.st_dev), os.minor(info.st_dev))
+        )
+        fsid = os.fstatvfs(fd).f_fsid
+    # At-rest assurance on a NAS is an infrastructure claim, never an observed
+    # true obtained just by parsing a root-owned marker on the client.
+    return dict(
+        kind=kind,
+        **mount,
+        fsid=fsid,
+        store_uuid=marker['store_uuid'],
+        declared_encryption_at_rest=marker['encryption_at_rest'],
+        server_policy_sha256=marker['server_policy_sha256'],
+        transport_encryption_observed=bool(
+            set(mount['options']) &
+            {'xprtsec=tls', 'xprtsec=mtls', 'sec=krb5p'}
+        ),
+    )
+
+
+def inspect(config_path):
+    c._require(type(config_path) is str and os.path.isabs(config_path))
+    config = configparser.ConfigParser(interpolation=None)
+    config.read_string(
+        _read(
+            os.path.dirname(config_path),
+            os.path.basename(config_path),
+            MAX_JSON,
+        ).decode()
+    )
+    measured = {}
+    uri = config.get(
+        'libvirt', 'connection_uri', fallback='qemu:///system'
+    )
+    try:
+        measured['runtime'] = _runtime(uri)
+    except Exception:
+        measured['runtime'] = dict(
+            kind='runtime', status='unobserved', **_versions()
+        )
+    for kind in ('store', 'staging'):
+        try:
+            path = config.get('checkpoint', kind + '_root')
+            measured[kind] = _mount(path, kind)
+        except Exception:
+            measured[kind] = dict(kind=kind, status='unobserved')
+    return dict(
+        schema_version=1,
+        scope='components',
+        measured=measured,
+        checks={
+            name: dict(status='skipped', evidence=[])
+            for name in COMPONENT_CHECKS
+        },
+        metrics=dict(pause_milliseconds=0, peak_bytes=0),
+        qualified=False,
+        stack_qualified=False,
+        unverified=list(COMPONENT_CHECKS),
+    )
