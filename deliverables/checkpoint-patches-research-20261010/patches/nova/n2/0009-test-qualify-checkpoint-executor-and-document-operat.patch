diff --git a/tools/checkpoint/profile.schema.json b/tools/checkpoint/profile.schema.json
new file mode 100644
index 0000000000000000000000000000000000000000..80c229e4eece6cd70234a00156a7a6812b5d040e
--- /dev/null
+++ b/tools/checkpoint/profile.schema.json
@@ -0,0 +1,64 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "urn:openstack:nova:checkpoint:profiles:1",
+  "title": "Operator-controlled qualified checkpoint component allowlist",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schema_version",
+    "records"
+  ],
+  "properties": {
+    "schema_version": {
+      "const": 1
+    },
+    "records": {
+      "type": "array",
+      "items": {
+        "type": "object",
+        "additionalProperties": false,
+        "required": [
+          "id",
+          "kind",
+          "identity_sha256",
+          "qualification_sha256",
+          "observed",
+          "limits"
+        ],
+        "properties": {
+          "id": {
+            "type": "string",
+            "format": "uuid"
+          },
+          "kind": {
+            "enum": [
+              "runtime",
+              "store",
+              "staging"
+            ]
+          },
+          "identity_sha256": {
+            "type": "string",
+            "pattern": "^[0-9a-f]{64}$"
+          },
+          "qualification_sha256": {
+            "type": "string",
+            "pattern": "^[0-9a-f]{64}$"
+          },
+          "observed": {
+            "type": "object",
+            "minProperties": 1
+          },
+          "limits": {
+            "type": "object",
+            "minProperties": 1,
+            "additionalProperties": {
+              "type": "integer",
+              "minimum": 1
+            }
+          }
+        }
+      }
+    }
+  }
+}
