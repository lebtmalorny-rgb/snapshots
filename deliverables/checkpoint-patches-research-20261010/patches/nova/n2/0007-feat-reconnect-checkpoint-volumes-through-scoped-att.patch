+class BDMUpdateTest(fixtures.StoreTestBase):
+    def setUp(self):
+        super().setUp()
+        self.parent_id = self.parent('volume_reconnect', [])
+        self.connection = dict(
+            driver_volume_type='iscsi',
+            serial=uuids.volume,
+            data=dict(
+                volume_id=uuids.volume,
+                device_path='/dev/mapper/new',
+                auth_password='private-password',
+            ),
+        )
+        self.digest = c.canonical_payload_hash(self.connection)
+
+        @db.pick_context_manager_writer
+        def seed(ctx):
+            # The preceding adapters are covered separately; seed their durable
+            # success to exercise the real claimed BDM-only mutation boundary.
+            op = ctx.session.get(
+                models.InstanceCheckpointOperation, uuids.operation
+            )
+            op.kind = 'revert'
+            op.phase = 'volume_reconnect'
+            ctx.session.add(
+                models.InstanceCheckpointTemporaryBudget(
+                    operation_id=uuids.operation,
+                    ticket_id=uuids.temporary,
+                    reserved_bytes=fixtures.LIMIT,
+                    version=1,
+                    state='confirmed',
+                )
+            )
+            rows = (
+                ctx.session.query(models.InstanceCheckpointEffect)
+                .filter_by(parent_step_id=self.parent_id)
+                .all()
+            )
+            for row in rows:
+                row.status = (
+                    'dispatching'
+                    if row.action == 'bdm_update'
+                    else 'succeeded'
+                )
+                evidence = dict(
+                    volume_id=uuids.volume,
+                    attachment_id=uuids.new_attachment,
+                )
+                if row.action in ('host_connect', 'bdm_update'):
+                    evidence['connection_sha256'] = self.digest
+                if row.action == 'bdm_update':
+                    evidence.update(
+                        bdm_uuid=uuids.bdm,
+                        guest_fingerprint=self.binding.db_fingerprint,
+                    )
+                row.result = journal._encode(
+                    v2.EffectResult(
+                        'succeeded', evidence, None
+                    ).to_primitive()
+                )
+
+        seed(self.ctx)
+
+    def update(self, **changes):
+        args = dict(
+            context=self.ctx,
+            instance_uuid=uuids.instance,
+            operation_id=uuids.operation,
+            generation=1,
+            bdm_uuid=uuids.bdm,
+            attachment_id=uuids.new_attachment,
+            connection_info=self.connection,
+        )
+        args.update(changes)
+        objects.BlockDeviceMapping.checkpoint_update(**args)
+
+    def current(self):
+        return objects.BlockDeviceMapping.get_by_volume_and_instance(
+            self.ctx, uuids.volume, uuids.instance
+        )
+
+    def test_only_connection_fields_change_and_guest_identity_stays(self):
+        before = objects.InstanceCheckpointOperation.device_manifest(
+            self.ctx, uuids.instance
+        )
+        self.update()
+        after = objects.InstanceCheckpointOperation.device_manifest(
+            self.ctx, uuids.instance
+        )
+        self.assertEqual(before, after)
+        self.assertEqual(uuids.bdm, self.current().uuid)
+        self.assertEqual(
+            uuids.new_attachment, self.current().attachment_id
+        )
+        self.assertEqual(
+            self.connection,
+            jsonutils.loads(self.current().connection_info),
+        )
+
+    def test_wrong_instance_or_attachment_or_connection_rejected(self):
+        for args in (
+            dict(instance_uuid=uuids.foreign),
+            dict(attachment_id=uuids.foreign),
+            dict(
+                connection_info=dict(self.connection, serial=uuids.foreign)
+            ),
+        ):
+            self.assertRaises(
+                (ValueError, exception.CheckpointConflict),
+                self.update,
+                **args,
+            )
+        self.assertIsNone(self.current().attachment_id)
+
+    def test_released_owner_cannot_save_stale_bdm(self):
+        @db.pick_context_manager_writer
+        def release(ctx):
+            guard = ctx.session.get(
+                models.InstanceCheckpointGuard, uuids.instance
+            )
+            guard.operation_id = None
+
+        release(self.ctx)
+        self.assertRaises(exception.CheckpointConflict, self.update)
+        self.assertIsNone(self.current().attachment_id)
+
+    def test_cancelled_temporary_budget_rejects_late_bdm_update(self):
+        @db.pick_context_manager_writer
+        def cancel(ctx):
+            ctx.session.get(
+                models.InstanceCheckpointTemporaryBudget, uuids.operation
+            ).state = 'cancelled'
+
+        cancel(self.ctx)
+        self.assertRaises(exception.CheckpointConflict, self.update)
+        self.assertIsNone(self.current().attachment_id)
+
+    def test_generic_bdm_save_cannot_bypass_child_connection_proof(self):
+        guard = objects.InstanceCheckpointGuard.get_by_instance_uuid(
+            self.ctx, uuids.instance
+        )
+        scope = c.Scope(
+            uuids.instance,
+            'checkpoint',
+            uuids.operation,
+            1,
+            'volume_reconnect',
+            guard.token,
+        )
+        with guards.scope(self.ctx, scope) as ctx:
+            bdm = objects.BlockDeviceMapping.get_by_volume_and_instance(
+                ctx, uuids.volume, uuids.instance
+            )
+            bdm.attachment_id = uuids.foreign
+            self.assertRaises(exception.CheckpointConflict, bdm.save)
+        self.assertIsNone(self.current().attachment_id)
+
+    def test_new_serial_rolls_back_even_with_matching_connection_hash(
+        self,
+    ):
+        changed = dict(self.connection, serial=uuids.foreign)
+
+        @db.pick_context_manager_writer
+        def proof(ctx):
+            row = (
+                ctx.session.query(models.InstanceCheckpointEffect)
+                .filter_by(
+                    parent_step_id=self.parent_id, action='host_connect'
+                )
+                .one()
+            )
+            value = journal._row(row)['result']
+            value['evidence']['connection_sha256'] = (
+                c.canonical_payload_hash(changed)
+            )
+            row.result = journal._encode(value)
+
+        proof(self.ctx)
+        self.assertRaises(ValueError, self.update, connection_info=changed)
+        self.assertIsNone(self.current().attachment_id)
+        self.assertEqual(
+            uuids.volume,
+            jsonutils.loads(self.current().connection_info)['serial'],
+        )
