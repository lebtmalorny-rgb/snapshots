+        )
+        self.assertEqual(1, self.cinder.submit_attachment.call_count)
+        self.driver.detach_volume.assert_not_called()
+        self.assertEqual(
+            2,
+            len(
+                db.block_device_mapping_get_all_by_instance(
+                    self.ctx, uuids.instance
+                )
+            ),
+        )
