@@ -490,6 +496,22 @@ def _parent_success(parent, children, evidence):
                         'runtime_restore_checkpoint',
                         'cleanup_runtime_restore_current'):
         return bool(proofs) and proofs[-1] == evidence
+    if parent.phase == 'volume_disconnect':
+        expected = {row.resource_id for row in children}
+        return (set(evidence['volume_ids']) == expected and
+                set(evidence['disconnected_volume_ids']) == expected and
