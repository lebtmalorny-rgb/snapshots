+"""One claimed attachment effect at a time; observation never dispatches."""
+
+import dataclasses
+
+from oslo_serialization import jsonutils
+
+from nova.checkpoints import contracts as c
+from nova.checkpoints import contracts_v2 as v2
+from nova import objects
+from nova.virt.libvirt.checkpoints import journal
+from nova.volume import checkpoints as cinder
+
+
+def intent(row):
+    return v2.ChildIntent(
+        **{f.name: row[f.name] for f in dataclasses.fields(v2.ChildIntent)}
+    )
+
+
+def unknown():
+    return v2.EffectResult('unknown', {}, 'recovery_required')
+
+
+class AttachmentCoordinator:
+    def __init__(
+        self, driver, staging, runtime, client=None, updater=None
+    ):
+        self.driver, self.staging, self.runtime = driver, staging, runtime
+        self.client = client or cinder.CheckpointClient()
+        self.updater = updater or driver.virtapi.checkpoint_update_bdm
+
+    def _bound(self, context, instance, binding, parent_id):
+        parent = objects.InstanceCheckpointStep.get_by_uuid(
+            context, parent_id
+        )
+        operation = objects.InstanceCheckpointOperation.get_by_uuid(
+            context, parent.operation_id
+        )
+        checkpoint = objects.InstanceCheckpoint.get_by_uuid(
+            context, binding.checkpoint_id
+        )
+        c._require(
+            parent.phase in ('volume_disconnect', 'volume_reconnect') and
+            parent.contract_version == 2 and
+            operation.kind == 'revert' and
+            operation.binding == binding.to_primitive() and
+            checkpoint.active_operation_id == operation.uuid and
+            (
+                instance.uuid,
+                instance.host,
+                instance.node,
+                instance.project_id,
+            ) ==
+            (
+                binding.instance_uuid,
+                binding.host,
+                binding.node,
+                binding.project_id,
+            )
+        )
+        current = objects.InstanceCheckpointOperation.device_manifest(
+            context, instance.uuid
+        )
+        c._require(c.device_fingerprint(current) == binding.db_fingerprint)
+        rows = objects.CheckpointEffect.get_children(context, parent_id)
+        c._require(bool(rows))
+        for row in rows:
+            journal.authorize(context, binding, intent(row))
+        return parent, operation, current, rows
+
+    def _stopped(self, context, instance, binding, operation):
+        steps = objects.InstanceCheckpointStepList.get_by_operation(
+            context, operation.uuid
+        )
+        parent = next(s for s in steps if s.phase == 'runtime_stop')
+        c._require(parent.status == 'succeeded')
+        children = objects.CheckpointEffect.get_children(
+            context, parent.uuid
+        )
+        c._require(
+            len(children) == 1 and
+            children[0]['action'] == 'stop' and
+            children[0]['status'] == 'succeeded'
+        )
+        c._require(
+            self.runtime.query(
+                context, instance, intent(children[0])
+            ).status ==
+            'succeeded'
+        )
+
+    def _reverted(self, context, operation, manifest):
+        value = self.client.get(context, operation.uuid)
+        ids = {d['volume_id'] for d in manifest['disks']}
+        c._require(
+            value['kind'] == 'revert' and
+            value['instance_uuid'] == operation.instance_uuid and
+            value['generation'] == 1 and
+            value['status'] == 'succeeded' and
+            {r['volume_id'] for r in value['resources']} == ids
+        )
+        resources = {r['id'] for r in value['resources']}
+        reverted = [s for s in value['steps'] if s['phase'] == 'revert']
+        c._require(
+            len(reverted) == len(resources) and
+            {s['resource_id'] for s in reverted} == resources and
+            all(s['status'] == 'succeeded' for s in reverted)
+        )
+
+    @staticmethod
+    def _bdm(context, instance, volume):
+        return objects.BlockDeviceMapping.get_by_volume_and_instance(
+            context, volume, instance.uuid
+        )
+
+    @staticmethod
+    def _prior(rows, action, volume):
+        row = next(
+            r
+            for r in rows
+            if r['action'] == action and r['resource_id'] == volume
+        )
+        c._require(row['status'] == 'succeeded')
+        proof = v2.validate_child_result(action, row['result'])
+        c._require(proof.status == 'succeeded')
+        return row, proof.evidence
+
+    def _request(self, context, instance, child, rows):
+        action = child.action.removeprefix('attachment_')
+        attachment_id = None
+        if action == 'delete':
+            attachment_id = self._bdm(
+                context, instance, child.resource_id
+            ).attachment_id
+            c._uuid(attachment_id)
+        elif action != 'create':
+            row, proof = self._prior(
+                rows, 'attachment_create', child.resource_id
+            )
+            attachment_id = proof['attachment_id']
+        return dict(
+            id=child.id,
+            generation=1,
+            volume_id=child.resource_id,
+            action=action,
+            attachment_id=attachment_id,
+            connector=(
+                self.driver.get_volume_connector(instance)
+                if action == 'update'
+                else None
+            ),
+            mountpoint=(
+                self._bdm(context, instance, child.resource_id).device_name
+                if action == 'update'
+                else None
+            ),
+        )
+
+    def _attachment(self, context, instance, child, rows, query):
+        value = (
+            self.client.get_attachment_request(
+                context, child.operation_id, child.id
+            )
+            if query
+            else self.client.submit_attachment(
+                context,
+                child.operation_id,
+                self._request(context, instance, child, rows),
+            )
+        )
+        c._require(
+            value['id'] == child.id and
+            value['volume_id'] == child.resource_id and
+            value['action'] == child.action.removeprefix('attachment_')
+        )
+        if value['status'] != 'succeeded':
+            return (
+                v2.EffectResult('pending', {}, None)
+                if value['status'] == 'pending'
+                else unknown()
+            )
+        if child.action != 'attachment_create':
+            expected = (
+                self._bdm(
+                    context, instance, child.resource_id
+                ).attachment_id
+                if child.action == 'attachment_delete'
+                else self._prior(
+                    rows, 'attachment_create', child.resource_id
+                )[1]['attachment_id']
+            )
+            c._require(value['attachment_id'] == expected)
+        return v2.EffectResult(
+            'succeeded',
+            dict(
+                volume_id=child.resource_id,
+                attachment_id=value['attachment_id'],
+            ),
+            None,
+        )
+
+    def _connected(self, context, binding, rows, volume):
+        row, proof = self._prior(rows, 'host_connect', volume)
+        with self.staging.runtime_record(
+            context, binding, intent(row)
+        ) as record:
+            c._require(record.read().evidence == proof)
+            connection = record.connection()
+            c._require(
+                c.canonical_payload_hash(connection) ==
+                proof['connection_sha256']
+            )
+            return proof['attachment_id'], connection
+
+    def _host(self, context, instance, binding, child, rows, query):
+        with self.staging.runtime_record(
+            context, binding, child, write=not query
+        ) as record:
+            if query or record.started():
+                result = record.read()
+                if child.action == 'host_connect':
+                    c._require(
+                        c.canonical_payload_hash(record.connection()) ==
+                        result.evidence['connection_sha256']
+                    )
+                return result
+            if child.action == 'host_disconnect':
+                bdm = self._bdm(context, instance, child.resource_id)
+                connection = jsonutils.loads(bdm.connection_info)
+                record.start()
+                self.driver._checkpoint_disconnect_volume(
+                    context, instance, binding, child, connection
+                )
+                result = v2.EffectResult(
+                    'succeeded',
+                    dict(volume_id=child.resource_id, disconnected=True),
+                    None,
+                )
+            else:
+                row, proof = self._prior(
+                    rows, 'attachment_update', child.resource_id
+                )
+                attachment = self.client.get_attachment(
+                    context, child.operation_id, proof['attachment_id']
+                )
+                c._require(
+                    attachment['volume_id'] == child.resource_id and
+                    attachment['instance'] == instance.uuid and
+                    attachment['status'] == 'attaching'
+                )
+                connection = attachment['connection_info']
+                c._require(type(connection) is dict)
+                current = (
+                    objects.InstanceCheckpointOperation.device_manifest(
+                        context, instance.uuid
+                    )
+                )
+                disk = next(
+                    d
+                    for d in current['disks']
+                    if d['volume_id'] == child.resource_id
+                )
+                connection['serial'] = disk['serial']
+                record.start()
+                self.driver._checkpoint_connect_volume(
+                    context, instance, binding, child, connection
+                )
+                record.connection(connection)
+                result = v2.EffectResult(
+                    'succeeded',
+                    dict(
+                        volume_id=child.resource_id,
+                        attachment_id=proof['attachment_id'],
+                        connection_sha256=c.canonical_payload_hash(
+                            connection
+                        ),
+                    ),
+                    None,
+                )
+            record.finish(result)
+            return result
+
+    def _bdm_effect(self, context, instance, binding, child, rows, query):
+        attachment_id, connection = self._connected(
+            context, binding, rows, child.resource_id
+        )
+        bdm = self._bdm(context, instance, child.resource_id)
+        if not query:
+            self.updater(
+                context,
+                instance.uuid,
+                child.operation_id,
+                1,
+                bdm.uuid,
+                attachment_id,
+                connection,
+            )
+            bdm = self._bdm(context, instance, child.resource_id)
+        c._require(
+            bdm.attachment_id == attachment_id and
+            jsonutils.loads(bdm.connection_info) == connection
+        )
+        return v2.EffectResult(
+            'succeeded',
+            dict(
+                volume_id=child.resource_id,
+                attachment_id=attachment_id,
+                bdm_uuid=bdm.uuid,
+                guest_fingerprint=binding.db_fingerprint,
+                connection_sha256=c.canonical_payload_hash(connection),
+            ),
+            None,
+        )
+
+    def _aggregate(self, parent, manifest, rows):
+        if all(r['status'] == 'succeeded' for r in rows):
+            volumes = sorted(d['volume_id'] for d in manifest['disks'])
+            if parent.phase == 'volume_disconnect':
+                evidence = dict(
+                    volume_ids=volumes, disconnected_volume_ids=volumes
+                )
+            else:
+                evidence = dict(
+                    volume_ids=volumes,
+                    port_ids=sorted(p['uuid'] for p in manifest['ports']),
+                    attachments=[
+                        dict(
+                            self._prior(rows, 'attachment_complete', v)[1]
+                        )
+                        for v in volumes
+                    ],
+                )
+            return v2.EffectResult('succeeded', evidence, None)
+        return None
+
+    def _run(
+        self,
+        context,
+        instance,
+        binding,
+        parent_id,
+        phase=None,
+        query=False,
+    ):
+        try:
+            parent, operation, manifest, rows = self._bound(
+                context, instance, binding, parent_id
+            )
+            c._require(phase is None or parent.phase == phase)
+            self._stopped(context, instance, binding, operation)
+            if parent.phase == 'volume_reconnect':
+                self._reverted(context, operation, manifest)
+            result = self._aggregate(parent, manifest, rows)
+            if result is not None:
+                return result
+            row = next(r for r in rows if r['status'] != 'succeeded')
+            if row['status'] == 'prepared':
+                if query:
+                    value = objects.CheckpointEffect.continuation(
+                        context, parent_id
+                    )
+                    return v2.EffectResult('ready', value, None)
+                row = objects.CheckpointEffect.claim(
+                    context,
+                    row['id'],
+                    1,
+                    binding.executor_id,
+                    row['revision'],
+                )
+                if row is None:
+                    return unknown()
+            else:
+                query = True
+            child = intent(row)
+            if child.action.startswith('attachment_'):
+                result = self._attachment(
+                    context, instance, child, rows, query
+                )
+            elif child.action in ('host_connect', 'host_disconnect'):
+                result = self._host(
+                    context, instance, binding, child, rows, query
+                )
+            elif child.action == 'bdm_update':
+                result = self._bdm_effect(
+                    context, instance, binding, child, rows, query
+                )
+            else:
+                return unknown()
+            objects.CheckpointEffect.observe(
+                context, child.id, 1, result.to_primitive()
+            )
+            rows = objects.CheckpointEffect.get_children(
+                context, parent_id
+            )
+            if result.status != 'succeeded':
+                return result
+            aggregate = self._aggregate(parent, manifest, rows)
+            return aggregate or v2.EffectResult(
+                'ready',
+                objects.CheckpointEffect.continuation(context, parent_id),
+                None,
+            )
+        except Exception:
+            return unknown()
+
+    def disconnect(self, context, instance, binding, parent_step_id):
+        return self._run(
+            context, instance, binding, parent_step_id, 'volume_disconnect'
+        )
+
+    def reconnect(self, context, instance, binding, parent_step_id):
+        return self._run(
+            context, instance, binding, parent_step_id, 'volume_reconnect'
+        )
+
+    def query(self, context, instance, binding, parent_step_id):
+        return self._run(
+            context, instance, binding, parent_step_id, query=True
+        )
