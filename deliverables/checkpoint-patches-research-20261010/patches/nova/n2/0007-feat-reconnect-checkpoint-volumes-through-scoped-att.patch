+
+"""The sole checkpoint BDM mutation, fenced with the Instance transaction."""
+
+from nova.checkpoints import contracts as c
+from nova.checkpoints import contracts_v2 as v2
+from nova.db.main import api as db
+from nova.db.main import checkpoint_effects as effects
+from nova.db.main import checkpoint_temporary as temporary
+from nova.db.main import checkpoints as journal
+from nova.db.main import models
+from nova.db.utils import require_context
+
+
+@require_context
+@db.pick_context_manager_writer
+def update(
+    context,
+    instance_uuid,
+    operation_id,
+    generation,
+    bdm_uuid,
+    attachment_id,
+    connection_info,
+):
+    instance, guard, checkpoint, operation = journal._owned(
+        context, operation_id, generation
+    )
+    temporary.assert_dispatch(context, operation, 'volume_reconnect')
+    c._require(
+        operation.contract_version == 2 and
+        operation.kind == 'revert' and
+        instance_uuid == instance.uuid and
+        operation.phase == 'volume_reconnect' and
+        operation.quota_ready
+    )
+    c._uuid(bdm_uuid)
+    c._uuid(attachment_id)
+    c._require(type(connection_info) is dict)
+    c._require(
+        c.device_fingerprint(journal._manifest(context, instance)) ==
+        checkpoint.fingerprint
+    )
+    bdm = (
+        context.session.query(models.BlockDeviceMapping)
+        .filter_by(uuid=bdm_uuid, instance_uuid=instance_uuid, deleted=0)
+        .first()
+    )
+    c._require(bdm is not None)
+    parent = next(
+        s
+        for s in journal._steps(context, operation.uuid)
+        if s.phase == 'volume_reconnect'
+    )
+    c._require(
+        parent.status in ('dispatching', 'pending', 'unknown', 'ready')
+    )
+    rows = effects._rows(context, parent)
+    child = next(
+        r
+        for r in rows
+        if r.action == 'bdm_update' and r.resource_id == bdm.volume_id
+    )
+    c._require(child.status == 'dispatching')
+    c._require(
+        all(r.status == 'succeeded' for r in rows[: child.sequence])
+    )
+    connect = next(
+        r
+        for r in rows
+        if r.action == 'host_connect' and r.resource_id == bdm.volume_id
+    )
+    proof = v2.validate_child_result(
+        'host_connect', journal._row(connect)['result']
+    )
+    c._require(
+        proof.status == 'succeeded' and
+        proof.evidence['volume_id'] == bdm.volume_id and
+        proof.evidence['attachment_id'] == attachment_id and
+        proof.evidence['connection_sha256'] ==
+        c.canonical_payload_hash(connection_info)
+    )
+    bdm.attachment_id = attachment_id
+    bdm.connection_info = journal._encode(connection_info)
+    context.session.flush()
+    # serial is projected from connection_info. An unrelated replacement must
+    # roll back the complete transaction, including attachment_id.
+    c._require(
+        c.device_fingerprint(journal._manifest(context, instance)) ==
+        checkpoint.fingerprint
+    )
