 class ExecutorV2FunctionalTest(checkpoints_v2.CheckpointV2TestCase):
+    def test_busy_publish_restores_running_and_releases_all_resources(
+        self,
+    ):
+        driver = self.drivers[0]
+        self.flags(max_concurrent_transfers=1, group='checkpoint')
+        with driver.checkpoint_executor.store._transfer():
+            created = self.create()
+        self.assertEqual('released', self.operation(created)['state'])
+        self.assertEqual(1, driver.backend.state)
+        self.assertEqual(1, driver.backend.calls['save'])
+        self.assertEqual(0, self.usage()['artifact_bytes'])
+        self.assertEqual({}, driver.backend.snapshots)
+        before = dict(driver.backend.calls)
+        self.recover()
+        self.assertEqual(before, dict(driver.backend.calls))
+
+    def test_busy_download_aborts_before_stop_and_retains_checkpoint(self):
+        driver = self.drivers[0]
+        created = self.create()
+        retained = self.usage()['artifact_bytes']
+        self.flags(max_concurrent_transfers=1, group='checkpoint')
+        with driver.checkpoint_executor.store._transfer():
+            result = self.action(created['checkpoint']['id'], 'revert')
+        self.assertEqual('released', self.operation(result)['state'])
+        self.assertEqual(retained, self.usage()['artifact_bytes'])
+        self.assertEqual(0, driver.backend.calls['stop'])
+        self.assertEqual(0, driver.backend.calls['disconnect'])
+        self.assertEqual(1, driver.backend.state)
+        retried = self.action(created['checkpoint']['id'], 'revert')
+        self.assertEqual('succeeded', self.operation(retried)['state'])
+
+    def no_free_space(self):
+        original = os.fstatvfs
+        return mock.patch(
+            'os.fstatvfs',
+            side_effect=lambda fd: SimpleNamespace(
+                f_fsid=original(fd).f_fsid, f_frsize=4096, f_bavail=0
+            ),
+        )
+
+    def test_no_space_rejects_create_before_save_or_quota(self):
+        with self.no_free_space():
+            self.create(expected=409)
+        self.assertEqual(0, self.drivers[0].backend.calls['save'])
+        self.assertEqual(0, self.usage()['artifact_bytes'])
+
+    def test_no_space_rejects_new_revert_but_permits_delete(self):
+        created = self.create()
+        retained = self.usage()['artifact_bytes']
+        with self.no_free_space():
+            self.request(
+                'POST',
+                'checkpoints/%s/action' % created['checkpoint']['id'],
+                {'revert': {'request_id': uuids.no_space_revert}},
+                expected=409,
+            )
+            self.assertEqual(retained, self.usage()['artifact_bytes'])
+            result = self.action(created['checkpoint']['id'], 'delete')
+        self.assertEqual('released', self.operation(result)['state'])
+        self.assertEqual(0, self.usage()['artifact_bytes'])
+        self.assertEqual(0, self.drivers[0].backend.calls['stop'])
+
+    def test_full_storage_does_not_block_existing_create_recovery(self):
+        driver = self.drivers[0]
+        with mock.patch.object(
+            driver.checkpoint_executor.store,
+            '_copy',
+            side_effect=OSError('interrupted upload'),
+        ):
+            created = self.create()
+        self.assertGreater(self.usage()['artifact_bytes'], 0)
+        with self.no_free_space():
+            self.advance(created)
+        self.assertEqual('released', self.operation(created)['state'])
+        self.assertEqual(1, driver.backend.state)
+        self.assertEqual(0, self.usage()['artifact_bytes'])
+
