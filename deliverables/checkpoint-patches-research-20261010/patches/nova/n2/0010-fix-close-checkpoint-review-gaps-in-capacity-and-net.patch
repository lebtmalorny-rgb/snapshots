+        c._require(
+            type(bridge) is str and
+            vif['network']['bridge'] ==
+            bridge[: network_model.NIC_NAME_LEN] and
+            vif['devname'] ==
+            ('tap' + current['id'])[: network_model.NIC_NAME_LEN] and
+            vif['ovs_interfaceid'] ==
+            (current['id'] if vif_type == 'ovs' else None)
+        )
         return driver.vif_driver.get_config(
             instance, vif, instance.image_meta, instance.flavor, 'kvm'
