+    def drive_until(self, result, predicate):
+        for unused in range(40):
+            if predicate():
+                return
+            self.advance(result)
+        self.fail(
+            'bounded coordinator did not reach expected journal state: %s'
+            % [(s.phase, s.status) for s in self.rows(result)]
+        )
