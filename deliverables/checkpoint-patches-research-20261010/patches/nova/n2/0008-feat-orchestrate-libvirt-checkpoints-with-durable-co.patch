+            instance, connection, info
+        ).to_xml()
+
+    def interface_source(context, instance, port):
+        network = instance.get_network_info()
+        vif = next(v for v in network if v['id'] == port['uuid'])
+        return driver.vif_driver.get_config(
+            instance, vif, instance.image_meta, instance.flavor, 'kvm'
+        ).to_xml()
