+    def test_query_observes_lost_rpc_without_repeating_save(self):
+
+        self.patch(coordinator.Coordinator, 'max_transitions', 1)
+        driver = self.drivers[0]
+        original = driver.checkpoint_execute_v2
+
+        def lost(ctx, inst, intent):
+            result = original(ctx, inst, intent)
+            if (
+                intent['phase'] == 'runtime_save' and
+                result['status'] == 'succeeded'
+            ):
+                raise RuntimeError(
+                    'Nova RPC lost after durable child receipt'
+                )
+            return result
+
+        # The save is a continuation; this wraps the same finite executor hook.
+        self.patch(driver, 'checkpoint_execute_v2', lost)
+        created = self.create()
+        self.drive_until(
+            created, lambda: driver.backend.calls['save'] == 1
+        )
+        self.assertEqual(0, driver.backend.calls['snapshot'])
+        self.assertEqual(
+            'unknown',
+            next(
+                s for s in self.rows(created) if s.phase == 'runtime_save'
+            ).status,
+        )
+        self.advance(
+            created
+        )  # query aggregates durable save, no disk submit
+        self.assertEqual(1, driver.backend.calls['save'])
+        self.assertEqual(0, driver.backend.calls['snapshot'])
+        self.advance(created)
+        self.assertEqual(1, driver.backend.calls['snapshot'])
+        self.drive_until(
+            created,
+            lambda: self.operation(created)['state'] == 'succeeded',
+        )
+        self.assertEqual(1, driver.backend.calls['save'])
+
+    def test_stale_continuation_never_claims_the_next_child(self):
+
+        self.patch(coordinator.Coordinator, 'max_transitions', 1)
+        created = self.create()
+        self.drive_until(
+            created,
+            lambda: any(
+                s.phase == 'runtime_save' and s.status == 'ready'
+                for s in self.rows(created)
+            ),
+        )
+        parent = next(
+            s for s in self.rows(created) if s.phase == 'runtime_save'
+        )
+        with context.target_cell(self.ctx, self.cells[0]) as ctx:
+            continuation = objects.CheckpointEffect.continuation(
+                ctx, parent.uuid
+            )
+            inst = objects.Instance.get_by_uuid(ctx, self.servers[0])
+            engine = compute_v2.ComputeV2(self.drivers[0], inst.host)
+            self.assertRaises(
+                ValueError,
+                engine.continue_step,
+                ctx,
+                inst,
+                created['operation']['id'],
+                1,
+                parent.uuid,
+                continuation['journal_revision'] - 1,
+            )
+        self.assertEqual(0, self.drivers[0].backend.calls['save'])
+        self.advance(created)
+        self.assertEqual(1, self.drivers[0].backend.calls['save'])
