+"""Qualified component composition, with one child dispatch per invocation."""
+
+import os
+import uuid
+
+from nova.checkpoints import attachments as attachment_api
+from nova.checkpoints import contracts as c
+from nova.checkpoints import contracts_v2 as v2
+from nova import conf
+from nova import objects
+from nova.virt.libvirt.checkpoints import files
+from nova.virt.libvirt.checkpoints import journal
+
+
+def unknown(reason='recovery_required'):
+    return v2.EffectResult('unknown', {}, reason)
+
+
+class LibvirtCheckpointExecutor:
+    def __init__(
+        self,
+        driver,
+        runtime,
+        store,
+        staging,
+        cinder,
+        attachments,
+        executor_id=None,
+    ):
+        self.driver, self.runtime, self.store = driver, runtime, store
+        self.staging, self.cinder, self.attachments = (
+            staging,
+            cinder,
+            attachments,
+        )
+        self.executor_id = executor_id or str(
+            uuid.uuid5(
+                uuid.UUID(conf.CONF.checkpoint.deployment_id),
+                'libvirt-checkpoint:' + conf.CONF.host,
+            )
+        )
+
+    def probe(
+        self,
+        context,
+        instance,
+        manifest,
+        purpose,
+        checkpoint_id=None,
+        operation_id=None,
+    ):
+        try:
+            c._require(
+                self.store.probe()['supported'] and
+                self.staging.probe()['supported']
+            )
+            checkpoint = (
+                objects.InstanceCheckpoint.get_by_uuid(
+                    context, checkpoint_id
+                )
+                if checkpoint_id
+                else None
+            )
+            binding = (
+                v2.Binding.from_primitive(checkpoint.binding)
+                if checkpoint
+                else None
+            )
+            if binding:
+                c._require(
+                    binding.executor_id == self.executor_id and
+                    binding.store_profile_id == self.store.profile.id and
+                    binding.staging_profile_id ==
+                    self.staging.profile.id and
+                    binding.db_fingerprint ==
+                    c.device_fingerprint(manifest)
+                )
+            ids = tuple(d['volume_id'] for d in manifest['disks'])
+            if operation_id is None:
+                self.cinder.preflight_capabilities(context, ids)
+            else:
+                for ident in ids:
+                    self.cinder.capabilities(context, operation_id, ident)
+            if purpose == 'delete':
+                c._require(binding is not None)
+                original = objects.InstanceCheckpointOperation.get_by_uuid(
+                    context, checkpoint.create_operation_id
+                ).admission
+                observed = {
+                    key: original[key]
+                    for key in (
+                        'runtime_fingerprint',
+                        'runtime_profile_id',
+                        'save_bytes_limit',
+                        'restore_bytes_limit',
+                    )
+                }
+            else:
+                observed = self.runtime.topology.inspect(
+                    context,
+                    instance,
+                    manifest,
+                    'recover' if operation_id else purpose,
+                    binding,
+                )
+            count = 1 + bool(manifest['config_drive'])
+            maximum = observed['save_bytes_limit']
+            self.store.fs.budget(maximum)
+            self.staging.fs.budget(maximum)
+            return v2.ProbeV2(
+                True,
+                (),
+                self.executor_id,
+                c.PROFILE,
+                c.device_fingerprint(manifest),
+                manifest,
+                2 * count * maximum,
+                observed['runtime_fingerprint'],
+                observed['runtime_profile_id'],
+                self.store.profile.id,
+                self.staging.profile.id,
+                maximum,
+                observed['restore_bytes_limit'],
+            )
+        except Exception:
+            return v2.unsupported('profile_unverified')
+
+    @staticmethod
+    def _ref(row):
+        c._require(row['writer_state'] == 'closed')
+        return v2.ArtifactRef(
+            row['id'],
+            row['kind'],
+            row['logical_id'],
+            row['actual_bytes'],
+            row['checksum'],
+            row['location'],
+        )
+
+    def _workspace(self, binding, child):
+        return self.staging._entry(binding, child.operation_id)
+
+    def _cinder(self, context, binding, child, phase, operation, query):
+        if child.action == 'reserve' and not query:
+            value = self.cinder.reserve(
+                context,
+                operation.uuid,
+                operation.checkpoint_id,
+                operation.instance_uuid,
+                operation.kind,
+                tuple(
+                    d['volume_id']
+                    for d in operation.admission['device_manifest'][
+                        'disks'
+                    ]
+                ),
+            )
+        elif child.action == 'submit_disk_operation' and not query:
+            value = self.cinder.action(
+                context,
+                operation.uuid,
+                (
+                    'cleanup'
+                    if phase == 'cleanup_disk_snapshots'
+                    else 'execute'
+                ),
+                1,
+            )
+        elif child.action == 'release' and not query:
+            value = self.cinder.action(
+                context,
+                operation.uuid,
+                'release',
+                1,
+                outcome=(
+                    'abort'
+                    if phase == 'cleanup_cinder_release'
+                    else 'commit'
+                ),
+            )
+        else:
+            value = self.cinder.get(context, operation.uuid)
+        ids = sorted(
+            d['volume_id']
+            for d in operation.admission['device_manifest']['disks']
+        )
+        c._require(
+            sorted(r['volume_id'] for r in value['resources']) == ids
+        )
+        if child.action == 'reserve':
+            c._require(value['status'] != 'released')
+            return v2.EffectResult(
+                'succeeded',
+                dict(
+                    operation_id=value['id'],
+                    generation=1,
+                    volume_ids=ids,
+                    state='reserved',
+                ),
+                None,
+            )
+        if child.action == 'release':
+            expected = (
+                'abort' if phase == 'cleanup_cinder_release' else 'commit'
+            )
+            if value['status'] != 'released':
+                return v2.EffectResult('pending', {}, None)
+            c._require(value['release_outcome'] == expected)
+            return v2.EffectResult(
+                'succeeded',
+                dict(
+                    operation_id=value['id'],
+                    generation=1,
+                    state='released',
+                    outcome=(
+                        'failed_no_effect'
+                        if expected == 'abort'
+                        else 'succeeded'
+                    ),
+                ),
+                None,
+            )
+        target = {
+            'disk_snapshot': 'snapshot',
+            'disk_revert': 'revert',
+            'disk_snapshot_delete': 'delete_snapshot',
+            'cleanup_disk_snapshots': 'delete_snapshot',
+        }[phase]
+        steps = [s for s in value['steps'] if s['phase'] == target]
+        if phase == 'cleanup_disk_snapshots':
+            # C1.1 closes a snapshot that never dispatched by cancelling its
+            # original step and quota. Such a resource needs no delete RPC.
+            for resource in value['resources']:
+                if not any(
+                    s['resource_id'] == resource['id'] for s in steps
+                ):
+                    original = [
+                        s
+                        for s in value['steps']
+                        if s['resource_id'] == resource['id'] and
+                        s['phase'] == 'snapshot'
+                    ]
+                    c._require(
+                        resource['status'] == 'deleted' and
+                        len(original) == 1 and
+                        original[0]['status'] == 'failed_no_effect'
+                    )
+                    steps.append(
+                        dict(
+                            resource_id=resource['id'], status='succeeded'
+                        )
+                    )
+        c._require(
+            len(steps) == len(ids) and
+            {s['resource_id'] for s in steps} ==
+            {r['id'] for r in value['resources']}
+        )
+        if all(s['status'] == 'succeeded' for s in steps):
+            status = {
+                'snapshot': 'available',
+                'revert': 'reverted',
+                'delete_snapshot': 'deleted',
+            }[target]
+            if target != 'revert':
+                c._require(
+                    all(r['status'] == status for r in value['resources'])
+                )
+            return v2.EffectResult(
+                'succeeded',
+                dict(
+                    phase=phase,
+                    volume_ids=ids,
+                    snapshots=[
+                        dict(
+                            volume_id=r['volume_id'],
+                            snapshot_id=r['snapshot_id'],
+                            status=status,
+                        )
+                        for r in value['resources']
+                    ],
+                ),
+                None,
+            )
+        if all(
+            s['status'] in ('succeeded', 'failed_no_effect') for s in steps
+        ):
+            return v2.EffectResult(
+                'failed_with_effects',
+                dict(
+                    resource_ids=ids,
+                    terminal_child_ids=[child.id],
+                    late_effect_impossible=True,
+                ),
+                'resources_remaining',
+            )
+        if any(s['status'] == 'unknown' for s in steps):
+            return unknown()
+        return v2.EffectResult('pending', {}, None)
+
+    def _config(self, context, instance, binding, child):
+        # The original readonly config drive remains the restore source. This
+        # encrypted immutable copy records the point's bytes and is never a
+        # writable guest disk or a replacement instance-directory file.
+        from nova.virt.libvirt.checkpoints import topology
+
+        manifest = objects.InstanceCheckpointOperation.device_manifest(
+            context, instance.uuid
+        )
+        observed = self.runtime.topology.inspect(
+            context, instance, manifest, 'recover', binding
+        )
+        path = os.path.join(
+            conf.CONF.instances_path, instance.uuid, 'disk.config'
+        )
+        with topology.config_reader(path) as source:
+            with self.staging.writer(context, binding, child) as writer:
+                import hashlib
+
+                digest, total = hashlib.sha256(), 0
+                while True:
+                    block = os.read(source, 1024 * 1024)
+                    if not block:
+                        break
+                    total += len(block)
+                    c._require(
+                        total <=
+                        writer.row['upper_bound'] - writer.metadata
+                    )
+                    self.staging.fs.check()
+                    files.write_all(writer.fd, block)
+                    digest.update(block)
+                c._require(
+                    digest.hexdigest() ==
+                    observed['runtime_manifest']['config_sha256']
+                )
+                artifact = writer.finish()
+        return v2.EffectResult(
+            'succeeded', dict(artifact=artifact.to_primitive()), None
+        )
+
+    def _effect(self, context, instance, binding, parent, child, query):
+        operation = objects.InstanceCheckpointOperation.get_by_uuid(
+            context, child.operation_id
+        )
+        action = child.action
+        if action == 'inspect':
+            manifest = objects.InstanceCheckpointOperation.device_manifest(
+                context, instance.uuid
+            )
+            observed = self.runtime.topology.inspect(
+                context, instance, manifest, operation.kind, binding
+            )
+            c._require(
+                observed['runtime_fingerprint'] ==
+                binding.runtime_fingerprint
+            )
+            return v2.EffectResult(
+                'succeeded',
+                dict(
+                    fingerprint=binding.db_fingerprint,
+                    host=binding.host,
+                    node=binding.node,
+                ),
+                None,
+            )
+        if action in ('reserve', 'submit_disk_operation', 'release'):
+            return self._cinder(
+                context, binding, child, parent.phase, operation, query
+            )
+        if action == 'reserve_staging':
+            if not query:
+                limit = operation.admission[
+                    (
+                        'save_bytes_limit'
+                        if operation.kind == 'create'
+                        else 'restore_bytes_limit'
+                    )
+                ]
+                self.staging.reserve(context, binding, child, limit)
+            return self.staging.observe(context, binding, child)
+        if action == 'release_staging':
+            return (
+                self.staging.observe if query else self.staging.cleanup
+            )(context, binding, child)
+        if action == 'copy_config':
+            return (
+                self.staging.observe_copy(context, binding, child)
+                if query
+                else self._config(context, instance, binding, child)
+            )
+        if action in journal.RUNTIME_ACTIONS:
+            if query:
+                return self.runtime.query(context, instance, child)
+            observed = dict(
+                runtime_fingerprint=binding.runtime_fingerprint
+            )
+            if action == 'save':
+                return self.runtime.save(
+                    context,
+                    instance,
+                    child,
+                    self._workspace(binding, child),
+                    observed,
+                )
+            if action == 'stop':
+                return self.runtime.stop(
+                    context, instance, child, observed
+                )
+            if action == 'unpause':
+                return self.runtime.unpause(
+                    context, instance, child, binding
+                )
+            rows = journal.reservations(context, binding)
+            artifact = self._ref(
+                next(
+                    r
+                    for r in rows
+                    if r['operation_id'] == operation.uuid and
+                    r['kind'] == 'ram' and
+                    r['location'] == 'staging' and
+                    r['writer_state'] == 'closed'
+                )
+            )
+            xml = self.runtime.host.get_guest(instance).get_xml_desc(
+                dump_sensitive=True
+            )
+            return self.runtime.restore_paused(
+                context,
+                instance,
+                child,
+                artifact,
+                self._workspace(binding, child),
+                xml,
+            )
+        if query:
+            return self.store.query(context, binding, child)
+        if action in ('publish', 'download'):
+            source = self._ref(
+                journal.reservation(
+                    context, binding, child.payload['source_id']
+                )
+            )
+            if action == 'publish':
+                row = journal.reservation(
+                    context, binding, child.resource_id
+                )
+                return self.store.publish(
+                    context, binding, child, source, row['upper_bound']
+                )
+            return self.store.download(
+                context,
+                binding,
+                child,
+                source,
+                self._workspace(binding, child),
+            )
+        if action == 'delete':
+            row = journal.reservation(context, binding, child.resource_id)
+            refs = (self._ref(row),) if row['checksum'] else ()
+            return self.store.delete(context, binding, child, refs)
+        return unknown('executor_unsupported')
+
+    @staticmethod
+    def _aggregate(parent, rows):
+        if not all(r['status'] == 'succeeded' for r in rows):
+            return None
+        proofs = [r['result']['evidence'] for r in rows]
+        phase = parent.phase
+        if phase in (
+            'runtime_save',
+            'artifact_publish_shared',
+            'artifact_stage',
+        ):
+            refs = [a for p in proofs for a in p.get('artifacts', [])]
+            refs += [p['artifact'] for p in proofs if 'artifact' in p]
+            evidence = dict(artifacts=refs)
+            if phase == 'runtime_save':
+                evidence['writes_stopped'] = True
+        elif phase in (
+            'staging_cleanup',
+            'artifact_delete',
+            'cleanup_artifacts',
+        ):
+            ids = [
+                r['resource_id'] for r in rows if r['action'] == 'delete'
+            ]
+            evidence = dict(artifact_ids=ids, deleted_artifact_ids=ids)
+            if phase == 'staging_cleanup':
+                evidence['late_effect_impossible'] = True
+        else:
+            c._require(bool(proofs))
+            evidence = dict(proofs[-1])
+            evidence.pop('phase', None)
+        return v2.EffectResult('succeeded', evidence, None)
+
+    def _run(self, context, instance, primitive, query):
+        try:
+            intent = v2.StepIntentV2.from_primitive(primitive)
+            parent = objects.InstanceCheckpointStep.get_by_uuid(
+                context, intent.id
+            )
+            binding = v2.Binding.from_primitive(intent.payload['binding'])
+            c._require(
+                parent.payload_hash == intent.payload_hash and
+                binding.executor_id == self.executor_id
+            )
+            if parent.phase in ('volume_disconnect', 'volume_reconnect'):
+                method = (
+                    self.attachments.query
+                    if query
+                    else getattr(
+                        self.attachments,
+                        (
+                            'disconnect'
+                            if parent.phase == 'volume_disconnect'
+                            else 'reconnect'
+                        ),
+                    )
+                )
+                return method(context, instance, binding, parent.uuid)
+            rows = objects.CheckpointEffect.get_children(
+                context, parent.uuid
+            )
+            result = self._aggregate(parent, rows)
+            if result is not None:
+                return result
+            row = next(r for r in rows if r['status'] != 'succeeded')
+            if row['status'] == 'prepared':
+                if query:
+                    return v2.EffectResult(
+                        'ready',
+                        objects.CheckpointEffect.continuation(
+                            context, parent.uuid
+                        ),
+                        None,
+                    )
+                row = objects.CheckpointEffect.claim(
+                    context,
+                    row['id'],
+                    1,
+                    self.executor_id,
+                    getattr(
+                        context,
+                        '_checkpoint_continuation_revision',
+                        row['revision'],
+                    ),
+                )
+                if row is None:
+                    return unknown()
+            else:
+                query = True
+            child = attachment_api.intent(row)
+            try:
+                result = self._effect(
+                    context, instance, binding, parent, child, query
+                )
+            except Exception:
+                result = (
+                    v2.EffectResult(
+                        'failed_no_effect',
+                        dict(no_effect=True, late_effect_impossible=True),
+                        'identity_changed',
+                    )
+                    if child.action == 'inspect'
+                    else unknown()
+                )
+            objects.CheckpointEffect.observe(
+                context, child.id, 1, result.to_primitive()
+            )
+            rows = objects.CheckpointEffect.get_children(
+                context, parent.uuid
+            )
+            if result.status == 'succeeded':
+                return self._aggregate(parent, rows) or v2.EffectResult(
+                    'ready',
+                    objects.CheckpointEffect.continuation(
+                        context, parent.uuid
+                    ),
+                    None,
+                )
+            return result
+        except Exception:
+            return unknown()
+
+    def execute(self, context, instance, intent):
+        return self._run(context, instance, intent, False).to_primitive()
+
+    def query(self, context, instance, intent):
+        return self._run(context, instance, intent, True).to_primitive()
