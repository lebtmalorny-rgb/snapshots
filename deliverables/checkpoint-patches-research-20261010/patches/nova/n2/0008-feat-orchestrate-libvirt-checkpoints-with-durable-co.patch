+    def test_partial_snapshot_cleanup_holds_charge_until_remote_deletion(
+        self,
+    ):
+        self.add_disk()
+        backend = self.drivers[0].backend
+        backend.fail.update(('partial_snapshot', 'cleanup_pending'))
+        created = self.create()
+        self.assertNotEqual('succeeded', self.operation(created)['state'])
+        self.assertGreater(self.usage()['artifact_bytes'], 0)
+        self.assertEqual(
+            1, backend.state
+        )  # original RAM restored before cleanup
+        op = backend.operations[created['operation']['id']]
+        self.assertEqual(1, len(backend.snapshots))
+        # An independent service completion; Nova's next pass only GETs it.
+        for step in op['steps']:
+            if step['phase'] == 'delete_snapshot':
+                step['status'] = 'succeeded'
+                resource = next(
+                    r
+                    for r in op['resources']
+                    if r['id'] == step['resource_id']
+                )
+                backend.snapshots.pop(resource['snapshot_id'], None)
+                resource['status'] = 'deleted'
+        self.advance(created)
+        self.assertEqual('released', self.operation(created)['state'])
+        self.assertEqual(0, self.usage()['artifact_bytes'])
+        self.assertEqual({}, backend.snapshots)
+        self.assertEqual(1, backend.calls['cleanup'])
