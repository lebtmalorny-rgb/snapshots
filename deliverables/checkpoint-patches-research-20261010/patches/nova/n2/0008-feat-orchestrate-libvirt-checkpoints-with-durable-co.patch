diff --git a/nova/checkpoints/compute_v2.py b/nova/checkpoints/compute_v2.py
new file mode 100644
index 0000000000000000000000000000000000000000..0092a77bc63c4e64a19bd7aba9c976882b63ee7b
--- /dev/null
+++ b/nova/checkpoints/compute_v2.py
@@ -0,0 +1,297 @@
+# Licensed under the Apache License, Version 2.0 (the "License"); you may
+# not use this file except in compliance with the License. You may obtain
+# a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+# WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+# License for the specific language governing permissions and limitations
+# under the License.
+
+"""Compute-side v2 orchestration; persistence is exclusively remotable OVO."""
+
+from nova.checkpoints import contracts as c
+from nova.checkpoints import contracts_v2 as v2
+from nova.checkpoints import guards
+from nova.checkpoints import workflow_v2 as workflow
+from nova import objects
+
+TERMINAL = ('succeeded', 'released')
+FAILED = ('failed_no_effect', 'failed_with_effects')
+
+
+def plan(context, operation):
+    steps = {
+        s.phase: s
+        for s in objects.InstanceCheckpointStepList.get_by_operation(
+            context, operation.uuid
+        )
+    }
+    children = {
+        name: objects.CheckpointEffect.get_children(context, step.uuid)
+        for name, step in steps.items()
+    }
+    phases, cleaning = workflow.execution_plan(
+        operation.kind,
+        {name: step.status for name, step in steps.items()},
+        children,
+    )
+    return steps, children, phases, cleaning
+
+
+class ComputeV2:
+    def __init__(self, driver, host):
+        self.driver, self.host = driver, host
+
+    def _load(self, context, instance, operation_id, generation):
+        v2.validate_generation(generation)
+        op = objects.InstanceCheckpointOperation.get_by_uuid(
+            context, operation_id
+        )
+        c._require(
+            op.contract_version == 2 and
+            op.generation == generation and
+            op.instance_uuid == instance.uuid and
+            op.host == self.host
+        )
+        current = objects.Instance.get_by_uuid(context, instance.uuid)
+        c._require(
+            (current.host, current.node, current.project_id) ==
+            (op.host, op.node, op.project_id)
+        )
+        if op.state not in TERMINAL:
+            c._require(op.quota_ready)
+            manifest = objects.InstanceCheckpointOperation.device_manifest(
+                context, current.uuid
+            )
+            c._require(
+                c.device_fingerprint(manifest) ==
+                op.admission['fingerprint']
+            )
+        return op, current
+
+    @staticmethod
+    def _intent(step):
+        return v2.StepIntentV2(
+            step.uuid,
+            step.operation_id,
+            step.generation,
+            step.phase,
+            step.executor_id,
+            step.payload_hash,
+            step.payload,
+        )
+
+    @staticmethod
+    def report(context, operation_id, status, step=None):
+        op = objects.InstanceCheckpointOperation.get_by_uuid(
+            context, operation_id
+        )
+        result = dict(
+            schema_version=2,
+            operation_id=op.uuid,
+            generation=1,
+            state=op.state,
+            phase=op.phase,
+            error_code=op.error_code,
+            status=status,
+        )
+        if status == 'ready':
+            result['continuation'] = objects.CheckpointEffect.continuation(
+                context, step.uuid
+            )
+        return result
+
+    def _effect(
+        self,
+        context,
+        instance,
+        operation,
+        step,
+        query=False,
+        revision=None,
+    ):
+        guard = objects.InstanceCheckpointGuard.get_by_instance_uuid(
+            context, instance.uuid
+        )
+        scope = c.Scope(
+            instance.uuid,
+            'checkpoint',
+            operation.uuid,
+            1,
+            step.phase,
+            guard.token,
+        )
+        try:
+            with guards.scope(context, scope) as ctx:
+                if revision is not None:
+                    ctx._checkpoint_continuation_revision = revision
+                method = (
+                    self.driver.checkpoint_query_v2
+                    if query
+                    else self.driver.checkpoint_execute_v2
+                )
+                result = v2.validate_result(
+                    step.phase,
+                    method(
+                        ctx, instance, self._intent(step).to_primitive()
+                    ),
+                )
+        except Exception:
+            result = v2.EffectResult('unknown', {}, 'executor_unavailable')
+        objects.InstanceCheckpointOperation.finish_step(
+            context, step.uuid, 1, result.to_primitive()
+        )
+        return result
+
+    @staticmethod
+    def _failure(context, operation, step):
+        objects.CheckpointEffect.cancel_prepared(
+            context, operation.uuid, 1
+        )
+        rows = objects.CheckpointEffect.get_children(context, step.uuid)
+        if any(r['status'] not in ('succeeded',) + FAILED for r in rows):
+            return v2.EffectResult('unknown', {}, 'recovery_required')
+        if all(r['status'] == 'failed_no_effect' for r in rows):
+            return v2.EffectResult(
+                'failed_no_effect',
+                dict(no_effect=True, late_effect_impossible=True),
+                'resources_remaining',
+            )
+        ids = {
+            r['id']
+            for r in objects.CheckpointArtifactReservation.get_by_checkpoint(
+                context, operation.checkpoint_id
+            )
+            if r['child_id'] in {r['id'] for r in rows}
+        }
+        for row in rows:
+            if (
+                row['action'] == 'submit_disk_operation' and
+                row['status'] == 'failed_with_effects'
+            ):
+                ids.update(row['result']['evidence']['resource_ids'])
+        c._require(bool(ids))
+        return v2.EffectResult(
+            'failed_with_effects',
+            dict(
+                resource_ids=sorted(ids),
+                terminal_child_ids=sorted(r['id'] for r in rows),
+                late_effect_impossible=True,
+            ),
+            'resources_remaining',
+        )
+
+    def advance(
+        self, context, instance, operation_id, generation, query=False
+    ):
+        op, current = self._load(
+            context, instance, operation_id, generation
+        )
+        if op.state in TERMINAL:
+            return self.report(context, op.uuid, 'terminal')
+        steps, children, phases, cleaning = plan(context, op)
+        if (
+            op.kind == 'create' and
+            not cleaning and
+            'staging_cleanup' in steps and
+            steps['staging_cleanup'].status == 'succeeded'
+        ):
+            objects.InstanceCheckpointOperation.confirm_artifact_usage(
+                context,
+                op.uuid,
+                steps['artifact_publish_shared'].result['evidence'],
+            )
+        for phase in phases:
+            step = steps.get(phase)
+            if step is not None and step.status == 'succeeded':
+                continue
+            if step is not None and step.status in FAILED:
+                return self.report(context, op.uuid, 'unknown')
+            if step is None:
+                if query:
+                    return self.report(context, op.uuid, 'progress')
+                primitive = objects.InstanceCheckpointOperation.claim_step(
+                    context, op.uuid, 1, phase, op.executor_id
+                )
+                if primitive is None:
+                    return self.report(context, op.uuid, 'unknown')
+                intent = v2.StepIntentV2.from_primitive(primitive)
+                step = objects.InstanceCheckpointStep.get_by_uuid(
+                    context, intent.id
+                )
+                result = self._effect(context, current, op, step)
+            elif any(r['status'] in FAILED for r in children[phase]):
+                if query:
+                    return self.report(context, op.uuid, 'fence_required')
+                result = self._failure(context, op, step)
+                objects.InstanceCheckpointOperation.finish_step(
+                    context, step.uuid, 1, result.to_primitive()
+                )
+            elif step.status == 'ready':
+                return self.report(context, op.uuid, 'ready', step)
+            else:
+                result = self._effect(
+                    context, current, op, step, query=True
+                )
+            if result.status == 'succeeded':
+                status = 'progress'
+            elif result.status in FAILED:
+                status = 'progress'
+            elif result.status == 'unknown':
+                rows = objects.CheckpointEffect.get_children(
+                    context, step.uuid
+                )
+                status = (
+                    'fence_required'
+                    if any(r['status'] in FAILED for r in rows)
+                    else 'unknown'
+                )
+            else:
+                status = result.status
+            return self.report(context, op.uuid, status, step)
+        objects.InstanceCheckpointOperation.finalize(
+            context, op.uuid, 1, 'succeeded'
+        )
+        updated = objects.InstanceCheckpointOperation.get_by_uuid(
+            context, op.uuid
+        )
+        return self.report(
+            context,
+            op.uuid,
+            'terminal' if updated.state in TERMINAL else 'closing',
+        )
+
+    def continue_step(
+        self,
+        context,
+        instance,
+        operation_id,
+        generation,
+        step_id,
+        journal_revision,
+    ):
+        op, current = self._load(
+            context, instance, operation_id, generation
+        )
+        c._integer(journal_revision, minimum=1)
+        step = objects.InstanceCheckpointStep.get_by_uuid(context, step_id)
+        value = objects.CheckpointEffect.continuation(context, step_id)
+        c._require(
+            step.operation_id == op.uuid and
+            step.phase == op.phase and
+            step.status == 'ready' and
+            value is not None and
+            value['journal_revision'] == journal_revision
+        )
+        result = self._effect(
+            context, current, op, step, revision=journal_revision
+        )
+        status = (
+            'progress'
+            if result.status in ('succeeded',) + FAILED
+            else result.status
+        )
+        return self.report(context, op.uuid, status, step)
