+class ExecutorV2FunctionalTest(checkpoints_v2.CheckpointV2TestCase):
+    def test_actual_executor_through_wsgi_and_serialized_rpc(self):
+        self.assertIsInstance(
+            self.drivers[0].checkpoint_executor,
+            executor.LibvirtCheckpointExecutor,
+        )
+        created = self.create('A')
+        self.assertEqual('succeeded', self.operation(created)['state'])
+
+    def test_two_independent_points_arbitrary_revert_and_delete(self):
+        backend = self.drivers[0].backend
+        a = self.create('A')
+        aid = a['checkpoint']['id']
+        backend.memory, backend.disk_bytes = b'B-memory', b'B-volume'
+        b = self.create('B')
+        bid = b['checkpoint']['id']
+        self.assertEqual('succeeded', self.operation(b)['state'])
+        for ident, memory, disk in (
+            (aid, b'original-memory', b'original-volume'),
+            (bid, b'B-memory', b'B-volume'),
+            (aid, b'original-memory', b'original-volume'),
+        ):
+            result = self.action(ident, 'revert')
+            self.assertEqual('succeeded', self.operation(result)['state'])
+            self.assertEqual(
+                (memory, disk, 1),
+                (backend.memory, backend.disk_bytes, backend.state),
+            )
+        for ident in (bid, aid):
+            result = self.action(ident, 'delete')
+            self.assertEqual('released', self.operation(result)['state'])
+        self.assertEqual(0, self.usage()['artifact_bytes'])
+        self.assertEqual({}, backend.snapshots)
+
+    def test_delete_does_not_require_a_working_domain(self):
+        a = self.create()
+        self.drivers[0].backend.fail.add('missing_domain')
+        result = self.action(a['checkpoint']['id'], 'delete')
+        self.assertEqual('released', self.operation(result)['state'])
+
+    def test_native_save_reply_loss_remains_guarded_and_charged(self):
+        backend = self.drivers[0].backend
+        backend.fail.add('save_reply')
+        a = self.create()
+        self.assertNotEqual('succeeded', self.operation(a)['state'])
+        before = dict(backend.calls)
+        self.ctx.auth_token = None
+        self.flags(enabled=False, group='checkpoint')
+        for unused in range(2):
+            self.recover()
+        self.assertEqual(before, dict(backend.calls))
+        self.assertEqual(5, backend.state)
+        self.assertGreater(self.usage()['artifact_bytes'], 0)
+        self.assertEqual(0, backend.calls['snapshot'])
+
+    def advance(self, result):
+
+        return coordinator.Coordinator().run(
+            self.ctx, self.servers[0], result['operation']['id'], 1
+        )
+
+    def rows(self, result):
+
+        with context.target_cell(self.ctx, self.cells[0]) as ctx:
+            return list(
+                objects.InstanceCheckpointStepList.get_by_operation(
+                    ctx, result['operation']['id']
+                )
+            )
