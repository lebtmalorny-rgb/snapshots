+
+def build(driver):
+    # Re-read the root-controlled allowlist on every entry, including recovery.
+    # Revoking a component cannot leave a cached permission to start writes.
+    config = conf.CONF.checkpoint
+    c._uuid(config.deployment_id)
+    c._require(conf.CONF.libvirt.virt_type == 'kvm')
+    records = profiles.load(config.profile_file)
+    shared_profile = records.match(
