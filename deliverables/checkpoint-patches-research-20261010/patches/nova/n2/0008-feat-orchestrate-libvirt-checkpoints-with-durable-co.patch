+def execution_plan(kind, statuses, children):
+    """Compensate only terminal effects; a partial revert stays guarded."""
+    normal = steps_for(kind)
+    failed = any(
+        statuses.get(p) in ('failed_no_effect', 'failed_with_effects')
+        for p in normal
+    )
+    terminal = ('succeeded', 'failed_no_effect', 'failed_with_effects')
+    if (
+        not failed or
+        kind == 'delete' or
+        any(
+            value not in terminal
+            for phase, value in statuses.items()
+            if phase in normal
+        ) or
+        any(
+            row['status'] not in terminal
+            for phase, rows in children.items()
+            if phase in normal
+            for row in rows
+        )
+    ):
+        return normal, False
+    saved = next(
+        (
+            r['status']
+            for r in children.get('runtime_save', [])
+            if r['action'] == 'save'
+        ),
+        None,
+    )
+    stopped = next(
+        (
+            r['status']
+            for r in children.get('runtime_stop', [])
+            if r['action'] == 'stop'
+        ),
+        None,
+    )
+    if (kind == 'create' and saved == 'failed_with_effects') or (
+        kind == 'revert' and stopped not in (None, 'failed_no_effect')
+    ):
+        return normal, False
+    cleanup = []
+    if (
+        saved == 'succeeded' and
+        statuses.get('runtime_restore_current') != 'succeeded'
+    ):
+        cleanup.append('cleanup_runtime_restore_current')
+    if kind == 'create' and statuses.get('cinder_reserve') == 'succeeded':
+        cleanup.append('cleanup_disk_snapshots')
+    if kind == 'create' and 'artifact_publish_shared' in statuses:
+        cleanup.append('cleanup_artifacts')
+    if 'runtime_save' in statuses or 'artifact_stage' in statuses:
+        cleanup.append('staging_cleanup')
+    if statuses.get('cinder_reserve') == 'succeeded':
+        cleanup.append('cleanup_cinder_release')
+    return tuple(cleanup), True
