+# under the License.
+
+"""Real N2 components over explicitly simulated physical/service boundaries."""
+
+from collections import Counter
+import copy
+import os
+from pathlib import Path
+import tempfile
+import uuid
+
+from lxml import etree
+from oslo_serialization import jsonutils
+from oslo_utils.fixture import uuidsentinel as uuids
+from oslo_utils import uuidutils
+
+from nova.checkpoints import attachments
+from nova.checkpoints import contracts as c
+from nova import context
+from nova import objects
+from nova.tests.fixtures import checkpoints
+from nova.tests.unit.virt.libvirt.checkpoints.test_topology import XML
+from nova.virt.libvirt.checkpoints import executor
+from nova.virt.libvirt.checkpoints import profiles
+from nova.virt.libvirt.checkpoints import runtime
+from nova.virt.libvirt.checkpoints import staging
+from nova.virt.libvirt.checkpoints import store
+from nova.virt.libvirt.checkpoints import topology
+
+LIMIT = 1024 * 1024
+
+
+class Backend:
+    def __init__(self, instance, volume, port, mac):
+        self.instance, self.volume, self.port = instance, volume, port
+        self.uuid, self.state = instance.uuid, 1
+        self.calls = Counter()
+        self.fail = set()
+        self.xml = (
+            XML.replace(uuids.instance, instance.uuid)
+            .replace(uuids.volume, volume)
+            .replace('fa:16:3e:00:00:01', mac)
+        )
+        self.interface = etree.tostring(
+            topology.document(self.xml).find('devices/interface'),
+            encoding='unicode',
+        )
+        self.operations, self.requests, self.attachments = {}, {}, {}
+        self.disk_bytes = b'original-volume'
+        self.memory = b'original-memory'
+        self.snapshots = {}
+
+    def get_guest(self, instance):
+        if 'missing_domain' in self.fail:
+            raise RuntimeError('simulated absent domain')
+        assert instance.uuid == self.uuid
+        return self
+
+    def get_xml_desc(self, **kwargs):
+        return self.xml
+
+    def checkpoint_state(self):
+        return dict(state=self.state, managed_save=False, job=0)
+
+    def checkpoint_block_job(self, name):
+        return {}
+
+    def checkpoint_set_marker(self, marker):
+        root = topology.document(self.xml)
+        old = root.find('metadata')
+        if old is not None:
+            root.remove(old)
+        etree.SubElement(root, 'metadata').append(
+            etree.fromstring(marker.encode())
+        )
+        self.xml = etree.tostring(root, encoding='unicode')
+
+    def checkpoint_save(self, path, xml):
+        self.calls['save'] += 1
+        Path(path).write_bytes(
+            jsonutils.dump_as_bytes(
+                dict(xml=xml, memory=self.memory.hex())
+            )
+        )
+        self.xml, self.state = xml, 5
+        if 'save_reply' in self.fail:
+            raise RuntimeError('simulated native save reply loss')
+
+    def checkpoint_stop(self):
+        self.calls['stop'] += 1
+        self.state = 5
+
+    def checkpoint_saved_xml(self, path):
+        return jsonutils.loads(Path(path).read_bytes())['xml']
+
+    def checkpoint_restore(self, path, xml):
+        self.calls['restore'] += 1
+        self.memory = bytes.fromhex(
+            jsonutils.loads(Path(path).read_bytes())['memory']
+        )
+        self.xml, self.state = xml, 3
+        if 'restore_reply' in self.fail:
+            raise RuntimeError('simulated native restore reply loss')
+
+    def resume(self):
+        self.calls['unpause'] += 1
+        self.state = 1
+        if 'unpause_reply' in self.fail:
+            raise RuntimeError('simulated native unpause reply loss')
+
+    def show_port(self, ident):
+        assert ident == self.port
+        return dict(
+            port=dict(
+                id=ident,
+                device_id=self.uuid,
+                network_id=uuids.network,
+                mac_address=self.interface_mac,
+                project_id=self.instance.project_id,
+                status='ACTIVE',
+                **{
+                    'binding:host_id': self.instance.host,
+                    'binding:vnic_type': 'normal',
+                    'binding:vif_type': 'ovs',
+                },
+            )
+        )
+
+    @property
+    def interface_mac(self):
+        return (
+            etree.fromstring(self.interface.encode())
+            .find('mac')
+            .get('address')
+        )
+
+    def sources(self, ctx, instance, disk):
+        bdm = objects.BlockDeviceMapping.get_by_volume_and_instance(
+            ctx, disk['volume_id'], instance.uuid
+        )
+        connection = jsonutils.loads(bdm.connection_info)
+        path = connection.get('data', {}).get(
+            'device_path', '/dev/mapper/disk-original'
+        )
+        node = topology.document(XML).find('devices/disk')
+        node.find('serial').text = disk['serial']
+        node.find('source').set('dev', path)
+        node.find('target').set(
+            'dev', disk['device_name'].removeprefix('/dev/')
+        )
+        return etree.tostring(node, encoding='unicode')
+
+    def volumes(self, ctx, ids, purpose, operation_id):
+        return {
+            ident: dict(id=ident, multiattach=False, encrypted=False)
+            for ident in ids
+        }
+
+    def preflight_capabilities(self, ctx, ids):
+        return {ident: dict(supported=True) for ident in ids}
+
+    def capabilities(self, ctx, operation, ident):
+        assert ident in [
+            r['volume_id'] for r in self.operations[operation]['resources']
+        ]
+        return dict(supported=True)
+
+    def reserve(self, ctx, operation, checkpoint, instance, kind, ids):
+        assert ctx.auth_token, 'background cannot create a reserve'
+        self.calls['reserve'] += 1
+        if 'reserve_absent' in self.fail:
+            raise RuntimeError('simulated request did not reach Cinder')
+        if operation not in self.operations:
+            original = (
+                objects.InstanceCheckpointDiskList.get_by_checkpoint(
+                    ctx, checkpoint
+                )
+                if kind != 'create'
+                else None
+            )
+            resources = []
+            for ident in ids:
+                snapshot = (
+                    next(
+                        r.snapshot_id
+                        for r in original
+                        if r.volume_id == ident
+                    )
+                    if original
+                    else uuidutils.generate_uuid()
+                )
+                resources.append(
+                    dict(
+                        id=uuidutils.generate_uuid(),
+                        volume_id=ident,
+                        snapshot_id=snapshot,
+                        status='reserved',
+                    )
+                )
+            self.operations[operation] = dict(
+                id=uuidutils.generate_uuid(),
+                kind=kind,
+                generation=1,
+                instance_uuid=instance,
+                status='reserved',
+                resources=resources,
+                steps=[],
+                release_outcome=None,
+            )
+        if 'reserve_reply' in self.fail:
+            raise RuntimeError('simulated reserve reply loss')
+        return copy.deepcopy(self.operations[operation])
+
+    def get(self, ctx, operation):
+        return copy.deepcopy(self.operations[operation])
+
+    def action(self, ctx, operation, action, generation, **kwargs):
+        op = self.operations[operation]
+        self.calls[action] += 1
+        if action == 'release':
+            op.update(status='released', release_outcome=kwargs['outcome'])
+        else:
+            phase = (
+                'delete_snapshot'
+                if action == 'cleanup'
+                else {
+                    'create': 'snapshot',
+                    'revert': 'revert',
+                    'delete': 'delete_snapshot',
+                }[op['kind']]
+            )
+            if not any(s['phase'] == phase for s in op['steps']):
+                for index, resource in enumerate(op['resources']):
+                    self.calls[phase] += 1
+                    snapshot = resource['snapshot_id']
+                    if (
+                        phase == 'snapshot' and
+                        index == 1 and
+                        'partial_snapshot' in self.fail
+                    ):
+                        op['steps'].append(
+                            dict(
+                                id=uuidutils.generate_uuid(),
+                                resource_id=resource['id'],
+                                phase=phase,
+                                status='failed_no_effect',
+                            )
+                        )
+                        continue
+                    if (
+                        phase == 'revert' and
+                        index == 1 and
+                        'partial_revert' in self.fail
+                    ):
+                        op['steps'].append(
+                            dict(
+                                id=uuidutils.generate_uuid(),
+                                resource_id=resource['id'],
+                                phase=phase,
+                                status='failed_no_effect',
+                            )
+                        )
+                        continue
+                    if action == 'cleanup':
+                        original = next(
+                            (
+                                s
+                                for s in op['steps']
+                                if s['phase'] == 'snapshot' and
+                                s['resource_id'] == resource['id']
+                            ),
+                            None,
+                        )
+                        if (
+                            original is not None and
+                            original['status'] == 'failed_no_effect'
+                        ):
+                            resource['status'] = 'deleted'
+                            continue
+                        if 'cleanup_pending' in self.fail:
+                            op['steps'].append(
+                                dict(
+                                    id=uuidutils.generate_uuid(),
+                                    resource_id=resource['id'],
+                                    phase=phase,
+                                    status='pending',
+                                )
+                            )
+                            continue
+                    if phase == 'snapshot':
+                        self.snapshots[snapshot] = self.disk_bytes
+                        resource['status'] = 'available'
+                    elif phase == 'revert':
+                        self.disk_bytes = self.snapshots[snapshot]
+                    else:
+                        self.snapshots.pop(snapshot, None)
+                        resource['status'] = 'deleted'
+                    op['steps'].append(
+                        dict(
+                            id=uuidutils.generate_uuid(),
+                            resource_id=resource['id'],
+                            phase=phase,
+                            status='succeeded',
+                        )
+                    )
+            op['status'] = (
+                'succeeded'
+                if all(s['status'] == 'succeeded' for s in op['steps'])
+                else 'recovery_required'
+            )
+        return copy.deepcopy(op)
+
+    def submit_attachment(self, ctx, operation, payload):
+        self.calls['attachment_' + payload['action']] += 1
+        if payload['id'] not in self.requests:
+            ident = payload['attachment_id'] or uuidutils.generate_uuid()
+            self.requests[payload['id']] = dict(
+                payload, attachment_id=ident, status='succeeded'
+            )
+            self.attachments[ident] = dict(
+                id=ident,
+                volume_id=payload['volume_id'],
+                instance=self.uuid,
+                status='attaching',
+                connection_info=dict(
+                    driver_volume_type='iscsi',
+                    data=dict(volume_id=payload['volume_id']),
+                ),
+            )
+        return copy.deepcopy(self.requests[payload['id']])
+
+    def get_attachment_request(self, ctx, operation, ident):
+        return copy.deepcopy(self.requests[ident])
+
+    def get_attachment(self, ctx, operation, ident):
+        return copy.deepcopy(self.attachments[ident])
+
+
+class Driver:
+    def __init__(self, backend, virtapi):
+        self.backend, self.virtapi = backend, virtapi
+
+    def checkpoint_probe_v2(
+        self,
+        context,
+        instance,
+        manifest,
+        purpose,
+        checkpoint_id=None,
+        operation_id=None,
+    ):
+        return self.checkpoint_executor.probe(
+            context,
+            instance,
+            manifest,
+            purpose,
+            checkpoint_id,
+            operation_id,
+        ).to_primitive()
+
+    def checkpoint_execute_v2(self, context, instance, intent):
+        return self.checkpoint_executor.execute(context, instance, intent)
+
+    def checkpoint_query_v2(self, context, instance, intent):
+        return self.checkpoint_executor.query(context, instance, intent)
+
+    def get_volume_connector(self, instance):
+        return dict(host=instance.host)
+
+    def _checkpoint_disconnect_volume(
+        self, ctx, instance, binding, child, connection
+    ):
+        assert self.backend.state == 5
+        self.backend.calls['disconnect'] += 1
+
+    def _checkpoint_connect_volume(
+        self, ctx, instance, binding, child, connection
+    ):
+        assert self.backend.state == 5
+        self.backend.calls['connect'] += 1
+        connection['data']['device_path'] = (
+            '/dev/mapper/new-' + child.resource_id
+        )
+
+
+class CheckpointV2TestCase(checkpoints.CheckpointTestCase):
+    CHECKPOINT_CONTRACT_VERSION = 2
+
+    def setUp(self):
+        super().setUp()
+        self.ctx.auth_token = 'test-original-user'
+        self.flags(
+            max_artifact_bytes_per_project=64 * LIMIT, group='checkpoint'
+        )
+
+    def make_driver(self, index, manager):
+        self.flags(deployment_id=uuids.deployment, group='checkpoint')
+        temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(temporary.cleanup)
+        root = Path(temporary.name)
+        with context.target_cell(self.ctx, self.cells[index]) as ctx:
+            inst = objects.Instance.get_by_uuid(ctx, self.servers[index])
+            bdm = objects.BlockDeviceMapping.get_by_volume_and_instance(
+                ctx, self.volumes[index], inst.uuid
+            )
+            bdm.attachment_id = uuidutils.generate_uuid()
+            bdm.save()
+        backend = Backend(
+            inst,
+            self.volumes[index],
+            self.ports[index],
+            'fa:16:3e:00:00:%02d' % index,
+        )
+        driver = Driver(backend, manager.virtapi)
+        observed_runtime = dict(
+            kind='runtime',
+            kvm=True,
+            libvirt_version=11010000,
+            qemu_version=9002000,
+            architecture='x86_64',
+            machine='pc-q35-9.2',
+            path_access='same-pid-namespace-proc-fd',
+        )
+        runtime_profile = profiles.ProfileMatch(
+            uuids.runtime,
+            'runtime',
+            c.canonical_payload_hash(observed_runtime),
+            'a' * 64,
+            observed_runtime,
+            dict(
+                max_memory_bytes=1024**3,
+                save_bytes_limit=LIMIT,
+                restore_bytes_limit=LIMIT,
+            ),
+        )
+        inspector = topology.Topology(
+            backend,
+            profileset=profiles.ProfileSet((runtime_profile,)),
+            observer=lambda guest, xml: observed_runtime,
+            neutron_factory=lambda ctx: backend,
+            volume_reader=backend.volumes,
+            source_reader=backend.sources,
+            interface_reader=lambda ctx, instance, port: backend.interface,
+        )
+
+        def filesystem(kind):
+            path = root / kind
+            path.mkdir(mode=0o700)
+            dev = path.stat().st_dev
+            observed = dict(
+                kind=kind,
+                fstype='xfs' if kind == 'staging' else 'nfs4',
+                mount_id=index + 1,
+                device='%s:%s' % (os.major(dev), os.minor(dev)),
+                fsid=os.statvfs(path).f_fsid,
+                source='test-only',
+                store_uuid=getattr(uuids, kind + 'fs'),
+                encrypted_at_rest=True,
+            )
+            observed[
+                (
+                    'project_quota'
+                    if kind == 'staging'
+                    else 'encrypted_transport'
+                )
+            ] = True
+            profile = profiles.ProfileMatch(
+                getattr(uuids, kind),
+                kind,
+                c.canonical_payload_hash(observed),
+                'a' * 64,
+                observed,
+                dict(
+                    max_bytes=4 * LIMIT,
+                    metadata_bytes=262144,
+                    allocation_unit=4096,
+                    max_workspaces=128,
+                    project_id_min=100000,
+                    project_id_max=2147483647,
+                ),
+            )
+            return str(path), profile, lambda path: dict(observed)
+
+        path, profile, observer = filesystem('staging')
+        local = staging.StagingStore(
+            path,
+            profile,
+            observer=observer,
+            quota_helper=lambda root, workspace, project, limit: dict(
+                project_id=project, limit_bytes=limit, enforced=True
+            ),
+            quota_observer=lambda root, workspace, project: dict(
+                project_id=project, limit_bytes=LIMIT, enforced=True
+            ),
+        )
+        path, profile, observer = filesystem('store')
+        shared = store.ArtifactStore(
+            path, profile, staging=local, observer=observer
+        )
+        native = runtime.Runtime(backend, local, inspector)
+        attach = attachments.AttachmentCoordinator(
+            driver, local, native, client=backend
+        )
+        driver.checkpoint_executor = executor.LibvirtCheckpointExecutor(
+            driver,
+            native,
+            shared,
+            local,
+            backend,
+            attach,
+            executor_id=str(
+                uuid.uuid5(uuid.UUID(uuids.deployment), manager.host)
+            ),
+        )
+        return driver
