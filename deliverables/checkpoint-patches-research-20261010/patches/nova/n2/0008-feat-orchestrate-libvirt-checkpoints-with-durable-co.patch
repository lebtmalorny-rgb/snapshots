+    client = cinder.CheckpointClient()
+    attachment = attachments.AttachmentCoordinator(
+        driver, local, native, client=client
+    )
+    return executor.LibvirtCheckpointExecutor(
+        driver, native, shared, local, client, attachment
+    )
