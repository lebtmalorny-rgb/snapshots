+import contextlib
+import os
+import struct
+import tempfile
+from unittest import mock
+
+from oslo_utils.fixture import uuidsentinel as uuids
+
+import nova.privsep.checkpoint
+from nova import test
+from nova.tests import fixtures
+
+
+class CheckpointPrivsepTest(test.NoDBTestCase):
+    def setUp(self):
+        super().setUp()
+        self.useFixture(fixtures.PrivsepFixture())
+
+    def test_unconfigured_root_rejected_before_privileged_io(self):
+        with mock.patch.object(
+            nova.privsep.checkpoint, '_quota_call'
+        ) as call:
+            self.assertRaises(
+                ValueError,
+                nova.privsep.checkpoint.set_project_limit,
+                '/tmp/foreign',
+                uuids.workspace,
+                100000,
+                4096,
+            )
+        call.assert_not_called()
+
+    def test_accounting_without_enforcement_is_not_supported(self):
+        for flags, expected in ((0x10, False), (0x30, True)):
+
+            def reply(source, command, project, buffer):
+                struct.pack_into('=BBH', buffer, 0, 1, 0, flags)
+
+            with mock.patch.object(
+                nova.privsep.checkpoint, '_quota_call', side_effect=reply
+            ):
+                self.assertEqual(
+                    expected,
+                    nova.privsep.checkpoint._quota_flags('/dev/test'),
+                )
+
+    def test_quota_limits_are_512_byte_basic_blocks(self):
+        def reply(source, command, project, buffer):
+            struct.pack_into('=bbHIQQ', buffer, 0, 1, 2, 0, project, 16, 8)
+
+        with mock.patch.object(
+            nova.privsep.checkpoint, '_quota_call', side_effect=reply
+        ):
+            self.assertEqual(
+                (8192, 4096),
+                nova.privsep.checkpoint._quota_limit('/dev/test', 45),
+            )
+
+    def test_set_only_owned_directory_and_exact_bound(self):
+        with tempfile.TemporaryDirectory() as path:
+            fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
+            self.addCleanup(os.close, fd)
+
+            @contextlib.contextmanager
+            def workspace(root, ident, project):
+                yield fd, dict(source='/dev/test'), dict(limit_bytes=4096)
+
+            before = [0, 0, 0, 0, 0, b'\x00' * 8]
+            after = [
+                nova.privsep.checkpoint.PROJINHERIT,
+                0,
+                0,
+                45,
+                0,
+                b'\x00' * 8,
+            ]
+            with (
+                mock.patch.object(
+                    nova.privsep.checkpoint, '_workspace', workspace
+                ),
+                mock.patch.object(
+                    nova.privsep.checkpoint,
+                    '_attributes',
+                    side_effect=[before, after],
+                ),
+                mock.patch.object(
+                    nova.privsep.checkpoint, '_quota_call'
+                ) as call,
+                mock.patch.object(
+                    nova.privsep.checkpoint,
+                    '_quota_limit',
+                    return_value=(4096, 4096),
+                ),
+                mock.patch.object(
+                    nova.privsep.checkpoint,
+                    '_quota_flags',
+                    return_value=True,
+                ),
+                mock.patch.object(
+                    nova.privsep.checkpoint.fcntl, 'ioctl'
+                ) as ioctl,
+            ):
+                result = nova.privsep.checkpoint.set_project_limit(
+                    path, uuids.workspace, 45, 4096
+                )
+                self.assertEqual(
+                    dict(project_id=45, limit_bytes=4096, enforced=True),
+                    result,
+                )
+                source, command, ident, buffer = call.call_args.args
+                self.assertEqual(
+                    ('/dev/test', 4, 45), (source, command, ident)
+                )
+                self.assertEqual(
+                    (1, 2, 12, 45, 8, 8),
+                    struct.unpack_from('=bbHIQQ', buffer.raw),
+                )
+                self.assertEqual(fd, ioctl.call_args.args[0])
+                self.assertEqual(
+                    nova.privsep.checkpoint.FSSETXATTR,
+                    ioctl.call_args.args[1],
+                )
+
+    def test_unaligned_limit_rejected_without_rounding_up(self):
+        with mock.patch.object(
+            nova.privsep.checkpoint, '_workspace'
+        ) as workspace:
+            self.assertRaises(
+                ValueError,
+                nova.privsep.checkpoint.set_project_limit,
+                '/configured',
+                uuids.workspace,
+                45,
+                4097,
+            )
+        workspace.assert_not_called()
+
+    def test_external_xfs_device_is_not_implicitly_encrypted(self):
+        with tempfile.TemporaryDirectory() as path:
+            info = os.stat(path)
+            mount = dict(
+                device='%s:%s'
+                % (os.major(info.st_dev), os.minor(info.st_dev)),
+                mount_id=21,
+                source='/dev/test',
+                fstype='xfs',
+                options=['logdev=/dev/unencrypted'],
+            )
+            marker = dict(
+                kind='staging',
+                store_uuid=uuids.store,
+                server_policy_sha256='a' * 64,
+            )
+            self.flags(staging_root=path, group='checkpoint')
+            with (
+                mock.patch.object(
+                    nova.privsep.checkpoint, '_mount', return_value=mount
+                ),
+                mock.patch.object(
+                    nova.privsep.checkpoint, '_marker', return_value=marker
+                ),
+                mock.patch.object(
+                    nova.privsep.checkpoint,
+                    '_encrypted_device',
+                    return_value=True,
+                ),
+            ):
+                self.assertRaises(
+                    ValueError,
+                    nova.privsep.checkpoint.inspect_staging,
+                    path,
+                )
