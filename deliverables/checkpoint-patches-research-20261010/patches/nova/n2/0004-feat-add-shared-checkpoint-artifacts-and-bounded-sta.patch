+"""Local process-crash checks, without NAS power-loss qualification."""
+
+import os
+import sqlite3
+import traceback
+from unittest import mock
+
+from oslo_db.sqlalchemy import enginefacade
+from oslo_utils.fixture import uuidsentinel as uuids
+
+from nova.db.main import api as db
+from nova import objects
+from nova.tests.unit.virt.libvirt.checkpoints import fixtures
+
+
+class ArtifactProcessCrashTest(fixtures.StoreTestBase):
+    def test_process_exit_after_link_retains_owned_partial_copy(self):
+        # oslo.db discards inherited connections after fork. Persist the real
+        # fixture journal so the child reconnects to the same committed rows.
+        path = self.root / 'cell.sqlite'
+        source = db.get_engine(context=self.ctx).raw_connection()
+        try:
+            with sqlite3.connect(str(path)) as target:
+                source.driver_connection.backup(target)
+        finally:
+            source.close()
+        manager = enginefacade.transaction_context()
+        manager.configure(connection='sqlite:///' + str(path))
+        self.addCleanup(manager.dispose_pool)
+        self.ctx.db_connection = manager
+        pid = os.fork()
+        if pid == 0:
+            unlink = os.unlink
+
+            def crash(name, *args, **kwargs):
+                if name == 'part':
+                    os._exit(42)
+                return unlink(name, *args, **kwargs)
+
+            try:
+                with mock.patch('os.unlink', side_effect=crash):
+                    self.publish()
+            except BaseException:
+                (self.root / 'child-error').write_text(
+                    traceback.format_exc()
+                )
+            finally:
+                os._exit(99)
+        child_pid, status = os.waitpid(pid, 0)
+        self.assertEqual(pid, child_pid)
+        error = self.root / 'child-error'
+        self.assertEqual(
+            42,
+            os.waitstatus_to_exitcode(status),
+            error.read_text() if error.exists() else '',
+        )
+        result = self.store.query(
+            self.ctx, self.binding, self.publish_child
+        )
+        self.assertEqual('failed_with_effects', result.status)
+        objects.CheckpointEffect.observe(
+            self.ctx, self.publish_child.id, 1, result.to_primitive()
+        )
+        parent = self.parent(
+            'cleanup_artifacts',
+            [
+                dict(
+                    id=uuids.shared,
+                    kind='ram',
+                    location='shared',
+                    upper_bound=fixtures.LIMIT,
+                )
+            ],
+        )
+        cleanup = self.claim(parent, 'delete')
+        self.assertEqual(
+            'succeeded',
+            self.store.delete(self.ctx, self.binding, cleanup, ()).status,
+        )
+        self.assertTrue(os.path.exists(self.workspace['path']))
