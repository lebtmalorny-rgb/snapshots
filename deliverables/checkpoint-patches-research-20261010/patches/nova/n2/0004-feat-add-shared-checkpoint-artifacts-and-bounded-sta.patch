+        child = self.claim(parent, 'delete')
+        result = self.staging.cleanup(self.ctx, self.binding, child)
+        self.assertEqual('succeeded', result.status)
+        objects.CheckpointEffect.observe(
+            self.ctx, child.id, 1, result.to_primitive()
+        )
+        release = self.claim(parent, 'release_staging')
+        result = self.staging.cleanup(self.ctx, self.binding, release)
+        self.assertEqual('succeeded', result.status)
+        self.assertFalse(Path(self.workspace['path']).exists())
+        self.assertEqual(
+            result, self.staging.observe(self.ctx, self.binding, release)
+        )
+
+    def test_sparse_logical_size_is_charged(self):
+        child, shared, workspace = self.downloaded_child()
+        with self.staging.writer(self.ctx, self.binding, child) as writer:
+            with open(writer.path, 'wb') as stream:
+                stream.truncate(fixtures.LIMIT // 2)
+            artifact = writer.finish()
+        self.assertGreater(artifact.bytes, fixtures.LIMIT // 2)
+
+    def test_allocated_space_beyond_bound_is_not_confirmed(self):
+        child, shared, workspace = self.downloaded_child()
+        with self.staging.writer(self.ctx, self.binding, child) as writer:
+            allocate = ctypes.CDLL(None, use_errno=True).fallocate
+            allocate.argtypes = [
+                ctypes.c_int,
+                ctypes.c_int,
+                ctypes.c_longlong,
+                ctypes.c_longlong,
+            ]
+            allocate.restype = ctypes.c_int
+            # KEEP_SIZE allocates extents without increasing logical length.
+            self.assertEqual(0, allocate(writer.fd, 1, 0, fixtures.LIMIT))
+            self.assertEqual(0, Path(writer.path).stat().st_size)
+            self.assertRaises(ValueError, writer.finish)
