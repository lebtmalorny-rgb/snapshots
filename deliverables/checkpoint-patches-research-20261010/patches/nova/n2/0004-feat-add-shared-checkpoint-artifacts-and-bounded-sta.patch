+import dataclasses
+import os
+from pathlib import Path
+import tempfile
+from unittest import mock
+
+from oslo_utils.fixture import uuidsentinel as uuids
+from oslo_utils import uuidutils
+
+from nova.checkpoints import contracts as c
+from nova.checkpoints import contracts_v2 as v2
+from nova.checkpoints import workflow_v2
+from nova import context
+from nova.db.main import api as db
+from nova.db.main import checkpoints as journal
+from nova.db.main import models
+from nova import objects
+from nova import test
+from nova.tests.unit.checkpoints import test_cell_db
+from nova.virt.libvirt.checkpoints import profiles
+from nova.virt.libvirt.checkpoints import staging
+from nova.virt.libvirt.checkpoints import store
+
+LIMIT = 1024 * 1024
+
+
+class StoreTestBase(test.TestCase):
+    def setUp(self):
+        super().setUp()
+        self.flags(
+            enabled=True,
+            deployment_id=uuids.deployment,
+            group='checkpoint',
+        )
+        temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(temporary.cleanup)
+        self.root = Path(temporary.name)
+        self.shared_root, self.staging_root = (
+            self.root / 'shared',
+            self.root / 'staging',
+        )
+        self.shared_root.mkdir(mode=0o700)
+        self.staging_root.mkdir(mode=0o700)
+        self.ctx = context.RequestContext('actor', 'project')
+        test_cell_db.make_instance(self.ctx)
+        old = test_cell_db.admission(self.ctx)
+        self.admission = v2.AdmissionV2(
+            **dict(
+                {
+                    f.name: getattr(old, f.name)
+                    for f in dataclasses.fields(old)
+                },
+                artifact_upper_bound=4 * LIMIT,
+            ),
+            runtime_fingerprint='b' * 64,
+            runtime_profile_id=uuids.runtime,
+            store_profile_id=uuids.store,
+            staging_profile_id=uuids.staging,
+            save_bytes_limit=LIMIT,
+            restore_bytes_limit=LIMIT,
+        )
+        self.operation = objects.InstanceCheckpointOperation.admit(
+            self.ctx, self.admission.to_primitive(), uuids.ticket
+        )
+        journal.mark_quota_ready(self.ctx, uuids.operation, uuids.ticket)
+        self.binding = v2.Binding.from_primitive(self.operation.binding)
+        self.shared_observed = dict(
+            kind='store',
+            fstype='nfs4',
+            mount_id=21,
+            device='0:77',
+            source='test-server:/ram',
+            store_uuid=uuids.storefs,
+            encrypted_at_rest=True,
+            encrypted_transport=True,
+        )
+        self.staging_observed = dict(
+            kind='staging',
+            fstype='xfs',
+            mount_id=22,
+            device='253:2',
+            source='/dev/mapper/test-staging',
+            store_uuid=uuids.stagingfs,
+            encrypted_at_rest=True,
+            project_quota=True,
+        )
+        for root, observed in (
+            (self.shared_root, self.shared_observed),
+            (self.staging_root, self.staging_observed),
+        ):
+            device = root.stat().st_dev
+            observed.update(
+                device='%s:%s' % (os.major(device), os.minor(device)),
+                fsid=os.statvfs(root).f_fsid,
+            )
+        self.shared_observer = mock.Mock(
+            side_effect=lambda path: dict(self.shared_observed)
+        )
+        self.staging_observer = mock.Mock(
+            side_effect=lambda path: dict(self.staging_observed)
+        )
+        self.quota_helper = mock.Mock(
+            side_effect=lambda root, workspace, project, limit: dict(
+                project_id=project, limit_bytes=limit, enforced=True
+            )
+        )
+        self.staging = staging.StagingStore(
+            str(self.staging_root),
+            self.profile('staging', self.staging_observed),
+            observer=self.staging_observer,
+            quota_helper=self.quota_helper,
+            quota_observer=lambda root, workspace, project: dict(
+                project_id=project, limit_bytes=LIMIT, enforced=True
+            ),
+        )
+        self.store = store.ArtifactStore(
+            str(self.shared_root),
+            self.profile('store', self.shared_observed),
+            staging=self.staging,
+            observer=self.shared_observer,
+        )
+        self.save_parent = self.parent(
+            'runtime_save',
+            [
+                dict(
+                    id=uuids.ram,
+                    kind='ram',
+                    location='staging',
+                    upper_bound=LIMIT,
+                )
+            ],
+        )
+        reserve = self.claim(self.save_parent, 'reserve_staging')
+        self.reserve_child = reserve
+        self.workspace = self.staging.reserve(
+            self.ctx, self.binding, reserve, LIMIT
+        )
+        objects.CheckpointEffect.observe(
+            self.ctx,
+            reserve.id,
+            1,
+            v2.EffectResult(
+                'succeeded',
+                dict(workspace_id=uuids.operation, limit_bytes=LIMIT),
+                None,
+            ).to_primitive(),
+        )
+        self.save_child = self.claim(self.save_parent, 'save')
+        with self.staging.writer(
+            self.ctx, self.binding, self.save_child
+        ) as writer:
+            Path(writer.path).write_bytes(b'private-ram-state')
+            self.source = writer.finish()
+        objects.CheckpointEffect.observe(
+            self.ctx,
+            self.save_child.id,
+            1,
+            v2.EffectResult(
+                'succeeded',
+                dict(
+                    writes_stopped=True,
+                    artifacts=[self.source.to_primitive()],
+                ),
+                None,
+            ).to_primitive(),
+        )
+        self.publish_parent = self.parent(
+            'artifact_publish_shared',
+            [
+                dict(
+                    id=uuids.shared,
+                    kind='ram',
+                    location='shared',
+                    upper_bound=LIMIT,
+                    source_id=uuids.ram,
+                )
+            ],
+        )
+        self.publish_child = self.claim(self.publish_parent, 'publish')
+
+    def profile(self, kind, observed):
+        return profiles.ProfileMatch(
+            getattr(uuids, kind),
+            kind,
+            c.canonical_payload_hash(observed),
+            'a' * 64,
+            observed,
+            dict(
+                max_bytes=4 * LIMIT,
+                metadata_bytes=262144,
+                allocation_unit=4096,
+                max_workspaces=128,
+                project_id_min=100000,
+                project_id_max=2147483647,
+            ),
+        )
+
+    def parent(self, phase, artifacts):
+        ident = uuidutils.generate_uuid()
+        resources = dict(
+            parent_step_id=ident,
+            operation_id=uuids.operation,
+            checkpoint_id=uuids.checkpoint,
+            volume_ids=[uuids.volume],
+            artifacts=artifacts,
+        )
+        kind = (
+            'revert'
+            if phase == 'artifact_stage'
+            else 'cleanup' if phase.startswith('cleanup_') else 'create'
+        )
+        graph = workflow_v2.child_plan(kind, phase, resources)
+        payload = dict(
+            binding=self.binding.to_primitive(),
+            kind='create',
+            generation=1,
+            budgets=dict(total_bytes=4 * LIMIT, version=1),
+            children=[r['id'] for r in graph],
+            prior={},
+            resources=resources,
+        )
+
+        @db.pick_context_manager_writer
+        def insert(ctx):
+            # Seed this phase independently from the not-yet-wired adapters;
+            # real OVO reservation/claim below remains mandatory before I/O.
+            ctx.session.add(
+                models.InstanceCheckpointStep(
+                    uuid=ident,
+                    operation_id=uuids.operation,
+                    generation=1,
+                    phase=phase,
+                    executor_id='test-executor',
+                    payload_hash=c.canonical_payload_hash(payload),
+                    payload=journal._encode(payload),
+                    status='dispatching',
+                    version=1,
+                    contract_version=2,
+                    child_plan_count=len(graph),
+                    child_plan_hash=c.canonical_payload_hash(
+                        {'children': graph}
+                    ),
+                )
+            )
+            ctx.session.flush()
+            for index, child in enumerate(graph):
+                ctx.session.add(
+                    models.InstanceCheckpointEffect(
+                        id=child['id'],
+                        parent_step_id=ident,
+                        operation_id=uuids.operation,
+                        generation=1,
+                        action=child['action'],
+                        resource_id=child['resource_id'],
+                        executor_id='test-executor',
+                        payload=journal._encode(child['payload']),
+                        payload_hash=c.canonical_payload_hash(
+                            child['payload']
+                        ),
+                        status='prepared',
+                        revision=1,
+                        sequence=index,
+                    )
+                )
+
+        insert(self.ctx)
+        for child in objects.CheckpointEffect.get_children(
+            self.ctx, ident
+        ):
+            if child['action'] in (
+                'save',
+                'publish',
+                'download',
+                'copy_config',
+            ):
+                descriptor = next(
+                    r for r in artifacts if r['id'] == child['resource_id']
+                )
+                objects.CheckpointArtifactReservation.reserve(
+                    self.ctx,
+                    child['id'],
+                    descriptor['id'],
+                    descriptor['location'],
+                    descriptor['upper_bound'],
+                )
+        return ident
+
+    def claim(self, parent_id, action):
+        row = next(
+            r
+            for r in objects.CheckpointEffect.get_children(
+                self.ctx, parent_id
+            )
+            if r['action'] == action
+        )
+        row = objects.CheckpointEffect.claim(
+            self.ctx, row['id'], 1, 'test-executor', row['revision']
+        )
+        self.assertIsNotNone(row)
+        return v2.ChildIntent(
+            **{
+                f.name: row[f.name]
+                for f in dataclasses.fields(v2.ChildIntent)
+            }
+        )
+
+    def publish(self):
+        return self.store.publish(
+            self.ctx, self.binding, self.publish_child, self.source, LIMIT
+        )
+
+    def downloaded_child(self):
+        result = self.publish()
+        self.assertEqual('succeeded', result.status)
+        shared = v2.ArtifactRef.from_primitive(result.evidence['artifact'])
+        objects.CheckpointEffect.observe(
+            self.ctx, self.publish_child.id, 1, result.to_primitive()
+        )
+        parent = self.parent(
+            'artifact_stage',
+            [
+                dict(
+                    id=uuids.download,
+                    kind='ram',
+                    location='staging',
+                    upper_bound=LIMIT,
+                    source_id=shared.id,
+                )
+            ],
+        )
+        reserved = self.claim(parent, 'reserve_staging')
+        workspace = self.staging.reserve(
+            self.ctx, self.binding, reserved, LIMIT
+        )
+        objects.CheckpointEffect.observe(
+            self.ctx,
+            reserved.id,
+            1,
+            v2.EffectResult(
+                'succeeded',
+                dict(workspace_id=uuids.operation, limit_bytes=LIMIT),
+                None,
+            ).to_primitive(),
+        )
+        return self.claim(parent, 'download'), shared, workspace
