+
+    def test_missing_owner_does_not_prove_deletion(self):
+        result = self.publish()
+        self.assertEqual('succeeded', result.status)
+        ref = v2.ArtifactRef.from_primitive(result.evidence['artifact'])
+        objects.CheckpointEffect.observe(
+            self.ctx, self.publish_child.id, 1, result.to_primitive()
+        )
+        parent = self.parent(
+            'cleanup_artifacts',
+            [
+                dict(
+                    id=ref.id,
+                    kind='ram',
+                    location='shared',
