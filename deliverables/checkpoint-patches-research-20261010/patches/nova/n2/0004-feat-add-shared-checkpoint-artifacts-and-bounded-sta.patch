+
+"""Executor-side read checks use OVO indirection, never cell SQL."""
+
+import dataclasses
+
+from nova.checkpoints import contracts as c
+from nova.checkpoints import contracts_v2 as v2
+from nova import objects
+
+
+def authorize(context, binding, child, write=False):
+    c._require(
+        type(binding) is v2.Binding and type(child) is v2.ChildIntent
+    )
+    parent = objects.InstanceCheckpointStep.get_by_uuid(
+        context, child.parent_step_id
+    )
+    operation = objects.InstanceCheckpointOperation.get_by_uuid(
+        context, child.operation_id
+    )
+    checkpoint = objects.InstanceCheckpoint.get_by_uuid(
+        context, binding.checkpoint_id
+    )
+    rows = objects.CheckpointEffect.get_children(context, parent.uuid)
+    row = next((r for r in rows if r['id'] == child.id), None)
+    c._require(row is not None)
+    actual = {
+        f.name: row[f.name] for f in dataclasses.fields(v2.ChildIntent)
+    }
+    c._require(v2.ChildIntent(**actual) == child)
+    c._require(
+        operation.contract_version == 2 and parent.contract_version == 2
+    )
+    c._require(
+        operation.binding == binding.to_primitive() and
+        parent.payload['binding'] == binding.to_primitive() and
+        parent.operation_id == operation.uuid and
+        operation.checkpoint_id == checkpoint.uuid and
+        operation.executor_id == binding.executor_id
+    )
+    if write:
+        c._require(
+            checkpoint.active_operation_id == operation.uuid and
+            row['status'] == 'dispatching' and
+            operation.quota_ready
+        )
+    return row
+
+
+def reservations(context, binding):
+    return objects.CheckpointArtifactReservation.get_by_checkpoint(
+        context, binding.checkpoint_id
+    )
+
+
+def reservation(context, binding, artifact_id):
+    row = next(
+        (
+            r
+            for r in reservations(context, binding)
+            if r['id'] == artifact_id
+        ),
+        None,
+    )
+    c._require(
+        row is not None and
+        row['logical_id'] ==
+        v2.artifact_logical_id(binding, artifact_id)
+    )
+    return row
+
+
+def writer(context, binding, child, location):
+    authorize(context, binding, child, write=True)
+    row = reservation(context, binding, child.resource_id)
+    c._require(
+        row['child_id'] == child.id and
+        row['operation_id'] == child.operation_id and
+        row['location'] == location and
+        row['writer_state'] == 'dispatching'
+    )
+    return row
+
+
+def readable(context, binding, artifact):
+    row = reservation(context, binding, artifact.id)
+    c._require(
+        row['writer_state'] == 'closed' and
+        (
+            row['kind'],
+            row['logical_id'],
+            row['actual_bytes'],
+            row['checksum'],
+            row['location'],
+        ) ==
+        (
+            artifact.kind,
+            artifact.logical_id,
+            artifact.bytes,
+            artifact.checksum,
+            artifact.location,
+        )
+    )
+    return row
diff --git a/nova/virt/libvirt/checkpoints/staging.py b/nova/virt/libvirt/checkpoints/staging.py
new file mode 100644
index 0000000000000000000000000000000000000000..092698931afcf8f63d9632bf0755a7150e49a986
--- /dev/null
+++ b/nova/virt/libvirt/checkpoints/staging.py
@@ -0,0 +1,572 @@
+# Licensed under the Apache License, Version 2.0 (the "License"); you may
+# not use this file except in compliance with the License. You may obtain
+# a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+# WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+# License for the specific language governing permissions and limitations
+# under the License.
+
+"""Encrypted, qualified, project-quota-bounded local staging workspaces."""
+
+import contextlib
+import os
+
+from nova.checkpoints import contracts as c
+from nova.checkpoints import contracts_v2 as v2
+from nova import exception
+import nova.privsep.checkpoint
+from nova.virt.libvirt.checkpoints import files
+from nova.virt.libvirt.checkpoints import journal
+
+ERRORS = (
+    OSError,
+    ValueError,
+    KeyError,
+    TypeError,
+    exception.NovaException,
+)
+
+
+def unknown(reason='store_unavailable'):
+    return v2.EffectResult('unknown', {}, reason)
+
+
+class Writer:
+    """Private writer, sealed only after the backend writer ends."""
+
+    def __init__(
+        self, directory, descriptor, path, binding, child, row, metadata
+    ):
+        self.directory, self.fd, self.path = directory, descriptor, path
+        self.binding, self.child, self.row = binding, child, row
+        self.metadata = metadata
+
+    def finish(self):
+        return files.seal(
+            self.directory,
+            self.fd,
+            self.binding,
+            self.child,
+            self.row,
+            self.metadata,
+        )
+
+
+class StagingStore:
+    def __init__(
+        self,
+        root,
+        profile,
+        observer=None,
+        quota_helper=None,
+        quota_observer=None,
+    ):
+        c._require(profile.kind == 'staging')
+        self.root, self.profile = root, profile
+        self.fs = files.Root(
+            root,
+            profile,
+            observer or nova.privsep.checkpoint.inspect_staging,
+        )
+        self.set_quota = (
+            quota_helper or nova.privsep.checkpoint.set_project_limit
+        )
+        self.get_quota = (
+            quota_observer or nova.privsep.checkpoint.get_project_limit
+        )
+
+    def probe(self):
+        try:
+            self.fs.check()
+            with self.fs.directory() as root:
+                self._registry(root)
+            return dict(supported=True, profile_id=self.profile.id)
+        except ERRORS:
+            return dict(supported=False, reason='profile_unverified')
+
+    @staticmethod
+    def _parts(binding, operation_id):
+        return files.components(binding, operation_id)
+
+    def _registry(self, directory):
+        try:
+            result = files.read_json(directory, 'registry')
+        except FileNotFoundError:
+            c._require(
+                set(os.listdir(directory)) <=
+                {'.checkpoint-store', 'registry-lock'}
+            )
+            return dict(
+                next=self.profile.limits['project_id_min'], entries={}
+            )
+        c._keys(result, ('next', 'entries'))
+        c._integer(
+            result['next'], minimum=self.profile.limits['project_id_min']
+        )
+        c._require(type(result['entries']) is dict)
+        allocated = [r['project_id'] for r in result['entries'].values()]
+        c._require(
+            len(set(allocated)) == len(allocated) and
+            all(
+                type(ident) is int and 0 < ident < result['next']
+                for ident in allocated
+            )
+        )
+        return result
+
+    def _entry(self, binding, operation_id):
+        c._require(binding.staging_profile_id == self.profile.id)
+        with self.fs.directory() as root:
+            registry = self._registry(root)
+            entry = registry['entries'][operation_id]
+        c._require(
+            entry['binding'] == binding.to_primitive() and
+            entry['state'] == 'active'
+        )
+        quota = self.get_quota(
+            self.root, operation_id, entry['project_id']
+        )
+        c._require(
+            quota['enforced'] is True and
+            quota['project_id'] == entry['project_id'] and
+            quota['limit_bytes'] == entry['limit_bytes']
+        )
+        parts = self._parts(binding, operation_id)
+        with self.fs.directory(parts) as directory:
+            info = os.fstat(directory)
+            c._require(
+                (info.st_dev, info.st_ino) ==
+                (entry['device'], entry['inode'])
+            )
+        return dict(
+            entry,
+            path=os.path.join(self.root, *parts),
+            budget_version=1,
+            namespace_hash=c.canonical_payload_hash(
+                binding.to_primitive()
+            ),
+        )
+
+    def reserve(self, context, binding, child, limit_bytes):
+        journal.authorize(context, binding, child, write=True)
+        c._require(
+            child.action == 'reserve_staging' and
+            child.resource_id == child.operation_id and
+            binding.staging_profile_id == self.profile.id
+        )
+        self.fs.budget(limit_bytes)
+        c._require(
+            limit_bytes % self.profile.limits['allocation_unit'] == 0
+        )
+        parts = self._parts(binding, child.operation_id)
+        with (
+            self.fs.directory() as root,
+            files.control_lock(root, 'registry-lock'),
+        ):
+            registry = self._registry(root)
+            existing = registry['entries'].get(child.operation_id)
+            if existing:
+                c._require(
+                    existing['binding'] == binding.to_primitive() and
+                    existing['limit_bytes'] == limit_bytes
+                )
+            else:
+                c._require(
+                    len(registry['entries']) <
+                    self.profile.limits['max_workspaces'] and
+                    registry['next'] <=
+                    self.profile.limits['project_id_max']
+                )
+                with self.fs.directory(parts, create=True) as directory:
+                    c._require(not os.listdir(directory))
+                    info = os.fstat(directory)
+                    entry = dict(
+                        binding=binding.to_primitive(),
+                        project_id=registry['next'],
+                        limit_bytes=limit_bytes,
+                        device=info.st_dev,
+                        inode=info.st_ino,
+                        state='allocating',
+                    )
+                    registry['next'] += 1
+                    registry['entries'][child.operation_id] = entry
+                    files.replace_json(root, 'registry', registry)
+            entry = registry['entries'][child.operation_id]
+            if entry['state'] == 'allocating':
+                quota = self.set_quota(
+                    self.root,
+                    child.operation_id,
+                    entry['project_id'],
+                    limit_bytes,
+                )
+                c._require(
+                    quota ==
+                    dict(
+                        project_id=entry['project_id'],
+                        limit_bytes=limit_bytes,
+                        enforced=True,
+                    )
+                )
+                with self.fs.directory(parts) as directory:
+                    with files.control_lock(directory, 'io-lock'):
+                        os.fsync(directory)
+                entry['state'] = 'active'
+                files.replace_json(root, 'registry', registry)
+        return self._entry(binding, child.operation_id)
+
+    @contextlib.contextmanager
+    def writer(self, context, binding, child):
+        c._require(child.action in ('save', 'copy_config', 'download'))
+        row = journal.writer(context, binding, child, 'staging')
+        workspace = self._entry(binding, child.operation_id)
+        self.fs.budget(row['upper_bound'])
+        c._require(row['upper_bound'] <= workspace['limit_bytes'])
+        parts = self._parts(binding, child.operation_id)
+        with self.fs.directory(parts) as workspace_fd:
+            with self._io_lock(workspace_fd, exclusive=False):
+                artifact_parts = parts + ('artifacts', row['id'])
+                with self.fs.directory(
+                    artifact_parts, create=True
+                ) as directory:
+                    c._require(not os.listdir(directory))
+                    with files.locked(directory, create=True):
+                        fd = os.open(
+                            'data',
+                            os.O_RDWR |
+                            os.O_CREAT |
+                            os.O_EXCL |
+                            files.OPEN_FILE,
+                            0o600,
+                            dir_fd=directory,
+                        )
+                        try:
+                            files.create_json(
+                                directory,
+                                'owner',
+                                files.owner(
+                                    binding,
+                                    child,
+                                    row,
+                                    self.profile.id,
+                                    fd,
+                                ),
+                            )
+                            yield Writer(
+                                directory,
+                                fd,
+                                os.path.join(
+                                    workspace['path'],
+                                    'artifacts',
+                                    row['id'],
+                                    'data',
+                                ),
+                                binding,
+                                child,
+                                row,
+                                self.profile.limits['metadata_bytes'],
+                            )
+                        finally:
+                            os.close(fd)
+
+    @staticmethod
+    @contextlib.contextmanager
+    def _io_lock(directory, exclusive):
+        import fcntl
+
+        fd = os.open(
+            'io-lock', os.O_RDWR | files.OPEN_FILE, dir_fd=directory
+        )
+        try:
+            files.regular(fd)
+            fcntl.flock(
+                fd,
+                (fcntl.LOCK_EX if exclusive else fcntl.LOCK_SH) |
+                fcntl.LOCK_NB,
+            )
+            yield fd
+        finally:
+            os.close(fd)
+
+    @contextlib.contextmanager
+    def reader(self, context, binding, artifact):
+        row = journal.readable(context, binding, artifact)
+        self._entry(binding, row['operation_id'])
+        parts = self._parts(binding, row['operation_id'])
+        with self.fs.directory(parts) as workspace_fd:
+            with self._io_lock(workspace_fd, exclusive=False):
+                with self.fs.directory(
+                    parts + ('artifacts', row['id'])
+                ) as directory:
+                    with files.locked(directory, exclusive=False):
+                        ref, info = files.inspect(
+                            directory,
+                            self.profile.limits['metadata_bytes'],
+                        )
+                        c._require(ref == artifact)
+                        fd = os.open(
+                            'data',
+                            os.O_RDONLY | files.OPEN_FILE,
+                            dir_fd=directory,
+                        )
+                        try:
+                            yield fd, info
+                            self.fs.check()
+                            c._require(
+                                files.fingerprint(
+                                    fd,
+                                    self.profile.limits['metadata_bytes'],
+                                ) ==
+                                info
+                            )
+                        finally:
+                            os.close(fd)
+
+    def observe(self, context, binding, child):
+        try:
+            journal.authorize(context, binding, child)
+            if child.action == 'reserve_staging':
+                workspace = self._entry(binding, child.operation_id)
+                return v2.EffectResult(
+                    'succeeded',
+                    dict(
+                        workspace_id=child.operation_id,
+                        limit_bytes=workspace['limit_bytes'],
+                    ),
+                    None,
+                )
+            if child.action == 'release_staging':
+                return self._release(context, binding, child, query=True)
+            return unknown('recovery_required')
+        except ERRORS:
+            return unknown()
+
+    def observe_copy(self, context, binding, child):
+        """Only synchronous Nova copy workers are fenced by the file lock.
+
+        A libvirt save writer needs an independent backend completion proof;
+        this method deliberately cannot observe a save child.
+        """
+        try:
+            journal.authorize(context, binding, child)
+            c._require(child.action in ('download', 'copy_config'))
+            row = journal.reservation(context, binding, child.resource_id)
+            c._require(
+                row['child_id'] == child.id and
+                row['location'] == 'staging'
+            )
+            self._entry(binding, child.operation_id)
+            parts = self._parts(binding, child.operation_id)
+            with self.fs.directory(parts) as workspace:
+                with self._io_lock(workspace, exclusive=False):
+                    with self.fs.directory(
+                        parts + ('artifacts', row['id'])
+                    ) as directory:
+                        with files.locked(directory, exclusive=False):
+                            owner = files.read_json(directory, 'owner')
+                            files.check_owner(
+                                owner, binding, child, row, self.profile.id
+                            )
+                            names = set(os.listdir(directory))
+                            c._require(
+                                names <= {'owner', 'lock', 'data', 'seal'}
+                            )
+                            if 'seal' in names:
+                                ref, info = files.inspect(
+                                    directory,
+                                    self.profile.limits['metadata_bytes'],
+                                )
+                                c._require(
+                                    ref.id == row['id'] and
+                                    ref.bytes <= row['upper_bound'] and
+                                    (info['device'], info['inode']) ==
+                                    (owner['device'], owner['inode'])
+                                )
+                                return v2.EffectResult(
+                                    'succeeded',
+                                    dict(artifact=ref.to_primitive()),
+                                    None,
+                                )
+                            info = os.stat(
+                                'data',
+                                dir_fd=directory,
+                                follow_symlinks=False,
+                            )
+                            files.private(info)
+                            c._require(
+                                info.st_nlink == 1 and
+                                (info.st_dev, info.st_ino) ==
+                                (owner['device'], owner['inode'])
+                            )
+                            return v2.EffectResult(
+                                'failed_with_effects',
+                                dict(
+                                    resource_ids=[row['id']],
+                                    terminal_child_ids=[child.id],
+                                    late_effect_impossible=True,
+                                ),
+                                'resources_remaining',
+                            )
+        except BlockingIOError:
+            return v2.EffectResult('pending', {}, None)
+        except ERRORS:
+            return unknown()
+
+    def _release(self, context, binding, child, query=False):
+        rows = [
+            r
+            for r in journal.reservations(context, binding)
+            if r['operation_id'] == child.operation_id and
+            r['location'] == 'staging'
+        ]
+        c._require(all(r['writer_state'] == 'deleted' for r in rows))
+        parts = self._parts(binding, child.operation_id)
+        with self.fs.directory() as root:
+            registry = self._registry(root)
+            if query:
+                c._require(child.operation_id not in registry['entries'])
+                try:
+                    with self.fs.directory(parts):
+                        return unknown('resources_remaining')
+                except FileNotFoundError:
+                    pass
+            else:
+                with files.control_lock(root, 'registry-lock'):
+                    registry = self._registry(root)
+                    entry = registry['entries'].get(child.operation_id)
+                    if entry:
+                        c._require(
+                            entry['binding'] == binding.to_primitive()
+                        )
+                        with self.fs.directory(parts) as directory:
+                            with self._io_lock(directory, exclusive=True):
+                                # Artifact delete children remove the leaves
+                                # before releasing this workspace.
+                                c._require(
+                                    set(os.listdir(directory)) <=
+                                    {'io-lock', 'artifacts'}
+                                )
+                                if 'artifacts' in os.listdir(directory):
+                                    os.rmdir('artifacts', dir_fd=directory)
+                                os.unlink('io-lock', dir_fd=directory)
+                                os.fsync(directory)
+                        files.remove_empty(self.fs, parts)
+                        del registry['entries'][child.operation_id]
+                        files.replace_json(root, 'registry', registry)
+        return v2.EffectResult(
+            'succeeded',
+            dict(
+                workspace_id=child.operation_id,
+                deleted=True,
+                late_effect_impossible=True,
+            ),
+            None,
+        )
+
+    def cleanup(self, context, binding, child):
+        try:
+            journal.authorize(context, binding, child, write=True)
+            if child.action == 'release_staging':
+                return self._release(context, binding, child)
+            c._require(child.action == 'delete')
+            row = journal.reservation(context, binding, child.resource_id)
+            c._require(row['location'] == 'staging')
+            peers = [
+                r
+                for r in journal.reservations(context, binding)
+                if r['operation_id'] == row['operation_id'] and
+                r['location'] == 'staging'
+            ]
+            c._require(
+                all(
+                    r['writer_state'] in ('closed', 'deleted')
+                    for r in peers
+                )
+            )
+            parts = self._parts(binding, row['operation_id'])
+            artifact_parts = parts + ('artifacts', row['id'])
+            self.fs.check()
+            with self.fs.directory(parts) as workspace_fd:
+                with self._io_lock(workspace_fd, exclusive=True):
+                    with contextlib.ExitStack() as stack:
+                        try:
+                            directory = stack.enter_context(
+                                self.fs.directory(artifact_parts)
+                            )
+                        except FileNotFoundError:
+                            self.fs.check()
+                        else:
+                            with files.locked(directory):
+                                owner = files.read_json(directory, 'owner')
+                                c._require(
+                                    owner['artifact_id'] == row['id'] and
+                                    owner['child']['id'] ==
+                                    row['child_id'] and
+                                    owner['binding'] ==
+                                    binding.to_primitive()
+                                )
+                                files.erase(directory, owner)
+                            with self.fs.directory(
+                                parts + ('artifacts',)
+                            ) as parent:
+                                os.rmdir(row['id'], dir_fd=parent)
+                                os.fsync(parent)
+            return v2.EffectResult(
+                'succeeded',
+                dict(
+                    artifact_id=row['id'],
+                    deleted=True,
+                    late_effect_impossible=True,
+                ),
+                None,
+            )
+        except ERRORS:
+            return unknown()
+
+    def query_delete(self, context, binding, child):
+        try:
+            journal.authorize(context, binding, child)
+            c._require(child.action == 'delete')
+            row = journal.reservation(context, binding, child.resource_id)
+            c._require(
+                row['location'] == 'staging' and
+                row['writer_state'] in ('closed', 'deleted')
+            )
+            parts = self._parts(binding, row['operation_id'])
+            if (
+                row['writer_state'] == 'deleted' and
+                row['cleanup_child_id'] == child.id
+            ):
+                self.fs.check()
+                return v2.EffectResult(
+                    'succeeded',
+                    dict(
+                        artifact_id=row['id'],
+                        deleted=True,
+                        late_effect_impossible=True,
+                    ),
+                    None,
+                )
+            with self.fs.directory(parts) as workspace_fd:
+                with self._io_lock(workspace_fd, exclusive=True):
+                    try:
+                        with self.fs.directory(
+                            parts + ('artifacts', row['id'])
+                        ):
+                            return unknown('resources_remaining')
+                    except FileNotFoundError:
+                        self.fs.check()
+            return v2.EffectResult(
+                'succeeded',
+                dict(
+                    artifact_id=row['id'],
+                    deleted=True,
+                    late_effect_impossible=True,
+                ),
+                None,
+            )
+        except ERRORS:
+            return unknown()
