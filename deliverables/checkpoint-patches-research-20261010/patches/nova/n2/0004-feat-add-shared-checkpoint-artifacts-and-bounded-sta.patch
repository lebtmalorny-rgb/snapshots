+"""Immutable shared artifacts requiring a qualified NAS profile."""
+
+import contextlib
+import hashlib
+import os
+
+from nova.checkpoints import contracts as c
+from nova.checkpoints import contracts_v2 as v2
+from nova import conf
+from nova import exception
+import nova.privsep.checkpoint
+from nova.virt.libvirt.checkpoints import files
+from nova.virt.libvirt.checkpoints import journal
+
+ERRORS = (
+    OSError,
+    ValueError,
+    KeyError,
+    TypeError,
+    exception.NovaException,
+)
+
+
+def unknown(reason='store_unavailable'):
+    return v2.EffectResult('unknown', {}, reason)
+
+
+class ArtifactStore:
+    def __init__(self, root, profile, staging=None, observer=None):
+        c._require(profile.kind == 'store')
+        self.root, self.profile, self.staging = root, profile, staging
+        self.fs = files.Root(
+            root,
+            profile,
+            observer or nova.privsep.checkpoint.inspect_mount,
+        )
+
+    def probe(self):
+        try:
+            with self.fs.directory():
+                pass
+            return dict(supported=True, profile_id=self.profile.id)
+        except ERRORS:
+            return dict(supported=False, reason='profile_unverified')
+
+    def artifact_path(self, binding, artifact_id):
+        return self.fs.artifact_path(binding, artifact_id)
+
+    @contextlib.contextmanager
+    def _transfer(self):
+        with self.fs.directory() as root:
+            count = conf.CONF.checkpoint.max_concurrent_transfers
+            c._integer(count, minimum=1, maximum=1024)
+            with contextlib.ExitStack() as stack:
+                for slot in range(count):
+                    try:
+                        stack.enter_context(
+                            files.control_lock(root, 'transfer-%d' % slot)
+                        )
+                        break
+                    except BlockingIOError:
+                        continue
+                else:
+                    raise BlockingIOError('Checkpoint transfers busy')
+                yield
+
+    def _copy(self, source_fd, target_fd, logical_bytes, checksum, limit):
+        maximum = self.fs.budget(limit)
+        c._require(logical_bytes <= maximum)
+        digest, total = hashlib.sha256(), 0
+        os.lseek(source_fd, 0, os.SEEK_SET)
+        while True:
+            self.fs.check()
+            block = os.read(
+                source_fd, min(1024 * 1024, maximum - total + 1)
+            )
+            if not block:
+                break
+            c._require(total + len(block) <= maximum)
+            files.write_all(target_fd, block)
+            digest.update(block)
+            total += len(block)
+        c._require(
+            total == logical_bytes and digest.hexdigest() == checksum
+        )
+        os.fsync(target_fd)
+        info = files.regular(target_fd)
+        c._require(max(info.st_size, info.st_blocks * 512) <= maximum)
+
+    def publish(self, context, binding, child, source, budget):
+        try:
+            c._require(
+                child.action == 'publish' and
+                binding.store_profile_id == self.profile.id and
+                child.payload['source_id'] == source.id
+            )
+            self.fs.budget(budget)
+            row = journal.writer(context, binding, child, 'shared')
+            c._require(
+                budget <= row['upper_bound'] and source.bytes <= budget
+            )
+            parts = files.components(binding, child.resource_id)
+            with self.staging.reader(context, binding, source) as (
+                src,
+                observed,
+            ):
+                with (
+                    self._transfer(),
+                    self.fs.directory(parts, create=True) as directory,
+                ):
+                    if os.listdir(directory):
+                        return self.query(context, binding, child)
+                    with files.locked(directory, create=True):
+                        fd = os.open(
+                            'part',
+                            os.O_RDWR |
+                            os.O_CREAT |
+                            os.O_EXCL |
+                            files.OPEN_FILE,
+                            0o600,
+                            dir_fd=directory,
+                        )
+                        try:
+                            files.create_json(
+                                directory,
+                                'owner',
+                                files.owner(
+                                    binding,
+                                    child,
+                                    row,
+                                    self.profile.id,
+                                    fd,
+                                ),
+                            )
+                            self._copy(
+                                src,
+                                fd,
+                                observed['logical_bytes'],
+                                source.checksum,
+                                budget,
+                            )
+                            self.fs.check()
+                            os.link(
+                                'part',
+                                'data',
+                                src_dir_fd=directory,
+                                dst_dir_fd=directory,
+                                follow_symlinks=False,
+                            )
+                            os.fsync(directory)
+                            os.unlink('part', dir_fd=directory)
+                            os.fsync(directory)
+                            ref = files.seal(
+                                directory,
+                                fd,
+                                binding,
+                                child,
+                                row,
+                                self.profile.limits['metadata_bytes'],
+                            )
+                        finally:
+                            os.close(fd)
+            return v2.EffectResult(
+                'succeeded', dict(artifact=ref.to_primitive()), None
+            )
+        except BlockingIOError:
+            return v2.EffectResult('pending', {}, None)
+        except ERRORS:
+            return unknown()
+
+    @contextlib.contextmanager
+    def reader(self, context, binding, artifact):
+        c._require(binding.store_profile_id == self.profile.id)
+        row = journal.readable(context, binding, artifact)
+        c._require(row['location'] == 'shared')
+        with self.fs.directory(
+            files.components(binding, row['id'])
+        ) as directory:
+            with files.locked(directory, exclusive=False):
+                ref, observed = files.inspect(
+                    directory, self.profile.limits['metadata_bytes']
+                )
+                c._require(ref == artifact)
+                owner = files.read_json(directory, 'owner')
+                c._require(
+                    owner['binding'] == binding.to_primitive() and
+                    owner['child']['id'] == row['child_id']
+                )
+                fd = os.open(
+                    'data', os.O_RDONLY | files.OPEN_FILE, dir_fd=directory
+                )
+                try:
+                    yield fd, observed
+                    self.fs.check()
+                    c._require(
+                        files.fingerprint(
+                            fd, self.profile.limits['metadata_bytes']
+                        ) ==
+                        observed
+                    )
+                finally:
+                    os.close(fd)
+
+    def download(self, context, binding, child, artifact, workspace):
+        try:
+            c._require(
+                child.action == 'download' and
+                child.payload['source_id'] == artifact.id
+            )
+            row = journal.writer(context, binding, child, 'staging')
+            c._require(row['upper_bound'] <= workspace['limit_bytes'])
+            with (
+                self._transfer(),
+                self.reader(context, binding, artifact) as (
+                    src,
+                    observed,
+                ),
+            ):
+                with self.staging.writer(
+                    context, binding, child
+                ) as writer:
+                    self._copy(
+                        src,
+                        writer.fd,
+                        observed['logical_bytes'],
+                        artifact.checksum,
+                        row['upper_bound'],
+                    )
+                    ref = writer.finish()
+            return v2.EffectResult(
+                'succeeded', dict(artifact=ref.to_primitive()), None
+            )
+        except BlockingIOError:
+            return v2.EffectResult('pending', {}, None)
+        except ERRORS:
+            return unknown()
+
+    def query(self, context, binding, child):
+        try:
+            journal.authorize(context, binding, child)
+            if child.action == 'download':
+                return self.staging.observe_copy(context, binding, child)
+            row = journal.reservation(context, binding, child.resource_id)
+            if child.action == 'delete':
+                return self._delete(
+                    context, binding, child, row, query=True
+                )
+            c._require(
+                child.action == 'publish' and
+                row['child_id'] == child.id and
+                binding.store_profile_id == self.profile.id
+            )
+            with self.fs.directory(
+                files.components(binding, row['id'])
+            ) as directory:
+                with files.locked(directory, exclusive=False):
+                    owner = files.read_json(directory, 'owner')
+                    files.check_owner(
+                        owner, binding, child, row, self.profile.id
+                    )
+                    names = set(os.listdir(directory))
+                    c._require(
+                        names <= {'owner', 'lock', 'data', 'part', 'seal'}
+                    )
+                    if 'seal' in names and 'part' not in names:
+                        ref, observed = files.inspect(
+                            directory,
+                            self.profile.limits['metadata_bytes'],
+                        )
+                        c._require(
+                            ref.id == row['id'] and
+                            ref.bytes <= row['upper_bound'] and
+                            (observed['device'], observed['inode']) ==
+                            (owner['device'], owner['inode'])
+                        )
+                        return v2.EffectResult(
+                            'succeeded',
+                            dict(artifact=ref.to_primitive()),
+                            None,
+                        )
+                    # The local copy worker has exited, and immutable owner
+                    # plus its one-shot file creation fences a late
+                    # reexecution.
+                    for name in names & {'data', 'part'}:
+                        info = os.stat(
+                            name, dir_fd=directory, follow_symlinks=False
+                        )
+                        files.private(info)
+                        c._require(
+                            (info.st_dev, info.st_ino) ==
+                            (owner['device'], owner['inode'])
+                        )
+                        c._require(
+                            info.st_nlink ==
+                            (2 if {'data', 'part'} <= names else 1)
+                        )
+                    return v2.EffectResult(
+                        'failed_with_effects',
+                        dict(
+                            resource_ids=[row['id']],
+                            terminal_child_ids=[child.id],
+                            late_effect_impossible=True,
+                        ),
+                        'resources_remaining',
+                    )
+        except BlockingIOError:
+            return v2.EffectResult('pending', {}, None)
+        except ERRORS:
+            return unknown('artifact_corrupt')
+
+    def _delete(self, context, binding, child, row, query=False):
+        c._require(row['writer_state'] in ('closed', 'deleted'))
+        if row['location'] == 'staging':
+            if query:
+                return self.staging.query_delete(context, binding, child)
+            return self.staging.cleanup(context, binding, child)
+        c._require(binding.store_profile_id == self.profile.id)
+        self.fs.check()
+        parts = files.components(binding, row['id'])
+        with contextlib.ExitStack() as stack:
+            try:
+                directory = stack.enter_context(self.fs.directory(parts))
+            except FileNotFoundError:
+                self.fs.check()
+            else:
+                if query:
+                    return unknown('resources_remaining')
+                with files.locked(directory):
+                    owner = files.read_json(directory, 'owner')
+                    c._require(
+                        owner['binding'] == binding.to_primitive() and
+                        owner['artifact_id'] == row['id'] and
+                        owner['child']['id'] == row['child_id']
+                    )
+                    files.erase(directory, owner)
+                files.remove_empty(self.fs, parts)
+        return v2.EffectResult(
+            'succeeded',
+            dict(
+                artifact_id=row['id'],
+                deleted=True,
+                late_effect_impossible=True,
+            ),
+            None,
+        )
+
+    def delete(self, context, binding, child, artifacts):
+        try:
+            journal.authorize(context, binding, child, write=True)
+            c._require(
+                child.action == 'delete' and type(artifacts) is tuple
+            )
+            row = journal.reservation(context, binding, child.resource_id)
+            if artifacts:
+                c._require(
+                    len(artifacts) == 1 and artifacts[0].id == row['id']
+                )
+                journal.readable(context, binding, artifacts[0])
+            return self._delete(context, binding, child, row)
+        except BlockingIOError:
+            return v2.EffectResult('pending', {}, None)
+        except ERRORS:
+            return unknown()
