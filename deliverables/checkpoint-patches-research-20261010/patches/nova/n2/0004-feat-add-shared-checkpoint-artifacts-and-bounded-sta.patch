+        self.assertEqual('failed_with_effects', result.status)
+        self.assertEqual((uuids.shared,), result.evidence['resource_ids'])
+        self.assertEqual(
+            before,
+            {
+                str(p): (p.stat().st_ino, p.stat().st_nlink)
+                for p in self.shared_root.rglob('*')
+            },
+        )
+
+    def test_download_keeps_shared_source_immutable(self):
+        child, shared, workspace = self.downloaded_child()
+        path = Path(self.store.artifact_path(self.binding, shared.id))
+        before = path.stat()
