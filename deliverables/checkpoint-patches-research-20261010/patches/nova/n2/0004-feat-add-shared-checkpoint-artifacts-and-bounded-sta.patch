+        with mock.patch('os.unlink', side_effect=fail_part):
+            self.assertNotEqual('succeeded', self.publish().status)
+        before = {
+            str(p): (p.stat().st_ino, p.stat().st_nlink)
+            for p in self.shared_root.rglob('*')
+        }
+        result = self.store.query(
+            self.ctx, self.binding, self.publish_child
