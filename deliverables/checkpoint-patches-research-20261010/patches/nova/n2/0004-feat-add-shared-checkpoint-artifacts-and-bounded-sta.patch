+        deleted = self.store.delete(self.ctx, self.binding, child, (ref,))
+        self.assertNotEqual('succeeded', deleted.status)
+        self.assertTrue(path.exists())
+
+    def test_interrupted_link_publish_is_observed_without_mutation(self):
+        unlink = os.unlink
+
+        def fail_part(name, *args, **kwargs):
+            if name == 'part':
+                raise OSError('copy interrupted after link')
+            return unlink(name, *args, **kwargs)
