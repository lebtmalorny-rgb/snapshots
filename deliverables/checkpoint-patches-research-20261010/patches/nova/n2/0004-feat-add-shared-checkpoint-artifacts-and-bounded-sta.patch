+        )
+        self.assertNotEqual('succeeded', result.status)
+        self.assertFalse(
+            (
+                Path(workspace['path']) / 'artifacts' / child.resource_id
+            ).exists()
+        )
+
+    def test_download_reply_loss_is_observed_without_writes(self):
+        child, shared, workspace = self.downloaded_child()
+        result = self.store.download(
