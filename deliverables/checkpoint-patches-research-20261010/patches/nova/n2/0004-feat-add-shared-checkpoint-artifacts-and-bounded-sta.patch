+
+    def test_opened_root_must_match_observed_mount_before_mkdir(self):
+        observed = dict(self.shared_observed, device='123:456')
+        root = files.Root(
+            str(self.shared_root),
+            self.profile('store', observed),
+            lambda path: observed,
+        )
+        with testtools.ExpectedException(ValueError):
+            with root.directory(('must-not-be-created',), create=True):
+                pass
+        self.assertEqual([], list(self.shared_root.iterdir()))
+
+    def test_traversal_root_is_rejected(self):
