+# WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+# License for the specific language governing permissions and limitations
+# under the License.
+
+"""Descriptor-relative private files and immutable publication primitives."""
+
+import contextlib
+import fcntl
+import hashlib
+import os
+from pathlib import PurePosixPath
+import stat
+
+from oslo_serialization import jsonutils
+
+from nova.checkpoints import contracts as c
+
+OPEN_DIR = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
+OPEN_FILE = os.O_NOFOLLOW | os.O_NONBLOCK
+MAX_META = 64 * 1024
+
+
+def components(binding, artifact_id):
+    c._uuid(artifact_id)
+    return (
+        binding.deployment_id,
+        binding.cell_uuid,
+        hashlib.sha256(binding.project_id.encode('utf-8')).hexdigest(),
+        binding.instance_uuid,
+        binding.checkpoint_id,
+        artifact_id,
+    )
+
+
+def private(info, directory=False):
+    c._require(
+        (
+            stat.S_ISDIR(info.st_mode)
+            if directory
+            else stat.S_ISREG(info.st_mode)
+        ) and
+        info.st_uid in (0, os.geteuid()) and
+        not info.st_mode & 0o007 and
+        (not info.st_mode & 0o020 or info.st_gid == os.getegid())
+    )
+
+
+def regular(fd, links=(1,)):
+    info = os.fstat(fd)
+    private(info)
+    c._require(info.st_nlink in links)
+    return info
+
+
+def read_json(directory, name):
+    fd = os.open(name, os.O_RDONLY | OPEN_FILE, dir_fd=directory)
+    with os.fdopen(fd, 'rb') as stream:
+        info = regular(stream.fileno())
+        c._require(info.st_size <= MAX_META)
+        value = jsonutils.loads(stream.read(MAX_META + 1))
+    c._require(type(value) is dict)
+    return value
+
+
+def write_all(fd, data):
+    offset = 0
+    while offset < len(data):
+        count = os.write(fd, data[offset:])
+        if count <= 0:
+            raise OSError('Short checkpoint write')
+        offset += count
+
+
+def create_json(directory, name, value):
+    raw = jsonutils.dump_as_bytes(
+        value, sort_keys=True, separators=(',', ':')
+    )
+    c._require(len(raw) <= MAX_META)
+    fd = os.open(
+        name,
+        os.O_WRONLY | os.O_CREAT | os.O_EXCL | OPEN_FILE,
+        0o600,
+        dir_fd=directory,
+    )
+    try:
+        write_all(fd, raw)
+        os.fsync(fd)
+    finally:
+        os.close(fd)
+    os.fsync(directory)
+
+
+def fingerprint(fd, metadata_bytes, links=(1,)):
+    before = regular(fd, links)
+    digest = hashlib.sha256()
+    os.lseek(fd, 0, os.SEEK_SET)
+    while True:
+        block = os.read(fd, 1024 * 1024)
+        if not block:
+            break
+        digest.update(block)
+    after = regular(fd, links)
+    fields = ('st_dev', 'st_ino', 'st_size', 'st_mtime_ns', 'st_ctime_ns')
+    c._require(
+        all(getattr(before, f) == getattr(after, f) for f in fields)
+    )
+    return dict(
+        device=after.st_dev,
+        inode=after.st_ino,
+        logical_bytes=after.st_size,
+        allocated_bytes=after.st_blocks * 512,
+        mtime_ns=after.st_mtime_ns,
+        ctime_ns=after.st_ctime_ns,
+        bytes=max(after.st_size, after.st_blocks * 512) + metadata_bytes,
+        checksum=digest.hexdigest(),
+    )
+
+
+@contextlib.contextmanager
+def locked(directory, exclusive=True, create=False):
+    flags = os.O_RDWR | OPEN_FILE
+    if create:
+        flags |= os.O_CREAT | os.O_EXCL
+    fd = os.open('lock', flags, 0o600, dir_fd=directory)
+    try:
+        regular(fd)
+        fcntl.flock(
+            fd,
+            (fcntl.LOCK_EX if exclusive else fcntl.LOCK_SH) |
+            fcntl.LOCK_NB,
+        )
+        yield fd
+    finally:
+        os.close(fd)
+
+
+class Root:
+    def __init__(self, path, profile, observer):
+        c._require(
+            type(path) is str and
+            path.startswith('/') and
+            str(PurePosixPath(path)) == path and
+            '..' not in path.split('/')
+        )
+        self.path, self.profile, self.observer = path, profile, observer
+        for key in ('metadata_bytes', 'allocation_unit', 'max_bytes'):
+            c._integer(profile.limits[key], minimum=1)
+        c._require(profile.limits['metadata_bytes'] >= 4 * MAX_META)
+
+    def check(self):
+        value = self.observer(self.path)
+        c._require(value == c._json(self.profile.observed))
+        c._require(value['encrypted_at_rest'] is True)
+        if self.profile.kind == 'store':
+            c._require(
+                value['fstype'] in ('nfs', 'nfs4') and
+                value['encrypted_transport'] is True
+            )
+        else:
+            c._require(
+                value['fstype'] == 'xfs' and value['project_quota'] is True
+            )
+        return value
+
+    @contextlib.contextmanager
+    def directory(self, parts=(), create=False):
+        observed = self.check()
+        descriptor = os.open('/', OPEN_DIR)
+        try:
+            for part in PurePosixPath(self.path).parts[1:]:
+                new = os.open(part, OPEN_DIR, dir_fd=descriptor)
+                os.close(descriptor)
+                descriptor = new
+            root = os.fstat(descriptor)
+            private(root, directory=True)
+            c._require(
+                observed['device'] ==
+                '%s:%s' % (os.major(root.st_dev), os.minor(root.st_dev)) and
+                observed['fsid'] == os.fstatvfs(descriptor).f_fsid
+            )
+            for part in parts:
+                c._require(
+                    type(part) is str and
+                    part not in ('', '.', '..') and
+                    '/' not in part and
+                    '\\' not in part
+                )
+                if create:
+                    try:
+                        os.mkdir(part, 0o700, dir_fd=descriptor)
+                        os.fsync(descriptor)
+                    except FileExistsError:
+                        pass
+                new = os.open(part, OPEN_DIR, dir_fd=descriptor)
+                os.close(descriptor)
+                descriptor = new
+                info = os.fstat(descriptor)
+                private(info, directory=True)
+                c._require(info.st_dev == root.st_dev)
+            self.check()
+            yield descriptor
+        finally:
+            os.close(descriptor)
+
+    def artifact_path(self, binding, artifact_id):
+        return os.path.join(
+            self.path, *components(binding, artifact_id), 'data'
+        )
+
+    def budget(self, limit):
+        c._integer(limit, minimum=1)
+        c._require(
+            limit <= self.profile.limits['max_bytes'] and
+            limit > self.profile.limits['metadata_bytes']
+        )
+        return limit - self.profile.limits['metadata_bytes']
+
+
+def owner(binding, child, row, profile_id, data_fd):
+    info = regular(data_fd)
+    return dict(
+        format=2,
+        binding=binding.to_primitive(),
+        child=child.to_primitive(),
+        artifact_id=row['id'],
+        kind=row['kind'],
+        location=row['location'],
+        upper_bound=row['upper_bound'],
+        profile_id=profile_id,
+        device=info.st_dev,
+        inode=info.st_ino,
+    )
+
+
+def check_owner(value, binding, child, row, profile_id):
+    c._keys(
+        value,
+        (
+            'format',
+            'binding',
+            'child',
+            'artifact_id',
+            'kind',
+            'location',
+            'upper_bound',
+            'profile_id',
+            'device',
+            'inode',
+        ),
+    )
+    c._require(
+        value['format'] == 2 and
+        value['binding'] == binding.to_primitive() and
+        value['child'] == child.to_primitive() and
+        value['artifact_id'] == row['id'] and
+        value['profile_id'] == profile_id and
+        value['location'] == row['location'] and
+        value['kind'] == row['kind'] and
+        value['upper_bound'] == row['upper_bound']
+    )
+
+
+def seal(directory, fd, binding, child, row, metadata_bytes):
+    from nova.checkpoints import contracts_v2 as v2
+
+    os.fsync(fd)
+    os.fchmod(fd, 0o400)
+    os.fsync(fd)
+    observed = fingerprint(fd, metadata_bytes)
+    c._require(observed['bytes'] <= row['upper_bound'])
+    ref = v2.ArtifactRef(
+        row['id'],
+        row['kind'],
+        v2.artifact_logical_id(binding, row['id']),
+        observed['bytes'],
+        observed['checksum'],
+        row['location'],
+    )
+    value = dict(
+        format=2,
+        owner_sha256=c.canonical_payload_hash(
+            read_json(directory, 'owner')
+        ),
+        artifact=ref.to_primitive(),
+        file=observed,
+    )
+    create_json(directory, 'seal', value)
+    return ref
+
+
+def inspect(directory, metadata_bytes):
+    from nova.checkpoints import contracts_v2 as v2
+
+    recorded = read_json(directory, 'seal')
+    c._keys(recorded, ('format', 'owner_sha256', 'artifact', 'file'))
+    c._require(
+        recorded['format'] == 2 and
+        recorded['owner_sha256'] ==
+        c.canonical_payload_hash(read_json(directory, 'owner'))
+    )
+    fd = os.open('data', os.O_RDONLY | OPEN_FILE, dir_fd=directory)
+    try:
+        current = fingerprint(fd, metadata_bytes)
+        c._require(current == recorded['file'])
+        ref = v2.ArtifactRef.from_primitive(recorded['artifact'])
+        c._require(
+            ref.checksum == current['checksum'] and
+            ref.bytes == current['bytes']
+        )
+        return ref, current
+    finally:
+        os.close(fd)
+
+
+def erase(directory, expected_owner):
+    value = read_json(directory, 'owner')
+    c._require(value == expected_owner)
+    names = set(os.listdir(directory))
+    c._require(names <= {'data', 'part', 'owner', 'seal', 'lock'})
+    # A two-link inode is allowed only for this intent's interrupted publish.
+    stats = {
+        n: os.stat(n, dir_fd=directory, follow_symlinks=False)
+        for n in names
+    }
+    for name, info in stats.items():
+        private(info)
+        if name in ('data', 'part'):
+            c._require((info.st_dev, info.st_ino) ==
+                       (value['device'], value['inode']))
+        if info.st_nlink != 1:
+            c._require(
+                name in ('data', 'part') and
+                info.st_nlink == 2 and
+                {'data', 'part'} <= names and
+                (stats['data'].st_dev, stats['data'].st_ino) ==
+                (stats['part'].st_dev, stats['part'].st_ino)
+            )
+    for name in sorted(names - {'lock', 'owner'}):
+        os.unlink(name, dir_fd=directory)
+        os.fsync(directory)
+    os.unlink('lock', dir_fd=directory)
+    os.fsync(directory)
+    os.unlink('owner', dir_fd=directory)
+    os.fsync(directory)
+
+
+def replace_json(directory, name, value):
+    temporary = name + '.new'
+    if temporary in os.listdir(directory):
+        # A prior registry write is ambiguous; no ID is silently recycled.
+        raise ValueError('Interrupted checkpoint registry update')
+    create_json(directory, temporary, value)
+    if name in os.listdir(directory):
+        fd = os.open(name, os.O_RDONLY | OPEN_FILE, dir_fd=directory)
+        try:
+            regular(fd)
+        finally:
+            os.close(fd)
+    os.replace(temporary, name, src_dir_fd=directory, dst_dir_fd=directory)
+    os.fsync(directory)
+
+
+@contextlib.contextmanager
+def control_lock(directory, name):
+    fd = os.open(
+        name, os.O_RDWR | os.O_CREAT | OPEN_FILE, 0o600, dir_fd=directory
+    )
+    try:
+        regular(fd)
+        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        yield fd
+    finally:
+        os.close(fd)
+
+
+def remove_empty(root, parts):
+    # Remove only empty private directories, preserving all foreign entries.
+    for length in range(len(parts), 0, -1):
+        with root.directory(parts[: length - 1]) as parent:
+            try:
+                os.rmdir(parts[length - 1], dir_fd=parent)
+                os.fsync(parent)
+            except OSError:
+                return
