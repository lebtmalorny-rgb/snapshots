diff --git a/nova/privsep/checkpoint.py b/nova/privsep/checkpoint.py
new file mode 100644
index 0000000000000000000000000000000000000000..c5bb4f0e6fd7651ef15465fb9d18e510d76fe398
--- /dev/null
+++ b/nova/privsep/checkpoint.py
@@ -0,0 +1,341 @@
+# Licensed under the Apache License, Version 2.0 (the "License"); you may
+# not use this file except in compliance with the License. You may obtain
+# a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+# WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+# License for the specific language governing permissions and limitations
+# under the License.
+
+"""Narrow read/quotactl/ioctl helpers; never mount, format or manage keys."""
+
+import contextlib
+import ctypes
+import fcntl
+import os
+from pathlib import Path
+import re
+import stat
+import struct
+
+from oslo_serialization import jsonutils
+
+from nova.checkpoints import contracts as c
+from nova.checkpoints import contracts_v2 as v2
+from nova import conf
+import nova.privsep
+from nova.virt.libvirt.checkpoints import files
+from nova.virt.libvirt.checkpoints import profiles
+
+CONF = conf.CONF
+# Linux uapi fs.h: struct fsxattr is five uint32 fields plus eight pad bytes.
+FSGETXATTR = 0x801C581F
+FSSETXATTR = 0x401C5820
+PROJINHERIT = 0x200
+
+
+def _allowed(path, staging=False):
+    roots = (
+        (CONF.checkpoint.staging_root,)
+        if staging
+        else (CONF.checkpoint.staging_root, CONF.checkpoint.store_root)
+    )
+    c._require(
+        type(path) is str and
+        path in roots and
+        path != '/' and
+        re.fullmatch(r'/[A-Za-z0-9_./-]+', path) is not None and
+        os.path.normpath(path) == path and
+        '..' not in path.split('/')
+    )
+
+
+@contextlib.contextmanager
+def _root(path):
+    fd = os.open('/', files.OPEN_DIR)
+    try:
+        for part in path.split('/')[1:]:
+            new = os.open(part, files.OPEN_DIR, dir_fd=fd)
+            os.close(fd)
+            fd = new
+        yield fd
+    finally:
+        os.close(fd)
+
+
+def _marker(fd):
+    descriptor = os.open(
+        '.checkpoint-store', os.O_RDONLY | files.OPEN_FILE, dir_fd=fd
+    )
+    with os.fdopen(descriptor, 'rb') as stream:
+        info = os.fstat(stream.fileno())
+        c._require(
+            stat.S_ISREG(info.st_mode) and
+            info.st_uid == 0 and
+            info.st_nlink == 1 and
+            not info.st_mode & 0o022 and
+            info.st_size <= files.MAX_META
+        )
+        result = jsonutils.loads(stream.read(files.MAX_META + 1))
+    c._keys(
+        result,
+        (
+            'schema_version',
+            'store_uuid',
+            'kind',
+            'encryption_at_rest',
+            'server_policy_sha256',
+        ),
+    )
+    c._integer(result['schema_version'], minimum=1, maximum=1)
+    c._uuid(result['store_uuid'])
+    c._digest(result['server_policy_sha256'])
+    c._require(result['encryption_at_rest'] is True)
+    return result
+
+
+def _mount(path):
+    # Escaped mountinfo paths are decoded; callers' roots use the closed
+    # character set above, and no returned path is executed as a command.
+    entries = []
+    for line in Path('/proc/self/mountinfo').read_text().splitlines():
+        before, after = line.split(' - ', 1)
+        left, right = before.split(), after.split()
+        point = re.sub(
+            r'\\([0-7]{3})', lambda m: chr(int(m.group(1), 8)), left[4]
+        )
+        if path == point or path.startswith(point.rstrip('/') + '/'):
+            entries.append(
+                (
+                    len(point),
+                    dict(
+                        mount_id=int(left[0]),
+                        device=left[2],
+                        mountpoint=point,
+                        fstype=right[0],
+                        source=right[1],
+                        options=sorted(
+                            set(left[5].split(',') + right[2].split(','))
+                        ),
+                    ),
+                )
+            )
+    c._require(bool(entries))
+    return max(entries, key=lambda item: item[0])[1]
+
+
+def _quota_call(source, number, project_id, buffer):
+    # QCMD(XQM_CMD(number), XQM_PRJQUOTA), Linux uapi dqblk_xfs.h.
+    library = ctypes.CDLL(None, use_errno=True)
+    call = library.quotactl
+    call.argtypes = [
+        ctypes.c_int,
+        ctypes.c_char_p,
+        ctypes.c_int,
+        ctypes.c_void_p,
+    ]
+    call.restype = ctypes.c_int
+    command = (((ord('X') << 8) + number) << 8) | 2
+    result = call(
+        command, os.fsencode(source), project_id, ctypes.byref(buffer)
+    )
+    if result != 0:
+        raise OSError(
+            ctypes.get_errno(), 'Checkpoint quota inspection failed'
+        )
+
+
+def _quota_flags(source):
+    buffer = ctypes.create_string_buffer(512)
+    buffer[0] = b'\x01'  # FS_QSTATV_VERSION1
+    _quota_call(source, 8, 0, buffer)
+    version, unused, flags = struct.unpack_from('=BBH', buffer.raw)
+    return version == 1 and flags & 0x30 == 0x30
+
+
+def _quota_limit(source, project_id):
+    buffer = ctypes.create_string_buffer(512)
+    _quota_call(source, 3, project_id, buffer)
+    version, flags, mask, ident, hard, soft = struct.unpack_from(
+        '=bbHIQQ', buffer.raw
+    )
+    c._require(version == 1 and flags & 2 and ident == project_id)
+    return hard * 512, soft * 512
+
+
+def _encrypted_device(device, seen=None):
+    seen = set() if seen is None else seen
+    c._require(
+        re.fullmatch(r'\d+:\d+', device) is not None and device not in seen
+    )
+    seen.add(device)
+    node = Path('/sys/dev/block') / device
+    uuid = node / 'dm' / 'uuid'
+    if uuid.exists() and uuid.read_text().strip().startswith('CRYPT-LUKS'):
+        return True
+    children = list((node / 'slaves').iterdir())
+    return bool(children) and all(
+        _encrypted_device((child / 'dev').read_text().strip(), set(seen))
+        for child in children
+    )
+
+
+def _inspect(path, staging=False):
+    _allowed(path, staging=staging)
+    mount = _mount(path)
+    with _root(path) as fd:
+        marker = _marker(fd)
+        info = os.fstat(fd)
+        c._require(
+            mount['device'] ==
+            '%s:%s' % (os.major(info.st_dev), os.minor(info.st_dev))
+        )
+        fsid = os.fstatvfs(fd).f_fsid
+    expected_kind = 'staging' if staging else 'store'
+    c._require(marker['kind'] == expected_kind)
+    common = dict(
+        kind=expected_kind,
+        mount_id=mount['mount_id'],
+        device=mount['device'],
+        source=mount['source'],
+        fstype=mount['fstype'],
+        store_uuid=marker['store_uuid'],
+        fsid=fsid,
+        server_policy_sha256=marker['server_policy_sha256'],
+        options=mount['options'],
+        encrypted_at_rest=True,
+    )
+    if staging:
+        c._require(
+            mount['fstype'] == 'xfs' and _encrypted_device(mount['device'])
+        )
+        # This initial profile supports an internal log and data device only.
+        # An encrypted data device proves nothing about external log/realtime.
+        c._require(
+            not any(
+                option.startswith(('logdev=', 'rtdev='))
+                for option in mount['options']
+            )
+        )
+        c._require(
+            stat.S_ISBLK(os.stat(mount['source']).st_mode) and
+            os.stat(mount['source']).st_rdev ==
+            os.makedev(*map(int, mount['device'].split(':')))
+        )
+        common['project_quota'] = _quota_flags(mount['source'])
+    else:
+        c._require(mount['fstype'] in ('nfs', 'nfs4'))
+        options = set(mount['options'])
+        common['encrypted_transport'] = bool(
+            options & {'xprtsec=tls', 'xprtsec=mtls', 'sec=krb5p'}
+        )
+    return common
+
+
+@nova.privsep.sys_admin_pctxt.entrypoint
+def inspect_mount(path):
+    return _inspect(path)
+
+
+@nova.privsep.sys_admin_pctxt.entrypoint
+def inspect_staging(path):
+    return _inspect(path, staging=True)
+
+
+@contextlib.contextmanager
+def _workspace(root, workspace_id, project_id):
+    _allowed(root, staging=True)
+    c._uuid(workspace_id)
+    c._integer(project_id, minimum=1, maximum=2**31 - 1)
+    observed = _inspect(root, staging=True)
+    profile = profiles.load(CONF.checkpoint.profile_file).match(observed)
+    c._require(
+        profile is not None and
+        profile.kind == 'staging' and
+        observed['project_quota'] is True and
+        profile.limits['project_id_min'] <=
+        project_id <=
+        profile.limits['project_id_max']
+    )
+    safe = files.Root(
+        root, profile, lambda path: _inspect(path, staging=True)
+    )
+    with safe.directory() as directory:
+        registry = files.read_json(directory, 'registry')
+    entry = registry['entries'][workspace_id]
+    binding = v2.Binding.from_primitive(entry['binding'])
+    c._require(
+        entry['project_id'] == project_id and
+        binding.staging_profile_id == profile.id
+    )
+    with safe.directory(files.components(binding, workspace_id)) as fd:
+        info = os.fstat(fd)
+        c._require(
+            (info.st_dev, info.st_ino) == (entry['device'], entry['inode'])
+        )
+        yield fd, observed, entry
+
+
+def _attributes(fd):
+    value = bytearray(28)
+    fcntl.ioctl(fd, FSGETXATTR, value, True)
+    return list(struct.unpack('=IIIII8s', value))
+
+
+@nova.privsep.sys_admin_pctxt.entrypoint
+def set_project_limit(root, workspace_id, project_id, bytes_limit):
+    c._integer(bytes_limit, minimum=4096)
+    c._require(bytes_limit % 4096 == 0)
+    with _workspace(root, workspace_id, project_id) as (fd, mount, entry):
+        c._require(
+            entry['limit_bytes'] == bytes_limit and not os.listdir(fd)
+        )
+        attributes = _attributes(fd)
+        c._require(
+            attributes[3] in (0, project_id) and not attributes[0] & 0x100
+        )  # FS_XFLAG_RTINHERIT
+        buffer = ctypes.create_string_buffer(512)
+        # FS_DQ_BHARD | FS_DQ_BSOFT only: no global enforcement or key changes.
+        struct.pack_into(
+            '=bbHIQQ',
+            buffer,
+            0,
+            1,
+            2,
+            0x0C,
+            project_id,
+            bytes_limit // 512,
+            bytes_limit // 512,
+        )
+        _quota_call(mount['source'], 4, project_id, buffer)
+        attributes[0] |= PROJINHERIT
+        attributes[3] = project_id
+        fcntl.ioctl(fd, FSSETXATTR, struct.pack('=IIIII8s', *attributes))
+        os.fsync(fd)
+        checked = _attributes(fd)
+        hard, soft = _quota_limit(mount['source'], project_id)
+        c._require(
+            checked[3] == project_id and
+            checked[0] & PROJINHERIT and
+            hard == soft == bytes_limit and
+            _quota_flags(mount['source'])
+        )
+    return dict(
+        project_id=project_id, limit_bytes=bytes_limit, enforced=True
+    )
+
+
+@nova.privsep.sys_admin_pctxt.entrypoint
+def get_project_limit(root, workspace_id, project_id):
+    with _workspace(root, workspace_id, project_id) as (fd, mount, entry):
+        attributes = _attributes(fd)
+        hard, soft = _quota_limit(mount['source'], project_id)
+        c._require(
+            attributes[3] == project_id and
+            attributes[0] & PROJINHERIT and
+            hard == soft == entry['limit_bytes']
+        )
+    return dict(project_id=project_id, limit_bytes=hard, enforced=True)
