+        self.assertEqual(before.st_mtime_ns, path.stat().st_mtime_ns)
+        self.assertEqual(b'private-ram-state', path.read_bytes())
+
+    def test_corrupt_source_is_not_downloaded(self):
+        child, shared, workspace = self.downloaded_child()
+        path = Path(self.store.artifact_path(self.binding, shared.id))
+        os.chmod(path, 0o600)
