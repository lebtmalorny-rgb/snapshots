+"""Temporary bytes share the permanent project lock and mapping fence."""
+
+from oslo_serialization import jsonutils
+from oslo_utils import uuidutils
+
+from nova.checkpoints import contracts as c
+from nova.checkpoints import contracts_v2 as v2
+from nova.db.api import checkpoints as ledger
+from nova.db.api import models as m
+from nova.db.utils import require_context
+from nova import exception
+
+
+def _row(row):
+    values = ledger._row(row)
+    for key in ('identity', 'closing_proof'):
+        if values[key] is not None:
+            values[key] = jsonutils.loads(values[key])
+    return values
+
+
+def _ticket(context, ticket_id):
+    row = context.session.get(m.CheckpointTemporaryTicket, ticket_id)
+    if row is None:
+        raise exception.NotFound()
+    ledger._authorize(context, row.project_id)
+    return row
+
+
+def _locked(context, ticket_id):
+    row = _ticket(context, ticket_id)
+    usage = ledger._usage(context, row.project_id)
+    context.session.refresh(row, with_for_update=True)
+    return usage, row
+
+
+@require_context
+@ledger._reader
+def get(context, ticket_id):
+    return _row(_ticket(context, ticket_id))
+
+
+@require_context
+@ledger._retry
+@ledger._writer
+def reserve(context, value):
+    c._keys(value, ('operation_id', 'checkpoint_id', 'project_id',
+                   'instance_uuid', 'cell_uuid', 'reserved_bytes',
+                   'version', 'admission_hash'))
+    for name in ('operation_id', 'checkpoint_id',
+                 'instance_uuid', 'cell_uuid'):
+        c._uuid(value[name])
+    c._integer(value['reserved_bytes'], minimum=1)
+    c._integer(value['version'], minimum=1, maximum=1)
+    c._digest(value['admission_hash'])
+    usage = ledger._usage(context, value['project_id'])
+    digest = c.canonical_payload_hash(value)
+    existing = context.session.query(m.CheckpointTemporaryTicket).filter_by(
+        operation_id=value['operation_id']).first()
+    if existing:
+        ledger._authorize(context, existing.project_id)
+        if existing.payload_hash != digest:
+            ledger._conflict()
+        return _row(existing)
+    mapping = ledger.lock_instance_mapping(context, value['instance_uuid'])
+    cell = context.session.get(m.CellMapping, mapping.cell_id) if (
+        mapping is not None and mapping.cell_id is not None) else None
+    if cell is None or cell.uuid != value['cell_uuid'] or (
+            mapping.project_id != value['project_id']):
+        raise exception.CheckpointConflict(reason='identity_changed')
+    ledger._charge(usage, usage.checkpoint_count,
+                   usage.artifact_bytes + value['reserved_bytes'])
+    fields = {k: v for k, v in value.items() if k != 'admission_hash'}
+    row = m.CheckpointTemporaryTicket(
+        id=uuidutils.generate_uuid(), **fields, payload_hash=digest,
+        identity=jsonutils.dumps(value, sort_keys=True), state='held')
+    context.session.add(row)
+    context.session.flush()
+    return _row(row)
+
+
+@require_context
+@ledger._retry
+@ledger._writer
+def confirm(context, ticket_id, payload_hash, version):
+    usage, row = _locked(context, ticket_id)
+    if (row.state == 'released' or row.payload_hash != payload_hash or
+            row.version != version):
+        ledger._conflict()
+    row.state = 'confirmed'
+    context.session.flush()
+    return _row(row)
+
+
+@require_context
+@ledger._retry
+@ledger._writer
+def release(context, ticket_id, primitive):
+    usage, row = _locked(context, ticket_id)
+    proof = v2.TemporaryProof.from_primitive(primitive)
+    if (proof.ticket_id, proof.operation_id,
+            proof.cell_uuid, proof.version) != (
+            row.id, row.operation_id, row.cell_uuid, row.version):
+        ledger._conflict()
+    encoded = jsonutils.dumps(proof.to_primitive(), sort_keys=True)
+    if row.state == 'released':
+        if row.closing_proof != encoded:
+            ledger._conflict()
+        return _row(row)
+    usage.artifact_bytes -= row.reserved_bytes
+    if usage.artifact_bytes < 0:
+        ledger._conflict()
+    usage.version += 1
+    row.state = 'released'
+    row.closing_proof = encoded
+    context.session.flush()
+    return _row(row)
+
+
+@require_context
+@ledger._reader
+def list_tickets(context, limit=100, marker=None):
+    c._integer(limit, minimum=1, maximum=1000)
+    query = context.session.query(m.CheckpointTemporaryTicket)
+    if not context.is_admin:
+        query = query.filter_by(project_id=context.project_id)
+    if marker:
+        c._uuid(marker)
+        query = query.filter(m.CheckpointTemporaryTicket.id > marker)
+    return [_row(row) for row in query.order_by(
+        m.CheckpointTemporaryTicket.id).limit(limit)]
