+
+def temporary_identity(operation, total_bytes):
+    v1._integer(total_bytes, minimum=1)
+    if operation.kind != 'revert' or operation.generation != 1:
+        raise ValueError('Temporary quota requires a revert operation')
+    if operation.admission.get('schema_version') == 2:
+        v1._require(total_bytes >= operation.admission['restore_bytes_limit'])
+    return dict(operation_id=operation.uuid,
+                checkpoint_id=operation.checkpoint_id,
+                project_id=operation.project_id,
+                instance_uuid=operation.instance_uuid,
+                cell_uuid=operation.cell_uuid, reserved_bytes=total_bytes,
+                version=1, admission_hash=v1.canonical_payload_hash(
+                    operation.admission))
