@@ -17,7 +17,9 @@ the cell must first fence late admission with an immutable cancellation.
 """
 
 from nova.checkpoints import contracts as c
+from nova.checkpoints import contracts_v2 as v2
 from nova import context as nova_context
+from nova.db.api import checkpoint_temporary as temporary_db
 from nova.db.api import checkpoints as db
 from nova import exception
 from nova import objects
@@ -207,3 +209,82 @@ class QuotaLedger:
         if len(rows) == limit:
             report['next_marker'] = rows[-1]['id']
         return report
+
+    @staticmethod
+    def _temporary_object(context, row):
+        return objects.CheckpointTemporaryTicket._from_row(context, row)
+
+    @staticmethod
+    def _temporary_payload(ticket):
+        return dict(id=ticket.id, identity=ticket.identity,
+                    payload_hash=ticket.payload_hash)
+
+    def get_temporary(self, context, ticket_id):
+        return self._temporary_object(
+            context, temporary_db.get(context, ticket_id))
+
+    def reserve_temporary(self, context, operation_id, cell_uuid, total_bytes):
+        c._uuid(operation_id)
+        c._uuid(cell_uuid)
+        cell = objects.CellMapping.get_by_uuid(context, cell_uuid)
+        if cell.is_cell0():
+            raise exception.CheckpointUnavailable(reason='cell_unavailable')
+        with nova_context.target_cell(context, cell) as ctx:
+            operation = objects.InstanceCheckpointOperation.get_by_uuid(
+                ctx, operation_id)
+        if (operation.cell_uuid != cell_uuid or operation.kind != 'revert' or
+                operation.state not in ('reserved', 'running',
+                                        'recovery_required')):
+            raise exception.CheckpointConflict(reason='identity_changed')
+        value = v2.temporary_identity(operation, total_bytes)
+        return self._temporary_object(
+            context, temporary_db.reserve(context, value))
+
+    def confirm_temporary(self, context, ticket_id):
+        ticket = self.get_temporary(context, ticket_id)
+        if ticket.state == 'released':
+            raise exception.CheckpointConflict()
+        payload = self._temporary_payload(ticket)
+        with self._cell(context, ticket) as ctx:
+            objects.InstanceCheckpointOperation.bind_temporary(ctx, payload)
+        ticket = self._temporary_object(context, temporary_db.confirm(
+            context, ticket.id, ticket.payload_hash, ticket.version))
+        with self._cell(context, ticket) as ctx:
+            objects.InstanceCheckpointOperation.confirm_temporary(ctx, payload)
+        return ticket
+
+    def release_temporary(self, context, ticket_id):
+        ticket = self.get_temporary(context, ticket_id)
+        if ticket.state == 'released':
+            return ticket
+        with self._cell(context, ticket) as ctx:
+            proof = objects.InstanceCheckpointOperation.temporary_close_proof(
+                ctx, ticket.operation_id, ticket.id)
+            if proof is None:
+                proof = objects.InstanceCheckpointOperation.cancel_temporary(
+                    ctx, ticket.operation_id, ticket.id)
+        return self._temporary_object(context, temporary_db.release(
+            context, ticket_id, proof))
+
+    def reconcile_temporary(self, context, limit=100, marker=None):
+        rows = temporary_db.list_tickets(context, limit=limit, marker=marker)
+        report = dict(processed=0, failed=0, next_marker=None)
+        for row in rows:
+            try:
+                ticket = self._temporary_object(context, row)
+                if ticket.state != 'released':
+                    with self._cell(context, ticket) as ctx:
+                        proof = (objects.InstanceCheckpointOperation.
+                            temporary_close_proof(ctx, ticket.operation_id,
+                                                  ticket.id))
+                    if proof:
+                        self._temporary_object(context, temporary_db.release(
+                            context, ticket.id, proof))
+                    else:
+                        self.confirm_temporary(context, ticket.id)
+                report['processed'] += 1
+            except Exception:
+                report['failed'] += 1
+        if len(rows) == limit:
+            report['next_marker'] = rows[-1]['id']
+        return report
