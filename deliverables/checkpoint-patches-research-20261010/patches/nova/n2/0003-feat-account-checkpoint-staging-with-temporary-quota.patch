+class TemporaryQuotaTest(checkpoints.CheckpointTestCase):
+    """Quota protocol uses real settled points, cell journals and API SQL.
+
+    The existing executor fixture supplies completed points. This tests the
+    independent quota protocol; v2 runtime adapter integration is tested with
+    the executor in its own suite.
+    """
+    def setUp(self):
+        super().setUp()
