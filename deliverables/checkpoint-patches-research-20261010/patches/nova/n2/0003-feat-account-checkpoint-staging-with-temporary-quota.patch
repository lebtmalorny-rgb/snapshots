+    def test_cancelled_ticket_fences_late_confirmation_and_dispatch(self):
+        ticket = self.reserve_temp()
+        released = self.ledger.release_temporary(self.ctx, ticket.id)
+        self.assertEqual('released', released.state)
+        self.assertEqual(2048, self.usage()['artifact_bytes'])
+        self.assertEqual(2, self.usage()['checkpoint_count'])
+        self.assertRaises(exception.CheckpointConflict,
+            self.ledger.confirm_temporary, self.ctx, ticket.id)
+        with context.target_cell(self.ctx, self.cells[0]) as ctx:
+            op = objects.InstanceCheckpointOperation.get_by_uuid(
+                ctx, self.reverts[0])
+            self.assertRaises(exception.CheckpointConflict, journal.claim_step,
+                ctx, op.uuid, 1, 'preflight', op.executor_id)
+            self.assertEqual(op.uuid, journal.guard_get(
+                ctx, op.instance_uuid)['operation_id'])
+        self.assertEqual('released', self.ledger.release_temporary(
+            self.ctx, ticket.id).state)
