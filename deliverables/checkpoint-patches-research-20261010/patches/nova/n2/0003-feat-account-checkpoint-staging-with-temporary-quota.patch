+        with context.target_cell(self.ctx, self.cells[0]) as ctx:
+            op = objects.InstanceCheckpointOperation.get_by_uuid(
+                ctx, self.reverts[0])
+            step = journal.claim_step(ctx, op.uuid, 1, 'preflight',
+                                      op.executor_id)
+            journal.finish_step(ctx, step.id, 1, contracts.StepResult(
+                'unknown', {}, 'recovery_required'))
+        self.assertRaises(exception.CheckpointConflict,
+            self.ledger.release_temporary, self.ctx, ticket.id)
+        self.assertEqual('confirmed', self.ledger.get_temporary(
+            self.ctx, ticket.id).state)
+        self.assertEqual(6144, self.usage()['artifact_bytes'])
