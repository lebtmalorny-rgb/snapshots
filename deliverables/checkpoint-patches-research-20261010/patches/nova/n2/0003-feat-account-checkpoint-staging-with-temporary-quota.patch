+class TemporaryQuotaRaceMixin(test_checkpoint_quota.QuotaRaceMixin):
+    def value(self, index, size):
+        admission = self.candidates[index]
+        return dict(operation_id=admission.operation_id,
+            checkpoint_id=admission.checkpoint_id,
+            project_id=admission.key.project_id,
+            instance_uuid=admission.key.instance_uuid,
+            cell_uuid=admission.cell_uuid, reserved_bytes=size, version=1,
+            admission_hash=contracts.canonical_payload_hash(
+                admission.to_primitive()))
+
+    def test_temporary_race_shares_permanent_project_lock(self):
+        # This API SQL test receives the identity already checked by the
+        # ledger's cell read; the functional protocol tests cover that read.
+        quota.QuotaLedger().reserve(self.ctx, self.candidates[0])
+        barrier = threading.Barrier(2)
+        outcomes, failures = [], []
+
+        def reserve(index):
+            ctx = context.RequestContext('actor', 'project')
+            try:
+                barrier.wait(timeout=10)
+                temporary_db.reserve(ctx, self.value(index, 4096))
+                outcomes.append(True)
+            except exception.CheckpointQuotaExceeded:
+                outcomes.append(False)
+            except Exception as exc:
+                failures.append(exc)
+
+        workers = [threading.Thread(target=reserve, args=(i,)) for i in (0, 1)]
+        for worker in workers:
+            worker.start()
+        for worker in workers:
+            worker.join(timeout=20)
+            self.assertFalse(worker.is_alive())
+        self.assertEqual([], failures)
+        self.assertEqual([False, True], sorted(outcomes))
+        usage = test_checkpoint_quota.quota_db.get_usage(self.ctx, 'project')
+        self.assertEqual(1, usage['checkpoint_count'])
+        self.assertEqual(8192, usage['artifact_bytes'])
+
+    def test_temporary_ticket_alone_fences_mapping_change(self):
+        temporary_db.reserve(self.ctx, self.value(0, 4096))
+        mapping = objects.InstanceMapping.get_by_instance_uuid(
+            self.ctx, self.candidates[0].key.instance_uuid)
+        mapping.cell_mapping = self.cell_mappings['cell2']
+        self.assertRaises(exception.CheckpointConflict, mapping.save)
+
