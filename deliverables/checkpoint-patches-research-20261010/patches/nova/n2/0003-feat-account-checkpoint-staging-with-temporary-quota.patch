+    def test_lost_refund_reply_does_not_subtract_twice(self):
+        ticket = self.reserve_temp()
+        release = temporary_db.release
+
+        def lose_reply(*args):
+            release(*args)
+            raise TimeoutError()
+
+        with mock.patch.object(
