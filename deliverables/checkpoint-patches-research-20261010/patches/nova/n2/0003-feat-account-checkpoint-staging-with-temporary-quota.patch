+            self.assertEqual(
+                'succeeded', self.operation(point, index)['state'])
+            with mock.patch.object(self.conductor.compute_task_mgr,
+                    'checkpoint_run', side_effect=TimeoutError()):
+                result = self.action(point['checkpoint']['id'], 'revert',
+                                     index=index)
+            self.reverts.append(result['operation']['id'])
+        self.assertEqual(2048, self.usage()['artifact_bytes'])
+        self.assertEqual(2, self.usage()['checkpoint_count'])
