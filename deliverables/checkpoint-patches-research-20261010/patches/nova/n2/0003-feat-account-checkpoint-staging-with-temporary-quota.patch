+def settlement_resources(context, checkpoint, manifest):
+    steps = {s.phase: s for s in journal._steps(
+        context, checkpoint.create_operation_id)}
+    required = ('artifact_publish_shared', 'runtime_restore_current',
+                'staging_cleanup')
+    if any(p not in steps or steps[p].status != 'succeeded' for p in required):
+        journal._conflict('resources_remaining')
+    if manifest != jsonutils.loads(
+            steps['artifact_publish_shared'].result)['evidence']:
+        journal._conflict('identity_changed')
+    for parent in steps.values():
+        if any(c.status not in TERMINAL for c in _rows(context, parent)):
+            journal._conflict('resources_remaining')
+    rows = _reservations(context, checkpoint.uuid)
+    if any(r.location == 'staging' and r.writer_state != 'deleted'
+           for r in rows):
+        journal._conflict('resources_remaining')
+    shared = [r for r in rows if r.location == 'shared' and
+              r.writer_state != 'deleted']
+    if not shared or any(
+            r.writer_state != 'closed' or r.actual_bytes is None or
+            r.checksum is None for r in shared):
+        journal._conflict('resources_remaining')
+    refs = [v2.ArtifactRef(
+        r.id, r.kind, r.logical_id, r.actual_bytes,
+        r.checksum, r.location).to_primitive() for r in shared]
+    if sorted(refs, key=lambda r: r['id']) != sorted(
+            manifest['artifacts'], key=lambda r: r['id']):
+        journal._conflict('identity_changed')
+    return [dict(id=r.id, checksum=r.checksum, bytes=r.actual_bytes)
+            for r in shared]
