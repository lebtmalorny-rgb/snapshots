+    def test_lost_cell_confirmation_is_repaired(self):
+        ticket = self.reserve_temp()
+        with mock.patch.object(objects.InstanceCheckpointOperation,
+                'confirm_temporary', side_effect=TimeoutError()):
+            self.assertRaises(TimeoutError, self.ledger.confirm_temporary,
+                              self.ctx, ticket.id)
+        self.assertEqual('confirmed', self.ledger.get_temporary(
+            self.ctx, ticket.id).state)
+        report = self.ledger.reconcile_temporary(self.ctx)
+        self.assertEqual(0, report['failed'])
+        with context.target_cell(self.ctx, self.cells[0]) as ctx:
+            op = objects.InstanceCheckpointOperation.get_by_uuid(
+                ctx, self.reverts[0])
+            self.assertIsNotNone(journal.claim_step(
+                ctx, op.uuid, 1, 'preflight', op.executor_id))
