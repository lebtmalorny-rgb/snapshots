+
+"""Cell write authorization and durable temporary quota closing proofs."""
+
+from types import SimpleNamespace
+
+from oslo_serialization import jsonutils
+
+from nova.checkpoints import contracts as c
+from nova.checkpoints import contracts_v2 as v2
+from nova.db.main import api as db
+from nova.db.main import checkpoint_effects as effects
+from nova.db.main import checkpoints as journal
+from nova.db.main import models as m
+from nova.db.utils import require_context
+
+
+def _locked(context, operation_id):
+    op = journal._operation(context, operation_id)
+    journal._instance(context, op.instance_uuid, lock=True)
+    journal._guard(context, op.instance_uuid)
+    journal._checkpoint(context, op.checkpoint_id, lock=True)
+    context.session.refresh(op, with_for_update=True)
+    if op.kind != 'revert' or op.generation != 1:
+        journal._conflict()
+    row = context.session.get(m.InstanceCheckpointTemporaryBudget, op.uuid)
+    return op, row
+
+
+def _bind(context, value, confirmed=False):
+    c._keys(value, ('id', 'identity', 'payload_hash'))
+    c._uuid(value['id'])
+    identity = value['identity']
+    op, row = _locked(context, identity['operation_id'])
+    expected = v2.temporary_identity(
+        SimpleNamespace(**journal._row(op)), identity['reserved_bytes'])
+    if (identity != expected or value['payload_hash'] !=
+            c.canonical_payload_hash(identity)):
+        journal._conflict('identity_changed')
+    encoded = journal._encode(identity)
+    if row:
+        if (row.ticket_id != value['id'] or row.identity != encoded or
+                row.state in ('closed', 'cancelled')):
+            journal._conflict()
+    else:
+        journal._owned(context, op.uuid)
+        row = m.InstanceCheckpointTemporaryBudget(
+            operation_id=op.uuid, ticket_id=value['id'], version=1,
+            reserved_bytes=identity['reserved_bytes'], identity=encoded,
+            state='bound')
+        context.session.add(row)
+    if confirmed:
+        row.state = 'confirmed'
+    context.session.flush()
+
+
+@require_context
+@db.pick_context_manager_writer
+def bind(context, value):
+    _bind(context, value)
+
+
+@require_context
+@db.pick_context_manager_writer
+def confirm(context, value):
+    _bind(context, value, confirmed=True)
+
+
+def assert_dispatch(context, operation, phase=None):
+    row = context.session.get(m.InstanceCheckpointTemporaryBudget,
+                              operation.uuid)
+    if row is not None and row.state in ('closed', 'cancelled') and (
+            phase in ('cinder_release', 'cleanup_cinder_release')):
+        return
+    if row is not None and row.state != 'confirmed':
+        journal._conflict('resources_remaining')
+    if operation.contract_version == 2 and operation.kind == 'revert' and (
+            phase not in ('preflight', 'cinder_reserve')):
+        if row is None or row.state != 'confirmed':
+            journal._conflict('resources_remaining')
+
+
+def write_budget(context, operation, checkpoint):
+    if operation.kind != 'revert':
+        return (checkpoint.artifact_upper_bound,
+                checkpoint.artifact_budget_version)
+    assert_dispatch(context, operation, 'artifact_stage')
+    row = context.session.get(m.InstanceCheckpointTemporaryBudget,
+                              operation.uuid)
+    if row is None:
+        journal._conflict('resources_remaining')
+    return row.reserved_bytes, row.version
+
+
+def _closed_proof(context, op, row):
+    if row.closing_proof:
+        return jsonutils.loads(row.closing_proof)
+    phases = {s.phase: s for s in journal._steps(context, op.uuid)}
+    required = ('staging_cleanup' if op.contract_version == 2 else
+                'runtime_restore_checkpoint')
+    if required not in phases or phases[required].status != 'succeeded':
+        return None
+    children = context.session.query(m.InstanceCheckpointEffect).filter_by(
+        operation_id=op.uuid).all()
+    if any(child.status not in effects.TERMINAL for child in children):
+        return None
+    if any(r.writer_state != 'deleted' for r in effects._reservations(
+            context, op.checkpoint_id) if r.operation_id == op.uuid):
+        return None
+    if any(s.status not in effects.TERMINAL for s in phases.values()):
+        return None
+    proof = v2.TemporaryProof(row.ticket_id, op.uuid, op.cell_uuid,
+        row.version, 'staging_deleted', tuple(sorted(c.id for c in children)))
+    row.state = 'closed'
+    row.closing_proof = journal._encode(proof.to_primitive())
+    return proof.to_primitive()
+
+
+@require_context
+@db.pick_context_manager_writer
+def close_proof(context, operation_id, ticket_id):
+    op, row = _locked(context, operation_id)
+    if row is None:
+        return None
+    if row.ticket_id != ticket_id:
+        journal._conflict('identity_changed')
+    return _closed_proof(context, op, row)
+
+
+@require_context
+@db.pick_context_manager_writer
+def cancel(context, operation_id, ticket_id):
+    c._uuid(ticket_id)
+    op, row = _locked(context, operation_id)
+    if row is not None:
+        if row.ticket_id != ticket_id:
+            journal._conflict('identity_changed')
+        proof = _closed_proof(context, op, row)
+        if proof:
+            return proof
+    # Even before bind has arrived, a durable tombstone must reject its late
+    # delivery. Active ownership prevents a cancelled operation being revived.
+    journal._owned(context, operation_id)
+    for parent in journal._steps(context, operation_id):
+        if parent.contract_version == 1:
+            if parent.status == 'failed_no_effect' or (
+                    parent.phase in ('preflight', 'cinder_reserve') and
+                    parent.status == 'succeeded'):
+                continue
+            journal._conflict('resources_remaining')
+        children = effects._rows(context, parent)
+        for child in children:
+            if child.status in ('prepared', 'failed_no_effect'):
+                continue
+            if child.action in ('inspect', 'reserve') and (
+                    child.status == 'succeeded'):
+                continue
+            journal._conflict('resources_remaining')
+    if op.contract_version == 2:
+        effects.cancel_prepared(context, operation_id, 1)
+    if row is None:
+        row = m.InstanceCheckpointTemporaryBudget(
+            operation_id=op.uuid, ticket_id=ticket_id, version=1,
+            reserved_bytes=0, state='cancelled')
+        context.session.add(row)
+    row.state = 'cancelled'
+    children = context.session.query(m.InstanceCheckpointEffect).filter_by(
+        operation_id=op.uuid).all()
+    proof = v2.TemporaryProof(ticket_id, op.uuid, op.cell_uuid, row.version,
+        'cancelled_before_write', tuple(sorted(c.id for c in children)))
+    row.closing_proof = journal._encode(proof.to_primitive())
+    context.session.flush()
+    return proof.to_primitive()
