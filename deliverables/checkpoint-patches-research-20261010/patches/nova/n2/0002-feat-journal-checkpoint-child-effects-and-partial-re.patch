+                dict(binding, **{field: uuids.foreign}), uuids.artifact))
+
+    def test_unknown_writer_defeats_terminal_marker(self):
+        self.save_parent()
+
+        @db_api.pick_context_manager_writer
+        def mark_terminal(ctx):
+            row = ctx.session.get(models.InstanceCheckpoint, uuids.checkpoint)
+            row.terminal_operation_id = uuids.operation
+        mark_terminal(self.ctx)
+        self.assertIsNone(journal.close_proof(self.ctx, uuids.operation))
+
+    def test_stale_ready_evidence_does_not_advance_parent(self):
+        child = self.children()[0]
+        ready = objects.CheckpointEffect.continuation(self.ctx, self.parent.id)
+        self.claim(child)
+        objects.InstanceCheckpointOperation.finish_step(
+            self.ctx, self.parent.id, 1,
+            v2.EffectResult('ready', ready, None).to_primitive())
+        self.assertEqual('unknown', journal.step_get(
+            self.ctx, self.parent.id)['status'])
+
+    def test_v2_objects_cannot_be_downgraded(self):
+        self.assertRaises(ovo_exception.UnsupportedObjectError,
+                          self.operation.obj_to_primitive,
+                          target_version='1.0')
+
+
+class EffectDBTest(EffectTests, test.TestCase):
+    def setUp(self):
+        super().setUp()
+        self.prepare_effects()
+
+
+class EffectRaceTests(EffectTests):
+    USES_DB_SELF = True
+
+    def setUp(self):
+        super().setUp()
+        engine = enginefacade.writer.get_engine()
+        self.manager = db_api.create_context_manager(
+            engine.url.render_as_string(hide_password=False))
+        with mock.patch.object(migration, '_get_engine', return_value=engine):
+            migration.db_sync(database='main')
+        self.addCleanup(self.manager.dispose_pool)
+        self.prepare_effects()
+
+    def test_parallel_claim_has_one_dispatch(self):
+        child = self.children()[0]
+        barrier = threading.Barrier(2)
+        values, failures = [], []
+
+        def claim():
+            try:
+                ctx = context.RequestContext('actor', 'project')
+                ctx.db_connection = self.manager
+                barrier.wait(timeout=10)
+                values.append(objects.CheckpointEffect.claim(
+                    ctx, child['id'], 1, 'test-executor', child['revision']))
+            except Exception as exc:
+                failures.append(exc)
+
+        threads = [threading.Thread(target=claim) for _ in range(2)]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join(timeout=20)
+        self.assertFalse(any(t.is_alive() for t in threads))
+        self.assertEqual([], failures)
+        self.assertEqual(1, sum(v is not None for v in values))
+
+
+class EffectMySQLTest(EffectRaceTests,
