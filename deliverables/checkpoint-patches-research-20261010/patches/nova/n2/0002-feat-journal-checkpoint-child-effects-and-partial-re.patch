+def _deleted(context, checkpoint, operation, artifact_id, child):
+    row = context.session.get(m.InstanceCheckpointArtifactReservation,
+                              artifact_id)
+    if row is None or row.checkpoint_id != checkpoint.uuid:
+        raise exception.NotFound()
+    writer = context.session.get(m.InstanceCheckpointEffect, row.child_id)
+    if (child.action != 'delete' or child.resource_id != artifact_id or
+            child.status != 'succeeded' or writer.status not in TERMINAL or
+            row.writer_state not in ('closed', 'deleted')):
+        journal._conflict('resources_remaining')
