 """V2 ordering keeps both RAM copies charged until the writer is fenced."""
 
+import uuid
+
+from nova.checkpoints import contracts as c
+
 CREATE = ('preflight', 'cinder_reserve', 'runtime_save', 'disk_snapshot',
           'artifact_publish_shared', 'runtime_restore_current',
           'staging_cleanup', 'cinder_release')
@@ -37,3 +41,73 @@ def steps_for(kind):
                 'cleanup': CLEANUP}[kind]
     except (KeyError, TypeError):
         raise ValueError('Invalid checkpoint workflow') from None
+
+
+def child_plan(kind, phase, resources):
+    """Build the complete linear graph from a locked, service-owned manifest.
+
+    Attachment IDs returned by Cinder are predecessor results, never guesses
+    in a pre-dispatch intent. UUID5 only provides stable names, not authority.
+    """
+    c._require(phase in steps_for(kind))
+    operation = resources['operation_id']
+    checkpoint = resources['checkpoint_id']
+    parent = resources['parent_step_id']
+    for value in (operation, checkpoint, parent):
+        c._uuid(value)
+    volumes = resources['volume_ids']
+    c._ids(volumes, nonempty=True)
+    artifacts = resources.get('artifacts', [])
+    entries = []
+
+    def add(action, target, **payload):
+        c._uuid(target)
+        ident = str(uuid.uuid5(uuid.UUID(parent), action + ':' + target))
+        payload['depends_on'] = [entries[-1]['id']] if entries else []
+        entries.append(dict(id=ident, action=action, resource_id=target,
+                            payload=payload))
+
+    if phase == 'preflight':
+        add('inspect', checkpoint)
+    elif phase == 'cinder_reserve':
+        add('reserve', operation)
+    elif phase == 'runtime_save':
+        add('reserve_staging', operation)
+        for item in artifacts:
+            if item['kind'] == 'config':
+                add('copy_config', item['id'], artifact_ids=[item['id']])
+        ram = next(item for item in artifacts if item['kind'] == 'ram')
+        add('save', ram['id'], artifact_ids=[ram['id']])
+    elif phase in ('disk_snapshot', 'disk_revert', 'disk_snapshot_delete',
+                   'cleanup_disk_snapshots'):
+        add('submit_disk_operation', operation)
+    elif phase in ('artifact_publish_shared', 'artifact_stage',
+                   'artifact_delete', 'cleanup_artifacts',
+                   'staging_cleanup'):
+        action = {'artifact_publish_shared': 'publish',
+                  'artifact_stage': 'download'}.get(phase, 'delete')
+        for item in artifacts:
+            if phase == 'staging_cleanup' and item['location'] != 'staging':
+                continue
+            add(action, item['id'], artifact_ids=[item['id']],
+                source_id=item.get('source_id'))
+    elif phase == 'runtime_stop':
+        add('stop', checkpoint)
+    elif phase in ('runtime_restore_current', 'runtime_restore_checkpoint',
+                   'cleanup_runtime_restore_current'):
+        add('restore_paused', checkpoint)
+        add('unpause', checkpoint)
+    elif phase in ('volume_disconnect', 'volume_reconnect'):
+        actions = (('host_disconnect', 'attachment_delete')
+                   if phase == 'volume_disconnect' else (
+                       'attachment_create', 'attachment_update',
+                       'host_connect',
+                       'bdm_update', 'attachment_complete'))
+        for volume in sorted(volumes):
+            for action in actions:
+                add(action, volume)
+    elif phase in ('cinder_release', 'cleanup_cinder_release'):
+        add('release', operation)
+    else:
+        raise ValueError('Unsupported checkpoint phase')
+    return tuple(entries)
