+def finish_parent(context, instance, checkpoint, operation, parent, value):
+    result = v2.validate_result(parent.phase, value.to_primitive())
+    children = _rows(context, parent)
+    valid = True
+    if result.status == 'succeeded':
+        valid = _parent_success(
+            parent, children, result.to_primitive()['evidence'])
+        if 'fingerprint' in result.evidence:
+            valid &= result.evidence['fingerprint'] == checkpoint.fingerprint
+    elif result.status == 'ready':
+        valid = dict(result.evidence) == _continuation(context, parent)
+    elif result.status == 'failed_with_effects':
+        valid = (all(row.status in TERMINAL for row in children) and
+                 set(result.evidence['terminal_child_ids']) ==
+                 {row.id for row in children} and
+                 set(result.evidence['resource_ids']) == {r.id for r in
+                     _reservations(context, checkpoint.uuid)
+                     if r.child_id in {row.id for row in children}})
+    elif result.status == 'failed_no_effect':
+        valid = all(row.status == 'failed_no_effect' for row in children)
+    if not valid:
+        result = v2.EffectResult('unknown', {}, 'invalid_executor_result')
+    encoded = journal._encode(result.to_primitive())
+    if parent.status in TERMINAL:
+        if parent.result != encoded:
+            journal._conflict()
+        return
+    parent.status, parent.result = result.status, encoded
+    parent.version += 1
+    operation.version += 1
+    operation.error_code = result.error_code
+    if result.status in ('unknown', 'failed_no_effect', 'failed_with_effects'):
+        operation.state = 'recovery_required'
+        instance.task_state = task_states.CHECKPOINT_RECOVERING
+
+
+def resources_closed(context, checkpoint):
+    if any(row.writer_state != 'deleted'
+           for row in _reservations(context, checkpoint.uuid)):
+        return False
+    operations = context.session.query(
+        m.InstanceCheckpointOperation).filter_by(
+        checkpoint_id=checkpoint.uuid).all()
+    for operation in operations:
+        for parent in journal._steps(context, operation.uuid):
+            if any(row.status not in TERMINAL
+                   for row in _rows(context, parent)):
+                return False
+    return True
