+
+"""Cell-owned effects serialized by the Instance and guard fence."""
+
+import uuid
+
+from oslo_serialization import jsonutils
+from oslo_utils import uuidutils
+
+from nova.checkpoints import contracts as c
+from nova.checkpoints import contracts_v2 as v2
+from nova.checkpoints import workflow_v2 as workflow
+from nova.compute import task_states
+from nova import conf
+from nova.db.main import api as db
+from nova.db.main import checkpoints as journal
+from nova.db.main import models as m
+from nova.db.utils import require_context
+from nova import exception
+
+TERMINAL = ('succeeded', 'failed_no_effect', 'failed_with_effects')
+
+
+def admission_fields(admission):
+    if not isinstance(admission, v2.AdmissionV2):
+        return {'contract_version': 1}
+    binding = v2.Binding(
+        conf.CONF.checkpoint.deployment_id, admission.cell_uuid,
+        admission.key.project_id, admission.key.instance_uuid,
+        admission.checkpoint_id, admission.host, admission.node,
+        admission.executor_id, admission.fingerprint,
+        admission.runtime_fingerprint, admission.runtime_profile_id,
+        admission.store_profile_id, admission.staging_profile_id)
+    fields = dict(contract_version=2,
+                  binding=journal._encode(binding.to_primitive()))
+    for name in ('runtime_fingerprint', 'runtime_profile_id',
+                 'store_profile_id', 'staging_profile_id'):
+        fields[name] = getattr(admission, name)
+    return fields
+
+
+def _load(context, parent_id, owned=True):
+    parent = context.session.get(m.InstanceCheckpointStep, parent_id)
+    if parent is None:
+        raise exception.NotFound()
+    if owned:
+        unused, guard, checkpoint, operation = journal._owned(
+            context, parent.operation_id)
+        context.session.refresh(parent, with_for_update=True)
+    else:
+        operation = journal._operation(context, parent.operation_id)
+        checkpoint = journal._checkpoint(context, operation.checkpoint_id)
+    if parent.contract_version != 2 or operation.contract_version != 2:
+        journal._conflict('incompatible_service')
+    return parent, checkpoint, operation
+
+
+def _rows(context, parent):
+    rows = context.session.query(m.InstanceCheckpointEffect).filter_by(
+        parent_step_id=parent.uuid).order_by(
+            m.InstanceCheckpointEffect.sequence).all()
+    graph = [dict(id=row.id, action=row.action, resource_id=row.resource_id,
+                  payload=jsonutils.loads(row.payload)) for row in rows]
+    if len(rows) != parent.child_plan_count or c.canonical_payload_hash(
+            {'children': graph}) != parent.child_plan_hash:
+        journal._conflict('identity_changed')
+    return rows
+
+
+def _projection(row, parent):
+    value = journal._row(row)
+    value['revision'] = parent.version
+    return value
+
+
+def _reservations(context, checkpoint_id):
+    return context.session.query(
+        m.InstanceCheckpointArtifactReservation).filter_by(
+            checkpoint_id=checkpoint_id).order_by(
+                m.InstanceCheckpointArtifactReservation.id).all()
+
+
+def _logical(binding, artifact_id):
+    return c.canonical_payload_hash({
+        name: binding[name] for name in ('deployment_id', 'cell_uuid',
+        'project_id', 'instance_uuid', 'checkpoint_id')} |
+        {'artifact_id': artifact_id})
+
+
+def _artifact_plan(context, operation, checkpoint, phase):
+    existing = _reservations(context, checkpoint.uuid)
+    if phase == 'runtime_save':
+        kinds = ['ram']
+        if jsonutils.loads(checkpoint.device_manifest)['config_drive']:
+            kinds.append('config')
+        admission = v2.decode_admission(jsonutils.loads(operation.admission))
+        return [dict(
+            id=str(uuid.uuid5(uuid.UUID(operation.uuid), 'staging:' + kind)),
+            kind=kind, location='staging',
+            upper_bound=admission.save_bytes_limit) for kind in kinds]
+    if phase in ('artifact_publish_shared', 'artifact_stage'):
+        location = (
+            'shared' if phase == 'artifact_publish_shared' else 'staging')
+        source_location = 'staging' if location == 'shared' else 'shared'
+        source = [r for r in existing if r.location == source_location and
+                  r.writer_state == 'closed' and (location == 'staging' or
+                  r.operation_id == operation.uuid)]
+        return [dict(id=str(uuid.uuid5(uuid.UUID(operation.uuid),
+                                      location + ':' + item.id)),
+                     kind=item.kind, location=location,
+                     upper_bound=item.upper_bound, source_id=item.id)
+                for item in source]
+    return [dict(id=item.id, kind=item.kind, location=item.location,
+                 upper_bound=item.upper_bound)
+            for item in existing if item.writer_state != 'deleted']
+
+
+def claim_parent(context, instance, checkpoint, operation, phase):
+    phases = workflow.steps_for(operation.kind)
+    steps = {s.phase: s for s in journal._steps(context, operation.uuid)}
+    if phase not in phases:
+        journal._conflict()
+    if phase in steps:
+        return None
+    if any(p not in steps or steps[p].status != 'succeeded'
+           for p in phases[:phases.index(phase)]):
+        journal._conflict()
+    if any(p in steps for p in phases[phases.index(phase) + 1:]):
+        journal._conflict()
+    ident = uuidutils.generate_uuid()
+    binding = jsonutils.loads(operation.binding)
+    artifacts = _artifact_plan(context, operation, checkpoint, phase)
+    resources = dict(parent_step_id=ident, operation_id=operation.uuid,
+                     checkpoint_id=checkpoint.uuid,
+                     volume_ids=[d.volume_id for d in journal._disks(
+                         context, checkpoint.uuid)], artifacts=artifacts)
+    graph = workflow.child_plan(operation.kind, phase, resources)
+    payload = dict(binding=binding, kind=operation.kind, generation=1,
+                   budgets=dict(total_bytes=checkpoint.artifact_upper_bound,
+                                version=checkpoint.artifact_budget_version),
+                   children=[item['id'] for item in graph],
+                   resources=resources,
+                   prior={name: jsonutils.loads(step.result)
+                          for name, step in steps.items()})
+    intent = v2.StepIntentV2(ident, operation.uuid, 1, phase,
+                             operation.executor_id,
+                             c.canonical_payload_hash(payload), payload)
+    parent = m.InstanceCheckpointStep(
+        uuid=ident, operation_id=operation.uuid, generation=1, phase=phase,
+        executor_id=operation.executor_id, payload_hash=intent.payload_hash,
+        payload=journal._encode(payload), status='dispatching', version=1,
+        contract_version=2, child_plan_count=len(graph),
+        child_plan_hash=c.canonical_payload_hash({'children': graph}))
+    context.session.add(parent)
+    context.session.flush()
+    for position, item in enumerate(graph):
+        child = m.InstanceCheckpointEffect(
+            id=item['id'], parent_step_id=ident, operation_id=operation.uuid,
+            generation=1, executor_id=operation.executor_id,
+            action=item['action'], resource_id=item['resource_id'],
+            payload=journal._encode(item['payload']),
+            payload_hash=c.canonical_payload_hash(item['payload']),
+            status='prepared', revision=1, sequence=position)
+        context.session.add(child)
+        context.session.flush()
+        if child.action in ('save', 'copy_config', 'publish', 'download'):
+            descriptor = next(
+                a for a in artifacts if a['id'] == child.resource_id)
+            _reserve(context, child, checkpoint, operation, descriptor['id'],
+                     descriptor['location'], descriptor['upper_bound'],
+                     descriptor['kind'])
+    operation.phase = phase
+    operation.state = 'running'
+    operation.version += 1
+    context.session.flush()
+    return intent
+
+
+def _child(context, child_id):
+    child = context.session.get(m.InstanceCheckpointEffect, child_id)
+    if child is None:
+        raise exception.NotFound()
+    parent, checkpoint, operation = _load(context, child.parent_step_id)
+    rows = _rows(context, parent)
+    child = next(row for row in rows if row.id == child_id)
+    context.session.refresh(child, with_for_update=True)
+    return parent, checkpoint, operation, child, rows
+
+
+def _bump(parent, operation, child):
+    parent.version += 1
+    operation.version += 1
+    child.revision += 1
+
+
+@require_context
+@db.pick_context_manager_writer
+def prepare(context, parent_step_id, action, resource_id, payload):
+    parent, checkpoint, operation = _load(context, parent_step_id)
+    for row in _rows(context, parent):
+        if (row.action, row.resource_id) == (action, resource_id):
+            if row.payload_hash != c.canonical_payload_hash(payload):
+                journal._conflict('identity_changed')
+            return _projection(row, parent)
+    journal._conflict('operation_conflict')
+
+
+@require_context
+@db.pick_context_manager_writer
+def claim(context, child_id, generation, executor_id, expected_revision):
+    v2.validate_generation(generation)
+    c._integer(expected_revision, minimum=1)
+    parent, checkpoint, operation, child, rows = _child(context, child_id)
+    if operation.executor_id != executor_id or not operation.quota_ready:
+        journal._conflict('identity_changed')
+    if child.status != 'prepared' or parent.version != expected_revision:
+        return None
+    if any(row.status != 'succeeded' for row in rows[:child.sequence]):
+        return None
+    if parent.status not in ('dispatching', 'pending', 'unknown', 'ready'):
+        return None
+    child.status = 'dispatching'
+    _bump(parent, operation, child)
+    for item in _reservations(context, checkpoint.uuid):
+        if item.child_id == child.id:
+            if item.writer_state != 'reserved':
+                journal._conflict('resources_remaining')
+            item.writer_state = 'dispatching'
+    context.session.flush()
+    return _projection(child, parent)
+
+
+def _bind_child(context, checkpoint, operation, child, result):
+    evidence = result.evidence
+    reservations = [r for r in _reservations(context, checkpoint.uuid)
+                    if r.child_id == child.id]
+    valid = True
+    if result.status == 'failed_with_effects':
+        valid = (set(evidence['terminal_child_ids']) == {child.id} and
+                 set(evidence['resource_ids']) == {r.id for r in reservations})
+    if result.status == 'succeeded':
+        if 'fingerprint' in evidence:
+            valid &= evidence['fingerprint'] == checkpoint.fingerprint
+        if 'host' in evidence:
+            valid &= (evidence['host'], evidence['node']) == (
+                operation.host, operation.node)
+        if child.action == 'reserve_staging':
+            admission = v2.decode_admission(
+                jsonutils.loads(operation.admission))
+            limit = (admission.save_bytes_limit if operation.kind == 'create'
+                     else admission.restore_bytes_limit)
+            valid &= (evidence['workspace_id'] == operation.uuid and
+                      evidence['limit_bytes'] == limit)
+        if child.action in ('save', 'copy_config', 'publish', 'download'):
+            refs = evidence.get('artifacts', [evidence.get('artifact')])
+            refs = [v2.ArtifactRef.from_primitive(ref) for ref in refs]
+            valid &= {r.id for r in refs} == {r.id for r in reservations}
+            for ref in refs:
+                row = next((r for r in reservations if r.id == ref.id), None)
+                valid &= row is not None and (
+                    row.kind == ref.kind and row.location == ref.location and
+                    row.logical_id == ref.logical_id and
+                    ref.bytes <= row.upper_bound)
+        if child.action == 'delete':
+            valid &= evidence['artifact_id'] == child.resource_id
+    if not valid:
+        return v2.EffectResult('unknown', {}, 'identity_changed')
+    return result
+
+
+@require_context
+@db.pick_context_manager_writer
+def observe(context, child_id, generation, result):
+    v2.validate_generation(generation)
+    parent, checkpoint, operation, child, rows = _child(context, child_id)
+    if child.status == 'prepared':
+        journal._conflict('operation_conflict')
+    value = v2.validate_child_result(child.action, result)
+    value = _bind_child(context, checkpoint, operation, child, value)
+    encoded = journal._encode(value.to_primitive())
+    if child.status in TERMINAL:
+        if child.result != encoded:
+            journal._conflict('identity_changed')
+        return _projection(child, parent)
+    child.status, child.result = value.status, encoded
+    _bump(parent, operation, child)
+    reservations = [r for r in _reservations(context, checkpoint.uuid)
+                    if r.child_id == child.id]
+    for item in reservations:
+        item.writer_state = ('closed' if value.status in
+            ('succeeded', 'failed_with_effects') else
+            'deleted' if value.status == 'failed_no_effect' else value.status)
+    if value.status == 'succeeded':
+        refs = value.evidence.get('artifacts', [])
+        if 'artifact' in value.evidence:
+            refs = [value.evidence['artifact']]
+        for ref in refs:
+            item = next(r for r in reservations if r.id == ref['id'])
+            item.actual_bytes = ref['bytes']
+            item.checksum = ref['checksum']
+        if child.action == 'delete':
+            _deleted(context, checkpoint, operation, child.resource_id, child)
+    context.session.flush()
+    return _projection(child, parent)
+
+
+@require_context
+@db.pick_context_manager_reader
+def get_children(context, parent_step_id):
+    parent, checkpoint, operation = _load(context, parent_step_id, owned=False)
+    return [_projection(row, parent) for row in _rows(context, parent)]
+
+
+def _continuation(context, parent):
+    for row in _rows(context, parent):
+        if row.status == 'succeeded':
+            continue
+        if row.status == 'prepared':
+            return dict(step_id=parent.uuid, journal_revision=parent.version,
+                        next_child_id=row.id)
+        return None
+    return None
+
+
+@require_context
+@db.pick_context_manager_reader
+def continuation(context, parent_step_id):
+    parent, checkpoint, operation = _load(context, parent_step_id, owned=False)
+    return _continuation(context, parent)
+
+
+@require_context
+@db.pick_context_manager_writer
+def cancel_prepared(context, operation_id, generation):
+    v2.validate_generation(generation)
+    unused, guard, checkpoint, operation = journal._owned(
+        context, operation_id, generation)
+    for parent in journal._steps(context, operation_id):
+        for child in _rows(context, parent):
+            if child.status != 'prepared':
+                continue
+            value = v2.EffectResult('failed_no_effect', dict(
+                no_effect=True, late_effect_impossible=True),
+                'admission_cancelled')
+            child.status = value.status
+            child.result = journal._encode(value.to_primitive())
+            _bump(parent, operation, child)
+            for item in _reservations(context, checkpoint.uuid):
+                if item.child_id == child.id:
+                    item.writer_state = 'deleted'
+
+
+def _reserve(context, child, checkpoint, operation, artifact_id, location,
+             upper_bound, kind):
+    c._uuid(artifact_id)
+    c._integer(upper_bound, minimum=1)
+    if location not in ('staging', 'shared') or child.status != 'prepared':
+        journal._conflict()
+    binding = jsonutils.loads(operation.binding)
+    namespace = _logical(binding, artifact_id)
+    row = context.session.get(m.InstanceCheckpointArtifactReservation,
+                              artifact_id)
+    if row is not None:
+        if (row.child_id, row.namespace_hash,
+                row.location, row.upper_bound) != (
+                child.id, namespace, location, upper_bound):
+            journal._conflict('identity_changed')
+        return row
+    row = m.InstanceCheckpointArtifactReservation(
+        id=artifact_id, child_id=child.id, operation_id=operation.uuid,
+        checkpoint_id=checkpoint.uuid, namespace_hash=namespace,
+        logical_id=namespace, kind=kind, location=location,
+        upper_bound=upper_bound, writer_state='reserved')
+    context.session.add(row)
+    context.session.flush()
+    return row
+
+
+@require_context
+@db.pick_context_manager_writer
+def reserve(context, child_id, artifact_id, location, upper_bound):
+    parent, checkpoint, operation, child, rows = _child(context, child_id)
+    payload = jsonutils.loads(parent.payload)
+    descriptor = next((a for a in payload['resources']['artifacts']
+                       if a['id'] == artifact_id), None)
+    if (descriptor is None or child.resource_id != artifact_id or
+            child.action not in (
+                'save', 'copy_config', 'publish', 'download') or
+            descriptor['location'] != location or
+            descriptor['upper_bound'] != upper_bound):
+        journal._conflict('identity_changed')
+    return journal._row(_reserve(context, child, checkpoint, operation,
+        artifact_id, location, upper_bound, descriptor['kind']))
+
+
+@require_context
+@db.pick_context_manager_writer
+def confirm(context, artifact_id, result):
+    row = context.session.get(m.InstanceCheckpointArtifactReservation,
+                              artifact_id)
+    if row is None:
+        raise exception.NotFound()
+    parent, checkpoint, operation, child, rows = _child(context, row.child_id)
+    ref = v2.ArtifactRef.from_primitive(result)
+    if (child.status != 'succeeded' or row.writer_state != 'closed' or
+            (ref.id, ref.bytes, ref.checksum, ref.location,
+             ref.logical_id) !=
+            (row.id, row.actual_bytes, row.checksum, row.location,
+             row.logical_id)):
+        journal._conflict('identity_changed')
