+    journal._checkpoint(context, checkpoint_id)
+    return [journal._row(r) for r in _reservations(context, checkpoint_id)]
+
+
+def _parent_success(parent, children, evidence):
+    if any(row.status != 'succeeded' for row in children):
+        return False
+    proofs = [jsonutils.loads(row.result)['evidence'] for row in children]
+    if parent.phase in ('runtime_save', 'artifact_publish_shared',
+                        'artifact_stage'):
+        refs = []
+        for proof in proofs:
+            refs.extend(proof.get('artifacts', []))
+            if 'artifact' in proof:
+                refs.append(proof['artifact'])
+        return sorted(refs, key=lambda r: r['id']) == sorted(
+            evidence['artifacts'], key=lambda r: r['id'])
+    if parent.phase in ('runtime_restore_current',
+                        'runtime_restore_checkpoint',
+                        'cleanup_runtime_restore_current'):
+        return bool(proofs) and proofs[-1] == evidence
+    if parent.phase in ('staging_cleanup', 'artifact_delete',
+                        'cleanup_artifacts'):
+        return set(evidence['artifact_ids']) == {
+            row.resource_id for row in children}
