+# under the License.
+
+"""Explicit conductor-indirected child effect and resource transitions."""
+
+from nova.db.main import checkpoint_effects as db
+from nova.objects import base
+
+
+@base.NovaObjectRegistry.register
+class CheckpointEffect(base.NovaObject):
+    VERSION = '1.0'
+
+    @base.remotable_classmethod
+    def prepare(cls, context, parent_step_id, action, resource_id, payload):
+        return db.prepare(
+            context, parent_step_id, action, resource_id, payload)
+
+    @base.remotable_classmethod
+    def claim(cls, context, child_id, generation, executor_id,
+              expected_revision):
+        return db.claim(
+            context, child_id, generation, executor_id, expected_revision)
+
+    @base.remotable_classmethod
+    def observe(cls, context, child_id, generation, result):
+        return db.observe(context, child_id, generation, result)
+
+    @base.remotable_classmethod
+    def get_children(cls, context, parent_step_id):
+        return db.get_children(context, parent_step_id)
+
+    @base.remotable_classmethod
+    def continuation(cls, context, parent_step_id):
+        return db.continuation(context, parent_step_id)
+
+
+@base.NovaObjectRegistry.register
+class CheckpointArtifactReservation(base.NovaObject):
+    VERSION = '1.0'
+
+    @base.remotable_classmethod
+    def reserve(cls, context, child_id, artifact_id, location, upper_bound):
+        return db.reserve(
+            context, child_id, artifact_id, location, upper_bound)
+
+    @base.remotable_classmethod
+    def confirm(cls, context, artifact_id, result):
+        return db.confirm(context, artifact_id, result)
+
+    @base.remotable_classmethod
+    def deleted(cls, context, artifact_id, child_id):
+        return db.deleted(context, artifact_id, child_id)
