+class EffectTests:
+    def prepare_effects(self):
+        self.flags(enabled=True, deployment_id=uuids.deployment,
+                   group='checkpoint')
+        self.ctx = context.RequestContext('actor', 'project')
+        if hasattr(self, 'manager'):
+            self.ctx.db_connection = self.manager
+        test_cell_db.make_instance(self.ctx)
+        old = test_cell_db.admission(self.ctx)
+        self.admission = v2.AdmissionV2(
+            **{f.name: getattr(old, f.name) for f in dataclasses.fields(old)},
+            runtime_fingerprint='b' * 64, runtime_profile_id=uuids.runtime,
+            store_profile_id=uuids.store, staging_profile_id=uuids.staging,
+            save_bytes_limit=4096, restore_bytes_limit=4096)
+        self.operation = objects.InstanceCheckpointOperation.admit(
+            self.ctx, self.admission.to_primitive(), uuids.ticket)
+        journal.mark_quota_ready(self.ctx, uuids.operation, uuids.ticket)
+        self.parent = journal.claim_step(
+            self.ctx, uuids.operation, 1, 'preflight', 'test-executor')
+
+    def children(self):
+        return objects.CheckpointEffect.get_children(self.ctx, self.parent.id)
+
+    def claim(self, child):
+        return objects.CheckpointEffect.claim(
+            self.ctx, child['id'], 1, 'test-executor', child['revision'])
+
+    def finish(self, child, evidence):
+        self.claim(child)
+        value = v2.EffectResult('succeeded', evidence, None)
+        objects.CheckpointEffect.observe(
+            self.ctx, child['id'], 1, value.to_primitive())
+        objects.InstanceCheckpointOperation.finish_step(
+            self.ctx, self.parent.id, 1, value.to_primitive())
+
+    def save_parent(self):
+        self.finish(self.children()[0], dict(
+            fingerprint=self.admission.fingerprint,
+            host='compute', node='node'))
+        self.parent = journal.claim_step(
+            self.ctx, uuids.operation, 1, 'cinder_reserve', 'test-executor')
+        self.finish(self.children()[0], dict(
+            operation_id=uuids.cinder, generation=1,
+            volume_ids=[uuids.volume], state='reserved'))
+        self.parent = journal.claim_step(
+            self.ctx, uuids.operation, 1, 'runtime_save', 'test-executor')
+
+    def test_closed_plan_and_exact_prepare_replay(self):
+        before = self.children()
+        self.assertEqual(['inspect'], [c['action'] for c in before])
+        child = before[0]
+        replay = objects.CheckpointEffect.prepare(
+            self.ctx, self.parent.id, child['action'], child['resource_id'],
+            child['payload'])
+        self.assertEqual(child['id'], replay['id'])
+        self.assertRaises(exception.CheckpointConflict,
+                          objects.CheckpointEffect.prepare, self.ctx,
+                          self.parent.id, 'save', uuids.foreign, {})
+        self.assertEqual(before, self.children())
+
+    def test_claim_once_and_stale_revision_cannot_dispatch(self):
+        child = self.children()[0]
+        self.assertIsNotNone(self.claim(child))
+        self.assertIsNone(self.claim(child))
+        self.assertEqual('dispatching', self.children()[0]['status'])
+
+    def test_ready_is_not_success_and_observe_does_not_add_children(self):
+        self.save_parent()
+        before = self.children()
+        self.assertEqual(['reserve_staging', 'save'],
+                         [c['action'] for c in before])
+        child = before[0]
+        self.claim(child)
+        objects.CheckpointEffect.observe(self.ctx, child['id'], 1,
+            v2.EffectResult('succeeded', dict(workspace_id=uuids.operation,
+                                            limit_bytes=4096), None
+                            ).to_primitive())
+        ready = objects.CheckpointEffect.continuation(self.ctx, self.parent.id)
+        self.assertEqual(before[1]['id'], ready['next_child_id'])
+        self.assertEqual('dispatching', journal.step_get(
+            self.ctx, self.parent.id)['status'])
+        self.assertEqual([c['id'] for c in before],
+                         [c['id'] for c in self.children()])
+        self.assertIsNone(self.claim(before[1]))
+        self.assertIsNotNone(objects.CheckpointEffect.claim(
+            self.ctx, ready['next_child_id'], 1, 'test-executor',
+            ready['journal_revision']))
+
+    def test_unknown_save_reservation_blocks_cleanup_and_close(self):
+        self.save_parent()
+        child = self.children()[0]
+        self.claim(child)
+        objects.CheckpointEffect.observe(self.ctx, child['id'], 1,
+            v2.EffectResult('succeeded', dict(workspace_id=uuids.operation,
+                                            limit_bytes=4096), None
+                            ).to_primitive())
+        child = self.children()[1]
+        self.claim(child)
+        objects.CheckpointEffect.observe(self.ctx, child['id'], 1,
+            v2.EffectResult('unknown', {}, 'recovery_required').to_primitive())
+        rows = effects.get_reservations(self.ctx, uuids.checkpoint)
+        self.assertEqual(1, len(rows))
+        self.assertEqual('unknown', rows[0]['writer_state'])
+        self.assertRaises(exception.CheckpointConflict,
+                          objects.CheckpointArtifactReservation.deleted,
+                          self.ctx, rows[0]['id'], child['id'])
+        self.assertIsNone(journal.close_proof(self.ctx, uuids.operation))
+
+    def test_partial_result_cannot_claim_foreign_or_unknown_children(self):
+        child = self.children()[0]
+        self.claim(child)
+        value = v2.EffectResult('failed_with_effects', dict(
+            resource_ids=[uuids.foreign], terminal_child_ids=[uuids.foreign],
+            late_effect_impossible=True), 'resources_remaining')
+        objects.CheckpointEffect.observe(
+            self.ctx, child['id'], 1, value.to_primitive())
+        self.assertEqual('unknown', self.children()[0]['status'])
+
+    def test_fenced_prepared_child_rejects_late_claim(self):
+        child = self.children()[0]
+        effects.cancel_prepared(self.ctx, uuids.operation, 1)
+        self.assertIsNone(self.claim(child))
+        self.assertEqual('failed_no_effect', self.children()[0]['status'])
+
+    def test_parent_success_cannot_bypass_child_dispatch(self):
+        value = v2.EffectResult('succeeded', dict(
+            fingerprint=self.admission.fingerprint,
+            host='compute', node='node'),
+            None)
+        objects.InstanceCheckpointOperation.finish_step(
+            self.ctx, self.parent.id, 1, value.to_primitive())
+        self.assertNotEqual('succeeded', journal.step_get(
+            self.ctx, self.parent.id)['status'])
+        self.assertEqual('prepared', self.children()[0]['status'])
+
+    def complete_save_child(self):
+        self.save_parent()
+        child = self.children()[0]
+        self.claim(child)
+        objects.CheckpointEffect.observe(self.ctx, child['id'], 1,
+            v2.EffectResult('succeeded', dict(workspace_id=uuids.operation,
+                limit_bytes=4096), None).to_primitive())
+        child = self.children()[1]
+        self.claim(child)
+        row = effects.get_reservations(self.ctx, uuids.checkpoint)[0]
+        ref = v2.ArtifactRef(row['id'], 'ram', row['logical_id'],
+                            1024, 'c' * 64, 'staging').to_primitive()
+        value = v2.EffectResult('succeeded', dict(writes_stopped=True,
+                               artifacts=[ref]), None)
+        objects.CheckpointEffect.observe(self.ctx, child['id'], 1,
+                                          value.to_primitive())
+        return value
+
+    def test_parent_cannot_substitute_artifact_after_children_succeed(self):
+        value = self.complete_save_child().to_primitive()
+        value['evidence']['artifacts'][0]['id'] = uuids.foreign
+        objects.InstanceCheckpointOperation.finish_step(
+            self.ctx, self.parent.id, 1, value)
+        self.assertEqual('unknown', journal.step_get(
+            self.ctx, self.parent.id)['status'])
+
+    def test_confirm_cannot_change_recorded_resource(self):
+        value = self.complete_save_child().to_primitive()
+        ref = value['evidence']['artifacts'][0]
+        self.assertEqual(1024, objects.CheckpointArtifactReservation.confirm(
+            self.ctx, ref['id'], ref)['actual_bytes'])
+        ref['bytes'] = 1
+        self.assertRaises(exception.CheckpointConflict,
+            objects.CheckpointArtifactReservation.confirm,
+            self.ctx, ref['id'], ref)
+
+    def test_foreign_namespace_collision_rolls_back_complete_graph(self):
+        self.save_parent()
+        original = effects.get_reservations(self.ctx, uuids.checkpoint)[0]
+        test_cell_db.make_instance(self.ctx, uuids.instance2, uuids.bdm2,
+                                   uuids.volume2)
+        old = test_cell_db.admission(self.ctx, request_id=uuids.request2,
+            checkpoint_id=uuids.checkpoint2, operation_id=uuids.operation2,
+            instance_uuid=uuids.instance2)
+        other = dataclasses.replace(self.admission,
+            **{f.name: getattr(old, f.name) for f in dataclasses.fields(old)})
+        other = dataclasses.replace(other, cell_uuid=uuids.cell2)
+        objects.InstanceCheckpointOperation.admit(
+            self.ctx, other.to_primitive(), uuids.ticket2)
+        journal.mark_quota_ready(self.ctx, other.operation_id, uuids.ticket2)
+        for phase, evidence in (
+                ('preflight', dict(fingerprint=other.fingerprint,
+                                   host='compute', node='node')),
+                ('cinder_reserve', dict(operation_id=uuids.cinder2,
+                    generation=1, volume_ids=[uuids.volume2],
+                    state='reserved'))):
+            self.parent = journal.claim_step(self.ctx, other.operation_id, 1,
+                                            phase, 'test-executor')
+            self.finish(self.children()[0], evidence)
+        with mock.patch.object(effects, '_artifact_plan', return_value=[dict(
+                id=original['id'], kind='ram', location='staging',
+                upper_bound=4096)]):
+            self.assertRaises(
+                exception.CheckpointConflict, journal.claim_step,
+                self.ctx, other.operation_id, 1,
+                'runtime_save', 'test-executor')
+        self.assertEqual(['preflight', 'cinder_reserve'], [r['phase'] for r in
+            sorted(journal.steps_get(self.ctx, other.operation_id),
+                   key=lambda r: r['created_at'])])
+        self.assertEqual([], effects.get_reservations(self.ctx,
+                                                      uuids.checkpoint2))
+        self.assertEqual(original, effects.get_reservations(
+            self.ctx, uuids.checkpoint)[0])
+
+    def test_namespace_includes_cell_and_instance(self):
+        binding = self.admission.to_primitive()
+        binding = dict(deployment_id=uuids.deployment,
+            cell_uuid=binding['cell_uuid'], project_id='project',
+            instance_uuid=uuids.instance, checkpoint_id=uuids.checkpoint)
+        name = effects._logical(binding, uuids.artifact)
+        for field in ('cell_uuid', 'instance_uuid', 'checkpoint_id',
+                      'deployment_id', 'project_id'):
