+def cinder_reserve_payload(operation):
+    """Exact Cinder 3.73 body, derived from immutable admission identity."""
+    return dict(request_id=operation.request_id,
+        checkpoint_id=operation.checkpoint_id,
+        instance_uuid=operation.instance_uuid, kind=operation.kind,
+        volume_ids=sorted(d['volume_id'] for d in
+            operation.admission['device_manifest']['disks']),
+        nova_operation_id=operation.uuid, allow_service_continuation=True)
