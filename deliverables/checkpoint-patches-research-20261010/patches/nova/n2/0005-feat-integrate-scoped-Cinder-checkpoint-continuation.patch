+class CinderReserveReplayTest(test.NoDBTestCase):
+    def test_replay_requires_original_actor_and_current_policy(self):
+        from nova.checkpoints import api
+        from nova.tests.unit.volume import test_checkpoints as fixture
+        op = fixture.operation()
+        ctx = context.RequestContext('actor', 'owner-project',
+                                     auth_token='fresh')
+        ctx.can = mock.Mock(return_value=True)
+        client = mock.Mock()
+        service = api.API(checkpoint_client=client)
+        with mock.patch.object(objects.InstanceCheckpointOperation,
+                               'get_by_uuid', return_value=op):
+            service.resume_reserve_with_user(ctx, op.uuid)
+            client.reserve.assert_called_once_with(ctx, op.uuid,
+                op.checkpoint_id, op.instance_uuid, op.kind, (uuids.volume,))
+            ctx.can.assert_called_once_with(
+                'os_compute_api:server_checkpoints:create',
+                target={'project_id': 'owner-project'})
+            client.reset_mock()
+            ctx.user_id = 'foreign'
+            self.assertRaises(exception.CheckpointConflict,
+                service.resume_reserve_with_user, ctx, op.uuid)
+            client.reserve.assert_not_called()
