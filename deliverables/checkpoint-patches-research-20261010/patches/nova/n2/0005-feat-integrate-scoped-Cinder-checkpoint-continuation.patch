 class API:
-    def __init__(self, conductor_api=None, ledger=None):
+    def __init__(self, conductor_api=None, ledger=None,
+                 checkpoint_client=None):
         self.conductor = conductor_api or conductor.ComputeTaskAPI()
         self.ledger = ledger or quota.QuotaLedger()
+        self.checkpoint_client = checkpoint_client
+
+    def resume_reserve_with_user(self, context, operation_id):
+        """Replay a keyed reserve in its targeted cell with a fresh user token.
+
+        The HTTP client requires the exact persisted reserve intent and rejects
+        completed/cancelled children. Background reconciliation only uses GET.
+        """
+        operation = objects.InstanceCheckpointOperation.get_by_uuid(
+            context, operation_id)
+        if (operation.contract_version != 2 or not context.auth_token or
+                context.user_id != operation.actor_user_id or
+                context.project_id != operation.project_id):
+            raise exception.CheckpointConflict(reason='identity_changed')
+        context.can(policies.POLICY_ROOT % operation.kind,
+                    target={'project_id': operation.project_id})
+        client = (self.checkpoint_client or
+                  cinder_checkpoints.CheckpointClient())
+        volumes = cinder_checkpoints.reserve_payload(operation)['volume_ids']
+        client.reserve(context, operation.uuid, operation.checkpoint_id,
+                       operation.instance_uuid, operation.kind, tuple(volumes))
 
     @contextlib.contextmanager
     def _server(self, context, instance_uuid, action):
