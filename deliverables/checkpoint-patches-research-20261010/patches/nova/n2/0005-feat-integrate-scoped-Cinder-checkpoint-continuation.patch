+# License for the specific language governing permissions and limitations
+# under the License.
+
+"""Mandatory wire gate against the pinned C1.1 authenticated HTTP fixture."""
+
+import os
+from pathlib import Path
+import subprocess
+import tempfile
+import time
+from types import SimpleNamespace
+
+from keystoneauth1 import session
+from oslo_serialization import jsonutils
+from oslo_utils import uuidutils
+
+from nova import context
+from nova import exception
+from nova import test
+from nova.tests.unit.volume.test_checkpoints import MarkerAuth
+from nova.volume import checkpoints
+
+CINDER_HEAD = 'd065a55cbe5cb8cd59489752846a41145d72bd27'
+CINDER_TREE = '53888d9cea7fa1b12d35a0b9afd894eeee270843'
+
+
+class CinderContinuationContractTest(test.NoDBTestCase):
+    def setUp(self):
+        super().setUp()
+        checkout = os.environ.get('N2_CINDER_CHECKOUT')
+        python = os.environ.get('N2_CINDER_PYTHON')
+        self.assertTrue(
+            checkout and python,
+            'N2_CINDER_CHECKOUT and N2_CINDER_PYTHON are required',
+        )
+        temporary = tempfile.TemporaryDirectory()
+        self.addCleanup(temporary.cleanup)
+        root = Path(temporary.name)
+        git_env = dict(os.environ)
+        git_dir = os.environ.get('N2_CINDER_GIT_DIR')
+        if git_dir:
+            git_env.update(GIT_DIR=git_dir, GIT_WORK_TREE=checkout)
+        for revision, expected in (
+            ('HEAD', CINDER_HEAD),
+            ('HEAD^{tree}', CINDER_TREE),
+        ):
+            actual = subprocess.check_output(
+                ['git', '-C', checkout, 'rev-parse', revision],
+                env=git_env,
+                text=True,
+            ).strip()
+            self.assertEqual(expected, actual)
+        git_env['GIT_INDEX_FILE'] = str(root / 'dependency.index')
+        subprocess.run(
+            ['git', '-C', checkout, 'read-tree', 'HEAD'],
+            env=git_env,
+            check=True,
+        )
+        subprocess.run(
+            ['git', '-C', checkout, 'diff', '--exit-code', 'HEAD', '--'],
+            env=git_env,
+            check=True,
+            stdout=subprocess.DEVNULL,
+        )
+        ready, log = root / 'ready.json', root / 'cinder.log'
+        output = log.open('w')
+        self.addCleanup(output.close)
+        # Do not send Nova discovery paths or its opportunistic DB selection
+        # into Cinder's separate interpreter and disposable fixture database.
+        env = {
+            k: v
+            for k, v in os.environ.items()
+            if not k.startswith(('OS_TEST_', 'NOVA_', 'N2_', 'GIT_')) and
+            k not in ('PYTHONPATH', 'PYTHONHOME', 'VIRTUAL_ENV')
+        }
+        env.update(
+            PYTHONPATH=checkout,
+            PBR_VERSION='0.0.0',
+            PYTHONDONTWRITEBYTECODE='1',
+        )
+        process = subprocess.Popen(
+            [
+                python,
+                '-m',
+                'cinder.tests.functional.checkpoint_continuation_fixture',
+                '--ready',
+                str(ready),
+            ],
+            cwd=checkout,
+            env=env,
+            stdout=output,
+            stderr=subprocess.STDOUT,
+        )
+
+        def stop():
+            process.terminate()
+            try:
+                process.wait(timeout=15)
+            except subprocess.TimeoutExpired:
+                process.kill()
+                process.wait(timeout=5)
+
+        self.addCleanup(stop)
+        deadline = time.monotonic() + 30
+        while not ready.exists() and time.monotonic() < deadline:
+            if process.poll() is not None:
+                self.fail(log.read_text())
+            time.sleep(0.02)
+        self.assertTrue(ready.exists(), log.read_text())
+        self.fixture = f = jsonutils.loads(ready.read_text())
+        self.ctx = context.RequestContext(
+            f['actor_user_id'],
+            f['owner_project_id'],
+            auth_token=f['user_token'],
+        )
+        self.user = MarkerAuth(
+            f['user_token'],
+            f['actor_user_id'],
+            f['owner_project_id'],
+            f['endpoint'] + '/' + f['owner_project_id'],
+        )
+        service = MarkerAuth(
+            f['service_token'],
+            f['executor_service_user_id'],
+            f['service_project_id'],
+            f['endpoint'] + '/' + f['service_project_id'],
+        )
+        self.ctx.get_auth_plugin = lambda: self.user
+        self.recovery = context.get_admin_context()
+        self.operations = {}
+        self.intents = {}
+        self.client = checkpoints.CheckpointClient(
+            session=session.Session(),
+            service_auth_factory=lambda: service,
+            operation_loader=lambda ctx, ident: self.operations[ident],
+            intent_loader=lambda ctx, ident: self.intents[ident],
+        )
+
+    def reserve(self, kind, checkpoint_id):
+        f = self.fixture
+        op = SimpleNamespace(
+            uuid=uuidutils.generate_uuid(),
+            checkpoint_id=checkpoint_id,
+            instance_uuid=f['instance_uuid'],
+            request_id=uuidutils.generate_uuid(),
+            project_id=f['owner_project_id'],
+            actor_user_id=f['actor_user_id'],
+            kind=kind,
+            generation=1,
+            contract_version=2,
+            quota_ready=True,
+            admission={
+                'device_manifest': {
+                    'disks': [
+                        dict(volume_id=ident) for ident in f['volume_ids']
+                    ]
+                }
+            },
+        )
+        self.operations[op.uuid] = op
+        self.intents[op.uuid] = dict(
+            body=checkpoints.reserve_payload(op), status='dispatching'
+        )
+        accepted = self.client.reserve(
+            self.ctx,
+            op.uuid,
+            op.checkpoint_id,
+            op.instance_uuid,
+            kind,
+            tuple(f['volume_ids']),
+        )
+        self.assertEqual('reserved', accepted['status'])
+        return op, accepted
+
+    def wait(self, op, status, child=None):
+        deadline = time.monotonic() + 10
+        while time.monotonic() < deadline:
+            result = (
+                self.client.get_attachment_request(
+                    self.recovery, op.uuid, child
+                )
+                if child
+                else self.client.get(self.recovery, op.uuid)
+            )
+            if result['status'] == status:
+                return result
+            time.sleep(0.02)
+        self.fail('Cinder did not reach %s' % status)
+
+    def test_actual_c11_create_revert_delete_and_scoped_attachments(self):
+        volume_ids = tuple(self.fixture['volume_ids'])
+        capabilities = self.client.preflight_capabilities(
+            self.ctx, volume_ids
+        )
+        self.assertEqual(set(volume_ids), set(capabilities))
+        resources = self.client.preflight_resources(
+            self.ctx, volume_ids, ()
+        )
+        self.assertEqual(set(volume_ids), set(resources['volumes']))
+        op, accepted = self.reserve('create', uuidutils.generate_uuid())
+        for volume_id in volume_ids:
+            self.assertTrue(
+                self.client.capabilities(
+                    self.recovery, op.uuid, volume_id
+                )['supported']
+            )
+        # Loss of the reserve response does not need another user in recovery.
+        self.user.token = 'expired-user-marker'
+        self.ctx.auth_token = 'expired-user-marker'
+        self.assertEqual(accepted, self.client.get(self.recovery, op.uuid))
+        self.assertRaises(
+            exception.CheckpointConflict,
+            self.client.reserve,
+            self.ctx,
+            op.uuid,
+            op.checkpoint_id,
+            op.instance_uuid,
+            op.kind,
+            volume_ids,
+        )
+        self.client.action(self.recovery, op.uuid, 'execute', 1)
+        self.wait(op, 'succeeded')
+        self.client.action(self.recovery, op.uuid, 'release', 1, 'commit')
+        self.user.token = self.fixture['user_token']
+        self.ctx.auth_token = self.fixture['user_token']
+        snapshots = tuple(r['snapshot_id'] for r in accepted['resources'])
+        self.client.preflight_resources(self.ctx, volume_ids, snapshots)
+        revert, accepted = self.reserve('revert', op.checkpoint_id)
+
+        def attachment(action, volume, ident=None):
+            request = dict(
+                id=uuidutils.generate_uuid(),
+                generation=1,
+                volume_id=volume,
+                action=action,
+                attachment_id=ident,
+                connector=(
+                    {'host': 'compute-one', 'ip': '192.0.2.10'}
+                    if action == 'update'
+                    else None
+                ),
+                mountpoint='/dev/vda' if action == 'update' else None,
+            )
+            self.client.submit_attachment(
+                self.recovery, revert.uuid, request
+            )
+            result = self.wait(revert, 'succeeded', child=request['id'])
+            replay = self.client.submit_attachment(
+                self.recovery, revert.uuid, request
+            )
+            self.assertEqual(result, replay)
+            return result['attachment_id']
+
+        for volume in volume_ids:
+            original = resources['volumes'][volume]['attachments'][0][
+                'attachment_id'
+            ]
+            attachment('delete', volume, original)
+        self.client.action(self.recovery, revert.uuid, 'execute', 1)
+        self.wait(revert, 'succeeded')
+        for volume in volume_ids:
+            ident = attachment('create', volume)
+            attachment('update', volume, ident)
+            detail = self.client.get_attachment(
+                self.recovery, revert.uuid, ident
+            )
+            self.assertEqual(volume, detail['volume_id'])
+            self.assertIsInstance(detail['connection_info'], dict)
+            attachment('complete', volume, ident)
+        self.client.action(
+            self.recovery, revert.uuid, 'release', 1, 'commit'
+        )
+        delete, unused = self.reserve('delete', op.checkpoint_id)
+        self.client.action(self.recovery, delete.uuid, 'execute', 1)
+        self.wait(delete, 'succeeded')
+        self.client.action(
+            self.recovery, delete.uuid, 'release', 1, 'commit'
+        )
+        self.assertEqual(
+            'released',
+            self.client.get(self.recovery, delete.uuid)['status'],
+        )
