+
+
+class MarkerAuth(plugin.BaseAuthPlugin):
+    def __init__(self, token, user, project, endpoint):
+        self.token, self.user, self.project = token, user, project
+        self.endpoint = endpoint
+
+    def get_headers(self, session, **kwargs):
+        return {'X-Auth-Token': self.token}
+
+    def get_token(self, session):
+        return self.token
+
+    def get_user_id(self, session):
+        return self.user
+
+    def get_project_id(self, session):
+        return self.project
+
+    def get_endpoint(self, session, **kwargs):
+        return self.endpoint
+
+
+def operation():
+    return SimpleNamespace(
+        uuid=uuids.operation,
+        checkpoint_id=uuids.checkpoint,
+        instance_uuid=uuids.instance,
+        request_id=uuids.request,
+        project_id='owner-project',
+        actor_user_id='actor',
+        kind='create',
+        generation=1,
+        contract_version=2,
+        quota_ready=True,
+        admission={
+            'device_manifest': {'disks': [{'volume_id': uuids.volume}]}
+        },
+    )
+
+
+def reserve_body(op):
+    return dict(
+        request_id=op.request_id,
+        checkpoint_id=op.checkpoint_id,
+        instance_uuid=op.instance_uuid,
+        kind=op.kind,
+        volume_ids=[
+            d['volume_id']
+            for d in op.admission['device_manifest']['disks']
+        ],
+        nova_operation_id=op.uuid,
+        allow_service_continuation=True,
+    )
+
+
+def response(op, service='nova-service'):
+    return dict(
+        id=uuids.cinder,
+        request_id=op.request_id,
+        checkpoint_id=op.checkpoint_id,
+        instance_uuid=op.instance_uuid,
+        kind=op.kind,
+        generation=1,
+        status='reserved',
+        release_outcome=None,
+        error_code=None,
+        resources=[
+            dict(
+                id=uuids.resource,
+                volume_id=uuids.volume,
+                snapshot_id=uuids.snapshot,
+                volume_size=1,
+                status='creating',
+            )
+        ],
+        steps=[
+            dict(
+                id=uuids.step,
+                resource_id=uuids.resource,
+                phase='snapshot',
+                generation=1,
+                status='prepared',
+                error_code=None,
+            )
+        ],
+        continuation=dict(
+            version=1,
+            nova_operation_id=op.uuid,
+            owner_project_id=op.project_id,
+            actor_user_id=op.actor_user_id,
+            executor_service_user_id=service,
+            generation=1,
+        ),
+    )
+
+
+class CheckpointClientTest(test.NoDBTestCase):
+    def setUp(self):
+        super().setUp()
+        self.http = self.useFixture(requests_fixture.Fixture())
+        self.endpoint = 'http://cinder.test/v3/service-project'
+        self.service = MarkerAuth(
+            'service-marker',
+            'nova-service',
+            'service-project',
+            self.endpoint,
+        )
+        self.user = MarkerAuth(
+            'user-marker',
+            'actor',
+            'owner-project',
+            'http://cinder.test/v3/owner-project',
+        )
+        self.ctx = context.RequestContext(
+            'actor', 'owner-project', auth_token='user-marker'
+        )
+        self.ctx.get_auth_plugin = lambda: self.user
+        self.recovery = context.get_admin_context()
+        self.op = operation()
+        self.intent = dict(
+            body=reserve_body(self.op), status='dispatching'
+        )
+        self.session = session.Session()
+        self.client = checkpoints.CheckpointClient(
+            session=self.session,
+            service_auth_factory=lambda: self.service,
+            operation_loader=lambda ctx, ident: self.op,
+            intent_loader=lambda ctx, ident: self.intent,
+        )
+        self.url = (
+            'http://cinder.test/v3/checkpoint-service-operations/' +
+            self.op.uuid
+        )
+        self.reply = response(self.op)
+        self.respond(
+            'GET', self.url, json={'checkpoint_operation': self.reply}
+        )
+
+    def respond(self, *args, **kwargs):
+        kwargs.setdefault(
+            'headers', {'OpenStack-API-Version': 'volume 3.73'}
+        )
+        return self.http.register_uri(*args, **kwargs)
+
+    def test_background_uses_only_fresh_service_identity(self):
+        self.user.token = 'expired-user-marker'
+        result = self.client.get(self.recovery, self.op.uuid)
+        self.assertEqual(
+            self.op.uuid, result['continuation']['nova_operation_id']
+        )
+        request = self.http.last_request
+        self.assertEqual('service-marker', request.headers['X-Auth-Token'])
+        self.assertNotIn('X-Service-Token', request.headers)
+        self.assertNotIn('expired-user-marker', request.headers.values())
+        self.assertEqual(
+            'volume 3.73', request.headers['OpenStack-API-Version']
+        )
+
+    def test_missing_grant_does_not_fall_back_to_reserve(self):
+        self.respond('GET', self.url, status_code=404, json={})
+        self.assertRaises(
+            exception.CheckpointConflict,
+            self.client.get,
+            self.recovery,
+            self.op.uuid,
+        )
+        self.assertEqual(
+            ['GET'], [r.method for r in self.http.request_history]
+        )
+
+    def test_unknown_field_and_binding_mismatch_rejected(self):
+        for change in (
+            {'unexpected': True},
+            {'checkpoint_id': uuids.foreign},
+            {'generation': 2},
+        ):
+            invalid = dict(self.reply, **change)
+            self.respond(
+                'GET', self.url, json={'checkpoint_operation': invalid}
+            )
+            self.assertRaises(
+                exception.CheckpointConflict,
+                self.client.get,
+                self.recovery,
+                self.op.uuid,
+            )
+
+    def test_wrong_resource_set_rejected(self):
+        invalid = copy.deepcopy(self.reply)
+        invalid['resources'][0]['volume_id'] = uuids.foreign
+        self.respond(
+            'GET', self.url, json={'checkpoint_operation': invalid}
+        )
+        self.assertRaises(
+            exception.CheckpointConflict,
+            self.client.get,
+            self.recovery,
+            self.op.uuid,
+        )
+
+    def test_reserve_exact_stored_body_dual_auth_and_202(self):
+        url = 'http://cinder.test/v3/checkpoint-operations'
+        self.respond(
+            'POST',
+            url,
+            status_code=202,
+            json={'checkpoint_operation': self.reply},
+        )
+        result = self.client.reserve(
+            self.ctx,
+            self.op.uuid,
+            self.op.checkpoint_id,
+            self.op.instance_uuid,
+            'create',
+            (uuids.volume,),
+        )
+        self.assertEqual('reserved', result['status'])
+        self.assertEqual(
+            {'checkpoint_operation': self.intent['body']},
+            self.http.last_request.json(),
+        )
+        self.assertEqual(
+            'user-marker', self.http.last_request.headers['X-Auth-Token']
+        )
+        self.assertEqual(
+            'service-marker',
+            self.http.last_request.headers['X-Service-Token'],
+        )
+
+    def test_reserve_without_user_or_for_foreign_actor_is_denied(self):
+        for ctx in (
+            self.recovery,
+            context.RequestContext(
+                'another', 'owner-project', auth_token='user-marker'
+            ),
+        ):
+            self.assertRaises(
+                exception.CheckpointConflict,
+                self.client.reserve,
+                ctx,
+                self.op.uuid,
+                self.op.checkpoint_id,
+                self.op.instance_uuid,
+                'create',
+                (uuids.volume,),
+            )
+        self.assertEqual([], self.http.request_history)
+
+    def test_modified_stored_payload_is_not_replayed(self):
+        self.intent['body']['request_id'] = uuids.foreign
+        self.assertRaises(
+            exception.CheckpointConflict,
+            self.client.reserve,
+            self.ctx,
+            self.op.uuid,
+            self.op.checkpoint_id,
+            self.op.instance_uuid,
+            'create',
+            (uuids.volume,),
+        )
+        self.assertEqual([], self.http.request_history)
+
+    def test_no_logging_or_automatic_post_retry(self):
+        self.respond(
+            'POST',
+            self.url + '/action',
+            status_code=503,
+            json={'error': {'message': 'sensitive'}},
+        )
+        with mock.patch.object(
+            self.session, 'request', wraps=self.session.request
+        ) as request:
+            self.assertRaises(
+                exception.CheckpointUnavailable,
+                self.client.action,
+                self.recovery,
+                self.op.uuid,
+                'execute',
+                1,
+            )
+        self.assertFalse(request.call_args.kwargs['log'])
+        self.assertFalse(request.call_args.kwargs['allow_reauth'])
+        self.assertEqual(0, request.call_args.kwargs['connect_retries'])
+        self.assertEqual(1, len(self.http.request_history))
+
+    def test_372_response_cannot_be_used_as_continuation(self):
+        invalid = dict(self.reply)
+        invalid.pop('continuation')
+        self.respond(
+            'GET', self.url, json={'checkpoint_operation': invalid}
+        )
+        self.assertRaises(
+            exception.CheckpointConflict,
+            self.client.get,
+            self.recovery,
+            self.op.uuid,
+        )
+
+    def test_foreign_service_in_reply_is_rejected(self):
+        invalid = response(self.op, service='foreign-service')
+        self.respond(
+            'GET', self.url, json={'checkpoint_operation': invalid}
+        )
+        self.assertRaises(
+            exception.CheckpointConflict,
+            self.client.get,
+            self.recovery,
+            self.op.uuid,
+        )
+
+    def test_old_microversion_header_rejected(self):
+        self.respond(
+            'GET',
+            self.url,
+            headers={'OpenStack-API-Version': 'volume 3.72'},
+            json={'checkpoint_operation': self.reply},
+        )
+        self.assertRaises(
+            exception.CheckpointConflict,
+            self.client.get,
+            self.recovery,
+            self.op.uuid,
+        )
+
+    def test_foreign_cinder_operation_attachment_reply_rejected(self):
+        self.op.kind = 'revert'
+        reply = response(self.op)
+        self.respond('GET', self.url, json={'checkpoint_operation': reply})
+        value = dict(
+            id=uuids.child,
+            operation_id=uuids.foreign,
+            generation=1,
+            volume_id=uuids.volume,
+            action='create',
+            status='succeeded',
+            attachment_id=uuids.attachment,
+            error_code=None,
+        )
