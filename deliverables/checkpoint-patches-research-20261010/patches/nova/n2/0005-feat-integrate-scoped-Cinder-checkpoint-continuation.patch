+# WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+# License for the specific language governing permissions and limitations
+# under the License.
+
+"""Private Cinder 3.73 client, bound to durable Nova operation identities.
+
+Only reserve/preflight uses a live user credential. Continuation obtains its
+own service authentication and addresses the delegated operation UUID. No
+response URL, serialized context, bearer, or connection secret is persisted.
+"""
+
+import functools
+import re
+from urllib import parse
+
+from keystoneauth1 import exceptions as ks_exc
+from keystoneauth1 import loading
+from keystoneauth1 import service_token
+import requests
+
+from nova.checkpoints import contracts as c
+from nova.checkpoints import contracts_v2 as v2
+from nova import conf
+from nova import exception
+from nova import objects
+from nova.volume import cinder
+
+CAPABILITIES = (
+    'native_snapshot',
+    'arbitrary_inplace_revert',
+    'preserves_other_checkpoints',
+    'independent_snapshot_delete',
+    'operation_reconciliation',
+)
+OP_STATES = (
+    'reserved',
+    'running',
+    'succeeded',
+    'failed',
+    'recovery_required',
+    'released',
+)
+STEP_STATES = (
+    'prepared',
+    'dispatching',
+    'pending',
+    'succeeded',
+    'failed_no_effect',
+    'unknown',
+)
+
+
+def checked(method):
+    @functools.wraps(method)
+    def wrapped(*args, **kwargs):
+        try:
+            return method(*args, **kwargs)
+        except (
+            ValueError,
+            KeyError,
+            TypeError,
+            AttributeError,
+            StopIteration,
+        ):
+            raise exception.CheckpointConflict(
+                reason='identity_changed'
+            ) from None
+        except (ks_exc.ClientException, requests.RequestException):
+            raise exception.CheckpointUnavailable() from None
+
+    return wrapped
+
+
+def _service_auth():
+    c._require(conf.CONF.service_user.send_service_user_token)
+    auth = loading.load_auth_from_conf_options(conf.CONF, 'service_user')
+    c._require(auth is not None)
+    return auth
+
+
+def reserve_payload(operation):
+    """Exact C1.1 request body; the parent journal persists it before HTTP."""
+    return v2.cinder_reserve_payload(operation)
+
+
+def reserve_intent(context, operation_id):
+    steps = objects.InstanceCheckpointStepList.get_by_operation(
+        context, operation_id
+    )
+    parent = next(s for s in steps if s.phase == 'cinder_reserve')
+    children = objects.CheckpointEffect.get_children(context, parent.uuid)
+    c._require(
+        len(children) == 1 and
+        children[0]['action'] == 'reserve' and
+        children[0]['operation_id'] == operation_id and
+        parent.contract_version == 2 and
+        parent.generation == 1 and
+        parent.payload_hash == c.canonical_payload_hash(parent.payload)
+    )
+    result = children[0]['result']
+    accepted_id = (
+        result['evidence']['operation_id']
+        if result and result['status'] == 'succeeded'
+        else None
+    )
+    return dict(
+        body=parent.payload['resources']['cinder_reserve'],
+        status=children[0]['status'],
+        cinder_operation_id=accepted_id,
+    )
+
+
+def _error(value):
+    c._require(
+        value is None or
+        type(value) is str and
+        re.fullmatch('[a-z][a-z0-9_]{0,63}', value) is not None
+    )
+
+
+def validate_capabilities(value):
+    c._keys(
+        value,
+        set(CAPABILITIES) |
+        {
+            'contract_version',
+            'supported',
+            'snapshot_semantics',
+            'consistent_group_snapshot',
+            'driver_identity',
+            'unsupported_reasons',
+        },
+    )
+    c._integer(value['contract_version'], minimum=1, maximum=1)
+    c._require(
+        value['supported'] is True and
+        all(value[k] is True for k in CAPABILITIES) and
+        value['snapshot_semantics'] in ('cow', 'row') and
+        type(value['consistent_group_snapshot']) is bool and
+        value['unsupported_reasons'] == []
+    )
+    identity = value['driver_identity']
+    c._keys(identity, ('driver_class', 'driver_version', 'profile'))
+    for field in identity.values():
+        c._string(field)
+    return value
+
+
+class CheckpointClient:
+    def __init__(
+        self,
+        session=None,
+        service_auth_factory=None,
+        operation_loader=None,
+        intent_loader=None,
+    ):
+        if session is None:
+            cinder._load_session()
+            session = cinder._SESSION
+        self.session = session
+        self.service_auth_factory = service_auth_factory or _service_auth
+        self.operation_loader = (
+            operation_loader or
+            objects.InstanceCheckpointOperation.get_by_uuid
+        )
+        self.intent_loader = intent_loader or reserve_intent
+
+    def _operation(self, context, operation_id):
+        c._uuid(operation_id)
+        op = self.operation_loader(context, operation_id)
+        c._require(
+            op.uuid == operation_id and
+            op.contract_version == 2 and
+            op.generation == 1
+        )
+        return op
+
+    def _auth(self, context, user=False):
+        service = self.service_auth_factory()
+        ident = service.get_user_id(self.session)
+        c._string(ident)
+        if user:
+            c._require(
+                bool(context.auth_token) and
+                bool(context.user_id) and
+                bool(context.project_id)
+            )
+            auth = service_token.ServiceTokenAuthWrapper(
+                user_auth=context.get_auth_plugin(), service_auth=service
+            )
+        else:
+            auth = service
+        return auth, ident
+
+    def _endpoint(self, auth):
+        service_type, name, interface = (
+            conf.CONF.cinder.catalog_info.split(':')
+        )
+        filters = dict(
+            service_type=service_type,
+            interface=interface,
+            region_name=conf.CONF.cinder.os_region_name,
+        )
+        if name:
+            filters['service_name'] = name
+        template = conf.CONF.cinder.endpoint_template
+        if template:
+            # Substitute only the authenticated principal's project, never
+            # impersonate the original owner with a fabricated context.
+            project = auth.get_project_id(self.session)
+            c._string(project)
+            endpoint = template % {
+                'project_id': project,
+                'tenant_id': project,
+            }
+        else:
+            endpoint = self.session.get_endpoint(auth=auth, **filters)
+        c._require(type(endpoint) is str)
+        url = parse.urlsplit(endpoint)
+        c._require(
+            url.scheme in ('https', 'http') and
+            bool(url.netloc) and
+            not url.username and
+            not url.password and
+            not url.query and
+            not url.fragment
+        )
+        # Cinder exposes both unscoped and legacy project-prefixed routes.
+        # Use its unscoped v3 route even with a service-project catalog URL.
+        match = re.fullmatch(r'(.*?/v3)(?:/[^/]+)?/?', url.path)
+        c._require(match is not None)
+        return parse.urlunsplit((url.scheme, url.netloc, match[1], '', ''))
+
+    def _fetch(self, context, method, path, field, body=None, user=False):
+        auth, identity = self._auth(context, user=user)
+        response = self.session.request(
+            self._endpoint(auth) + path,
+            method,
+            json=body,
+            auth=auth,
+            headers={'OpenStack-API-Version': 'volume 3.73'},
+            raise_exc=False,
+            redirect=False,
+            log=False,
+            allow_reauth=method == 'GET' and not user,
+            connect_retries=0,
+            status_code_retries=0,
+            timeout=self.session.timeout or 60,
+        )
+        if response.status_code in (401, 403, 404, 409):
+            raise exception.CheckpointConflict(reason='recovery_required')
+        if response.status_code == 406:
+            raise exception.CheckpointNotSupported(
+                reason='incompatible_service'
+            )
+        if response.status_code != (200 if method == 'GET' else 202):
+            raise exception.CheckpointUnavailable()
+        c._require(
+            response.headers.get('OpenStack-API-Version') == 'volume 3.73'
+        )
+        c._require(len(response.content) <= 2 * 1024 * 1024)
+        value = response.json()
+        c._keys(value, (field,))
+        c._require(type(value[field]) is dict)
+        return value[field], identity
+
+    def _validate_operation(self, context, value, operation, identity):
+        c._keys(
+            value,
+            (
+                'id',
+                'request_id',
+                'checkpoint_id',
+                'instance_uuid',
+                'kind',
+                'generation',
+                'status',
+                'release_outcome',
+                'error_code',
+                'resources',
+                'steps',
+                'continuation',
+            ),
+        )
+        c._uuid(value['id'])
+        accepted = self.intent_loader(context, operation.uuid).get(
+            'cinder_operation_id'
+        )
+        c._require(accepted is None or value['id'] == accepted)
+        for field in (
+            'request_id',
+            'checkpoint_id',
+            'instance_uuid',
+            'kind',
+        ):
+            c._require(value[field] == getattr(operation, field))
+        c._integer(value['generation'], minimum=1, maximum=1)
+        c._require(
+            value['status'] in OP_STATES and
+            value['release_outcome'] in (None, 'commit', 'abort')
+        )
+        _error(value['error_code'])
+        scope = value['continuation']
+        c._keys(
+            scope,
+            (
+                'version',
+                'nova_operation_id',
+                'owner_project_id',
+                'actor_user_id',
+                'executor_service_user_id',
+                'generation',
+            ),
+        )
+        c._integer(scope['version'], minimum=1, maximum=1)
+        c._integer(scope['generation'], minimum=1, maximum=1)
+        c._require(
+            scope['nova_operation_id'] == operation.uuid and
+            scope['owner_project_id'] == operation.project_id and
+            scope['actor_user_id'] == operation.actor_user_id and
+            scope['executor_service_user_id'] == identity
+        )
+        c._require(
+            type(value['resources']) is list and
+            type(value['steps']) is list
+        )
+        volumes, resources, snapshots = [], [], []
+        for row in value['resources']:
+            c._keys(
+                row,
+                (
+                    'id',
+                    'volume_id',
+                    'snapshot_id',
+                    'volume_size',
+                    'status',
+                ),
+            )
+            for field in ('id', 'volume_id', 'snapshot_id'):
+                c._uuid(row[field])
+            c._integer(row['volume_size'], minimum=1)
+            c._require(
+                row['status'] in ('creating', 'available', 'deleted')
+            )
+            volumes.append(row['volume_id'])
+            resources.append(row['id'])
+            snapshots.append(row['snapshot_id'])
+        expected = reserve_payload(operation)['volume_ids']
+        c._require(
+            sorted(volumes) == expected and
+            len(set(resources)) == len(resources) and
+            len(set(snapshots)) == len(snapshots)
+        )
+        steps = []
+        covered = set()
+        for row in value['steps']:
+            c._keys(
+                row,
+                (
+                    'id',
+                    'resource_id',
+                    'phase',
+                    'generation',
+                    'status',
+                    'error_code',
+                ),
+            )
+            c._uuid(row['id'])
+            c._require(
+                row['resource_id'] in resources and
+                row['phase']
+                in ('snapshot', 'revert', 'delete_snapshot') and
+                row['status'] in STEP_STATES
+            )
+            c._integer(row['generation'], minimum=1, maximum=1)
+            _error(row['error_code'])
+            steps.append(row['id'])
+            covered.add(row['resource_id'])
+        c._require(
+            len(set(steps)) == len(steps) and covered == set(resources)
+        )
+        return value
+
+    @checked
+    def reserve(
+        self,
+        context,
+        nova_operation_id,
+        checkpoint_id,
+        instance_uuid,
+        kind,
+        volume_ids,
+    ):
+        op = self._operation(context, nova_operation_id)
+        c._require(
+            context.user_id == op.actor_user_id and
+            context.project_id == op.project_id and
+            bool(context.auth_token) and
+            op.quota_ready and
+            (checkpoint_id, instance_uuid, kind) ==
+            (op.checkpoint_id, op.instance_uuid, op.kind)
+        )
+        expected = reserve_payload(op)
+        c._ids(volume_ids, nonempty=True)
+        c._require(sorted(volume_ids) == expected['volume_ids'])
+        stored = self.intent_loader(context, op.uuid)
+        c._require(
+            stored['body'] == expected and
+            stored['status'] in ('dispatching', 'pending', 'unknown')
+        )
+        value, identity = self._fetch(
+            context,
+            'POST',
+            '/checkpoint-operations',
+            'checkpoint_operation',
+            {'checkpoint_operation': stored['body']},
+            user=True,
+        )
+        return self._validate_operation(context, value, op, identity)
+
+    @checked
+    def get(self, context, nova_operation_id):
+        op = self._operation(context, nova_operation_id)
+        value, identity = self._fetch(
+            context,
+            'GET',
+            '/checkpoint-service-operations/' + op.uuid,
+            'checkpoint_operation',
+        )
+        return self._validate_operation(context, value, op, identity)
+
+    @checked
+    def action(
+        self, context, nova_operation_id, name, generation, outcome=None
+    ):
+        op = self._operation(context, nova_operation_id)
+        c._integer(generation, minimum=1, maximum=1)
+        c._require(name in ('execute', 'reconcile', 'cleanup', 'release'))
+        args = dict(generation=generation)
+        if name == 'release':
+            c._require(outcome in ('commit', 'abort'))
+            args['outcome'] = outcome
+        else:
+            c._require(outcome is None)
+        value, identity = self._fetch(
+            context,
+            'POST',
+            '/checkpoint-service-operations/' + op.uuid + '/action',
+            'checkpoint_operation',
+            {name: args},
+        )
+        return self._validate_operation(context, value, op, identity)
+
+    @checked
+    def capabilities(self, context, nova_operation_id, volume_id):
+        op = self._operation(context, nova_operation_id)
+        c._uuid(volume_id)
+        c._require(volume_id in reserve_payload(op)['volume_ids'])
+        value, unused = self._fetch(
+            context,
+            'GET',
+            '/checkpoint-service-operations/' +
+            op.uuid +
+            '/volumes/' +
+            volume_id +
+            '/capabilities',
+            'checkpoint_capabilities',
+        )
+        return validate_capabilities(value)
+
+    @checked
+    def preflight_capabilities(self, context, volume_ids):
+        c._ids(volume_ids, nonempty=True)
+        result = {}
+        for ident in volume_ids:
+            value, unused = self._fetch(
+                context,
+                'GET',
+                '/volumes/' + ident + '/checkpoint-capabilities',
+                'checkpoint_capabilities',
+                user=True,
+            )
+            result[ident] = validate_capabilities(value)
+        return result
+
+    @checked
+    def preflight_resources(self, context, volume_ids, snapshot_ids):
+        c._ids(volume_ids, nonempty=True)
+        c._ids(snapshot_ids)
+        result = {'volumes': {}, 'snapshots': {}}
+        for kind, ids in (
+            ('volume', volume_ids),
+            ('snapshot', snapshot_ids),
+        ):
+            for ident in ids:
+                value, unused = self._fetch(
+                    context,
+                    'GET',
+                    '/' + kind + 's/' + ident,
+                    kind,
+                    user=True,
+                )
+                c._require(value['id'] == ident)
+                if kind == 'volume':
+                    keys = (
+                        'id',
+                        'status',
+                        'size',
+                        'attachments',
+                        'encrypted',
+                        'multiattach',
+                    )
+                else:
+                    c._require(value['volume_id'] in volume_ids)
+                    keys = ('id', 'volume_id', 'status', 'size')
+                result[kind + 's'][ident] = {k: value[k] for k in keys}
+        return result
+
+    @staticmethod
+    def _attachment(
+        value, op, child_id, cinder_operation_id, request=None
+    ):
+        c._keys(
+            value,
+            (
+                'id',
+                'operation_id',
+                'generation',
+                'volume_id',
+                'action',
+                'status',
+                'attachment_id',
+                'error_code',
+            ),
+        )
+        c._require(value['operation_id'] == cinder_operation_id)
+        c._require(
+            value['id'] == child_id and
+            value['volume_id'] in reserve_payload(op)['volume_ids'] and
+            value['action']
+            in ('create', 'update', 'complete', 'delete') and
+            value['status'] in STEP_STATES
+        )
+        c._integer(value['generation'], minimum=1, maximum=1)
+        if (
+            value['attachment_id'] is not None or
+            value['status'] == 'succeeded'
+        ):
+            c._uuid(value['attachment_id'])
+        _error(value['error_code'])
+        if request:
+            c._require(
+                value['action'] == request['action'] and
+                value['volume_id'] == request['volume_id']
+            )
+            if request['action'] != 'create':
+                c._require(
+                    value['attachment_id'] == request['attachment_id']
+                )
+        return value
+
+    @checked
+    def submit_attachment(self, context, nova_operation_id, request):
+        op = self._operation(context, nova_operation_id)
+        c._keys(
+            request,
+            (
+                'id',
+                'generation',
+                'volume_id',
+                'action',
+                'attachment_id',
+                'connector',
+                'mountpoint',
+            ),
+        )
+        c._uuid(request['id'])
+        c._integer(request['generation'], minimum=1, maximum=1)
+        c._require(
+            op.kind == 'revert' and
+            request['volume_id'] in reserve_payload(op)['volume_ids']
+        )
+        c._require(
+            request['action'] in ('create', 'update', 'complete', 'delete')
+        )
+        if request['action'] == 'create':
+            c._require(
+                all(
+                    request[k] is None
+                    for k in ('attachment_id', 'connector', 'mountpoint')
+                )
+            )
+        else:
+            c._uuid(request['attachment_id'])
+            if request['action'] == 'update':
+                c._require(type(request['connector']) is dict)
+            else:
+                c._require(
+                    request['connector'] is None and
+                    request['mountpoint'] is None
+                )
+        grant = self.get(context, nova_operation_id)
+        value, unused = self._fetch(
+            context,
+            'POST',
+            '/checkpoint-service-operations/' +
+            op.uuid +
+            '/attachment-requests',
+            'attachment_request',
+            {'attachment_request': request},
+        )
+        return self._attachment(
+            value, op, request['id'], grant['id'], request
+        )
+
+    @checked
+    def get_attachment_request(self, context, nova_operation_id, child_id):
+        op = self._operation(context, nova_operation_id)
+        c._uuid(child_id)
+        grant = self.get(context, nova_operation_id)
+        value, unused = self._fetch(
+            context,
+            'GET',
+            '/checkpoint-service-operations/' +
+            op.uuid +
+            '/attachment-requests/' +
+            child_id,
+            'attachment_request',
+        )
+        return self._attachment(value, op, child_id, grant['id'])
+
+    @checked
+    def get_attachment(self, context, nova_operation_id, attachment_id):
+        op = self._operation(context, nova_operation_id)
+        c._uuid(attachment_id)
+        value, unused = self._fetch(
+            context,
+            'GET',
+            '/checkpoint-service-operations/' +
+            op.uuid +
+            '/attachments/' +
+            attachment_id,
+            'attachment',
+        )
+        c._keys(
+            value,
+            (
+                'id',
+                'volume_id',
+                'instance',
+                'status',
+                'attach_mode',
+                'attached_at',
+                'detached_at',
+                'connection_info',
+            ),
+        )
+        c._require(
+            value['id'] == attachment_id and
+            value['instance'] == op.instance_uuid and
+            value['volume_id'] in reserve_payload(op)['volume_ids'] and
+            (
+                value['connection_info'] is None or
+                type(value['connection_info']) is dict
+            )
+        )
+        return value
