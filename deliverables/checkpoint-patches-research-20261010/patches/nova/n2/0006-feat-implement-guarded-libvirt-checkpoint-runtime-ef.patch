+"""Closed BIOS/KVM topology, current service-authorized ports and profiles."""
+
+import copy
+import hashlib
+import os
+from pathlib import Path
+from urllib import parse
+
+from lxml import etree
+
+from nova.checkpoints import contracts as c
+from nova import conf
+from nova.network import neutron
+from nova import objects
+from nova.virt.libvirt.checkpoints import files
+from nova.virt.libvirt.checkpoints import profiles
+from nova.volume import checkpoints as cinder
+
+MARKER_NS = 'urn:openstack:nova:checkpoint:2'
+NOVA_NS = 'http://openstack.org/xmlns/libvirt/nova/1.0'
+DEVICE_TAGS = frozenset(
+    (
+        'emulator',
+        'disk',
+        'interface',
+        'controller',
+        'serial',
+        'console',
+        'channel',
+        'input',
+        'graphics',
+        'video',
+        'memballoon',
+        'rng',
+        'watchdog',
+        'audio',
+        'panic',
+    )
+)
+ROOT_TAGS = frozenset(
+    (
+        'name',
+        'uuid',
+        'metadata',
+        'memory',
+        'currentMemory',
+        'maxMemory',
+        'memoryBacking',
+        'vcpu',
+        'vcpus',
+        'cputune',
+        'numatune',
+        'resource',
+        'sysinfo',
+        'os',
+        'features',
+        'cpu',
+        'clock',
+        'on_poweroff',
+        'on_reboot',
+        'on_crash',
+        'devices',
+        'seclabel',
+    )
+)
+
+
+def document(xml):
+    c._require(type(xml) is str and len(xml.encode()) <= 1024 * 1024)
+    root = etree.fromstring(
+        xml.encode(),
+        etree.XMLParser(
+            resolve_entities=False,
+            no_network=True,
+            load_dtd=False,
+            remove_blank_text=True,
+        ),
+    )
+    c._require(
+        root.tag == 'domain' and
+        root.getroottree().docinfo.doctype == '' and
+        all(type(e.tag) is str for e in root.iter())
+    )
+    return root
+
+
+def serialized(node):
+    return etree.tostring(node, method='c14n', with_comments=False)
+
+
+def host_fields(root):
+    """The only XML fields which restoration may substitute."""
+    for disk in root.findall('./devices/disk'):
+        for name in ('source', 'auth'):
+            yield disk, name
+    for interface in root.findall('./devices/interface'):
+        for name in (
+            'source',
+            'target',
+            'virtualport',
+            'filterref',
+            'bandwidth',
+        ):
+            yield interface, name
+    for graphics in root.findall('./devices/graphics'):
+        yield graphics, 'listen'
+    yield root, 'seclabel'
+
+
+def guest_identity(xml):
+    root = document(xml)
+    root.attrib.pop('id', None)
+    for parent, name in host_fields(root):
+        for element in parent.findall(name):
+            parent.remove(element)
+    for graphics in root.findall('./devices/graphics'):
+        for attr in ('port', 'tlsPort', 'websocket', 'listen'):
+            graphics.attrib.pop(attr, None)
+    for metadata in root.findall('metadata'):
+        root.remove(metadata)
+    # Libvirt adds generated aliases to a live XML. Addresses, serials, CPU,
+    # memory and controller attributes remain part of the guest identity.
+    for alias in root.findall('./devices/*/alias'):
+        alias.getparent().remove(alias)
+    return hashlib.sha256(serialized(root)).hexdigest()
+
+
+def marker_xml(binding, child):
+    node = etree.Element(
+        '{%s}checkpoint' % MARKER_NS, nsmap={'checkpoint': MARKER_NS}
+    )
+    for key, value in dict(
+        operation_id=child.operation_id,
+        checkpoint_id=binding.checkpoint_id,
+        instance_uuid=binding.instance_uuid,
+        child_id=child.id,
+        action=child.action,
+        runtime_fingerprint=binding.runtime_fingerprint,
+        payload_hash=child.payload_hash,
+    ).items():
+        node.set(key, value)
+    return etree.tostring(node, encoding='unicode')
+
+
+def with_marker(xml, binding, child):
+    root = document(xml)
+    metadata = root.find('metadata')
+    if metadata is None:
+        metadata = etree.SubElement(root, 'metadata')
+    for old in metadata.findall('{%s}checkpoint' % MARKER_NS):
+        metadata.remove(old)
+    metadata.append(etree.fromstring(marker_xml(binding, child).encode()))
+    return etree.tostring(root, encoding='unicode')
+
+
+def matching_marker(xml, binding, child):
+    root = document(xml)
+    items = root.findall('./metadata/{%s}checkpoint' % MARKER_NS)
+    expected = etree.fromstring(marker_xml(binding, child).encode())
+    return len(items) == 1 and dict(items[0].attrib) == dict(
+        expected.attrib
+    )
+
+
+def _bytes(node):
+    c._require(node is not None)
+    unit = node.get('unit', 'KiB').lower()
+    factors = {
+        'b': 1,
+        'bytes': 1,
+        'kib': 1024,
+        'mib': 1024**2,
+        'gib': 1024**3,
+        'k': 1000,
+        'm': 1000**2,
+        'g': 1000**3,
+    }
+    c._require(unit in factors and node.text.isdecimal())
+    return int(node.text) * factors[unit]
+
+
+def _read_config(path):
+    """Read the original config drive without following links."""
+    parts = Path(path).parts
+    c._require(os.path.isabs(path) and '..' not in parts)
+    fd = os.open('/', files.OPEN_DIR)
+    try:
+        for part in parts[1:-1]:
+            next_fd = os.open(part, files.OPEN_DIR, dir_fd=fd)
+            os.close(fd)
+            fd = next_fd
+        source = os.open(
+            parts[-1], os.O_RDONLY | files.OPEN_FILE, dir_fd=fd
+        )
+        try:
+            observed = files.fingerprint(source, 0)
+            return observed['checksum'], observed['bytes']
+        finally:
+            os.close(source)
+    finally:
+        os.close(fd)
+
+
+class Topology:
+    def __init__(
+        self,
+        host,
+        profileset=None,
+        observer=None,
+        neutron_factory=None,
+        volume_reader=None,
+        source_reader=None,
+        key_reader=None,
+        interface_reader=None,
+    ):
+        self.host = host
+        self.profileset = profileset
+        self.observer = observer or self._observe
+        self.neutron_factory = neutron_factory or (
+            lambda ctx: neutron.get_client(ctx, admin=True)
+        )
+        self.volume_reader = volume_reader or self._volumes
+        self.source_reader = source_reader
+        self.key_reader = key_reader or self._key
+        self.interface_reader = interface_reader
+
+    def _observe(self, guest, xml):
+        conn = self.host.get_connection()
+        uri = conn.getURI()
+        parsed = parse.urlsplit(uri)
+        c._require(
+            parsed.scheme in ('qemu', 'qemu+unix') and
+            not parsed.netloc and
+            parsed.path == '/system'
+        )
+        root = document(xml)
+        cpu = etree.fromstring(conn.getCapabilities().encode()).find(
+            'host/cpu'
+        )
+        c._require(
+            cpu is not None and os.access('/dev/kvm', os.R_OK | os.W_OK)
+        )
+        return dict(
+            kind='runtime',
+            libvirt_version=conn.getLibVersion(),
+            qemu_version=conn.getVersion(),
+            architecture=os.uname().machine,
+            machine=root.find('os/type').get('machine'),
+            host_cpu_sha256=hashlib.sha256(serialized(cpu)).hexdigest(),
+            libvirt_uri=uri,
+            uid=os.geteuid(),
+            gid=os.getegid(),
+            pid_namespace=os.readlink('/proc/self/ns/pid'),
+            mount_namespace=os.readlink('/proc/self/ns/mnt'),
+            path_access='same-pid-namespace-proc-fd',
+            kvm=True,
+        )
+
+    def _key(self, ident):
+        # A private/unavailable secret cannot be guessed from its UUID.
+        value = (
+            self.host.get_connection()
+            .secretLookupByUUIDString(ident)
+            .value(0)
+        )
+        c._require(type(value) is bytes and bool(value))
+        return hashlib.sha256(value).hexdigest()
+
+    @staticmethod
+    def _volumes(context, ids, purpose, operation_id):
+        client = cinder.CheckpointClient()
+        if operation_id is None:
+            return client.preflight_resources(context, tuple(ids), ())[
+                'volumes'
+            ]
+        # C1.1 rejects multiattach; its active scope fences ordinary
+        # topology mutations. Revalidate scope and capabilities per disk.
+        grant = client.get(context, operation_id)
+        c._require(grant['status'] != 'released')
+        result = {}
+        for ident in ids:
+            client.capabilities(context, operation_id, ident)
+            result[ident] = dict(
+                id=ident, multiattach=False, grant_bound=True
+            )
+        return result
+
+    def _ports(self, context, instance, ports, interfaces, inactive=False):
+        c._require(len(ports) == len(interfaces))
+        by_mac = {
+            node.find('mac').get('address').lower(): node
+            for node in interfaces
+        }
+        c._require(len(by_mac) == len(ports))
+        if not ports:
+            return []
+        client = self.neutron_factory(context)
+        observed = []
+        for port in ports:
+            c._require(port['vnic_type'] == 'normal')
+            current = client.show_port(port['uuid'])['port']
+            c._require(
+                current['id'] == port['uuid'] and
+                current['device_id'] == instance.uuid and
+                current.get('project_id', current.get('tenant_id')) ==
+                instance.project_id and
+                current['network_id'] == port['network_uuid'] and
+                current['mac_address'].lower() == port['mac'].lower() and
+                current['binding:host_id'] == instance.host and
+                current['binding:vnic_type'] == 'normal' and
+                current['binding:vif_type'] in ('ovs', 'bridge') and
+                current['status']
+                in (('ACTIVE', 'DOWN') if inactive else ('ACTIVE',))
+            )
+            interface = by_mac[port['mac'].lower()]
+            c._require(
+                interface.get('type') == 'bridge' and
+                interface.find('model').get('type') == port['model']
+            )
+            c._require(self.interface_reader is not None)
+            expected = document(
+                '<domain><devices>' +
+                self.interface_reader(context, instance, port) +
+                '</devices></domain>'
+            ).find('devices/interface')
+            c._require(
+                expected is not None and expected.get('type') == 'bridge'
+            )
+            for name in (
+                'source',
+                'target',
+                'virtualport',
+                'filterref',
+                'bandwidth',
+            ):
+                c._require(
+                    [serialized(n) for n in interface.findall(name)] ==
+                    [serialized(n) for n in expected.findall(name)]
+                )
+            observed.append(
+                {
+                    k: port[k]
+                    for k in (
+                        'uuid',
+                        'mac',
+                        'network_uuid',
+                        'model',
+                        'vnic_type',
+                    )
+                }
+            )
+        return sorted(observed, key=lambda p: p['uuid'])
+
+    def _inspect(
+        self, context, instance, db_manifest, purpose, saved_binding
+    ):
+        c._require(purpose in ('create', 'revert', 'recover'))
+        c._require(
+            db_manifest['instance_uuid'] == instance.uuid and
+            db_manifest['host'] == instance.host and
+            db_manifest['node'] == instance.node and
+            not db_manifest['shares'] and
+            not db_manifest['flavor']['ephemeral_gb'] and
+            not db_manifest['flavor']['swap']
+        )
+        if saved_binding is not None:
+            c._require(
+                (
+                    saved_binding.instance_uuid,
+                    saved_binding.host,
+                    saved_binding.node,
+                    saved_binding.project_id,
+                ) ==
+                (
+                    instance.uuid,
+                    instance.host,
+                    instance.node,
+                    instance.project_id,
+                )
+            )
+        c._require(purpose != 'recover' or saved_binding is not None)
+        guest = self.host.get_guest(instance)
+        c._require(guest.uuid == instance.uuid)
+        state = guest.checkpoint_state()
+        c._require(
+            state['managed_save'] is False and
+            state['job'] == 0 and
+            state['state']
+            in ((1, 3, 5) if purpose == 'recover' else (1,))
+        )
+        xml = guest.get_xml_desc(dump_sensitive=True)
+        root = document(xml)
+        c._require(
+            root.get('type') == 'kvm' and
+            root.findtext('uuid') == instance.uuid and
+            all(node.tag in ROOT_TAGS for node in root) and
+            len(root.findall('os')) == 1 and
+            len(root.findall('devices')) == 1 and
+            len(root.findall('cpu')) == 1 and
+            len(root.findall('uuid')) == 1 and
+            len(root.findall('vcpu')) == 1
+        )
+        os_element = root.find('os')
+        os_type = root.find('os/type')
+        c._require(
+            os_element.get('firmware') in (None, 'bios') and
+            os_type is not None and
+            os_type.text == 'hvm' and
+            os_type.get('arch') == 'x86_64' and
+            os_type.get('machine', '').startswith('pc') and
+            not root.findall('.//loader') and
+            not root.findall('.//nvram') and
+            not root.findall('.//backingStore') and
+            not root.findall('.//shareable')
+        )
+        c._require(all(n.tag in DEVICE_TAGS for n in root.find('devices')))
+        for node in root.iter():
+            c._require(
+                not set(node.attrib) & {'passwd', 'password', 'key'}
+            )
+        for node in root.findall('./metadata/*'):
+            c._require(etree.QName(node).namespace in (NOVA_NS, MARKER_NS))
+        observed = self.observer(guest, xml)
+        profile = (
+            self.profileset or
+            profiles.load(conf.CONF.checkpoint.profile_file)
+        ).match(observed)
+        c._require(
+            profile is not None and
+            profile.kind == 'runtime' and
+            observed['kvm'] is True
+        )
+        memory = max(
+            _bytes(root.find('memory')),
+            (
+                _bytes(root.find('maxMemory'))
+                if root.find('maxMemory') is not None
