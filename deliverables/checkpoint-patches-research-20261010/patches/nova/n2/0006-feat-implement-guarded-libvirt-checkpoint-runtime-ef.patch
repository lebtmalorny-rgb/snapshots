+        writable = [d for d in xml_disks if d.find('readonly') is None]
+        c._require(len(writable) == len(disks))
+        serials = {d.findtext('serial'): d for d in writable}
+        c._require(len(serials) == len(disks))
+        keys = []
+        for disk in disks:
+            node = serials[disk['serial']]
+            target = node.find('target')
+            c._require(
