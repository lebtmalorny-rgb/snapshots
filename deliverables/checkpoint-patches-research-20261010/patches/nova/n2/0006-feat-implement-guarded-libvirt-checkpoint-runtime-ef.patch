+
+def unknown():
+    return v2.EffectResult('unknown', {}, 'recovery_required')
+
+
+class Runtime:
+    def __init__(self, host, staging, topology):
+        self.host, self.staging, self.topology = host, staging, topology
+
+    def _binding(self, context, instance, child):
+        operation = objects.InstanceCheckpointOperation.get_by_uuid(
+            context, child.operation_id
+        )
+        binding = v2.Binding.from_primitive(operation.binding)
+        c._require(
+            (
+                instance.uuid,
+                instance.project_id,
+                instance.host,
+                instance.node,
+            ) ==
+            (
+                binding.instance_uuid,
+                binding.project_id,
+                binding.host,
+                binding.node,
+            )
+        )
+        journal.authorize(context, binding, child)
+        return binding
+
+    def _state(self, instance, binding, child, expected, marker=True):
+        guest = self.host.get_guest(instance)
+        c._require(guest.uuid == binding.instance_uuid)
+        state = guest.checkpoint_state()
+        c._require(
+            state == dict(state=expected, managed_save=False, job=0)
+        )
+        xml = guest.get_xml_desc(dump_sensitive=True)
+        c._require(
+            xmltools.document(xml).findtext('uuid') == instance.uuid
+        )
+        if marker:
+            c._require(xmltools.matching_marker(xml, binding, child))
+        return guest, xml
+
+    def _revalidate(self, context, instance, binding):
+        manifest = objects.InstanceCheckpointOperation.device_manifest(
+            context, instance.uuid
+        )
+        c._require(
+            c.device_fingerprint(manifest) == binding.db_fingerprint
+        )
+        result = self.topology.inspect(
+            context, instance, manifest, 'recover', binding
+        )
+        c._require(
+            result['runtime_fingerprint'] == binding.runtime_fingerprint
+        )
+        return result
+
+    def _workspace(self, binding, child, workspace):
+        current = self.staging._entry(binding, child.operation_id)
+        c._require(workspace == current)
+
+    def save(self, context, instance, child, workspace, topology):
+        try:
+            c._require(child.action == 'save')
+            binding = self._binding(context, instance, child)
+            with self.staging.runtime_record(
+                context, binding, child, write=True
+            ) as record:
+                if record.started():
+                    return self.query(context, instance, child)
+                self._workspace(binding, child, workspace)
+                c._require(
+                    topology['runtime_fingerprint'] ==
+                    binding.runtime_fingerprint
+                )
+                self._revalidate(context, instance, binding)
+                guest, xml = self._state(
+                    instance, binding, child, 1, marker=False
+                )
+                xml = xmltools.with_marker(xml, binding, child)
+                with self.staging.writer(
+                    context, binding, child
+                ) as writer:
+                    record.start()
+                    guest.checkpoint_set_marker(
+                        xmltools.marker_xml(binding, child)
+                    )
+                    guest.checkpoint_save(writer.pinned_path, xml)
+                    self._state(instance, binding, child, 5)
+                    artifact = writer.finish()
+                result = v2.EffectResult(
+                    'succeeded',
+                    dict(
+                        writes_stopped=True,
+                        artifacts=[artifact.to_primitive()],
+                    ),
+                    None,
+                )
+                record.finish(result)
+                return result
+        except Exception:
+            return unknown()
+
+    def stop(self, context, instance, child, topology):
+        try:
+            c._require(child.action == 'stop')
+            binding = self._binding(context, instance, child)
+            with self.staging.runtime_record(
+                context, binding, child, write=True
+            ) as record:
+                if record.started():
+                    return self.query(context, instance, child)
+                c._require(
+                    topology['runtime_fingerprint'] ==
+                    binding.runtime_fingerprint
+                )
+                self._revalidate(context, instance, binding)
+                guest, xml = self._state(
+                    instance, binding, child, 1, marker=False
+                )
+                record.start()
+                guest.checkpoint_set_marker(
+                    xmltools.marker_xml(binding, child)
+                )
+                guest.checkpoint_stop()
+                self._state(instance, binding, child, 5)
+                result = v2.EffectResult(
+                    'succeeded',
+                    dict(writes_stopped=True, power_state='SHUTOFF'),
+                    None,
+                )
+                record.finish(result)
+                return result
+        except Exception:
+            return unknown()
+
+    def restore_paused(
+        self, context, instance, child, artifact, workspace, xml
+    ):
+        try:
+            c._require(
+                child.action == 'restore_paused' and
+                artifact.kind == 'ram' and
+                artifact.location == 'staging'
+            )
+            binding = self._binding(context, instance, child)
+            with self.staging.runtime_record(
+                context, binding, child, write=True
+            ) as record:
+                if record.started():
+                    return self.query(context, instance, child)
+                self._workspace(binding, child, workspace)
+                observed = self._revalidate(context, instance, binding)
+                guest, current_xml = self._state(
+                    instance, binding, child, 5, marker=False
+                )
+                c._require(
+                    xmltools.guest_identity(xml) ==
+                    xmltools.guest_identity(current_xml)
+                )
+                with self.staging.pinned_reader(
+                    context, binding, artifact
+                ) as (path, fd, info):
+                    saved_xml = self.host.checkpoint_saved_xml(path)
+                    restore_xml = self.topology.restore_xml(
+                        saved_xml, dict(observed, xml=current_xml), binding
+                    )
+                    restore_xml = xmltools.with_marker(
+                        restore_xml, binding, child
+                    )
+                    record.start()
+                    self.host.checkpoint_restore(path, restore_xml)
+                    self._state(instance, binding, child, 3)
+                    self._revalidate(context, instance, binding)
+                result = v2.EffectResult(
+                    'succeeded',
+                    dict(
+                        fingerprint=binding.db_fingerprint,
+                        power_state='PAUSED',
+                    ),
+                    None,
+                )
+                record.finish(result)
+                return result
+        except Exception:
+            return unknown()
+
+    def unpause(self, context, instance, child, binding):
+        try:
+            c._require(
+                child.action == 'unpause' and
+                binding == self._binding(context, instance, child)
+            )
+            with self.staging.runtime_record(
+                context, binding, child, write=True
+            ) as record:
+                if record.started():
+                    return self.query(context, instance, child)
+                rows = objects.CheckpointEffect.get_children(
+                    context, child.parent_step_id
+                )
+                previous = next(
+                    r for r in rows if r['action'] == 'restore_paused'
+                )
+                c._require(
+                    previous['status'] == 'succeeded' and
+                    child.payload['depends_on'] == (previous['id'],)
+                )
+                restored = v2.ChildIntent(
+                    **{
+                        f.name: previous[f.name]
+                        for f in dataclasses.fields(v2.ChildIntent)
+                    }
+                )
+                c._require(
+                    self.query(context, instance, restored).status ==
+                    'succeeded'
+                )
+                self._revalidate(context, instance, binding)
+                guest, xml = self._state(instance, binding, restored, 3)
+                record.start()
+                guest.checkpoint_set_marker(
+                    xmltools.marker_xml(binding, child)
+                )
+                guest.resume()
+                self._state(instance, binding, child, 1)
+                result = v2.EffectResult(
+                    'succeeded',
+                    dict(
+                        fingerprint=binding.db_fingerprint,
+                        power_state='RUNNING',
+                    ),
+                    None,
+                )
+                record.finish(result)
+                return result
+        except Exception:
+            return unknown()
+
+    def query(self, context, instance, child):
+        """Read receipts and current state; never retry a libvirt effect."""
+        try:
+            binding = self._binding(context, instance, child)
+            with self.staging.runtime_record(
+                context, binding, child
+            ) as record:
+                result = record.read()
+                self._state(
+                    instance,
+                    binding,
+                    child,
+                    {
+                        'save': 5,
+                        'stop': 5,
+                        'restore_paused': 3,
+                        'unpause': 1,
+                    }[child.action],
+                )
+                if child.action == 'save':
+                    artifact = self.staging.sealed_save(
+                        context, binding, child
+                    )
+                    c._require(
+                        result.evidence['artifacts'] ==
+                        (artifact.to_primitive(),)
+                    )
+                if child.action in ('restore_paused', 'unpause'):
+                    self._revalidate(context, instance, binding)
+                return result
+        except Exception:
+            return unknown()
