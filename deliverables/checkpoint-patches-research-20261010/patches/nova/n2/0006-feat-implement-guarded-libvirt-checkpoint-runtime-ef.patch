+class RuntimeRecord:
+    """Bounded immutable start/completion receipts inside the XFS quota."""
+
+    def __init__(self, directory, binding, child):
+        self.directory, self.binding, self.child = (
+            directory,
+            binding,
+            child,
+        )
+
+    def _name(self, suffix):
+        return 'runtime-%s.%s' % (self.child.id, suffix)
+
+    def _value(self):
+        return dict(
+            format=2,
+            binding=self.binding.to_primitive(),
+            child=self.child.to_primitive(),
+        )
+
+    def started(self):
+        try:
+            value = files.read_json(self.directory, self._name('intent'))
+        except FileNotFoundError:
+            return False
+        c._require(value == self._value())
+        return True
+
+    def start(self):
+        value = self._value()
+        c._require(len(jsonutils.dump_as_bytes(value)) <= 4096)
+        # O_EXCL is the dispatch fence, including after Nova restarts.
+        files.create_json(self.directory, self._name('intent'), value)
+
+    def finish(self, result):
+        c._require(
+            v2.validate_child_result(
+                self.child.action, result.to_primitive()
+            ) ==
+            result and
+            result.status == 'succeeded'
+        )
+        value = dict(
+            self._value(), call_returned=True, result=result.to_primitive()
+        )
+        c._require(len(jsonutils.dump_as_bytes(value)) <= 4096)
+        files.create_json(self.directory, self._name('done'), value)
+
+    def read(self):
+        intent = files.read_json(self.directory, self._name('intent'))
+        c._require(intent == self._value())
+        value = files.read_json(self.directory, self._name('done'))
+        c._keys(
+            value,
+            ('format', 'binding', 'child', 'call_returned', 'result'),
+        )
+        c._require(
+            {key: value[key] for key in intent} == intent and
+            value['call_returned'] is True
+        )
+        result = v2.validate_child_result(
+            self.child.action, value['result']
+        )
+        c._require(result.status == 'succeeded')
+        return result
