+"""Dedicated synchronous libvirt calls with durable, non-inferred completion.
+
+A matching marker, an inactive domain, or an image header alone never closes a
+child. A lost libvirt reply retains the guard and staging quota for recovery.
+"""
+
+import dataclasses
+
+from nova.checkpoints import contracts as c
+from nova.checkpoints import contracts_v2 as v2
+from nova import objects
+from nova.virt.libvirt.checkpoints import journal
+from nova.virt.libvirt.checkpoints import topology as xmltools
