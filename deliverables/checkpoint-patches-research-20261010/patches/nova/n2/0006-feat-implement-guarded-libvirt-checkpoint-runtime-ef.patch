+# under the License.
+
+import os
+from pathlib import Path
+from types import SimpleNamespace
+from unittest import mock
+
+from oslo_utils.fixture import uuidsentinel as uuids
+
+from nova import objects
+from nova.tests.unit.virt.libvirt.checkpoints import fixtures
+from nova.tests.unit.virt.libvirt.checkpoints.test_topology import XML
+from nova.virt.libvirt.checkpoints import runtime
+from nova.virt.libvirt.checkpoints import topology
+
+
+class RuntimeBase(fixtures.StoreTestBase):
+    def setUp(self):
+        super().setUp()
+        self.instance = SimpleNamespace(
+            uuid=self.binding.instance_uuid,
+            host=self.binding.host,
+            node=self.binding.node,
+            project_id=self.binding.project_id,
+        )
+        self.state = 1
+        self.xml = XML.replace(uuids.instance, self.instance.uuid)
+        self.guest = mock.Mock(uuid=self.instance.uuid)
+        self.guest.get_xml_desc.side_effect = lambda **kw: self.xml
+        self.guest.checkpoint_state.side_effect = lambda: dict(
+            state=self.state, managed_save=False, job=0
+        )
+        self.guest.checkpoint_set_marker.side_effect = self.set_marker
+        self.guest.checkpoint_save.side_effect = self.save
+        self.guest.checkpoint_stop.side_effect = lambda: self.set_state(5)
+        self.guest.resume.side_effect = lambda: self.set_state(1)
+        self.host = mock.Mock()
+        self.host.get_guest.return_value = self.guest
+        self.host.checkpoint_saved_xml.side_effect = lambda path: self.xml
+        self.host.checkpoint_restore.side_effect = self.restore
+        self.inspector = mock.Mock()
+        self.inspector.inspect.return_value = dict(
+            runtime_fingerprint=self.binding.runtime_fingerprint
+        )
+        self.inspector.restore_xml.side_effect = (
+            topology.Topology.restore_xml
+        )
+        self.runtime = runtime.Runtime(
+            self.host, self.staging, self.inspector
+        )
+        self.snapshot = dict(
+            runtime_fingerprint=self.binding.runtime_fingerprint
+        )
+
+    def set_state(self, state):
+        self.state = state
+
+    def set_marker(self, marker):
+        root = topology.document(self.xml)
+        from lxml import etree
+
+        metadata = root.find('metadata')
+        if metadata is not None:
+            root.remove(metadata)
+        metadata = etree.SubElement(root, 'metadata')
+        metadata.append(etree.fromstring(marker.encode()))
+        self.xml = etree.tostring(root, encoding='unicode')
+
+    def save(self, path, xml):
+        # The native writer reopens this path; verify the FD pins the workspace
+        # and the unrepeatable artifact UUID remains part of the suffix.
+        self.assertRegex(
+            path, r'^/proc/[0-9]+/fd/[0-9]+/artifacts/[0-9a-f-]+/data$'
+        )
+        with open(path, 'wb') as stream:
+            stream.write(b'libvirt-complete-save-image')
+        self.xml = xml
+        self.state = 5
+
+    def restore(self, path, xml):
+        self.assertTrue(Path(path).is_file())
+        self.xml = xml
+        self.state = 3
+
+    def new_save(self):
+        return self.save_child
+
+    def restored(self):
+        self.state = 5
+        parent = self.parent('runtime_restore_current', [])
+        child = self.claim(parent, 'restore_paused')
+        result = self.runtime.restore_paused(
+            self.ctx,
+            self.instance,
+            child,
+            self.source,
+            self.workspace,
+            self.xml,
+        )
+        return parent, child, result
+
+
+class SaveRuntimeTest(RuntimeBase):
+    seed_saved_source = False
+
+    def test_save_has_backend_receipt_and_query_never_reissues(self):
+        child = self.new_save()
+        result = self.runtime.save(
+            self.ctx, self.instance, child, self.workspace, self.snapshot
+        )
+        self.assertEqual('succeeded', result.status)
+        self.assertTrue(result.evidence['writes_stopped'])
+        observed = self.runtime.query(self.ctx, self.instance, child)
+        self.assertEqual(result, observed)
+        self.assertEqual(1, self.guest.checkpoint_save.call_count)
+        self.assertEqual(
+            result,
+            self.runtime.save(
+                self.ctx,
+                self.instance,
+                child,
+                self.workspace,
+                self.snapshot,
+            ),
+        )
+        self.assertEqual(1, self.guest.checkpoint_save.call_count)
+
+    def test_save_call_reply_loss_even_complete_image_is_unknown(self):
+        child = self.new_save()
+
+        def lost(path, xml):
+            self.save(path, xml)
+            raise RuntimeError('connection lost')
+
+        self.guest.checkpoint_save.side_effect = lost
+        result = self.runtime.save(
+            self.ctx, self.instance, child, self.workspace, self.snapshot
+        )
+        self.assertEqual('unknown', result.status)
+        self.assertEqual(
+            'unknown',
+            self.runtime.query(self.ctx, self.instance, child).status,
+        )
+        self.runtime.save(
+            self.ctx, self.instance, child, self.workspace, self.snapshot
+        )
+        self.assertEqual(1, self.guest.checkpoint_save.call_count)
+        self.guest.resume.assert_not_called()
+
+    def test_active_job_or_managed_save_prevents_new_save(self):
+        child = self.new_save()
+        for state in (
+            dict(state=1, job=1, managed_save=False),
+            dict(state=1, job=0, managed_save=True),
+        ):
+            self.guest.checkpoint_state.side_effect = lambda: state
+            self.assertEqual(
+                'unknown',
+                self.runtime.save(
+                    self.ctx,
+                    self.instance,
+                    child,
+                    self.workspace,
+                    self.snapshot,
+                ).status,
+            )
+        self.guest.checkpoint_save.assert_not_called()
+
+
+class RuntimeTest(RuntimeBase):
+    def test_stop_has_completion_receipt_and_never_detaches(self):
+        parent = self.parent('runtime_stop', [])
+        child = self.claim(parent, 'stop')
+        result = self.runtime.stop(
+            self.ctx, self.instance, child, self.snapshot
+        )
+        self.assertEqual('succeeded', result.status)
+        self.assertEqual(
+            result, self.runtime.query(self.ctx, self.instance, child)
+        )
+        self.guest.checkpoint_stop.assert_called_once_with()
+        self.guest.resume.assert_not_called()
+
+    def test_receipts_are_removed_only_after_closed_runtime_and_artifacts(
+        self,
+    ):
+        parent, restored, result = self.restored()
+        objects.CheckpointEffect.observe(
+            self.ctx, restored.id, 1, result.to_primitive()
+        )
+        child = self.claim(parent, 'unpause')
+        result = self.runtime.unpause(
+            self.ctx, self.instance, child, self.binding
+        )
+        self.assertEqual(
+            self.binding.db_fingerprint, result.evidence['fingerprint']
+        )
+        objects.CheckpointEffect.observe(
+            self.ctx, child.id, 1, result.to_primitive()
+        )
+        cleanup = self.parent(
+            'staging_cleanup',
+            [
+                dict(
+                    id=self.source.id,
+                    kind='ram',
+                    location='staging',
+                    upper_bound=fixtures.LIMIT,
+                )
+            ],
+        )
+        deletion = self.claim(cleanup, 'delete')
+        result = self.staging.cleanup(self.ctx, self.binding, deletion)
+        self.assertEqual('succeeded', result.status)
+        objects.CheckpointEffect.observe(
+            self.ctx, deletion.id, 1, result.to_primitive()
+        )
+        release = self.claim(cleanup, 'release_staging')
+        self.assertEqual(
+            'succeeded',
+            self.staging.cleanup(self.ctx, self.binding, release).status,
+        )
+        self.assertFalse(Path(self.workspace['path']).exists())
+
+    def test_seal_and_shutoff_without_runtime_receipt_are_unknown(self):
+        self.state = 5
+        self.assertEqual(
+            'unknown',
+            self.runtime.query(
+                self.ctx, self.instance, self.save_child
+            ).status,
+        )
+        self.guest.checkpoint_save.assert_not_called()
+
+    def test_restore_always_paused_and_query_requires_receipt(self):
+        parent, child, result = self.restored()
+        self.assertEqual('succeeded', result.status)
+        self.assertEqual('PAUSED', result.evidence['power_state'])
+        self.assertEqual(
+            result, self.runtime.query(self.ctx, self.instance, child)
+        )
+        self.guest.resume.assert_not_called()
+        self.assertEqual(1, self.host.checkpoint_restore.call_count)
+
+    def test_restore_reply_loss_marker_and_paused_state_are_insufficient(
+        self,
+    ):
+        def lost(path, xml):
+            self.restore(path, xml)
+            raise RuntimeError('connection lost')
+
+        self.host.checkpoint_restore.side_effect = lost
+        parent, child, result = self.restored()
+        self.assertEqual(3, self.state)
+        self.assertEqual('unknown', result.status)
+        self.assertEqual(
+            'unknown',
+            self.runtime.query(self.ctx, self.instance, child).status,
+        )
+        self.guest.resume.assert_not_called()
+
+    def test_unpause_revalidates_then_has_recoverable_receipt(self):
+        parent, restored, result = self.restored()
+        objects.CheckpointEffect.observe(
+            self.ctx, restored.id, 1, result.to_primitive()
+        )
+        child = self.claim(parent, 'unpause')
+        result = self.runtime.unpause(
+            self.ctx, self.instance, child, self.binding
+        )
+        self.assertEqual('succeeded', result.status)
+        self.assertEqual('RUNNING', result.evidence['power_state'])
+        self.assertEqual(
+            result, self.runtime.query(self.ctx, self.instance, child)
+        )
+        self.guest.resume.assert_called_once_with()
+
+    def test_changed_topology_prevents_unpause(self):
+        parent, restored, result = self.restored()
+        objects.CheckpointEffect.observe(
+            self.ctx, restored.id, 1, result.to_primitive()
+        )
+        child = self.claim(parent, 'unpause')
+        self.inspector.inspect.side_effect = ValueError(
+            'port or key changed'
+        )
+        self.assertEqual(
+            'unknown',
+            self.runtime.unpause(
+                self.ctx, self.instance, child, self.binding
+            ).status,
+        )
+        self.guest.resume.assert_not_called()
+        self.assertEqual(3, self.state)
+
+    def test_guest_dies_during_unpause_is_unknown(self):
+        parent, restored, result = self.restored()
+        objects.CheckpointEffect.observe(
+            self.ctx, restored.id, 1, result.to_primitive()
+        )
+        child = self.claim(parent, 'unpause')
+        self.guest.resume.side_effect = lambda: self.set_state(5)
+        self.assertEqual(
+            'unknown',
+            self.runtime.unpause(
+                self.ctx, self.instance, child, self.binding
+            ).status,
+        )
+        self.assertEqual(
+            'unknown',
+            self.runtime.query(self.ctx, self.instance, child).status,
+        )
+
+    def test_unpause_reply_loss_does_not_resume_twice(self):
+        parent, restored, result = self.restored()
+        objects.CheckpointEffect.observe(
+            self.ctx, restored.id, 1, result.to_primitive())
+        child = self.claim(parent, 'unpause')
+
+        def lost():
+            self.set_state(1)
+            raise RuntimeError('libvirt reply lost')
+
+        self.guest.resume.side_effect = lost
+        self.assertEqual('unknown', self.runtime.unpause(
+            self.ctx, self.instance, child, self.binding).status)
+        self.assertEqual('unknown', self.runtime.query(
+            self.ctx, self.instance, child).status)
+        self.runtime.unpause(self.ctx, self.instance, child, self.binding)
+        self.guest.resume.assert_called_once_with()
+
+    def test_foreign_uuid_or_marker_invalidates_completion(self):
+        parent, child, result = self.restored()
+        self.guest.uuid = uuids.foreign
+        self.assertEqual(
+            'unknown',
+            self.runtime.query(self.ctx, self.instance, child).status,
+        )
+        self.guest.uuid = self.instance.uuid
+        self.xml = self.xml.replace(child.id, uuids.foreign)
+        self.assertEqual(
+            'unknown',
+            self.runtime.query(self.ctx, self.instance, child).status,
+        )
+
+    def test_staging_cannot_be_deleted_with_unknown_restore_reader(self):
+        parent, child, result = self.restored()
+        # SQL still says dispatching: external ownership is unresolved.
+        cleanup = self.parent(
+            'staging_cleanup',
+            [
+                dict(
+                    id=self.source.id,
+                    kind='ram',
+                    location='staging',
+                    upper_bound=fixtures.LIMIT,
+                )
+            ],
+        )
+        deletion = self.claim(cleanup, 'delete')
+        self.assertEqual(
+            'unknown',
+            self.staging.cleanup(self.ctx, self.binding, deletion).status,
+        )
+        with self.staging.reader(self.ctx, self.binding, self.source) as (
+            fd,
+            info,
+        ):
+            self.assertGreater(os.fstat(fd).st_size, 0)
