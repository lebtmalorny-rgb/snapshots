+from types import SimpleNamespace
+from unittest import mock
+
+from nova import test
+from nova.virt.libvirt import guest
+from nova.virt.libvirt import host
+
+
+class NativeRuntimeTest(test.NoDBTestCase):
+    def setUp(self):
+        super().setUp()
+        # Values also checked against the actual Linux libvirt binding in the
+        # qualification gate. Ordinary Nova tests need no native installation.
+        constants = SimpleNamespace(
+            VIR_DOMAIN_SAVE_PAUSED=4,
+            VIR_DOMAIN_XML_SECURE=1,
+            VIR_DOMAIN_JOB_NONE=0,
+            VIR_DOMAIN_SHUTOFF=5,
+            VIR_DOMAIN_METADATA_ELEMENT=2,
+            VIR_DOMAIN_AFFECT_LIVE=1,
+            VIR_DOMAIN_AFFECT_CONFIG=2,
+        )
+        self.patch(guest, 'libvirt', constants)
+        self.patch(host, 'libvirt', constants)
+        self.domain = mock.Mock()
+        self.guest = guest.Guest(self.domain)
+        self.host = host.Host('qemu:///system')
+        self.conn = mock.Mock()
+        self.patch(
+            self.host, 'get_connection', mock.Mock(return_value=self.conn)
+        )
+
+    def test_dedicated_save_and_paused_restore_leave_managed_save_alone(
+        self,
+    ):
+        self.guest.checkpoint_save('/pinned/image', '<domain/>')
+        self.domain.saveFlags.assert_called_once_with(
+            '/pinned/image', '<domain/>', 0
+        )
+        self.domain.managedSave.assert_not_called()
+        self.host.checkpoint_restore('/pinned/image', '<domain/>')
+        self.conn.restoreFlags.assert_called_once_with(
+            '/pinned/image', '<domain/>', 4
+        )
+        self.domain.resume.assert_not_called()
+        self.host.checkpoint_saved_xml('/pinned/image')
+        self.conn.saveImageGetXMLDesc.assert_called_once_with(
+            '/pinned/image', 1
+        )
+        self.conn.saveImageDefineXML.assert_not_called()
+
+    def test_state_does_not_convert_failed_job_query_to_idle(self):
+        self.domain.state.return_value = (1, 0)
+        self.domain.hasManagedSaveImage.return_value = 0
+        self.domain.jobStats.side_effect = RuntimeError('disconnected')
+        self.assertRaises(RuntimeError, self.guest.checkpoint_state)
+        self.domain.state.return_value = (5, 0)
+        self.assertEqual(
+            dict(state=5, managed_save=False, job=0),
+            self.guest.checkpoint_state(),
+        )
+
+    def test_marker_updates_both_configs_and_stop_has_no_detach(self):
+        self.guest.checkpoint_set_marker('<checkpoint/>')
+        self.domain.setMetadata.assert_called_once_with(
+            2,
+            '<checkpoint/>',
+            'checkpoint',
+            'urn:openstack:nova:checkpoint:2',
+            3,
+        )
+        self.guest.checkpoint_stop()
+        self.domain.destroyFlags.assert_called_once_with(0)
+        self.domain.detachDeviceFlags.assert_not_called()
+        self.domain.undefine.assert_not_called()
