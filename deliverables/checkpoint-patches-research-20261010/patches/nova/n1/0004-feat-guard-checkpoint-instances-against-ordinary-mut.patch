+def _scope_matches(context, guard, instance_uuid):
+    value = getattr(context, 'checkpoint_scope', None)
+    if value is None:
+        return None
+    try:
+        scope = c.Scope.from_primitive(value)
+    except (ValueError, TypeError, KeyError):
+        _conflict('guard_busy')
+    if scope.instance_uuid != instance_uuid or guard is None:
+        _conflict('guard_busy')
+    if scope.kind == 'ordinary':
+        if (
+            scope.owner_uuid != guard.ordinary_claim_uuid or
+            scope.token != guard.ordinary_token or
+            scope.action != guard.ordinary_action or
+            guard.ordinary_state != 'running'
+        ):
+            _conflict('guard_busy')
+    else:
+        if (
+            scope.owner_uuid != guard.operation_id or
+            scope.token != guard.token or
+            scope.generation != guard.generation
+        ):
+            _conflict('guard_busy')
+        operation = _operation(context, scope.owner_uuid)
+        step = (
+            context.session.query(m.InstanceCheckpointStep)
+            .filter_by(
+                operation_id=operation.uuid,
+                phase=scope.action,
+                generation=scope.generation,
+            )
+            .first()
+        )
+        if (
+            operation.phase != scope.action or
+            step is None or
+            step.status not in ('dispatching', 'pending', 'unknown')
+        ):
+            _conflict('guard_busy')
+    return scope
+
+
+def _network_identity(value):
+    ports = jsonutils.loads(value or '[]')
+    return sorted(
+        (
+            port['id'],
+            port['address'],
+            port['network']['id'],
+            port.get('vnic_type'),
+            port.get('model'),
+        )
+        for port in ports
+    )
+
+
+def _image_identity(values):
+    return {
+        key: value
+        for key, value in values.items()
+        if key.startswith(('image_', 'instance_type_'))
+    }
+
+
+def guard_mutation(context, instance_uuid, action, values=None):
+    """Join the caller's writer transaction, always locking Instance first.
+
+    No facade/decorator here: separating this check from the mutation would
+    admit a checkpoint in the gap. Orphan legacy rows remain maintainable.
+    """
+    values = values or {}
+    try:
+        instance = _instance(
+            context, instance_uuid, lock=True, authorize=False
+        )
+    except exception.InstanceNotFound:
+        if context.session.get(m.InstanceCheckpointGuard, instance_uuid):
+            _conflict('guard_busy')
+        return
+    guard = context.session.get(m.InstanceCheckpointGuard, instance_uuid)
+    scope = _scope_matches(context, guard, instance_uuid)
+    if guard is None:
+        return
+    protected = (
+        guard.operation_id or
+        guard.ordinary_claim_uuid or
+        guard.checkpoint_count
+    )
+    if not protected:
+        return
+    topology = True
+    if action == 'instance':
+        changed = {
+            key
+            for key, value in values.items()
+            if key not in _INSTANCE_INFORMATION and
+            (
+                key == 'system_metadata' or
+                getattr(instance, key, object()) != value
+            )
+        }
+        if 'system_metadata' in changed:
+            old = {
+                row.key: row.value
+                for row in context.session.query(
+                    m.InstanceSystemMetadata
+                ).filter_by(instance_uuid=instance_uuid, deleted=0)
+            }
+            if _image_identity(old) == _image_identity(
+                values['system_metadata']
+            ):
+                changed.remove('system_metadata')
+        if not changed:
+            return
+        topology = bool(changed - _INSTANCE_STATE)
+    elif action == 'system_metadata':
+        old = {
+            row.key: row.value
+            for row in context.session.query(
+                m.InstanceSystemMetadata
+            ).filter_by(instance_uuid=instance_uuid, deleted=0)
+        }
+        new = (
+            values['metadata']
+            if values['delete']
+            else dict(old, **values['metadata'])
+        )
+        if _image_identity(old) == _image_identity(new):
+            return
+    elif action == 'info_cache':
+        if 'network_info' not in values:
+            return
+        row = (
+            context.session.query(m.InstanceInfoCache)
+            .filter_by(instance_uuid=instance_uuid, deleted=0)
+            .first()
+        )
+        try:
+            if _network_identity(row.network_info if row else None) == (
+                _network_identity(values['network_info'])
+            ):
+                return
+        except (ValueError, KeyError, TypeError):
+            pass
+    elif action == 'bdm_update':
+        topology = bool(set(values) - _BDM_CONNECTION)
+    elif action == 'extra':
+        if not set(values) - {'updated_at'}:
+            return
+    if guard.operation_id:
+        if scope is None or scope.kind != 'checkpoint' or topology:
+            _conflict('guard_busy')
+        if action == 'bdm_update' and scope.action not in (
+            'volume_disconnect',
+            'volume_reconnect',
+        ):
+            _conflict('guard_busy')
+        if action == 'instance' and scope.action not in (
+            'runtime_save',
+            'runtime_stop',
+            'runtime_restore_current',
+            'runtime_restore_checkpoint',
+            'cleanup_runtime_restore_current',
+        ):
+            _conflict('guard_busy')
+    else:
+        if guard.ordinary_claim_uuid and scope is None:
+            _conflict('guard_busy')
+        if guard.checkpoint_count:
+            if topology or scope is None:
+                _conflict('identity_changed' if topology else 'guard_busy')
+            if scope.action not in NON_TOPOLOGY_ACTIONS:
+                _conflict('identity_changed')
+
+
+def _check_guard(context, guard, instance_uuid, action):
+    scope = _scope_matches(context, guard, instance_uuid)
+    if guard is None:
+        return
+    if scope is not None and scope.kind == 'checkpoint':
+        if scope.action != action:
+            _conflict('guard_busy')
+        return
+    if guard.operation_id or guard.ordinary_claim_uuid:
+        if scope is None or scope.action != action:
+            _conflict('guard_busy')
+    if guard.checkpoint_count and action not in NON_TOPOLOGY_ACTIONS:
+        _conflict('identity_changed')
+
+
+@require_context
+@db.pick_context_manager_reader
+def guard_check(context, instance_uuid, action):
+    guard = context.session.get(m.InstanceCheckpointGuard, instance_uuid)
+    _check_guard(context, guard, instance_uuid, action)
+
+
+@require_context
+@oslo_db_api.wrap_db_retry(max_retries=5, retry_on_deadlock=True)
+@db.pick_context_manager_writer
+def guard_acquire(context, instance_uuid, action):
+    if not isinstance(action, str) or not action or len(action) > 64:
+        _conflict()
+    try:
+        _instance(context, instance_uuid, lock=True, authorize=False)
+    except exception.InstanceNotFound:
+        if context.session.get(m.InstanceCheckpointGuard, instance_uuid):
+            _conflict('guard_busy')
+        return None
+    existing = context.session.get(m.InstanceCheckpointGuard, instance_uuid)
+    if not CONF.checkpoint.enabled and (
+        existing is None or
+        not (
+            existing.operation_id or
+            existing.ordinary_claim_uuid or
+            existing.checkpoint_count
+        )
+    ):
+        # Disabled is not an unlock: any durable owner/checkpoint still takes
+        # the checked path below. The option is not runtime-mutable.
+        _scope_matches(context, existing, instance_uuid)
+        return None
+    guard = _guard(context, instance_uuid)
+    _check_guard(context, guard, instance_uuid, action)
+    if guard.operation_id:
+        _conflict('guard_busy')
+    if guard.ordinary_claim_uuid:
+        return c.Scope.from_primitive(context.checkpoint_scope)
+    guard.ordinary_claim_uuid = uuidutils.generate_uuid()
+    guard.ordinary_token = secrets.token_hex(32)
+    guard.ordinary_action = action
+    guard.ordinary_state = 'running'
+    guard.version += 1
+    return c.Scope(
+        instance_uuid,
+        'ordinary',
+        guard.ordinary_claim_uuid,
+        1,
+        action,
+        guard.ordinary_token,
+    )
+
+
+@require_context
+@db.pick_context_manager_writer
+def guard_release(context, scope):
+    # Successful delete may already have removed the Instance. No new
+    # admission can pass without it; keep token validation on the guard.
+    try:
+        _instance(context, scope.instance_uuid, lock=True)
+    except exception.InstanceNotFound:
+        pass
+    guard = _guard(context, scope.instance_uuid)
+    _validate_ordinary(guard, scope)
+    if guard.ordinary_state != 'running':
+        _conflict('guard_busy')
+    guard.ordinary_claim_uuid = None
+    guard.ordinary_token = None
+    guard.ordinary_action = None
+    guard.ordinary_state = None
+    guard.ordinary_target = None
+    guard.version += 1
+
+
+def _validate_ordinary(guard, scope):
+    if (
+        scope.kind != 'ordinary' or
+        scope.owner_uuid != guard.ordinary_claim_uuid or
+        scope.token != guard.ordinary_token or
+        scope.action != guard.ordinary_action
+    ):
+        _conflict('guard_busy')
+
+
+@require_context
+@db.pick_context_manager_writer
+def guard_handoff(context, scope, target):
+    _instance(context, scope.instance_uuid, lock=True)
+    guard = _guard(context, scope.instance_uuid)
+    _validate_ordinary(guard, scope)
+    if (
+        guard.ordinary_state != 'running' or
+        not isinstance(target, str) or
+        not target or
+        len(target) > 255
+    ):
+        _conflict('guard_busy')
+    guard.ordinary_state = 'queued'
+    guard.ordinary_target = target
+    guard.version += 1
+    return scope
+
+
+@require_context
+@db.pick_context_manager_writer
+def guard_adopt(context, scope, target):
+    _instance(context, scope.instance_uuid, lock=True)
+    guard = _guard(context, scope.instance_uuid)
+    _validate_ordinary(guard, scope)
+    if guard.ordinary_state != 'queued' or guard.ordinary_target != target:
+        _conflict('guard_busy')
+    guard.ordinary_state = 'running'
+    guard.ordinary_target = None
+    # A duplicate consumer has the old token, even when it races completion.
+    guard.ordinary_token = secrets.token_hex(32)
+    guard.version += 1
+    return c.Scope(
+        scope.instance_uuid,
+        'ordinary',
+        scope.owner_uuid,
+        1,
+        scope.action,
+        guard.ordinary_token,
+    )
