+#    under the License.
+
+"""Durable ordinary ownership through OVO; safe on nova-compute without SQL."""
+
+import contextlib
+import copy
+import functools
+
+from nova.checkpoints import contracts
+from nova import exception
+from nova import objects
+
+
+def check(context, instance_uuid, action):
+    objects.InstanceCheckpointGuard.check(context, instance_uuid, action)
+
+
+@contextlib.contextmanager
+def scope(context, value):
+    if not isinstance(value, contracts.Scope):
+        value = contracts.Scope.from_primitive(value)
+    ctx = copy.copy(context)
+    ctx.checkpoint_scope = value.to_primitive()
+    ctx.checkpoint_scope_cell_uuid = context.cell_uuid or getattr(
+        context, 'checkpoint_scope_cell_uuid', None
+    )
+    check(ctx, value.instance_uuid, value.action)
+    yield ctx
+
+
+@contextlib.contextmanager
+def worker(context, instance_uuid, action, target=None):
+    """Acquire before I/O. Exceptions retain ownership until investigated.
+
+    Local nesting is reentrant. The local marker is not serialized:
+    an RPC consumer must atomically adopt a queued claim and rotate its token.
+    OVO persistence needs only the durable scope, not that local marker.
+    """
+    existing = getattr(context, 'checkpoint_scope', None)
+    if existing and (
+        existing['action'] in contracts.ORDINARY_NON_TOPOLOGY and
+        action not in contracts.ORDINARY_NON_TOPOLOGY
+    ):
+        raise exception.CheckpointConflict(reason='identity_changed')
+    if existing and getattr(context, '_checkpoint_local_scope', None) == (
+        existing['token']
+    ):
+        check(context, instance_uuid, existing['action'])
+        yield context
+        return
+    if existing and getattr(context, 'checkpoint_borrowed_target', None):
+        if context.checkpoint_borrowed_target != target:
+            raise exception.CheckpointConflict(reason='guard_busy')
+        with scope(context, existing) as ctx:
+            ctx._checkpoint_local_scope = existing['token']
+            ctx._checkpoint_handed_off = False
+            yield ctx
+        return
+    if existing:
+        if target is None:
+            raise exception.CheckpointConflict(reason='guard_busy')
+        value = objects.InstanceCheckpointGuard.adopt(
+            context, existing, target
+        )
+    else:
+        value = objects.InstanceCheckpointGuard.acquire(
+            context, instance_uuid, action
+        )
+    if value is None:
+        # Legacy cleanup of an already absent Instance has no admissible
+        # checkpoint. An existing guard is never bypassed this way.
+        yield context
+        return
+    with scope(context, value) as ctx:
+        ctx._checkpoint_local_scope = value['token']
+        ctx._checkpoint_handed_off = False
+        yield ctx
+        if not ctx._checkpoint_handed_off:
+            objects.InstanceCheckpointGuard.release(ctx, value)
+
+
+def handoff(context, target):
+    if not getattr(context, 'checkpoint_scope', None):
+        return context
+    value = objects.InstanceCheckpointGuard.handoff(
+        context, context.checkpoint_scope, target
+    )
+    context._checkpoint_handed_off = True
+    outgoing = copy.copy(context)
+    outgoing.checkpoint_scope = value
+    outgoing.checkpoint_borrowed_target = None
+    outgoing._checkpoint_local_scope = None
+    return outgoing
+
+
+@contextlib.contextmanager
+def _bound_objects(value, context):
+    saved = {}
+
+    def bind(item):
+        if id(item) in saved:
+            return
+        if isinstance(item, objects.base.NovaObject):
+            saved[id(item)] = (item, item._context)
+            item._context = context
+            for field in item.fields:
+                if item.obj_attr_is_set(field):
+                    bind(getattr(item, field))
+        elif isinstance(item, dict):
+            for child in item.values():
+                bind(child)
+        elif isinstance(item, (list, tuple)):
+            for child in item:
+                bind(child)
+
+    bind(value)
+    try:
+        yield
+    finally:
+        for item, original in saved.values():
+            if item._context is context:
+                item._context = original
+
+
+def entrypoint(action, service='api', instance_arg=1):
+    """Bind both explicit context and nested OVO saves to the same claim."""
+
+    def decorate(function):
+        @functools.wraps(function)
+        def wrapped(self, *args, **kwargs):
+            positional = list(args)
+            name = 'context' if 'context' in kwargs else 'ctxt'
+            ctx = positional[0] if positional else kwargs[name]
+            instance = (
+                kwargs['instance']
+                if 'instance' in kwargs
+                else positional[instance_arg]
+            )
+            instance_uuid = (
+                instance['uuid']
+                if isinstance(instance, dict)
+                else instance.uuid
+            )
+            target = '%s:%s:%s' % (
+                service,
+                function.__name__,
+                getattr(self, 'host', '*') if service == 'compute' else '*',
+            )
+            with worker(ctx, instance_uuid, action, target=target) as owned:
+                if positional:
+                    positional[0] = owned
+                else:
+                    kwargs[name] = owned
+                with _bound_objects((positional, kwargs), owned):
+                    return function(self, *positional, **kwargs)
+
+        return wrapped
+
+    return decorate
+
+
+def run_task(task, execute, action):
+    """Cover TaskBase execution and rollback with the same durable owner."""
+    previous = task.context
+    with worker(previous, task.instance.uuid, action) as ctx:
+        task.context = ctx
+        try:
+            with _bound_objects(task.instance, ctx):
+                return execute()
+        finally:
+            task.context = previous
+
+
+class RPCClient:
+    """Propagate ownership at the actual RPC call or cast.
+
+    A synchronous nested call borrows its caller's still-held claim. A cast
+    transfers it to one queued consumer; a lost response keeps the claim.
+    Object-conductor RPC is never wrapped and keeps its normal OVO remoting.
+    """
+
+    def __init__(self, client, service, server='*'):
+        self._client = client
+        self._service = service
+        self._server = server
+
+    def __getattr__(self, name):
+        return getattr(self._client, name)
+
+    def prepare(self, **kwargs):
+        return RPCClient(
+            self._client.prepare(**kwargs),
+            self._service,
+            kwargs.get('server', self._server),
+        )
+
+    def _context(self, context, method, transfer):
+        if not getattr(context, 'checkpoint_scope', None):
+            return context
+        target = '%s:%s:%s' % (self._service, method, self._server)
+        if transfer:
+            return handoff(context, target)
+        borrowed = copy.copy(context)
+        borrowed.checkpoint_borrowed_target = target
+        borrowed._checkpoint_local_scope = None
+        return borrowed
+
+    def call(self, context, method, **kwargs):
+        result = self._client.call(
+            self._context(context, method, False), method, **kwargs
+        )
+        value = getattr(context, 'checkpoint_scope', None)
+        if value:
+            guard = objects.InstanceCheckpointGuard.get_by_instance_uuid(
+                context, value['instance_uuid']
+            )
+            if (
+                guard is None or
+                guard.ordinary_token != value['token'] or
+                guard.ordinary_state != 'running'
+            ):
+                context._checkpoint_handed_off = True
+        return result
+
+    def cast(self, context, method, **kwargs):
+        return self._client.cast(
+            self._context(context, method, True), method, **kwargs
+        )
+
+
+class RPCRouter:
+    def __init__(self, router):
+        self._router = router
+
+    def client(self, context):
+        return RPCClient(self._router.client(context), 'compute')
+
+    def __getattr__(self, name):
+        return getattr(self._router, name)
