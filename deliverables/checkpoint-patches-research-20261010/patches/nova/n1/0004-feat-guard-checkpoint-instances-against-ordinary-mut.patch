+import threading
+
+from oslo_db.sqlalchemy import test_fixtures
+from oslo_utils.fixture import uuidsentinel as uuids
+
+from nova import context
+from nova.db.main import api as db
+from nova.db.main import checkpoints
+from nova import exception
+from nova import test
+from nova.tests.unit.checkpoints import test_cell_db
+
+
+class GuardRaceMixin(test_cell_db.CellDBRaceMixin):
+    def race(self, ordinary):
+        self.flags(enabled=True, group='checkpoint')
+        candidate = test_cell_db.admission(self.ctx)
+        barrier = threading.Barrier(2)
+        outcomes = []
+
+        def run(kind):
+            ctx = context.RequestContext('actor', 'project')
+            ctx.db_connection = self.manager
+            barrier.wait(timeout=10)
+            try:
+                if kind == 'checkpoint':
+                    checkpoints.admit(ctx, candidate, uuids.ticket)
+                else:
+                    ordinary(ctx)
+                outcomes.append(kind)
+            except exception.CheckpointConflict:
+                outcomes.append('denied')
+
+        threads = [
+            threading.Thread(target=run, args=(kind,))
+            for kind in ('checkpoint', 'ordinary')
+        ]
+        for thread in threads:
+            thread.start()
+        for thread in threads:
+            thread.join(timeout=20)
+            self.assertFalse(thread.is_alive())
+        self.assertEqual(2, len(outcomes))
+        self.assertEqual(1, outcomes.count('denied'))
+
+    def test_delayed_worker_and_checkpoint_have_one_winner(self):
+        self.race(
+            lambda ctx: checkpoints.guard_acquire(
+                ctx, uuids.instance, 'reboot'
+            )
+        )
+
+    def test_runtime_key_cas_races_admission(self):
+        # Both operations enter the actual DB APIs and share the Instance lock.
+        keys = (
+            '{"nova_object.data":{"objects":[{"nova_object.data":'
+            '{"public_key":"new-key"}}]}}'
+        )
+        self.race(
+            lambda ctx: db.instance_extra_update_keypairs_if_current(
+                ctx, uuids.instance, None, keys
+            )
+        )
+
+
+class MySQLGuardRace(
+    GuardRaceMixin, test_fixtures.OpportunisticDBTestMixin, test.NoDBTestCase
+):
+    FIXTURE = test_fixtures.MySQLOpportunisticFixture
+
+
+class PostgreSQLGuardRace(
+    GuardRaceMixin, test_fixtures.OpportunisticDBTestMixin, test.NoDBTestCase
+):
+    FIXTURE = test_fixtures.PostgresqlOpportunisticFixture
