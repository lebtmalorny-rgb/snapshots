+def _checkpoint_guard(context, instance_uuid, action, values=None):
+    # Local import avoids the facade/helper import cycle. This is deliberately
+    # inside each existing writer, never a separate transaction.
+    from nova.db.main import checkpoints
+    checkpoints.guard_mutation(context, instance_uuid, action, values)
+
+
+def _checkpoint_guard_row(context, model, filters, action, values=None):
+    row = context.session.query(model.instance_uuid).filter_by(
+        **filters).first()
+    if row is None:
+        return
+    owners = {row.instance_uuid}
+    if values and values.get('instance_uuid'):
+        owners.add(values['instance_uuid'])
+    checked_values = dict(values or {})
+    for instance_uuid in sorted(owners):
+        _checkpoint_guard(context, instance_uuid, action, values)
+    if action == 'bdm_update' and 'connection_info' in checked_values:
+        original = context.session.query(model).filter_by(
+            **filters).populate_existing().first()
+        try:
+            before = jsonutils.loads(original.connection_info or '{}')
+            after = jsonutils.loads(checked_values['connection_info'] or '{}')
+            if (before.get('serial') or original.volume_id) != (
+                    after.get('serial') or original.volume_id):
+                checked_values['serial'] = 'changed'
+        except (ValueError, TypeError, AttributeError):
+            checked_values['serial'] = 'invalid'
+    for instance_uuid in sorted(owners):
+        _checkpoint_guard(context, instance_uuid, action, checked_values)
+    current = context.session.query(model.instance_uuid).filter_by(
+        **filters).first()
+    if current and current.instance_uuid != row.instance_uuid:
+        raise exception.CheckpointConflict(reason='identity_changed')
