+
+class CheckpointJSON(fields.FieldType):
+    @staticmethod
+    def coerce(obj, attr, value):
+        if not isinstance(value, dict):
+            raise ValueError('Checkpoint JSON object required')
+        return contracts._json(value)
+
+    @staticmethod
+    def to_primitive(obj, attr, value):
+        return contracts._json(value)
+
+    from_primitive = to_primitive
+
+    def get_schema(self):
+        return {'type': ['object']}
+
+
+class CheckpointJSONField(fields.AutoTypedField):
+    AUTO_TYPE = CheckpointJSON()
+
+
+class _VersionOne:
+    def obj_make_compatible(self, primitive, target_version):
+        if target_version != '1.0':
+            raise ovo_exc.UnsupportedObjectError(objtype=self.obj_name())
+        super().obj_make_compatible(primitive, target_version)
+
+
+class _Projection(_VersionOne, base.NovaObject, base.NovaObjectDictCompat):
+    VERSION = '1.0'
+    fields = {
+        'created_at': fields.DateTimeField(nullable=True),
+        'updated_at': fields.DateTimeField(nullable=True),
+    }
+
+    @staticmethod
+    def _from_db_object(context, obj, row):
+        for key in obj.fields:
+            obj[key] = row[key]
+        obj._context = context
+        obj.obj_reset_changes()
+        return obj
+
+    @classmethod
+    def _from_row(cls, context, row):
+        if row is None:
+            return None
+        return cls._from_db_object(context, cls(), row)
+
+
+@base.NovaObjectRegistry.register
+class InstanceCheckpoint(_Projection):
+    VERSION = '1.0'
+
+    fields = {
