+class CellDBRaceMixin:
+    USES_DB_SELF = True
+
+    def setUp(self):
+        super().setUp()
+        self.ctx = context.RequestContext('actor', 'project')
+        # Use the actual opportunistic engine with the Nova cell facade.
+        self.engine = enginefacade.writer.get_engine()
+        self.manager = db.create_context_manager(
+            self.engine.url.render_as_string(hide_password=False)
+        )
+        self.ctx.db_connection = self.manager
+        with mock.patch.object(
+            migration, '_get_engine', return_value=self.engine
+        ):
+            migration.db_sync(database='main')
+        self.addCleanup(self.manager.dispose_pool)
+        make_instance(self.ctx)
+
+    def test_same_instance_two_requests_one_winner(self):
+        candidates = [
+            admission(self.ctx),
+            admission(
+                self.ctx,
+                request_id=uuids.request2,
+                operation_id=uuids.op2,
+                checkpoint_id=uuids.checkpoint2,
+            ),
+        ]
+        barrier = threading.Barrier(2)
+        outcomes = []
+
+        def run(candidate):
+            ctx = context.RequestContext('actor', 'project')
+            ctx.db_connection = self.manager
+            barrier.wait(timeout=10)
+            try:
+                checkpoints.admit(ctx, candidate, uuids.ticket)
+                outcomes.append(True)
+            except exception.CheckpointConflict:
+                outcomes.append(False)
+
+        threads = [threading.Thread(target=run, args=(a,)) for a in candidates]
+        for worker in threads:
+            worker.start()
+        for worker in threads:
+            worker.join(timeout=20)
+            self.assertFalse(worker.is_alive())
+        self.assertEqual(2, len(outcomes))
+        self.assertEqual(1, sum(outcomes))
+
