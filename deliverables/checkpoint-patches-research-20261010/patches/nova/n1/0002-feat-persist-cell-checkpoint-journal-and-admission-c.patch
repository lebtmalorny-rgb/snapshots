+
+
+@require_context
+@db.pick_context_manager_reader
+def checkpoints_get(context, instance_uuid, marker=None, limit=100):
+    instance = _instance(context, instance_uuid)
+    c._integer(limit, minimum=1, maximum=1000)
+    query = context.session.query(m.InstanceCheckpoint).filter_by(
+        instance_uuid=instance_uuid, project_id=instance.project_id
+    )
+    if marker:
+        start = _checkpoint(context, marker)
+        if start.instance_uuid != instance_uuid:
