+    return [_row(row) for row in _steps(context, operation_id)]
+
+
+@require_context
+@db.pick_context_manager_reader
+def step_get(context, step_id):
+    step = context.session.get(m.InstanceCheckpointStep, step_id)
+    if step is None:
