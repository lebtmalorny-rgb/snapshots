+
+    @base.remotable_classmethod
+    def get_by_instance_uuid(cls, context, instance_uuid):
+        return cls._from_row(context, db.guard_get(context, instance_uuid))
+
+
+@base.NovaObjectRegistry.register
+class InstanceCheckpointList(
+    _VersionOne, base.ObjectListBase, base.NovaObject
+):
