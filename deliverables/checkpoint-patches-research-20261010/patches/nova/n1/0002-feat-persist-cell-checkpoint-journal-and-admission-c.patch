+"""Checkpoint projections and explicit remotable transitions.
+
+Only JSON primitives cross these calls; no dataclass is sent through RPC.
+Compute delegates SQL to conductor through standard object indirection.
+"""
+
+from oslo_versionedobjects import exception as ovo_exc
+
+from nova.checkpoints import contracts
