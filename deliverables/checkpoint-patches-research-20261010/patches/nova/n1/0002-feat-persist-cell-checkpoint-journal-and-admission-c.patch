+"""Cell-local checkpoint journal. SQL transactions never contain external I/O.
+
+Every ownership transition serializes on the Instance row, then guard,
+checkpoint, operation and children. The SQLite write fence acquires the same
+serialization before a read; MySQL/PostgreSQL also use row locks. Identity
+mutation paths join this fence in guards integration.
+"""
+
+import hashlib
+import secrets
+
+from oslo_db import api as oslo_db_api
+from oslo_serialization import jsonutils
+from oslo_utils import uuidutils
+import sqlalchemy as sa
+
+from nova.checkpoints import contracts as c
+from nova.checkpoints import workflow
+from nova.compute import task_states
+from nova.compute import vm_states
+from nova import conf
+from nova.db.main import api as db
+from nova.db.main import models as m
+from nova.db.utils import require_context
+from nova import exception
+
+CONF = conf.CONF
+_JSON_COLUMNS = frozenset(
+    ('device_manifest', 'admission', 'payload', 'result')
+)
+
+
+def _conflict(reason='operation_conflict'):
+    raise exception.CheckpointConflict(reason=reason)
+
+
+def _row(row):
+    if row is None:
+        return None
+    value = {
+        column.name: getattr(row, column.name)
+        for column in row.__table__.columns
+    }
+    for key in _JSON_COLUMNS & value.keys():
+        if value[key] is not None:
+            value[key] = jsonutils.loads(value[key])
+    return value
+
+
+def _encode(value):
+    return jsonutils.dumps(value, sort_keys=True, separators=(',', ':'))
+
+
+def _authorize(context, project_id):
+    if not context.is_admin and context.project_id != project_id:
+        raise exception.NotFound()
+
+
+def _instance(context, instance_uuid, lock=False):
+    query = context.session.query(m.Instance).filter_by(
+        uuid=instance_uuid, deleted=0
+    )
+    if lock:
+        # Explicit updated_at assignment prevents the no-op fence from changing
+        # a user-visible timestamp. SQLite SELECT FOR UPDATE alone is no fence.
+        query.update(
+            {
+                m.Instance.uuid: m.Instance.uuid,
+                m.Instance.updated_at: m.Instance.updated_at,
+            },
+            synchronize_session=False,
+        )
+        query = query.with_for_update()
+    instance = query.first()
+    if instance is None:
+        raise exception.InstanceNotFound(instance_id=instance_uuid)
+    _authorize(context, instance.project_id)
+    return instance
+
+
+def _guard(context, instance_uuid):
+    guard = (
+        context.session.query(m.InstanceCheckpointGuard)
+        .filter_by(instance_uuid=instance_uuid)
+        .with_for_update()
+        .first()
+    )
+    if guard is None:
+        guard = m.InstanceCheckpointGuard(
+            instance_uuid=instance_uuid,
+            generation=1,
+            checkpoint_count=0,
+            version=1,
+        )
+        context.session.add(guard)
+        context.session.flush()
+    return guard
+
+
+def _checkpoint(context, checkpoint_id, lock=False):
+    query = context.session.query(m.InstanceCheckpoint).filter_by(
+        uuid=checkpoint_id
+    )
+    if lock:
+        query = query.with_for_update()
+    checkpoint = query.first()
+    if checkpoint is None:
+        raise exception.NotFound()
+    _authorize(context, checkpoint.project_id)
+    return checkpoint
+
+
+def _operation(context, operation_id):
+    operation = (
+        context.session.query(m.InstanceCheckpointOperation)
+        .filter_by(uuid=operation_id)
+        .first()
+    )
+    if operation is None:
+        raise exception.NotFound()
+    _authorize(context, operation.project_id)
+    return operation
+
+
+def _owned(context, operation_id, generation=1):
+    # The first read locates the immutable instance UUID; refresh after
+    # locking.
+    operation = _operation(context, operation_id)
+    instance = _instance(context, operation.instance_uuid, lock=True)
+    guard = _guard(context, instance.uuid)
+    checkpoint = _checkpoint(context, operation.checkpoint_id, lock=True)
+    context.session.refresh(operation, with_for_update=True)
+    if (
+        type(generation) is not int or
+        generation != 1 or
+        operation.generation != generation or
+        guard.operation_id != operation.uuid or
+        guard.generation != generation or
+        checkpoint.active_operation_id != operation.uuid
+    ):
+        _conflict('guard_busy')
+    return instance, guard, checkpoint, operation
+
+
+def _manifest(context, instance):
+    extra = (
+        context.session.query(m.InstanceExtra)
+        .filter_by(instance_uuid=instance.uuid, deleted=0)
+        .first()
+    )
+    try:
+        flavor_info = jsonutils.loads(extra.flavor)
+        flavor = flavor_info['cur']['nova_object.data']
+        if flavor_info.get('old') or flavor_info.get('new'):
+            _conflict('invalid_state')
+        flavor = {
+            key: flavor[key]
+            for key in (
+                'memory_mb',
+                'vcpus',
+                'root_gb',
+                'ephemeral_gb',
+                'swap',
+                'extra_specs',
+            )
+        }
+        keys = []
+        if instance.key_data:
+            keys.append(hashlib.sha256(instance.key_data.encode()).hexdigest())
+        if extra.keypairs:
+            keypairs = jsonutils.loads(extra.keypairs)['nova_object.data']
+            for key in keypairs['objects']:
+                public = key['nova_object.data']['public_key']
+                keys.append(hashlib.sha256(public.encode()).hexdigest())
+        properties = {
+            item.key[6:]: item.value
+            for item in context.session.query(
+                m.InstanceSystemMetadata
+            ).filter_by(instance_uuid=instance.uuid, deleted=0)
+            if item.key.startswith(('image_hw_', 'image_os_secure_'))
+        }
+        properties.update(
+            {
+                key: getattr(instance, key)
+                for key in (
+                    'image_ref',
+                    'architecture',
+                    'vm_mode',
+                    'os_type',
+                    'root_device_name',
+                )
+            }
+        )
+        disks = []
+        bdms = (
+            context.session.query(m.BlockDeviceMapping)
+            .filter_by(instance_uuid=instance.uuid, deleted=0)
+            .order_by(m.BlockDeviceMapping.uuid)
+            .all()
+        )
+        for bdm in bdms:
+            if (
+                bdm.destination_type != 'volume' or
+                not bdm.volume_id or
+                bdm.device_type not in ('disk', None)
+            ):
+                raise ValueError('unsupported disk')
+            connection = jsonutils.loads(bdm.connection_info or '{}')
+            disks.append(
+                dict(
+                    uuid=bdm.uuid,
+                    volume_id=bdm.volume_id,
+                    serial=connection.get('serial') or bdm.volume_id,
+                    device_name=bdm.device_name,
+                    boot_index=bdm.boot_index,
+                )
+            )
+        cache = (
+            context.session.query(m.InstanceInfoCache)
+            .filter_by(instance_uuid=instance.uuid, deleted=0)
+            .first()
+        )
+        networks = jsonutils.loads(cache.network_info or '[]') if cache else []
+        vifs = (
+            context.session.query(m.VirtualInterface)
+            .filter_by(instance_uuid=instance.uuid, deleted=0)
+            .all()
+        )
+        ports = [
+            dict(
+                uuid=port['id'],
+                mac=port['address'],
+                network_uuid=port['network']['id'],
+                vnic_type=port['vnic_type'],
+                model=port['model'],
+            )
+            for port in networks
+        ]
+        if {(vif.uuid, vif.address) for vif in vifs} != {
+            (port['uuid'], port['mac']) for port in ports
+        }:
+            raise ValueError('network identity unavailable')
+        shares = [
+            item.share_id
+            for item in context.session.query(m.ShareMapping).filter_by(
+                instance_uuid=instance.uuid
+            )
+        ]
+        manifest = dict(
+            instance_uuid=instance.uuid,
+            host=instance.host,
+            node=instance.node,
+            flavor=flavor,
+            image_properties=properties,
+            config_drive=instance.config_drive or None,
+            disks=disks,
+            ports=ports,
+            shares=shares,
+            runtime_key_fingerprints=keys,
+        )
+        return c.device_projection(manifest)
+    except (ValueError, TypeError, KeyError, AttributeError):
+        raise exception.CheckpointNotSupported(reason='unsupported_profile')
+
+
+@require_context
+@db.pick_context_manager_reader
+def device_manifest(context, instance_uuid):
+    return _manifest(context, _instance(context, instance_uuid))
+
+
+def _request(context, key):
+    operation = (
+        context.session.query(m.InstanceCheckpointOperation)
+        .filter_by(
+            project_id=key.project_id,
+            instance_uuid=key.instance_uuid,
+            request_id=key.request_id,
+        )
+        .first()
+    )
+    if operation:
+        if operation.actor_user_id != key.actor_user_id:
+            raise exception.NotFound()
+        if (
+            operation.kind != key.kind or
+            operation.payload_hash != key.payload_hash
+        ):
+            _conflict()
+    return operation
+
+
+@require_context
+@db.pick_context_manager_reader
+def find_request(context, key):
+    _authorize(context, key.project_id)
+    return _row(_request(context, key))
+
+
+@require_context
+@oslo_db_api.wrap_db_retry(max_retries=5, retry_on_deadlock=True)
+@db.pick_context_manager_writer
+def admit(context, admission, ticket_id):
+    a = admission
+    c._uuid(ticket_id)
+    instance = _instance(context, a.key.instance_uuid, lock=True)
+    if instance.project_id != a.key.project_id or (
+        not context.is_admin and context.user_id != a.key.actor_user_id
+    ):
+        raise exception.NotFound()
+    if context.session.get(
+        m.InstanceCheckpointAdmissionTombstone, a.operation_id
+    ):
+        _conflict('admission_cancelled')
+    existing = _request(context, a.key)
+    if existing:
+        return _row(existing)
+    if context.session.get(m.InstanceCheckpointOperation, a.operation_id):
+        _conflict()
+    guard = _guard(context, instance.uuid)
+    if guard.operation_id or guard.ordinary_claim_uuid:
+        _conflict('guard_busy')
+    if instance.task_state is not None or (
+        a.key.kind in ('create', 'revert') and
+        instance.vm_state != vm_states.ACTIVE
+    ):
+        _conflict('invalid_state')
+    if c.device_fingerprint(_manifest(context, instance)) != a.fingerprint:
+        _conflict('identity_changed')
+    if a.key.kind == 'create':
+        if (
+            guard.checkpoint_count >=
+            CONF.checkpoint.max_checkpoints_per_instance
+        ):
+            raise exception.CheckpointQuotaExceeded()
+        if context.session.get(m.InstanceCheckpoint, a.checkpoint_id):
+            _conflict()
+        checkpoint = m.InstanceCheckpoint(
+            uuid=a.checkpoint_id,
+            instance_uuid=instance.uuid,
+            project_id=a.key.project_id,
+            creator_user_id=a.key.actor_user_id,
+            name=a.name,
+            status='creating',
+            host=a.host,
+            node=a.node,
+            cell_uuid=a.cell_uuid,
+            format_version=1,
+            fingerprint=a.fingerprint,
+            device_manifest=_encode(a.to_primitive()['device_manifest']),
+            quota_ticket_id=ticket_id,
+            create_operation_id=a.operation_id,
+            active_operation_id=a.operation_id,
+            artifact_upper_bound=a.artifact_upper_bound,
+        )
+        context.session.add(checkpoint)
+        for disk in a.device_manifest['disks']:
+            context.session.add(
+                m.InstanceCheckpointDisk(
+                    uuid=uuidutils.generate_uuid(),
+                    checkpoint_id=a.checkpoint_id,
+                    bdm_uuid=disk['uuid'],
+                    volume_id=disk['volume_id'],
+                    serial=disk['serial'],
+                    device_name=disk['device_name'],
+                    boot_index=disk['boot_index'],
+                    state='reserved',
+                )
+            )
+        guard.checkpoint_count += 1
+    else:
+        checkpoint = _checkpoint(context, a.checkpoint_id, lock=True)
+        if (
+            checkpoint.instance_uuid != instance.uuid or
+            checkpoint.project_id != a.key.project_id
+        ):
+            raise exception.NotFound()
+        if (
+            checkpoint.status != 'available' or
+            checkpoint.quota_ticket_id != ticket_id or
+            checkpoint.fingerprint != a.fingerprint or
+            checkpoint.cell_uuid != a.cell_uuid or
+            checkpoint.active_operation_id is not None
+        ):
+            _conflict('identity_changed')
+        checkpoint.active_operation_id = a.operation_id
+        if a.key.kind == 'delete':
+            checkpoint.status = 'deleting'
+    operation = m.InstanceCheckpointOperation(
+        uuid=a.operation_id,
+        instance_uuid=instance.uuid,
+        checkpoint_id=a.checkpoint_id,
+        project_id=a.key.project_id,
+        actor_user_id=a.key.actor_user_id,
+        request_id=a.key.request_id,
+        payload_hash=a.key.payload_hash,
+        kind=a.key.kind,
+        generation=1,
+        executor_id=a.executor_id,
+        host=a.host,
+        node=a.node,
+        cell_uuid=a.cell_uuid,
+        state='reserved',
+        previous_vm_state=instance.vm_state,
+        previous_power_state=instance.power_state,
+        previous_task_state=instance.task_state,
+        quota_ticket_id=ticket_id,
+        quota_ready=False,
+        quota_released=False,
+        version=1,
+        admission=_encode(a.to_primitive()),
+    )
+    context.session.add(operation)
+    guard.operation_id = a.operation_id
+    guard.token = secrets.token_hex(32)
+    guard.version += 1
+    instance.task_state = {
+        'create': task_states.CHECKPOINT_CREATING,
+        'revert': task_states.CHECKPOINT_REVERTING,
+        'delete': task_states.CHECKPOINT_DELETING,
+    }[a.key.kind]
+    context.session.flush()
+    return _row(operation)
+
+
+@require_context
+@oslo_db_api.wrap_db_retry(max_retries=5, retry_on_deadlock=True)
+@db.pick_context_manager_writer
+def cancel_admission(context, admission):
+    a = admission
+    instance = _instance(context, a.key.instance_uuid, lock=True)
+    if instance.project_id != a.key.project_id or a.key.kind != 'create':
+        raise exception.NotFound()
+    existing = context.session.get(
+        m.InstanceCheckpointOperation, a.operation_id
+    )
+    if existing:
+        if existing.admission != _encode(a.to_primitive()):
+            _conflict()
+        instance, guard, checkpoint, operation = _owned(
+            context, a.operation_id
+        )
+        if (
+            context.session.query(m.InstanceCheckpointStep)
+            .filter_by(operation_id=a.operation_id)
+            .first()
+        ):
+            _conflict('recovery_required')
+        # Keep accepted request history and ownership until quota is refunded.
+        # A pre-effect admitted cancellation has no resources to delete.
+        for disk in _disks(context, a.checkpoint_id):
+            disk.state = 'deleted'
+        checkpoint.terminal_operation_id = operation.uuid
+        operation.state = 'failed'
+        operation.error_code = 'admission_cancelled'
+        operation.version += 1
+        context.session.flush()
+        return c.CloseProof(
+            a.operation_id,
+            a.operation_id,
+            a.checkpoint_id,
+            a.cell_uuid,
+            'resources_deleted',
+        )
+    tombstone = context.session.get(
+        m.InstanceCheckpointAdmissionTombstone, a.operation_id
+    )
+    if tombstone:
+        if tombstone.admission != _encode(a.to_primitive()):
+            _conflict()
+    else:
+        context.session.add(
+            m.InstanceCheckpointAdmissionTombstone(
+                operation_id=a.operation_id,
+                cell_uuid=a.cell_uuid,
+                instance_uuid=instance.uuid,
+                project_id=a.key.project_id,
+                actor_user_id=a.key.actor_user_id,
+                request_id=a.key.request_id,
+                payload_hash=a.key.payload_hash,
+                checkpoint_id=a.checkpoint_id,
+                admission=_encode(a.to_primitive()),
+            )
+        )
+        context.session.flush()
+    return c.CloseProof(
+        a.operation_id,
+        a.operation_id,
+        a.checkpoint_id,
+        a.cell_uuid,
+        'admission_cancelled',
+    )
+
+
+@require_context
+@db.pick_context_manager_writer
+def mark_quota_ready(context, operation_id, ticket_id):
+    instance, guard, checkpoint, operation = _owned(context, operation_id)
+    if (
+        operation.quota_ticket_id != ticket_id or
+        operation.state not in ('reserved', 'running') or
+        checkpoint.terminal_operation_id
+    ):
+        _conflict()
+    if not operation.quota_ready:
+        operation.quota_ready = True
+        operation.version += 1
+
+
+def _disks(context, checkpoint_id):
+    return (
+        context.session.query(m.InstanceCheckpointDisk)
+        .filter_by(checkpoint_id=checkpoint_id)
+        .order_by(m.InstanceCheckpointDisk.uuid)
+        .all()
+    )
+
+
+def _artifacts(context, checkpoint_id):
+    return (
+        context.session.query(m.InstanceCheckpointArtifact)
+        .filter_by(checkpoint_id=checkpoint_id)
+        .order_by(m.InstanceCheckpointArtifact.uuid)
+        .all()
+    )
+
+
+def _steps(context, operation_id):
+    return (
+        context.session.query(m.InstanceCheckpointStep)
+        .filter_by(operation_id=operation_id)
+        .order_by(m.InstanceCheckpointStep.uuid)
+        .all()
+    )
+
+
+@require_context
+@db.pick_context_manager_writer
+def claim_step(context, operation_id, generation, phase, executor_id):
+    instance, guard, checkpoint, operation = _owned(
+        context, operation_id, generation
+    )
+    if (
+        not operation.quota_ready or
+        operation.executor_id != executor_id or
+        operation.state not in ('reserved', 'running', 'recovery_required') or
+        (instance.host, instance.node) != (operation.host, operation.node)
+    ):
+        _conflict()
+    phases = workflow.steps_for(operation.kind)
+    if phase not in phases:
+        _conflict()
+    steps = {step.phase: step for step in _steps(context, operation_id)}
+    if phase in steps:
+        return None
+    if any(
+        name not in steps or steps[name].status != 'succeeded'
+        for name in phases[: phases.index(phase)]
+    ):
+        _conflict()
+    if any(name in steps for name in phases[phases.index(phase) + 1:]):
+        _conflict()
+    payload = dict(
+        instance_uuid=instance.uuid,
+        checkpoint_id=checkpoint.uuid,
+        host=operation.host,
+        node=operation.node,
+        fingerprint=checkpoint.fingerprint,
+        device_manifest=jsonutils.loads(checkpoint.device_manifest),
+        disks=[
+            {
+                key: value
+                for key, value in _row(disk).items()
+                if key not in ('created_at', 'updated_at')
+            }
+            for disk in _disks(context, checkpoint.uuid)
+        ],
+        artifacts=[
+            {
+                key: value
+                for key, value in _row(item).items()
+                if key not in ('created_at', 'updated_at')
+            }
+            for item in _artifacts(context, checkpoint.uuid)
+        ],
+        previous_results={
+            name: jsonutils.loads(step.result) for name, step in steps.items()
+        },
+    )
+    intent = c.StepIntent(
+        uuidutils.generate_uuid(),
+        operation_id,
+        generation,
+        phase,
+        executor_id,
+        c.canonical_payload_hash(payload),
+        payload,
+    )
+    context.session.add(
+        m.InstanceCheckpointStep(
+            uuid=intent.id,
+            operation_id=operation_id,
+            generation=generation,
+            phase=phase,
+            executor_id=executor_id,
+            payload_hash=intent.payload_hash,
+            payload=_encode(intent.to_primitive()['payload']),
+            status='dispatching',
+            version=1,
+        )
+    )
+    operation.state = 'running'
+    operation.phase = phase
+    operation.version += 1
+    context.session.flush()
+    return intent
+
+
+def _bind_result(context, checkpoint, step, result):
+    """Match complete evidence to the identities in the journal."""
+    if result.status != 'succeeded':
+        return result
+    e = result.evidence
+    disks = _disks(context, checkpoint.uuid)
+    artifacts = _artifacts(context, checkpoint.uuid)
+    valid = True
+    if 'fingerprint' in e:
+        valid &= e['fingerprint'] == checkpoint.fingerprint
+    if 'host' in e:
+        valid &= (e['host'], e['node']) == (checkpoint.host, checkpoint.node)
+    if 'volume_ids' in e:
+        valid &= set(e['volume_ids']) == {disk.volume_id for disk in disks}
+    if 'port_ids' in e:
+        manifest = jsonutils.loads(checkpoint.device_manifest)
+        valid &= set(e['port_ids']) == {
+            port['uuid'] for port in manifest['ports']
+        }
+    if 'snapshots' in e and step.phase != 'disk_snapshot':
+        valid &= {
+            (item['volume_id'], item['snapshot_id']) for item in e['snapshots']
+        } == {(disk.volume_id, disk.snapshot_id) for disk in disks}
+    if 'artifact_ids' in e:
+        valid &= set(e['artifact_ids']) == {item.uuid for item in artifacts}
+    if step.phase == 'artifact_publish':
+        valid &= {
+            (a['id'], a['logical_id'], a['checksum'], a['bytes'])
+            for a in e['artifacts']
+        } == {
+            (a.uuid, a.logical_id, a.checksum, a.actual_bytes)
+            for a in artifacts
+        }
+    if step.phase == 'runtime_save':
+        valid &= sum(a['bytes'] for a in e['artifacts']) <= (
+            checkpoint.artifact_upper_bound
+        )
+        valid &= any(a['kind'] == 'ram' for a in e['artifacts'])
+    if step.phase == 'cinder_release':
+        reserve = (
+            context.session.query(m.InstanceCheckpointStep)
+            .filter_by(operation_id=step.operation_id, phase='cinder_reserve')
+            .one()
+        )
+        reserved = jsonutils.loads(reserve.result)['evidence']
+        valid &= e['operation_id'] == reserved['operation_id']
+        valid &= e['generation'] == reserved['generation']
+    return result if valid else c.StepResult('unknown', {}, 'identity_changed')
+
+
+def _record_resources(context, checkpoint, step, result):
+    evidence = result.to_primitive()['evidence']
+    if step.phase == 'runtime_save':
+        for item in evidence['artifacts']:
+            context.session.add(
+                m.InstanceCheckpointArtifact(
+                    uuid=item['id'],
+                    checkpoint_id=checkpoint.uuid,
+                    kind=item['kind'],
+                    logical_id=item['logical_id'],
+                    expected_upper_bound=checkpoint.artifact_upper_bound,
+                    actual_bytes=item['bytes'],
+                    checksum=item['checksum'],
+                    state='staging',
+                )
+            )
+    elif step.phase == 'artifact_publish':
+        for item in _artifacts(context, checkpoint.uuid):
+            item.state = 'available'
+    elif step.phase == 'disk_snapshot':
+        snapshots = {
+            item['volume_id']: item['snapshot_id']
+            for item in evidence['snapshots']
+        }
+        reserved = (
+            context.session.query(m.InstanceCheckpointStep)
+            .filter_by(operation_id=step.operation_id, phase='cinder_reserve')
+            .one()
+        )
+        cinder_id = jsonutils.loads(reserved.result)['evidence'][
+            'operation_id'
+        ]
+        for disk in _disks(context, checkpoint.uuid):
+            disk.snapshot_id = snapshots[disk.volume_id]
+            disk.cinder_operation_id = cinder_id
+            disk.state = 'available'
+    elif step.phase == 'disk_snapshot_delete':
+        for disk in _disks(context, checkpoint.uuid):
+            disk.state = 'deleted'
+    elif step.phase == 'artifact_delete':
+        for item in _artifacts(context, checkpoint.uuid):
+            item.state = 'deleted'
+
+
+@require_context
+@db.pick_context_manager_writer
+def finish_step(context, step_id, generation, result):
+    step = context.session.get(m.InstanceCheckpointStep, step_id)
+    if step is None:
+        raise exception.NotFound()
+    instance, guard, checkpoint, operation = _owned(
+        context, step.operation_id, generation
+    )
+    context.session.refresh(step, with_for_update=True)
+    result = c.validate_result(step.phase, result.to_primitive())
+    result = _bind_result(context, checkpoint, step, result)
+    encoded = _encode(result.to_primitive())
+    if step.status in ('succeeded', 'failed_no_effect'):
+        if step.result != encoded:
+            _conflict()
+        return
+    if result.status == 'succeeded':
+        _record_resources(context, checkpoint, step, result)
+    step.result = encoded
+    step.status = result.status
+    step.version += 1
+    operation.version += 1
+    operation.error_code = result.error_code
+    if result.status in ('unknown', 'failed_no_effect'):
+        operation.state = 'recovery_required'
+        instance.task_state = task_states.CHECKPOINT_RECOVERING
+
+
+@require_context
+@db.pick_context_manager_writer
+def finalize(context, operation_id, generation, outcome):
+    operation = _operation(context, operation_id)
+    if (
+        type(generation) is not int or
+        generation != 1 or
+        outcome != 'succeeded'
+    ):
+        _conflict()
+    if operation.state in ('succeeded', 'released'):
+        return _row(operation)
+    instance, guard, checkpoint, operation = _owned(
+        context, operation_id, generation
+    )
+    phases = workflow.steps_for(operation.kind)
+    steps = {step.phase: step for step in _steps(context, operation_id)}
+    # An executor's diagnostic code is not a cell cancellation proof.
+    cancelled = (operation.kind == 'create' and not steps and
+                 operation.state == 'failed' and
+                 checkpoint.terminal_operation_id == operation_id and
+                 operation.error_code == 'admission_cancelled')
+    if not cancelled and any(
+        phase not in steps or steps[phase].status != 'succeeded'
+        for phase in phases
+    ):
+        _conflict('resources_remaining')
+    closing = operation.kind == 'delete' or cancelled
+    if closing:
+        if any(
+            item.state != 'deleted'
+            for item in _disks(context, checkpoint.uuid) +
+            _artifacts(context, checkpoint.uuid)
+        ):
+            _conflict('resources_remaining')
+        checkpoint.terminal_operation_id = operation_id
+        operation.state = 'failed' if cancelled else 'running'
+        if not operation.quota_released:
+            context.session.flush()
+            return _row(operation)
+        checkpoint.status = 'deleted'
+        guard.checkpoint_count -= 1
+        operation.state = 'released'
+    else:
+        checkpoint.status = 'available'
+        operation.state = 'succeeded'
+    checkpoint.active_operation_id = None
+    guard.operation_id = None
+    guard.token = None
+    guard.version += 1
+    operation.version += 1
+    instance.task_state = operation.previous_task_state
+    context.session.flush()
+    return _row(operation)
+
+
+@require_context
+@db.pick_context_manager_reader
+def close_proof(context, create_operation_id):
+    tombstone = context.session.get(
+        m.InstanceCheckpointAdmissionTombstone, create_operation_id
+    )
+    if tombstone:
+        _authorize(context, tombstone.project_id)
+        return c.CloseProof(
+            create_operation_id,
+            create_operation_id,
+            tombstone.checkpoint_id,
+            tombstone.cell_uuid,
+            'admission_cancelled',
+        )
+    operation = context.session.get(
+        m.InstanceCheckpointOperation, create_operation_id
+    )
+    if not operation:
+        return None
+    _authorize(context, operation.project_id)
+    checkpoint = _checkpoint(context, operation.checkpoint_id)
+    if (
+        operation.kind != 'create' or
+        checkpoint.create_operation_id != operation.uuid
+    ):
+        _conflict()
+    if not checkpoint.terminal_operation_id:
+        return None
+    return c.CloseProof(
+        create_operation_id,
+        checkpoint.terminal_operation_id,
+        checkpoint.uuid,
+        checkpoint.cell_uuid,
+        'resources_deleted',
+    )
+
+
+@require_context
+@db.pick_context_manager_writer
+def mark_quota_released(context, closing_operation_id, ticket_id):
+    operation = _operation(context, closing_operation_id)
+    if operation.quota_released and operation.quota_ticket_id == ticket_id:
+        return
+    instance, guard, checkpoint, operation = _owned(
+        context, closing_operation_id
+    )
+    if (
+        checkpoint.terminal_operation_id != closing_operation_id or
+        checkpoint.quota_ticket_id != ticket_id
+    ):
+        _conflict()
+    operation.quota_released = True
+    operation.version += 1
+
+
+@require_context
+@db.pick_context_manager_reader
+def get_by_uuid(context, operation_id):
+    return _row(_operation(context, operation_id))
+
+
+@require_context
+@db.pick_context_manager_reader
