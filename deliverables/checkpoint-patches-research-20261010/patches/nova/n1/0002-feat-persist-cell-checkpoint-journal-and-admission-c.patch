+        query = query.filter(
+            sa.or_(
+                m.InstanceCheckpoint.created_at > start.created_at,
+                sa.and_(
+                    m.InstanceCheckpoint.created_at == start.created_at,
+                    m.InstanceCheckpoint.uuid > start.uuid,
