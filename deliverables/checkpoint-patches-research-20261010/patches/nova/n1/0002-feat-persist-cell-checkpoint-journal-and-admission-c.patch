+        'quota_ticket_id': fields.UUIDField(),
+        'create_operation_id': fields.UUIDField(),
+        'active_operation_id': fields.UUIDField(nullable=True),
+        'terminal_operation_id': fields.UUIDField(nullable=True),
+        'artifact_upper_bound': fields.IntegerField(),
+    }
+
+    @base.remotable_classmethod
+    def get_by_uuid(cls, context, checkpoint_id):
+        return cls._from_row(
+            context, db.checkpoint_get(context, checkpoint_id)
+        )
+
