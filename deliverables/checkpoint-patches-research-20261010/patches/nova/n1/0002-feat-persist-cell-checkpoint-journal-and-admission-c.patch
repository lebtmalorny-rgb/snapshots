+        'version': fields.IntegerField(),
+        'admission': CheckpointJSONField(),
+    }
+
+    @base.remotable_classmethod
+    def admit(cls, context, admission, ticket_id):
+        admission = contracts.Admission.from_primitive(admission)
+        return cls._from_row(context, db.admit(context, admission, ticket_id))
+
+    @base.remotable_classmethod
+    def cancel_admission(cls, context, admission):
+        admission = contracts.Admission.from_primitive(admission)
+        return db.cancel_admission(context, admission).to_primitive()
+
+    @base.remotable_classmethod
+    def mark_quota_ready(cls, context, operation_id, ticket_id):
+        db.mark_quota_ready(context, operation_id, ticket_id)
+
+    @base.remotable_classmethod
+    def get_by_uuid(cls, context, operation_id):
+        return cls._from_row(context, db.get_by_uuid(context, operation_id))
+
+    @base.remotable_classmethod
+    def find_request(cls, context, key):
+        key = contracts.RequestKey.from_primitive(key)
+        return cls._from_row(context, db.find_request(context, key))
+
+    @base.remotable_classmethod
+    def claim_step(cls, context, operation_id, generation, phase, executor_id):
+        intent = db.claim_step(
+            context, operation_id, generation, phase, executor_id
+        )
+        return intent.to_primitive() if intent else None
+
+    @base.remotable_classmethod
+    def finish_step(cls, context, step_id, generation, result):
+        result = contracts.StepResult.from_primitive(result)
+        db.finish_step(context, step_id, generation, result)
+
+    @base.remotable_classmethod
+    def finalize(cls, context, operation_id, generation, outcome):
+        return cls._from_row(
+            context, db.finalize(context, operation_id, generation, outcome)
+        )
+
+    @base.remotable_classmethod
+    def close_proof(cls, context, create_operation_id):
+        proof = db.close_proof(context, create_operation_id)
+        return proof.to_primitive() if proof else None
+
+    @base.remotable_classmethod
+    def mark_quota_released(cls, context, closing_operation_id, ticket_id):
+        db.mark_quota_released(context, closing_operation_id, ticket_id)
+
+    @base.remotable_classmethod
+    def device_manifest(cls, context, instance_uuid):
+        return db.device_manifest(context, instance_uuid)
+
+
+@base.NovaObjectRegistry.register
+class InstanceCheckpointStep(_Projection):
+    VERSION = '1.0'
+
+    fields = {
+        'uuid': fields.UUIDField(),
