+
+@ddt.ddt
+class ServerCheckpointsTest(test_api.APIFixture):
+    def setUp(self):
+        super().setUp()
+        self.useFixture(
+            fixtures.MockPatch(
+                'nova.checkpoints.api.API', return_value=self.api
+            )
+        )
+        self.app = fakes.wsgi_app_v21(fake_auth_context=self.ctx)
+
+    def request(
+        self, method, suffix, body=None, version='2.106', headers=None
+    ):
+        req = webob.Request.blank(
+            '/v2.1/servers/%s/%s' % (uuids.instance, suffix)
+        )
+        req.method = method
+        req.headers['OpenStack-API-Version'] = 'compute ' + version
+        if headers:
+            req.headers.update(headers)
+        if body is not None:
+            req.content_type = 'application/json'
+            req.body = jsonutils.dump_as_bytes(body)
+        return req.get_response(self.app)
+
+    @ddt.data(
+        ('GET', 'checkpoint-capabilities'),
+        ('GET', 'checkpoints'),
+        ('POST', 'checkpoints'),
+        ('GET', 'checkpoints/{id}'),
+        ('DELETE', 'checkpoints/{id}'),
+        ('POST', 'checkpoints/{id}/action'),
+        ('GET', 'checkpoint-operations/{id}'),
+    )
+    @ddt.unpack
+    def test_old_microversion_has_no_routes(self, method, path):
+        response = self.request(
+            method, path.format(id=uuids.cp), version='2.105'
+        )
+        self.assertEqual(404, response.status_int, response.text)
+
+    @ddt.data(
+        {'include_memory': False},
+        {'quiesce': True},
+        {'disks': []},
+        {'target_state': 'SHUTOFF'},
+        {'extra': 1},
+        {'name': 'x' * 256},
+        {'request_id': 'invalid'},
+    )
+    def test_strict_create_schema(self, extra):
+        body = dict(request_id=uuids.request)
+        body.update(extra)
+        response = self.request('POST', 'checkpoints', {'checkpoint': body})
+        self.assertEqual(400, response.status_int, response.text)
+        self.task_rpc.checkpoint_probe.assert_not_called()
+
+    @ddt.data(None, '', 'invalid')
+    def test_delete_requires_uuid_header(self, value):
+        headers = (
+            {} if value is None else {'OpenStack-Checkpoint-Request-ID': value}
+        )
+        response = self.request(
+            'DELETE', 'checkpoints/' + uuids.cp, headers=headers
+        )
+        self.assertEqual(400, response.status_int, response.text)
+
+    @ddt.data(
+        'checkpoints?limit=0',
+        'checkpoints?limit=1001',
+        'checkpoints?unknown=1',
+        'checkpoint-capabilities?unknown=1',
+    )
+    def test_strict_query_schema(self, path):
+        response = self.request('GET', path)
+        self.assertEqual(400, response.status_int, response.text)
+
+    def test_seven_routes_lifecycle_and_safe_response_fields(self):
+        response = self.request('GET', 'checkpoint-capabilities')
+        self.assertEqual(200, response.status_int, response.text)
+        self.assertTrue(response.json['capabilities']['supported'])
+        response = self.request(
+            'POST',
+            'checkpoints',
+            {'checkpoint': {'request_id': uuids.request, 'name': 'A'}},
+        )
+        self.assertEqual(202, response.status_int, response.text)
+        cp = response.json['checkpoint']['id']
+        op = response.json['operation']['id']
+        self.complete(self.api.operation_get(self.ctx, uuids.instance, op))
+        for path in (
+            'checkpoints',
+            'checkpoints/' + cp,
+            'checkpoint-operations/' + op,
+        ):
+            response = self.request('GET', path)
+            self.assertEqual(200, response.status_int, response.text)
+            for forbidden in (
+                'compute',
+                'node',
+                'token',
+                'manifest',
+                'connection_info',
+                'logical_id',
+                'evidence',
+            ):
+                self.assertNotIn(forbidden, response.text)
+        response = self.request(
+            'POST',
+            'checkpoints/%s/action' % cp,
+            {'revert': {'request_id': uuids.revert_request}},
+        )
+        self.assertEqual(202, response.status_int, response.text)
+        self.complete(
+            self.api.operation_get(
+                self.ctx, uuids.instance, response.json['operation']['id']
+            )
+        )
+        response = self.request(
+            'DELETE',
+            'checkpoints/' + cp,
+            headers={'OpenStack-Checkpoint-Request-ID': uuids.delete_request},
+        )
+        self.assertEqual(202, response.status_int, response.text)
+        deleted_op = response.json['operation']['id']
+        self.complete(
+            self.api.operation_get(self.ctx, uuids.instance, deleted_op)
+        )
+        response = self.request('GET', 'checkpoint-operations/' + deleted_op)
+        self.assertEqual(200, response.status_int, response.text)
+        self.assertEqual('released', response.json['operation']['state'])
+
+    @ddt.data(True, None)
+    def test_create_memory_true_or_default(self, include_memory):
+        body = dict(request_id=uuids.request)
+        if include_memory is not None:
+            body['include_memory'] = include_memory
+        response = self.request('POST', 'checkpoints', {'checkpoint': body})
+        self.assertEqual(202, response.status_int, response.text)
+
+    @ddt.data(
+        {},
+        {'revert': {}},
+        {'revert': {'request_id': 'bad'}},
+        {
+            'revert': {
+                'request_id': 'aaaaaaaa-aaaa-4aaa-aaaa-aaaaaaaaaaaa',
+                'target_state': 'SHUTOFF',
+            }
+        },
+    )
+    def test_strict_revert_schema(self, body):
+        response = self.request(
+            'POST', 'checkpoints/%s/action' % uuids.cp, body
+        )
+        self.assertEqual(400, response.status_int, response.text)
+
+    def test_missing_request_id_is_400(self):
+        response = self.request('POST', 'checkpoints', {'checkpoint': {}})
+        self.assertEqual(400, response.status_int, response.text)
+
+    def test_pagination_and_deleted_checkpoint_visibility(self):
+        first, op = self.create()
+        self.complete(op)
+        second, op = self.create(request_id=uuids.request2)
+        self.complete(op)
+        response = self.request('GET', 'checkpoints?limit=1')
+        self.assertEqual(
+            [first.uuid], [c['id'] for c in response.json['checkpoints']]
+        )
+        response = self.request(
+            'GET', 'checkpoints?limit=1000&marker=' + first.uuid
+        )
+        self.assertEqual(
+            [second.uuid], [c['id'] for c in response.json['checkpoints']]
+        )
+        deletion = self.api.delete(
+            self.ctx, uuids.instance, first.uuid, uuids.delete_request
+        )
+        self.complete(deletion)
+        response = self.request('GET', 'checkpoints/' + first.uuid)
+        self.assertEqual(404, response.status_int, response.text)
+        response = self.request('GET', 'checkpoints')
+        self.assertEqual(
+            [second.uuid], [c['id'] for c in response.json['checkpoints']]
+        )
+
+    @ddt.data(
+        ('disabled', 409),
+        ('quota', 413),
+        ('foreign', 404),
+        ('cell', 503),
+        ('reader', 403),
+        ('executor', 409),
+    )
+    @ddt.unpack
+    def test_public_error_statuses(self, case, code):
+        if case == 'disabled':
+            self.flags(enabled=False, group='checkpoint')
+        elif case == 'quota':
+            self.flags(max_artifact_bytes_per_project=0, group='checkpoint')
+        elif case == 'foreign':
+            self.ctx.project_id = 'foreign'
+        elif case == 'reader':
+            self.ctx.roles = ['reader']
+        elif case == 'executor':
+            self.task_rpc.checkpoint_probe.side_effect = None
+            self.task_rpc.checkpoint_probe.return_value = c.unsupported(
+                'executor_unsupported'
+            ).to_primitive()
+        else:
+            self.useFixture(
+                fixtures.MockPatchObject(
+                    objects.Instance,
+                    'get_by_uuid',
+                    side_effect=TimeoutError('private-backend-secret'),
+                )
+            )
+        response = self.request(
+            'POST',
+            'checkpoints',
+            {'checkpoint': {'request_id': uuids.request}},
+        )
+        self.assertEqual(code, response.status_int, response.text)
+        self.assertNotIn('private-backend-secret', response.text)
