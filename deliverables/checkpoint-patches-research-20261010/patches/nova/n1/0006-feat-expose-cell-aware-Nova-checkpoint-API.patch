+from nova.tests.unit.checkpoints import test_cell_db
+
+
+class APIFixture(test.TestCase):
+    NUMBER_OF_CELLS = 2
+
+    def setUp(self):
+        super().setUp()
+        from nova.checkpoints import api
+
+        self.flags(
+            enabled=True,
+            max_artifact_bytes_per_project=16384,
+            group='checkpoint',
+        )
+        self.useFixture(fixtures.RealPolicyFixture())
+        self.ctx = context.RequestContext(
+            'actor', 'project', roles=['member', 'reader']
+        )
+        self.cell = self.cell_mappings['cell1']
+        with context.target_cell(self.ctx, self.cell) as ctx:
+            test_cell_db.make_instance(ctx)
+            objects.Service(
+                ctx, host='compute', binary='nova-compute', topic='compute'
+            ).create()
+        objects.InstanceMapping(
+            self.ctx,
+            instance_uuid=uuids.instance,
+            cell_mapping=self.cell,
+            project_id='project',
+        ).create()
+        self.driver = fake_executor.FakeCheckpointDriver()
+        self.executor = compute.ComputeExecutor(self.driver, 'compute')
+        self.compute_rpc = mock.Mock()
+        self.compute_rpc.checkpoint_probe.side_effect = lambda *a, **kw: (
+            self.executor.probe(*a, **kw).to_primitive()
+        )
+        self.compute_rpc.checkpoint_execute.side_effect = self.executor.execute
+        self.ledger = quota.QuotaLedger()
+        self.coordinator = coordinator.Coordinator(
+            self.compute_rpc, self.ledger
+        )
+        self.task_rpc = mock.Mock()
+        self.task_rpc.checkpoint_probe.side_effect = lambda *a, **kw: (
+            self.coordinator.probe(*a, **kw).to_primitive()
+        )
+        self.api = api.API(conductor_api=self.task_rpc, ledger=self.ledger)
+
+    def create(self, request_id=uuids.request, **kw):
+        return self.api.create(
+            self.ctx, uuids.instance, dict(request_id=request_id, **kw)
+        )
+
+    def complete(self, op):
+        self.coordinator.run(self.ctx, op.instance_uuid, op.uuid, 1)
+
+    def usage(self):
+        return quota_db.get_usage(self.ctx, 'project')
+
+
+@ddt.ddt
+class CheckpointAPITest(APIFixture):
+    def test_exact_replay_after_disabled_returns_durable_operation(self):
+        cp, op = self.create(name='A')
+        self.assertTrue(op.quota_ready)
+        self.flags(enabled=False, group='checkpoint')
+        cp2, op2 = self.create(name='A', include_memory=True)
+        self.assertEqual((cp.uuid, op.uuid), (cp2.uuid, op2.uuid))
+        self.assertEqual(1, self.usage()['checkpoint_count'])
+        self.assertEqual(1, self.task_rpc.checkpoint_probe.call_count)
+
+    def test_replay_actor_and_payload_are_not_transferable(self):
+        cp, op = self.create(name='A')
+        other = context.RequestContext(
+            'other', 'project', roles=['member', 'reader']
+        )
+        self.assertRaises(
+            exception.NotFound,
+            self.api.create,
+            other,
+            uuids.instance,
+            dict(name='A', request_id=uuids.request),
+        )
+        self.assertRaises(exception.CheckpointConflict, self.create, name='B')
+        self.assertRaises(
+            exception.CheckpointConflict,
+            self.api.delete,
+            self.ctx,
+            uuids.instance,
+            cp.uuid,
+            uuids.request,
+        )
