+#    License for the specific language governing permissions and limitations
+#    under the License.
+
+import functools
+
+import webob
+
+from oslo_utils import uuidutils
+
+from nova.api.openstack.compute.schemas import server_checkpoints as schema
+from nova.api.openstack.compute.views import server_checkpoints as views
+from nova.api.openstack import wsgi
+from nova.api import validation
+from nova.checkpoints import api
+from nova import exception
+
+
+def _http_errors(method):
+    @functools.wraps(method)
+    def wrapped(*args, **kwargs):
+        try:
+            return method(*args, **kwargs)
+        except exception.NotFound:
+            raise webob.exc.HTTPNotFound(
+                explanation='Resource could not be found'
+            ) from None
+        except exception.CheckpointConflict as exc:
+            status = {
+                409: webob.exc.HTTPConflict,
+                413: webob.exc.HTTPRequestEntityTooLarge,
+                503: webob.exc.HTTPServiceUnavailable,
+            }[exc.code]
+            raise status(explanation=exc.format_message()) from None
+
+    return wrapped
+
+
+class ServerCheckpointsController(wsgi.Controller):
+    def __init__(self):
+        super().__init__()
+        self.api = api.API()
+
+    @wsgi.Controller.api_version('2.106')
+    @wsgi.expected_errors((400, 403, 404, 409, 503))
+    @_http_errors
+    @validation.query_schema(schema.empty_query)
+    def capabilities(self, req, server_id):
+        return {
+            'capabilities': self.api.capabilities(
+                req.environ['nova.context'], server_id
+            )
+        }
+
+    @wsgi.Controller.api_version('2.106')
+    @wsgi.expected_errors((400, 403, 404, 503))
+    @_http_errors
+    @validation.query_schema(schema.index_query)
+    def index(self, req, server_id):
+        checkpoints = self.api.list(
+            req.environ['nova.context'],
+            server_id,
+            marker=req.GET.get('marker'),
+            limit=int(req.GET.get('limit', 100)),
+        )
+        return {'checkpoints': [views.checkpoint(cp) for cp in checkpoints]}
+
+    @wsgi.Controller.api_version('2.106')
+    @wsgi.expected_errors((400, 403, 404, 503))
+    @_http_errors
+    @validation.query_schema(schema.empty_query)
+    def show(self, req, server_id, id):
+        return {
+            'checkpoint': views.checkpoint(
+                self.api.get(req.environ['nova.context'], server_id, id)
+            )
+        }
+
+    @wsgi.Controller.api_version('2.106')
+    @wsgi.response(202)
+    @wsgi.expected_errors((400, 403, 404, 409, 413, 503))
+    @_http_errors
+    @validation.query_schema(schema.empty_query)
+    @validation.schema(schema.create)
+    def create(self, req, server_id, body):
+        checkpoint, operation = self.api.create(
+            req.environ['nova.context'], server_id, body['checkpoint']
+        )
+        return {
+            'checkpoint': views.checkpoint(checkpoint),
+            'operation': views.operation(operation),
+        }
+
+    @wsgi.Controller.api_version('2.106')
+    @wsgi.response(202)
+    @wsgi.expected_errors((400, 403, 404, 409, 413, 503))
+    @_http_errors
+    @validation.query_schema(schema.empty_query)
+    @validation.schema(schema.revert)
+    def revert(self, req, server_id, id, body):
+        return {
+            'operation': views.operation(
+                self.api.revert(
+                    req.environ['nova.context'],
+                    server_id,
+                    id,
+                    body['revert']['request_id'],
+                )
+            )
+        }
+
+    @wsgi.Controller.api_version('2.106')
+    @wsgi.response(202)
+    @wsgi.expected_errors((400, 403, 404, 409, 413, 503))
+    @_http_errors
+    @validation.query_schema(schema.empty_query)
+    def delete(self, req, server_id, id):
+        request_id = req.headers.get('OpenStack-Checkpoint-Request-ID')
+        if not request_id or not uuidutils.is_uuid_like(request_id):
+            raise webob.exc.HTTPBadRequest(
+                explanation='OpenStack-Checkpoint-Request-ID must be a UUID'
+            )
+        return {
+            'operation': views.operation(
+                self.api.delete(
+                    req.environ['nova.context'], server_id, id, request_id
+                )
+            )
+        }
+
+    @wsgi.Controller.api_version('2.106')
+    @wsgi.expected_errors((400, 403, 404, 503))
+    @_http_errors
+    @validation.query_schema(schema.empty_query)
+    def operation_show(self, req, server_id, id):
+        return {
+            'operation': views.operation(
+                self.api.operation_get(
+                    req.environ['nova.context'], server_id, id
+                )
+            )
+        }
