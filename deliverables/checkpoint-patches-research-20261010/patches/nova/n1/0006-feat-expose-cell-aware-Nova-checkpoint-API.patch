+                )
+            return self._finish_admission(context, cell, operation)
+
+    def revert(self, context, instance_uuid, checkpoint_id, request_id):
+        return self._existing(
+            context, instance_uuid, checkpoint_id, request_id, 'revert'
+        )
+
+    def delete(self, context, instance_uuid, checkpoint_id, request_id):
+        return self._existing(
+            context, instance_uuid, checkpoint_id, request_id, 'delete'
+        )
