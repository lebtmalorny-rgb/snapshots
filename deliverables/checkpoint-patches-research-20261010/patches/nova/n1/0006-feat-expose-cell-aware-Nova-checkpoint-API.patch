+
+from oslo_policy import policy
+
+from nova.policies import base
+
+POLICY_ROOT = 'os_compute_api:server_checkpoints:%s'
+
+_ACTIONS = (
+    ('capabilities', 'GET', '/checkpoint-capabilities', False),
+    ('index', 'GET', '/checkpoints', False),
+    ('show', 'GET', '/checkpoints/{checkpoint_id}', False),
+    ('create', 'POST', '/checkpoints', True),
+    ('revert', 'POST', '/checkpoints/{checkpoint_id}/action', True),
+    ('delete', 'DELETE', '/checkpoints/{checkpoint_id}', True),
+    ('operation_show', 'GET', '/checkpoint-operations/{operation_id}', False),
+)
+
+
+def list_rules():
+    return [
+        policy.DocumentedRuleDefault(
+            name=POLICY_ROOT % action,
+            check_str=base.PROJECT_MEMBER if write else base.PROJECT_READER,
+            description='Private server checkpoint %s' % action,
+            operations=[
+                {'method': method, 'path': '/servers/{server_id}' + path}
+            ],
+            scope_types=['project'],
+        )
+        for action, method, path, write in _ACTIONS
+    ]
