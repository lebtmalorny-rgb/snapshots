+    @ddt.data('capabilities', 'index', 'show', 'operation_show')
+    def test_reader_allowed_in_project_only(self, action):
+        ctx = context.RequestContext('reader', 'project', roles=['reader'])
+        name = 'os_compute_api:server_checkpoints:' + action
+        self.assertTrue(ctx.can(name, target={'project_id': 'project'}))
+        self.assertRaises(
+            exception.PolicyNotAuthorized,
+            ctx.can,
+            name,
+            target={'project_id': 'other'},
+        )
+
+    @ddt.data('create', 'revert', 'delete')
+    def test_member_required_in_project(self, action):
+        name = 'os_compute_api:server_checkpoints:' + action
+        member = context.RequestContext(
+            'member', 'project', roles=['member', 'reader']
+        )
+        reader = context.RequestContext('reader', 'project', roles=['reader'])
+        self.assertTrue(member.can(name, target={'project_id': 'project'}))
+        self.assertRaises(
+            exception.PolicyNotAuthorized,
+            reader.can,
+            name,
+            target={'project_id': 'project'},
