+
+"""Explicit public projections: never serialize a journal object wholesale."""
+
+
+def _timestamp(value):
+    return value.isoformat() if value else None
+
+
+def checkpoint(value):
+    return dict(
+        id=value.uuid,
+        server_id=value.instance_uuid,
+        name=value.name,
+        status=value.status,
+        created_at=_timestamp(value.created_at),
+        operation_id=value.active_operation_id,
+    )
+
+
+def operation(value):
+    return dict(
+        id=value.uuid,
+        checkpoint_id=value.checkpoint_id,
+        kind=value.kind,
+        state=value.state,
+        phase=value.phase,
+        error_code=value.error_code,
+        created_at=_timestamp(value.created_at),
+        updated_at=_timestamp(value.updated_at),
+    )
diff --git a/nova/checkpoints/api.py b/nova/checkpoints/api.py
new file mode 100644
index 0000000..379f7b3
--- /dev/null
+++ b/nova/checkpoints/api.py
@@ -0,0 +1,309 @@
+#    Licensed under the Apache License, Version 2.0 (the "License"); you may
+#    not use this file except in compliance with the License. You may obtain
+#    a copy of the License at
+#
+#         http://www.apache.org/licenses/LICENSE-2.0
+#
+#    Unless required by applicable law or agreed to in writing, software
+#    distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+#    WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+#    License for the specific language governing permissions and limitations
+#    under the License.
+
+"""Cell-aware, project-scoped admission for private checkpoint API 2.106."""
+
+import contextlib
+import uuid
+
+from oslo_utils import uuidutils
+
+from nova.checkpoints import contracts as c
+from nova.checkpoints import quota
+from nova.conductor import api as conductor
+from nova import conf
+from nova import context as nova_context
+from nova import exception
+from nova import objects
+from nova.policies import server_checkpoints as policies
+
+
+class API:
+    def __init__(self, conductor_api=None, ledger=None):
+        self.conductor = conductor_api or conductor.ComputeTaskAPI()
+        self.ledger = ledger or quota.QuotaLedger()
+
+    @contextlib.contextmanager
+    def _server(self, context, instance_uuid, action):
+        try:
+            mapping = objects.InstanceMapping.get_by_instance_uuid(
+                context, instance_uuid
+            )
+            if (
+                not context.project_id or
+                context.project_id != mapping.project_id
+            ):
+                raise exception.NotFound()
+            context.can(
+                policies.POLICY_ROOT % action,
+                target={'project_id': mapping.project_id},
+            )
+            cell = mapping.cell_mapping
+            if cell is None or cell.is_cell0():
+                raise exception.CheckpointUnavailable(
+                    reason='cell_unavailable'
+                )
+            with nova_context.target_cell(context, cell) as ctx:
+                instance = objects.Instance.get_by_uuid(ctx, instance_uuid)
+                if instance.project_id != context.project_id:
+                    raise exception.NotFound()
+                yield ctx, instance, cell
+        except exception.NovaException:
+            raise
+        except Exception:
+            raise exception.CheckpointUnavailable(
+                reason='cell_unavailable'
+            ) from None
+
+    @staticmethod
+    def _checkpoint(context, instance_uuid, checkpoint_id):
+        checkpoint = objects.InstanceCheckpoint.get_by_uuid(
+            context, checkpoint_id
+        )
+        if (
+            checkpoint.instance_uuid != instance_uuid or
+            checkpoint.project_id != context.project_id
+        ):
+            raise exception.NotFound()
+        return checkpoint
+
+    @staticmethod
+    def _key(context, instance_uuid, request_id, kind, payload):
+        return c.RequestKey(
+            context.project_id,
+            instance_uuid,
+            str(uuid.UUID(request_id)),
+            context.user_id,
+            kind,
+            c.canonical_payload_hash(payload),
+        )
+
+    def _probe(self, context, instance_uuid, checkpoint_id=None):
+        try:
+            kwargs = (
+                {}
+                if checkpoint_id is None
+                else {'checkpoint_id': checkpoint_id}
+            )
+            result = self.conductor.checkpoint_probe(
+                context, instance_uuid, **kwargs
+            )
+            return c.validate_probe(result)
+        except exception.CheckpointConflict:
+            raise
+        except Exception:
+            raise exception.CheckpointUnavailable() from None
+
+    @staticmethod
+    def _supported(probe):
+        if probe.supported:
+            return
+        reason = probe.reasons[0]
+        if reason in ('executor_unavailable', 'cell_unavailable'):
+            raise exception.CheckpointUnavailable(reason=reason)
+        raise exception.CheckpointNotSupported(reason=reason)
+
+    def capabilities(self, context, instance_uuid):
+        with self._server(context, instance_uuid, 'capabilities'):
+            probe = (
+                self._probe(context, instance_uuid)
+                if conf.CONF.checkpoint.enabled
+                else c.unsupported('disabled')
+            )
+        return dict(
+            supported=probe.supported,
+            reasons=list(probe.reasons),
+            profile=probe.executor_profile if probe.supported else None,
+        )
+
+    def list(self, context, instance_uuid, marker=None, limit=100):
+        with self._server(context, instance_uuid, 'index') as (
+            ctx,
+            inst,
+            cell,
+        ):
+            return objects.InstanceCheckpointList.get_by_instance_uuid(
+                ctx, instance_uuid, marker=marker, limit=limit
+            )
+
+    def get(self, context, instance_uuid, checkpoint_id):
+        with self._server(context, instance_uuid, 'show') as (ctx, inst, cell):
+            checkpoint = self._checkpoint(ctx, instance_uuid, checkpoint_id)
+            if checkpoint.status == 'deleted':
+                raise exception.NotFound()
+            return checkpoint
+
+    def operation_get(self, context, instance_uuid, operation_id):
+        with self._server(context, instance_uuid, 'operation_show') as (
+            ctx,
+            inst,
+            cell,
+        ):
+            operation = objects.InstanceCheckpointOperation.get_by_uuid(
+                ctx, operation_id
+            )
+            if (
+                operation.instance_uuid != instance_uuid or
+                operation.project_id != context.project_id
+            ):
+                raise exception.NotFound()
+            return operation
+
+    def _finish_admission(self, context, cell, operation):
+        if operation.state in ('succeeded', 'released', 'failed'):
+            return operation
+        if not operation.quota_ready:
+            if operation.kind == 'create':
+                self.ledger.confirm(context, operation.quota_ticket_id)
+            else:
+                ticket = self.ledger.get(context, operation.quota_ticket_id)
+                with nova_context.target_cell(context, cell) as ctx:
+                    checkpoint = self._checkpoint(
+                        ctx, operation.instance_uuid, operation.checkpoint_id
+                    )
+                if (
+                    ticket.operation_id != checkpoint.create_operation_id or
+                    ticket.state != 'confirmed' or
+                    ticket.project_id != operation.project_id or
+                    ticket.instance_uuid != operation.instance_uuid or
+                    ticket.checkpoint_id != operation.checkpoint_id or
+                    ticket.cell_uuid != cell.uuid
+                ):
+                    raise exception.CheckpointConflict(
+                        reason='operation_conflict'
+                    )
+            with nova_context.target_cell(context, cell) as ctx:
+                objects.InstanceCheckpointOperation.mark_quota_ready(
+                    ctx, operation.uuid, operation.quota_ticket_id
+                )
+                operation = objects.InstanceCheckpointOperation.get_by_uuid(
+                    ctx, operation.uuid
+                )
+        try:
+            self.conductor.checkpoint_run(
+                context,
+                operation.instance_uuid,
+                operation.uuid,
+                operation.generation,
+            )
+        except Exception:
+            # Durable acceptance is not cancelled by a lost dispatch reply.
+            # Reconciliation will read this exact operation/step journal.
+            pass
+        return operation
+
+    def create(self, context, instance_uuid, body):
+        payload = dict(name=body.get('name', ''), include_memory=True)
+        with self._server(context, instance_uuid, 'create') as (
+            ctx,
+            inst,
+            cell,
+        ):
+            key = self._key(
+                context, instance_uuid, body['request_id'], 'create', payload
+            )
+            operation = objects.InstanceCheckpointOperation.find_request(
+                ctx, key.to_primitive()
+            )
+            if operation is None:
+                if not conf.CONF.checkpoint.enabled:
+                    raise exception.CheckpointNotSupported(reason='disabled')
+                probe = self._probe(context, instance_uuid)
+                self._supported(probe)
+                manifest = probe.to_primitive()['device_manifest']
+                admission = c.Admission(
+                    key,
+                    uuidutils.generate_uuid(),
+                    uuidutils.generate_uuid(),
+                    cell.uuid,
+                    manifest['host'],
+                    manifest['node'],
+                    probe.fingerprint,
+                    manifest,
+                    probe.artifact_upper_bound,
+                    probe.executor_id,
+                    name=payload['name'],
+                )
+                ticket = self.ledger.reserve(context, admission)
+                # A concurrent request may have won the unique ticket key.
+                admission = c.Admission.from_primitive(ticket.admission)
+                if (
+                    ticket.cell_uuid != cell.uuid or
+                    admission.cell_uuid != cell.uuid
+                ):
+                    raise exception.CheckpointConflict(
+                        reason='identity_changed'
+                    )
+                try:
+                    operation = objects.InstanceCheckpointOperation.admit(
+                        ctx, admission.to_primitive(), ticket.id
+                    )
+                except (exception.CheckpointConflict, exception.NotFound):
+                    objects.InstanceCheckpointOperation.cancel_admission(
+                        ctx, admission.to_primitive()
+                    )
+                    self.ledger.release(context, ticket.id)
+                    raise
+            operation = self._finish_admission(context, cell, operation)
+            checkpoint = self._checkpoint(
+                ctx, instance_uuid, operation.checkpoint_id
+            )
+            return checkpoint, operation
+
+    def _existing(
+        self, context, instance_uuid, checkpoint_id, request_id, kind
+    ):
+        with self._server(context, instance_uuid, kind) as (ctx, inst, cell):
+            key = self._key(
+                context,
+                instance_uuid,
+                request_id,
+                kind,
+                {'checkpoint_id': checkpoint_id},
+            )
+            operation = objects.InstanceCheckpointOperation.find_request(
+                ctx, key.to_primitive()
+            )
+            if operation is None:
+                checkpoint = self._checkpoint(
+                    ctx, instance_uuid, checkpoint_id
+                )
+                probe = self._probe(context, instance_uuid, checkpoint_id)
+                self._supported(probe)
+                manifest = probe.to_primitive()['device_manifest']
+                admission = c.Admission(
+                    key,
+                    uuidutils.generate_uuid(),
