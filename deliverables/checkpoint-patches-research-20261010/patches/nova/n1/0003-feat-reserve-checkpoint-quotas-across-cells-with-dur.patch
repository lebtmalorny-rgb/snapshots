+def _budget_checkpoint(context, operation_id):
+    operation = _operation(context, operation_id)
+    _instance(context, operation.instance_uuid, lock=True)
+    _guard(context, operation.instance_uuid)
+    checkpoint = _checkpoint(context, operation.checkpoint_id, lock=True)
+    if (operation.kind != 'create' or
+            checkpoint.create_operation_id != operation_id or
+            checkpoint.terminal_operation_id or
+            checkpoint.active_operation_id not in (None, operation_id)):
+        _conflict()
+    return checkpoint
+
+
+@require_context
+@db.pick_context_manager_writer
+def set_artifact_budget(context, operation_id, ticket_version, total_bytes):
+    c._integer(ticket_version, minimum=1)
+    c._integer(total_bytes, minimum=1)
+    checkpoint = _budget_checkpoint(context, operation_id)
+    if ticket_version < checkpoint.artifact_budget_version:
+        _conflict()
+    if ticket_version == checkpoint.artifact_budget_version:
+        if total_bytes != checkpoint.artifact_upper_bound:
+            _conflict()
+        return
+    if total_bytes < checkpoint.artifact_upper_bound:
+        _conflict()
+    save = context.session.query(m.InstanceCheckpointStep).filter_by(
+        operation_id=operation_id, phase='runtime_save').first()
+    if save and save.status not in ('succeeded', 'failed_no_effect'):
+        _conflict('recovery_required')
+    checkpoint.artifact_upper_bound = total_bytes
+    checkpoint.artifact_budget_version = ticket_version
+
+
+@require_context
+@db.pick_context_manager_writer
+def confirm_artifact_usage(context, operation_id, manifest):
+    checkpoint = _budget_checkpoint(context, operation_id)
+    publish = context.session.query(m.InstanceCheckpointStep).filter_by(
+        operation_id=operation_id, phase='artifact_publish').first()
+    if (not publish or publish.status != 'succeeded' or
+            manifest != jsonutils.loads(publish.result)['evidence']):
+        _conflict('resources_remaining')
+    artifacts = _artifacts(context, checkpoint.uuid)
+    if not artifacts or any(item.state != 'available' for item in artifacts):
+        _conflict('resources_remaining')
+    byte_count = sum(item.actual_bytes for item in artifacts)
+    if byte_count > checkpoint.artifact_upper_bound:
+        _conflict()
+    proof = dict(create_operation_id=operation_id,
+                 checkpoint_id=checkpoint.uuid, cell_uuid=checkpoint.cell_uuid,
+                 bytes=byte_count,
+                 ticket_version=checkpoint.artifact_budget_version,
+                 artifacts=[dict(id=item.uuid, checksum=item.checksum,
+                                 bytes=item.actual_bytes)
+                            for item in artifacts])
+    if checkpoint.artifact_usage_proof:
+        previous = jsonutils.loads(checkpoint.artifact_usage_proof)
+        previous.pop('revision')
+        if previous == proof:
+            return
+    checkpoint.artifact_usage_revision += 1
+    proof['revision'] = checkpoint.artifact_usage_revision
+    # Revoke the larger cell write budget BEFORE reducing the global charge.
+    checkpoint.artifact_upper_bound = byte_count
+    checkpoint.artifact_usage_proof = _encode(proof)
+
+
+@require_context
+@db.pick_context_manager_reader
+def artifact_usage_proof(context, create_operation_id):
+    operation = _operation(context, create_operation_id)
+    checkpoint = _checkpoint(context, operation.checkpoint_id)
+    if checkpoint.create_operation_id != create_operation_id:
+        _conflict()
+    return (jsonutils.loads(checkpoint.artifact_usage_proof)
+            if checkpoint.artifact_usage_proof else None)
