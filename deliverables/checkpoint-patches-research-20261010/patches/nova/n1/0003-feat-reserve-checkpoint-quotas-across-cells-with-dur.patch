+class QuotaRaceMixin:
+    USES_DB_SELF = True
+    NUMBER_OF_CELLS = 2
+
+    def setUp(self):
+        super().setUp()
+        self.flags(
+            max_checkpoints_per_project=1,
+            max_artifact_bytes_per_project=8192,
+            group='checkpoint',
+        )
+        engine = enginefacade.writer.get_engine()
+        self.manager = enginefacade.transaction_context()
+        self.manager.configure(
+            connection=engine.url.render_as_string(hide_password=False)
+        )
+        self.useFixture(
+            test_fixtures.ReplaceEngineFacadeFixture(
+                api_db.context_manager, self.manager
+            )
+        )
+        with mock.patch.object(migration, '_get_engine', return_value=engine):
+            migration.db_sync(database='api')
+        self.addCleanup(self.manager.dispose_pool)
+        self._setup_cells()
+        self.ctx = context.RequestContext('actor', 'project')
+        self.candidates = []
+        for index, name in enumerate(('cell1', 'cell2')):
+            cell = self.cell_mappings[name]
+            with context.target_cell(self.ctx, cell) as ctx:
+                instance_uuid = getattr(uuids, 'instance%d' % index)
+                test_cell_db.make_instance(
+                    ctx,
+                    instance_uuid,
+                    getattr(uuids, 'bdm%d' % index),
+                    getattr(uuids, 'volume%d' % index),
+                )
+                candidate = test_cell_db.admission(
+                    ctx,
+                    instance_uuid=instance_uuid,
+                    request_id=getattr(uuids, 'request%d' % index),
+                    operation_id=getattr(uuids, 'operation%d' % index),
+                    checkpoint_id=getattr(uuids, 'checkpoint%d' % index),
+                )
+                self.candidates.append(replace(candidate, cell_uuid=cell.uuid))
+
+    def test_two_cells_share_one_project_limit(self):
+        barrier = threading.Barrier(2)
+        outcomes = []
+
+        def reserve(candidate):
+            ctx = context.RequestContext('actor', 'project')
+            barrier.wait(timeout=10)
+            try:
+                quota.QuotaLedger().reserve(ctx, candidate)
+                outcomes.append(True)
+            except exception.CheckpointQuotaExceeded:
+                outcomes.append(False)
+
+        threads = [
+            threading.Thread(target=reserve, args=(a,))
+            for a in self.candidates
+        ]
+        for worker in threads:
+            worker.start()
+        for worker in threads:
+            worker.join(timeout=20)
+            self.assertFalse(worker.is_alive())
+        self.assertEqual(2, len(outcomes))
+        self.assertEqual(1, sum(outcomes))
+        usage = quota_db.get_usage(self.ctx, 'project')
+        self.assertEqual(1, usage['checkpoint_count'])
+        self.assertEqual(4096, usage['artifact_bytes'])
+
+
+class QuotaMySQLRace(
+    QuotaRaceMixin, test_fixtures.OpportunisticDBTestMixin, test.NoDBTestCase
+):
+    FIXTURE = test_fixtures.MySQLOpportunisticFixture
+
+
+class QuotaPostgreSQLRace(
+    QuotaRaceMixin, test_fixtures.OpportunisticDBTestMixin, test.NoDBTestCase
+):
+    FIXTURE = test_fixtures.PostgresqlOpportunisticFixture
