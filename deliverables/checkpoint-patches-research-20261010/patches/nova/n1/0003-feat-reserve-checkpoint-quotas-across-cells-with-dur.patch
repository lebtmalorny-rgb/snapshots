+
+from dataclasses import replace
+from unittest import mock
+
+from oslo_utils.fixture import uuidsentinel as uuids
+
+from nova.checkpoints import contracts as c
+from nova.checkpoints import quota
+from nova.checkpoints import workflow
+from nova import context
+from nova.db.api import checkpoints as quota_db
+from nova.db.main import checkpoints as cell_db
+from nova import exception
+from nova import objects
+from nova import test
+from nova.tests.unit.checkpoints import test_cell_db
+
+
+class QuotaTest(test.TestCase):
+    NUMBER_OF_CELLS = 2
+
+    def setUp(self):
+        super().setUp()
+        self.flags(
+            max_checkpoints_per_project=2,
+            max_artifact_bytes_per_project=16384,
+            group='checkpoint',
+        )
+        self.ctx = context.RequestContext('actor', 'project')
+        self.ledger = quota.QuotaLedger()
+        self.cell = self.cell_mappings['cell1']
+        with context.target_cell(self.ctx, self.cell) as ctx:
+            test_cell_db.make_instance(ctx)
+            self.admission = replace(
+                test_cell_db.admission(ctx), cell_uuid=self.cell.uuid
+            )
+
+    def usage(self):
+        return quota_db.get_usage(self.ctx, 'project')
+
+    def reserve_admit(self, confirm=True):
+        ticket = self.ledger.reserve(self.ctx, self.admission)
+        with context.target_cell(self.ctx, self.cell) as ctx:
+            objects.InstanceCheckpointOperation.admit(
+                ctx, self.admission.to_primitive(), ticket.id
+            )
+        if confirm:
+            ticket = self.ledger.confirm(self.ctx, ticket.id)
+            with context.target_cell(self.ctx, self.cell) as ctx:
+                objects.InstanceCheckpointOperation.mark_quota_ready(
+                    ctx, self.admission.operation_id, ticket.id
+                )
+        return ticket
+
+    def complete(self, admission, ticket):
+        with context.target_cell(self.ctx, self.cell) as ctx:
+            if admission.key.kind != 'create':
+                cell_db.admit(ctx, admission, ticket.id)
+                cell_db.mark_quota_ready(
+                    ctx, admission.operation_id, ticket.id
+                )
+            for phase in workflow.steps_for(admission.key.kind):
+                step = cell_db.claim_step(
+                    ctx, admission.operation_id, 1, phase, 'test-executor'
+                )
+                cell_db.finish_step(
+                    ctx,
+                    step.id,
+                    1,
+                    test_cell_db.phase_result(phase, admission.fingerprint),
+                )
+            cell_db.finalize(ctx, admission.operation_id, 1, 'succeeded')
+
+    def test_two_cells_share_one_project_limit(self):
+        self.flags(max_checkpoints_per_project=1, group='checkpoint')
+        first = self.ledger.reserve(self.ctx, self.admission)
+        second_cell = self.cell_mappings['cell2']
+        with context.target_cell(self.ctx, second_cell) as ctx:
+            test_cell_db.make_instance(
+                ctx, uuids.instance2, uuids.bdm2, uuids.volume2
+            )
+            second = test_cell_db.admission(
+                ctx,
+                request_id=uuids.request2,
+                operation_id=uuids.op2,
+                checkpoint_id=uuids.checkpoint2,
+                instance_uuid=uuids.instance2,
+            )
+            second = replace(second, cell_uuid=second_cell.uuid)
+        self.assertRaises(
+            exception.CheckpointQuotaExceeded,
+            self.ledger.reserve,
+            self.ctx,
+            second,
+        )
+        self.assertEqual('held', first.state)
+        self.assertEqual(1, self.usage()['checkpoint_count'])
+        self.assertEqual(4096, self.usage()['artifact_bytes'])
+
+    def test_lost_confirm_retains_charge(self):
+        ticket = self.reserve_admit(confirm=False)
+        self.assertEqual('held', self.ledger.get(self.ctx, ticket.id).state)
+        confirmed = self.ledger.confirm(self.ctx, ticket.id)
+        self.assertEqual('confirmed', confirmed.state)
+        self.assertEqual(
+            confirmed.version, self.ledger.confirm(self.ctx, ticket.id).version
+        )
+        self.assertEqual(4096, self.usage()['artifact_bytes'])
+
+    def test_absent_operation_not_refund_proof(self):
+        ticket = self.ledger.reserve(self.ctx, self.admission)
+        self.assertRaises(
+            exception.CheckpointConflict,
+            self.ledger.release,
+            self.ctx,
+            ticket.id,
+        )
+        self.assertEqual(1, self.usage()['checkpoint_count'])
+
+    def test_cancel_then_queued_admit_never_executes(self):
+        ticket = self.ledger.reserve(self.ctx, self.admission)
+        with context.target_cell(self.ctx, self.cell) as ctx:
+            objects.InstanceCheckpointOperation.cancel_admission(
+                ctx, self.admission.to_primitive()
+            )
+        self.assertEqual(
+            'released', self.ledger.release(self.ctx, ticket.id).state
+        )
+        with context.target_cell(self.ctx, self.cell) as ctx:
+            self.assertRaises(
+                exception.CheckpointConflict,
+                objects.InstanceCheckpointOperation.admit,
+                ctx,
+                self.admission.to_primitive(),
+                ticket.id,
+            )
+            self.assertEqual([], cell_db.steps_get(ctx, uuids.operation))
+        self.assertEqual(0, self.usage()['artifact_bytes'])
+
+    def test_duplicate_create_uses_winning_ids(self):
+        ticket = self.ledger.reserve(self.ctx, self.admission)
+        other = replace(
+            self.admission,
+            operation_id=uuids.candidate_op,
+            checkpoint_id=uuids.candidate_checkpoint,
+        )
+        replay = self.ledger.reserve(self.ctx, other)
+        self.assertEqual(ticket.id, replay.id)
+        self.assertEqual(ticket.operation_id, replay.operation_id)
+        self.assertEqual(ticket.checkpoint_id, replay.checkpoint_id)
+        self.assertEqual(self.admission.to_primitive(), replay.admission)
+        self.assertEqual(1, self.usage()['checkpoint_count'])
+
+    def test_other_actor_or_payload_cannot_reuse_ticket(self):
+        self.ledger.reserve(self.ctx, self.admission)
+        other = replace(
+            self.admission,
+            key=replace(self.admission.key, actor_user_id='other'),
+        )
+        self.assertRaises(
+            exception.NotFound,
+            self.ledger.reserve,
+            context.RequestContext('other', 'project'),
+            other,
+        )
+        other = replace(
+            self.admission,
+            key=replace(self.admission.key, payload_hash='a' * 64),
+        )
+        self.assertRaises(
+            exception.CheckpointConflict, self.ledger.reserve, self.ctx, other
+        )
+
+    def test_refund_once_after_delete(self):
+        ticket = self.reserve_admit()
+        self.complete(self.admission, ticket)
+        deleting = replace(
+            self.admission,
+            operation_id=uuids.delete_op,
+            key=replace(
+                self.admission.key,
+                kind='delete',
+                request_id=uuids.delete_request,
+            ),
+        )
+        self.complete(deleting, ticket)
+        released = self.ledger.release(self.ctx, ticket.id)
+        self.assertEqual('released', released.state)
+        self.assertEqual(
+            released.version, self.ledger.release(self.ctx, ticket.id).version
+        )
+        self.assertEqual(0, self.usage()['checkpoint_count'])
+        self.assertEqual(0, self.usage()['artifact_bytes'])
+        with context.target_cell(self.ctx, self.cell) as ctx:
+            # Ledger release itself does not tear down the cell guard.
+            self.assertEqual(
+                uuids.delete_op,
