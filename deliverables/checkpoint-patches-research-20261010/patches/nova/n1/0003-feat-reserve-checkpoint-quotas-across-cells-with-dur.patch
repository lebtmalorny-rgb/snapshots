+
+"""Two-database checkpoint admission and resource accounting.
+
+API DB writers never span cell/RPC calls. An absent row is not refund evidence:
+the cell must first fence late admission with an immutable cancellation.
+"""
+
+from nova.checkpoints import contracts as c
+from nova import context as nova_context
+from nova.db.api import checkpoints as db
+from nova import exception
+from nova import objects
+
+
+class QuotaLedger:
+    @staticmethod
+    def _object(context, row):
+        return objects.CheckpointQuotaTicket._from_row(context, row)
+
+    @staticmethod
+    def _cell(context, ticket):
+        cell = objects.CellMapping.get_by_uuid(context, ticket.cell_uuid)
+        if cell.is_cell0():
+            raise exception.CheckpointUnavailable(reason='cell_unavailable')
+        return nova_context.target_cell(context, cell)
+
+    def get(self, context, ticket_id):
+        return self._object(context, db.get(context, ticket_id))
+
+    def reserve(self, context, admission):
+        return self._object(context, db.reserve(context, admission))
+
+    def confirm(self, context, ticket_id):
+        ticket = self.get(context, ticket_id)
+        with self._cell(context, ticket) as ctx:
+            operation = objects.InstanceCheckpointOperation.get_by_uuid(
+                ctx, ticket.operation_id
+            )
+        if (
+            operation.admission != ticket.admission or
+            operation.quota_ticket_id != ticket.id or
+            operation.kind != 'create' or
+            operation.state in ('failed', 'released')
+        ):
+            raise exception.CheckpointConflict()
+        confirmed = self._object(context, db._confirm(context, ticket_id))
+        if not operation.quota_ready:
+            with self._cell(context, confirmed) as ctx:
+                objects.InstanceCheckpointOperation.set_artifact_budget(
+                    ctx,
+                    confirmed.operation_id,
+                    confirmed.version,
+                    confirmed.reserved_bytes,
+                )
+        return confirmed
+
+    def grow(self, context, ticket_id, expected_version, total_bytes):
+        ticket = self._object(
+            context,
+            db._grow(context, ticket_id, expected_version, total_bytes),
+        )
+        with self._cell(context, ticket) as ctx:
+            objects.InstanceCheckpointOperation.set_artifact_budget(
+                ctx, ticket.operation_id, ticket.version, ticket.reserved_bytes
+            )
+        return ticket
+
+    def settle(self, context, ticket_id):
+        ticket = self.get(context, ticket_id)
+        with self._cell(context, ticket) as ctx:
+            proof = objects.InstanceCheckpointOperation.artifact_usage_proof(
+                ctx, ticket.operation_id
+            )
+        if proof is None:
+            raise exception.CheckpointConflict(reason='resources_remaining')
+        return self._object(context, db._settle(context, ticket_id, proof))
+
+    def release(self, context, ticket_id):
+        ticket = self.get(context, ticket_id)
+        if ticket.state == 'released':
+            return ticket
+        with self._cell(context, ticket) as ctx:
+            primitive = objects.InstanceCheckpointOperation.close_proof(
+                ctx, ticket.operation_id
+            )
+        if primitive is None:
+            raise exception.CheckpointConflict(reason='resources_remaining')
+        proof = c.CloseProof.from_primitive(primitive)
+        return self._object(context, db._release(context, ticket_id, proof))
+
+    def _reconcile_ticket(self, context, ticket):
+        operation = None
+        with self._cell(context, ticket) as ctx:
+            proof = objects.InstanceCheckpointOperation.close_proof(
+                ctx, ticket.operation_id
+            )
+            if proof is None and ticket.state in ('held', 'confirmed'):
+                try:
+                    operation = (
+                        objects.InstanceCheckpointOperation.get_by_uuid(
+                            ctx, ticket.operation_id
+                        )
+                    )
+                except exception.NotFound:
+                    if ticket.state != 'held':
+                        raise
+                    proof = (
+                        objects.InstanceCheckpointOperation.cancel_admission(
+                            ctx, ticket.admission
+                        )
+                    )
+        if proof:
+            self.release(context, ticket.id)
+            close = c.CloseProof.from_primitive(proof)
+            if close.kind == 'resources_deleted':
+                with self._cell(context, ticket) as ctx:
+                    objects.InstanceCheckpointOperation.mark_quota_released(
+                        ctx, close.closing_operation_id, ticket.id
+                    )
+                    objects.InstanceCheckpointOperation.finalize(
+                        ctx, close.closing_operation_id, 1, 'succeeded'
+                    )
+        elif operation and (
+            ticket.state == 'held' or not operation.quota_ready
+        ):
+            self.confirm(context, ticket.id)
+            with self._cell(context, ticket) as ctx:
+                objects.InstanceCheckpointOperation.mark_quota_ready(
+                    ctx, ticket.operation_id, ticket.id
+                )
+        elif operation and ticket.state == 'confirmed':
+            with self._cell(context, ticket) as ctx:
+                checkpoint = objects.InstanceCheckpoint.get_by_uuid(
+                    ctx, ticket.checkpoint_id)
+                if checkpoint.artifact_budget_version < ticket.version:
+                    objects.InstanceCheckpointOperation.set_artifact_budget(
+                        ctx, ticket.operation_id, ticket.version,
+                        ticket.reserved_bytes)
+
+    def reconcile(self, context, limit=100, marker=None):
+        rows = db.list_tickets(context, marker=marker, limit=limit)
+        report = dict(processed=0, failed=0, next_marker=None)
+        for row in rows:
+            try:
+                self._reconcile_ticket(context, self._object(context, row))
+                report['processed'] += 1
+            except Exception:
+                # Keep charge/ownership. No token, traceback, or backend text
+                # is stored in the public journal as a diagnostic reason.
+                report['failed'] += 1
+        if len(rows) == limit:
+            report['next_marker'] = rows[-1]['id']
+        return report
diff --git a/nova/db/api/checkpoints.py b/nova/db/api/checkpoints.py
new file mode 100644
index 0000000..8cd0c06
--- /dev/null
+++ b/nova/db/api/checkpoints.py
@@ -0,0 +1,315 @@
+#    Licensed under the Apache License, Version 2.0 (the "License"); you may
+#    not use this file except in compliance with the License. You may obtain
+#    a copy of the License at
+#
+#         http://www.apache.org/licenses/LICENSE-2.0
+#
+#    Unless required by applicable law or agreed to in writing, software
+#    distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+#    WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+#    License for the specific language governing permissions and limitations
+#    under the License.
+
+"""Project checkpoint charges in the API database.
+
+No method in this module calls a cell, RPC, driver or external service. Proofs
+are fetched and checked by QuotaLedger before entering these transactions.
+"""
+
+import functools
+
+from oslo_db import api as oslo_db_api
+from oslo_db import exception as db_exc
+from oslo_serialization import jsonutils
+from oslo_utils import uuidutils
+
+from nova.checkpoints import contracts as c
+from nova import conf
+from nova import context as nova_context
+from nova.db.api import api as db
+from nova.db.api import models as m
+from nova.db.utils import require_context
+from nova import exception
+
+CONF = conf.CONF
+
+
+def _transaction(mode):
+    def decorate(fn):
+        @functools.wraps(fn)
+        def wrapped(context, *args, **kwargs):
+            # Never join a caller's cell transaction via oslo.db context state.
+            ctx = nova_context.RequestContext.from_dict(context.to_dict())
+            with getattr(db.context_manager, mode).using(ctx):
+                return fn(ctx, *args, **kwargs)
+
+        return wrapped
+
+    return decorate
+
+
+_writer = _transaction('writer')
+_reader = _transaction('reader')
+_retry = oslo_db_api.wrap_db_retry(
+    max_retries=5,
+    retry_on_deadlock=True,
+    exception_checker=lambda exc: isinstance(exc, db_exc.DBDuplicateEntry),
+)
+
+
+def _conflict():
+    raise exception.CheckpointConflict()
+
+
+def _authorize(context, project_id):
+    if not context.is_admin and context.project_id != project_id:
+        raise exception.NotFound()
+
+
+def _row(row):
+    values = {
+        column.name: getattr(row, column.name)
+        for column in row.__table__.columns
+    }
+    if 'admission' in values:
+        values['admission'] = jsonutils.loads(values['admission'])
+    return values
+
+
+def _ticket(context, ticket_id):
+    ticket = context.session.get(m.CheckpointQuotaTicket, ticket_id)
+    if ticket is None:
+        raise exception.NotFound()
+    _authorize(context, ticket.project_id)
+    return ticket
+
+
+def _usage(context, project_id):
+    _authorize(context, project_id)
+    query = context.session.query(m.CheckpointProjectUsage).filter_by(
+        project_id=project_id
+    )
+    query.update(
+        {
+            m.CheckpointProjectUsage.version: m.CheckpointProjectUsage.version,
+            m.CheckpointProjectUsage.updated_at:
+                m.CheckpointProjectUsage.updated_at,
+        },
+        synchronize_session=False,
+    )
+    row = query.with_for_update().first()
+    if row is None:
+        row = m.CheckpointProjectUsage(
+            project_id=project_id,
+            checkpoint_count=0,
+            artifact_bytes=0,
+            version=1,
+        )
+        context.session.add(row)
+        context.session.flush()
+    return row
+
+
+def _locked_ticket(context, ticket_id):
+    ticket = _ticket(context, ticket_id)
+    usage = _usage(context, ticket.project_id)
+    context.session.refresh(ticket, with_for_update=True)
+    return usage, ticket
+
+
+def _charge(usage, count, byte_count):
+    if (
+        count > CONF.checkpoint.max_checkpoints_per_project or
+        byte_count > CONF.checkpoint.max_artifact_bytes_per_project or
+        byte_count > c.MAX_BYTES or
+        count > c.MAX_BYTES
+    ):
+        raise exception.CheckpointQuotaExceeded()
+    if count < 0 or byte_count < 0:
+        _conflict()
+    usage.checkpoint_count = count
+    usage.artifact_bytes = byte_count
+    usage.version += 1
+
+
+@require_context
+@_reader
+def get(context, ticket_id):
+    return _row(_ticket(context, ticket_id))
+
+
+@require_context
+@_reader
+def get_usage(context, project_id):
+    _authorize(context, project_id)
+    usage = context.session.get(m.CheckpointProjectUsage, project_id)
+    if usage is None:
+        return dict(
+            project_id=project_id,
+            checkpoint_count=0,
+            artifact_bytes=0,
+            version=0,
+        )
+    return _row(usage)
+
+
+@require_context
+@_retry
+@_writer
+def reserve(context, admission):
+    a = admission
+    if a.key.kind != 'create':
+        _conflict()
+    _authorize(context, a.key.project_id)
+    if not context.is_admin and context.user_id != a.key.actor_user_id:
+        raise exception.NotFound()
+    usage = _usage(context, a.key.project_id)
+    ticket = (
+        context.session.query(m.CheckpointQuotaTicket)
+        .filter_by(
+            project_id=a.key.project_id,
+            instance_uuid=a.key.instance_uuid,
+            request_id=a.key.request_id,
+        )
+        .first()
+    )
+    if ticket:
+        if ticket.actor_user_id != a.key.actor_user_id:
+            raise exception.NotFound()
+        if ticket.payload_hash != a.key.payload_hash:
+            _conflict()
+        return _row(ticket)
+    _charge(
+        usage,
+        usage.checkpoint_count + 1,
+        usage.artifact_bytes + a.artifact_upper_bound,
+    )
+    ticket = m.CheckpointQuotaTicket(
+        id=uuidutils.generate_uuid(),
+        operation_id=a.operation_id,
+        checkpoint_id=a.checkpoint_id,
+        project_id=a.key.project_id,
+        instance_uuid=a.key.instance_uuid,
+        actor_user_id=a.key.actor_user_id,
+        request_id=a.key.request_id,
+        payload_hash=a.key.payload_hash,
+        cell_uuid=a.cell_uuid,
+        reserved_bytes=a.artifact_upper_bound,
+        state='held',
+        version=1,
+        settled_proof_revision=0,
+        admission=jsonutils.dumps(a.to_primitive(), sort_keys=True),
+    )
+    context.session.add(ticket)
+    context.session.flush()
+    return _row(ticket)
+
+
+@require_context
+@_retry
+@_writer
+def _confirm(context, ticket_id):
+    usage, ticket = _locked_ticket(context, ticket_id)
+    if ticket.state == 'released':
+        _conflict()
+    if ticket.state == 'held':
+        ticket.state = 'confirmed'
+        ticket.version += 1
+    context.session.flush()
+    return _row(ticket)
+
+
+@require_context
+@_retry
+@_writer
+def _grow(context, ticket_id, expected_version, total_bytes):
+    c._integer(total_bytes, minimum=1)
+    c._integer(expected_version, minimum=1)
+    usage, ticket = _locked_ticket(context, ticket_id)
+    if (
+        ticket.state != 'confirmed' or
+        ticket.version != expected_version or
+        total_bytes < ticket.reserved_bytes
+    ):
+        _conflict()
+    if total_bytes > ticket.reserved_bytes:
+        _charge(
+            usage,
+            usage.checkpoint_count,
+            usage.artifact_bytes + total_bytes - ticket.reserved_bytes,
+        )
+        ticket.reserved_bytes = total_bytes
+        ticket.version += 1
+    context.session.flush()
+    return _row(ticket)
+
+
+@require_context
+@_retry
+@_writer
+def _settle(context, ticket_id, proof):
+    usage, ticket = _locked_ticket(context, ticket_id)
+    c._integer(proof['revision'], minimum=1)
+    c._integer(proof['bytes'])
+    if (
+        proof['create_operation_id'] != ticket.operation_id or
+        proof['checkpoint_id'] != ticket.checkpoint_id or
+        proof['cell_uuid'] != ticket.cell_uuid
+    ):
+        _conflict()
+    if proof['revision'] <= ticket.settled_proof_revision:
+        return _row(ticket)
+    if (
+        ticket.state != 'confirmed' or
+        proof['ticket_version'] != ticket.version or
+        proof['bytes'] > ticket.reserved_bytes
+    ):
+        _conflict()
+    # Decreasing limits must not prevent release of an existing charge.
+    usage.artifact_bytes -= ticket.reserved_bytes - proof['bytes']
+    if usage.artifact_bytes < 0:
+        _conflict()
+    usage.version += 1
+    ticket.reserved_bytes = proof['bytes']
+    ticket.settled_proof_revision = proof['revision']
+    ticket.version += 1
+    context.session.flush()
+    return _row(ticket)
+
+
+@require_context
+@_retry
+@_writer
+def _release(context, ticket_id, proof):
+    usage, ticket = _locked_ticket(context, ticket_id)
+    if (
+        proof.create_operation_id != ticket.operation_id or
+        proof.checkpoint_id != ticket.checkpoint_id or
+        proof.cell_uuid != ticket.cell_uuid
+    ):
+        _conflict()
+    if ticket.state != 'released':
+        usage.checkpoint_count -= 1
+        usage.artifact_bytes -= ticket.reserved_bytes
+        if usage.checkpoint_count < 0 or usage.artifact_bytes < 0:
+            _conflict()
+        usage.version += 1
+        ticket.state = 'released'
+        ticket.version += 1
+    context.session.flush()
+    return _row(ticket)
+
+
+@require_context
+@_reader
+def list_tickets(context, marker=None, limit=100):
+    c._integer(limit, minimum=1, maximum=1000)
+    query = context.session.query(m.CheckpointQuotaTicket)
+    if not context.is_admin:
+        query = query.filter_by(project_id=context.project_id)
+    if marker:
+        query = query.filter(m.CheckpointQuotaTicket.id > marker)
+    return [
+        _row(row)
+        for row in query.order_by(m.CheckpointQuotaTicket.id).limit(limit)
+    ]
