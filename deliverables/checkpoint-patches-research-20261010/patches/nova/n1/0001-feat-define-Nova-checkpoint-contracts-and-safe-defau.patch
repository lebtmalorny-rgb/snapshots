+VOLUME = str(uuid.UUID(int=2))
+OPERATION = str(uuid.UUID(int=3))
+ARTIFACT = str(uuid.UUID(int=4))
+CHECKPOINT = str(uuid.UUID(int=5))
+CELL = str(uuid.UUID(int=6))
+DIGEST = 'a' * 64
+
+
+def manifest():
+    return dict(instance_uuid=INSTANCE, host='compute', node='node',
+                flavor={'memory_mb': 1024, 'vcpus': 1, 'extra_specs': {}},
+                image_properties={}, config_drive=None,
+                disks=[dict(uuid=str(uuid.UUID(int=7)), volume_id=VOLUME,
+                            serial=VOLUME, device_name='/dev/vda',
+                            boot_index=0)],
+                ports=[], shares=[], runtime_key_fingerprints=[])
+
+
+def probe():
+    devices = manifest()
+    return dict(schema_version=1, supported=True, reasons=[],
+                executor_id='test-executor',
+                executor_profile='kvm-bios-same-host-v1',
+                fingerprint=c.device_fingerprint(devices),
+                device_manifest=devices, artifact_upper_bound=1048576,
+                contract_version=1)
+
+
+def success(evidence):
+    return dict(schema_version=1, status='succeeded', evidence=evidence,
+                error_code=None)
+
+
+class ContractsTest(unittest.TestCase):
+    def test_defaults_disabled(self):
+        from nova import conf
+        opts = conf.CONF.checkpoint
+        self.assertFalse(opts.enabled)
+        self.assertEqual((8, 100, 0, 60), (
+            opts.max_checkpoints_per_instance,
+            opts.max_checkpoints_per_project,
+            opts.max_artifact_bytes_per_project, opts.reconcile_interval))
+
+    def test_negative_limits_rejected(self):
+        from oslo_config import cfg
+
+        from nova.conf import checkpoint
+        config = cfg.ConfigOpts()
+        checkpoint.register_opts(config)
+        for name in ('max_checkpoints_per_instance',
+                     'max_checkpoints_per_project',
+                     'max_artifact_bytes_per_project', 'reconcile_interval'):
+            with self.subTest(name=name), self.assertRaises(ValueError):
+                config.set_override(name, -1, group='checkpoint')
+
+    def test_supported_probe_roundtrip(self):
+        value = probe()
+        parsed = c.validate_probe(value)
+        self.assertTrue(parsed.supported)
+        self.assertEqual(value, parsed.to_primitive())
+        self.assertEqual(parsed, c.Probe.from_primitive(value))
+
+    def test_invalid_probe_fails_closed(self):
+        variants = [None, {}, {'supported': True}]
+        for field, value in (
+                ('executor_id', ''), ('executor_profile', 'unknown'),
+                ('contract_version', 2), ('supported', 1),
+                ('artifact_upper_bound', True), ('fingerprint', DIGEST),
+                ('reasons', ['backend password=secret']),
+                ('schema_version', True), ('arbitrary', 'value')):
+            changed = probe()
+            changed[field] = value
+            variants.append(changed)
+        for value in variants:
+            with self.subTest(value=value):
+                result = c.validate_probe(value)
+                self.assertFalse(result.supported)
+                self.assertEqual(('invalid_executor_result',), result.reasons)
+                self.assertEqual({}, result.to_primitive()['device_manifest'])
+
+    def test_phase_success_requires_evidence(self):
+        for kind in ('create', 'revert', 'delete', 'cleanup'):
+            for phase in workflow.steps_for(kind):
+                with self.subTest(phase=phase):
+                    result = c.validate_result(phase, success({}))
+                    self.assertEqual('unknown', result.status)
+                    self.assertEqual('invalid_executor_result',
+                                     result.error_code)
+
+    def test_preflight_evidence_is_typed_and_closed(self):
+        evidence = dict(fingerprint=DIGEST, host='compute', node='node')
+        self.assertEqual('succeeded',
+                         c.validate_result('preflight',
+                                           success(evidence)).status)
+        for field, value in [('fingerprint', 'bad'), ('host', ''),
+                             ('password', 'secret')]:
+            changed = dict(evidence, **{field: value})
+            self.assertEqual('unknown', c.validate_result(
+                'preflight', success(changed)).status)
+
+    def test_runtime_save_requires_all_artifact_fields_and_write_stop(self):
+        evidence = dict(writes_stopped=True, artifacts=[dict(
+            id=ARTIFACT, kind='ram', logical_id='opaque-ram-object',
+            checksum=DIGEST, bytes=1024)])
+        self.assertEqual('succeeded', c.validate_result(
+            'runtime_save', success(evidence)).status)
+        for changed in (dict(evidence, writes_stopped=False),
+                        dict(evidence, artifacts=[]),
+                        dict(evidence, artifacts=[{'id': ARTIFACT}])):
+            self.assertEqual('unknown', c.validate_result(
+                'runtime_save', success(changed)).status)
+
+    def test_each_effect_has_a_closed_success_schema(self):
+        artifacts = [dict(id=ARTIFACT, kind='ram', logical_id='opaque-object',
+                          checksum=DIGEST, bytes=1024)]
+        release = dict(operation_id=OPERATION, generation=1, state='released',
+                       outcome='succeeded')
+        deleted = dict(volume_ids=[VOLUME], snapshots=[dict(
+            volume_id=VOLUME, snapshot_id=CHECKPOINT, status='deleted')])
+        proofs = {
+            'cinder_reserve': dict(operation_id=OPERATION, generation=1,
+                                   volume_ids=[VOLUME], state='reserved'),
+            'runtime_stop': dict(power_state='SHUTOFF', writes_stopped=True),
+            'volume_disconnect': dict(volume_ids=[VOLUME],
+                                      disconnected_volume_ids=[VOLUME]),
+            'disk_revert': dict(volume_ids=[VOLUME], snapshots=[dict(
+                volume_id=VOLUME, snapshot_id=CHECKPOINT, status='reverted')]),
+            'volume_reconnect': dict(volume_ids=[VOLUME], port_ids=[],
+                                     attachments=[dict(volume_id=VOLUME,
+                                                       attachment_id=CELL)]),
+            'artifact_publish': dict(artifacts=artifacts,
+                                     staging_deleted=True),
+            'runtime_restore_current': dict(fingerprint=DIGEST,
+                                             power_state='RUNNING'),
+            'runtime_restore_checkpoint': dict(fingerprint=DIGEST,
+                                                power_state='RUNNING'),
+            'cinder_release': release,
+            'disk_snapshot_delete': deleted,
+            'artifact_delete': dict(artifact_ids=[ARTIFACT],
+                                    deleted_artifact_ids=[ARTIFACT]),
+            'cleanup_runtime_restore_current': dict(fingerprint=DIGEST,
+                                                     power_state='RUNNING'),
+            'cleanup_disk_snapshots': deleted,
+            'cleanup_artifacts': dict(artifact_ids=[ARTIFACT],
+                                      deleted_artifact_ids=[ARTIFACT]),
+            'cleanup_cinder_release': release,
+        }
+        for phase, evidence in proofs.items():
+            with self.subTest(phase=phase):
+                self.assertEqual('succeeded', c.validate_result(
+                    phase, success(evidence)).status)
+                for field in evidence:
+                    partial = dict(evidence)
+                    del partial[field]
+                    self.assertEqual('unknown', c.validate_result(
+                        phase, success(partial)).status)
+
+    def test_failure_is_not_proof_of_no_effect(self):
+        result = dict(schema_version=1, status='failed_no_effect',
+                      error_code='executor_rejected', evidence={})
+        self.assertEqual('unknown',
+                         c.validate_result('runtime_save', result).status)
+        result['evidence'] = dict(no_effect=True, late_effect_impossible=True)
+        self.assertEqual('failed_no_effect',
+                         c.validate_result('runtime_save', result).status)
+        result['evidence']['late_effect_impossible'] = False
+        self.assertEqual('unknown',
+                         c.validate_result('runtime_save', result).status)
+
+    def test_disk_results_reject_missing_duplicate_and_unknown_fields(self):
+        evidence = dict(volume_ids=[VOLUME], snapshots=[dict(
+            volume_id=VOLUME, snapshot_id=CHECKPOINT, status='available')])
+        self.assertEqual('succeeded', c.validate_result(
+            'disk_snapshot', success(evidence)).status)
+        for changed in (dict(evidence, snapshots=[]),
+                        dict(evidence, volume_ids=[VOLUME, OPERATION]),
+                        dict(evidence, snapshots=evidence['snapshots'] * 2),
+                        dict(evidence, password='secret')):
+            self.assertEqual('unknown', c.validate_result(
+                'disk_snapshot', success(changed)).status)
+
+    def test_canonical_request_hash(self):
+        first = dict(actor='alice', kind='create', body={'b': 2, 'a': 1})
+        other_order = dict(body={'a': 1, 'b': 2}, kind='create', actor='alice')
+        self.assertEqual(c.canonical_payload_hash(first),
+                         c.canonical_payload_hash(other_order))
+        for changed in (dict(first, actor='bob'), dict(first, kind='delete')):
+            self.assertNotEqual(c.canonical_payload_hash(first),
+                                c.canonical_payload_hash(changed))
+        for bad in ({'value': float('nan')}, {'value': object()}, {1: 'x'}):
+            with self.assertRaises(ValueError):
+                c.canonical_payload_hash(bad)
+
+    def test_device_fingerprint_ignores_ephemeral_network_state(self):
+        original = manifest()
+        original['ports'] = [dict(uuid=ARTIFACT, mac='fa:16:3e:00:00:01',
+                                  network_uuid=CELL, vnic_type='normal',
+                                  model='virtio', fixed_ips=['10.0.0.1'])]
+        changed = copy.deepcopy(original)
+        changed['ports'][0]['fixed_ips'] = ['10.0.0.2']
+        changed['ports'][0]['security_groups'] = [CHECKPOINT]
+        changed['task_state'] = 'checkpoint_creating'
+        self.assertEqual(c.device_fingerprint(original),
+                         c.device_fingerprint(changed))
+        changed['ports'][0]['mac'] = 'fa:16:3e:00:00:02'
+        self.assertNotEqual(c.device_fingerprint(original),
+                            c.device_fingerprint(changed))
+
+    def test_device_fingerprint_canonical_resource_order(self):
+        original = manifest()
+        original['disks'].append(dict(original['disks'][0], uuid=ARTIFACT,
+                                      volume_id=CHECKPOINT, boot_index=1))
+        original['runtime_key_fingerprints'] = ['SHA256:bbb', 'SHA256:aaa']
+        changed = copy.deepcopy(original)
