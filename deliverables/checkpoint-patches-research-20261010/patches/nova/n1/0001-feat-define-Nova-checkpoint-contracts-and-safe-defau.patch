@@ -0,0 +1,462 @@
+#    Licensed under the Apache License, Version 2.0 (the "License"); you may
+#    not use this file except in compliance with the License. You may obtain
+#    a copy of the License at
+#
+#         http://www.apache.org/licenses/LICENSE-2.0
+#
+#    Unless required by applicable law or agreed to in writing, software
+#    distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+#    WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+#    License for the specific language governing permissions and limitations
+#    under the License.
+
+"""Closed, immutable checkpoint wire contracts; no DB or driver dependencies.
+
+Validation establishes shape, never physical truth. The journal/engine must
+also bind every resource, host, fingerprint and result to its durable intent.
+"""
+
+from collections.abc import Mapping
+import dataclasses
+import hashlib
+import re
+from types import MappingProxyType
+import uuid
+
+from oslo_serialization import jsonutils
+
+from nova.checkpoints import workflow
+
+MAX_BYTES = 2 ** 63 - 1
+PROFILE = 'kvm-bios-same-host-v1'
+REASONS = frozenset({
+    'disabled', 'executor_unsupported', 'invalid_executor_result',
+    'executor_unavailable', 'executor_rejected', 'incompatible_service',
+    'unsupported_profile', 'quota_exceeded', 'guard_busy', 'identity_changed',
+    'invalid_state', 'operation_conflict', 'recovery_required',
+    'cell_unavailable', 'admission_cancelled', 'resources_remaining',
+})
+
+
+def reason_code(value):
+    return value if type(value) is str and value in REASONS else (
+        'invalid_executor_result')
+
+
+def _require(condition):
+    if not condition:
+        raise ValueError('Invalid checkpoint contract')
+
+
+def _string(value):
+    _require(type(value) is str and 0 < len(value) <= 255)
+
+
+def _uuid(value):
+    _require(type(value) is str)
+    try:
+        _require(str(uuid.UUID(value)) == value)
+    except (ValueError, AttributeError):
+        raise ValueError('Invalid checkpoint UUID') from None
+
+
+def _digest(value):
+    _require(type(value) is str and re.fullmatch('[0-9a-f]{64}', value))
+
+
+def _integer(value, minimum=0, maximum=MAX_BYTES):
+    _require(type(value) is int and minimum <= value <= maximum)
+
+
+def _json(value, depth=0):
+    """Detach JSON; reject objects, non-string keys and floating point."""
+    _require(depth <= 32)
+    if value is None or type(value) in (str, bool, int):
+        return value
+    if isinstance(value, Mapping):
+        _require(all(type(key) is str for key in value))
+        return {key: _json(item, depth + 1) for key, item in value.items()}
+    if type(value) in (list, tuple):
+        return [_json(item, depth + 1) for item in value]
+    raise ValueError('Non-JSON checkpoint value')
+
+
+def _freeze(value):
+    if isinstance(value, Mapping):
+        return MappingProxyType({key: _freeze(item)
+                                 for key, item in value.items()})
+    if type(value) in (list, tuple):
+        return tuple(_freeze(item) for item in value)
+    return value
+
+
+def canonical_payload_hash(payload):
+    _require(isinstance(payload, Mapping))
+    encoded = jsonutils.dumps(
+        _json(payload), sort_keys=True, separators=(',', ':'),
+        ensure_ascii=True, allow_nan=False).encode('ascii')
+    return hashlib.sha256(encoded).hexdigest()
+
+
+def _keys(value, names):
+    _require(isinstance(value, Mapping) and set(value) == set(names))
+
+
+def _ids(value, nonempty=False):
+    _require(type(value) in (tuple, list))
+    _require(not nonempty or len(value) > 0)
+    for item in value:
+        _uuid(item)
+    _require(len(set(value)) == len(value))
+
+
+def device_projection(manifest):
+    """Hash identity fields only; IPs, tokens and volatile status are excluded.
+
+    The producer must construct image_properties from device properties, never
+    from an unfiltered Glance/Instance metadata or connection_info dictionary.
+    """
+    _require(isinstance(manifest, Mapping))
+    required = ('instance_uuid', 'host', 'node', 'flavor', 'image_properties',
+                'config_drive', 'disks', 'ports', 'shares',
+                'runtime_key_fingerprints')
+    _require(all(key in manifest for key in required))
+    result = {key: _json(manifest[key]) for key in required}
+    _uuid(result['instance_uuid'])
+    _string(result['host'])
+    _string(result['node'])
+    _require(isinstance(result['flavor'], dict))
+    _require(isinstance(result['image_properties'], dict))
+    disk_keys = ('uuid', 'volume_id', 'serial', 'device_name', 'boot_index')
+    port_keys = ('uuid', 'mac', 'network_uuid', 'vnic_type', 'model')
+    for kind, keys in (('disks', disk_keys), ('ports', port_keys)):
+        _require(type(result[kind]) is list)
+        projected = []
+        for item in result[kind]:
+            _require(isinstance(item, dict) and all(k in item for k in keys))
+            projected.append({key: item[key] for key in keys})
+        _ids([item['uuid'] for item in projected], nonempty=kind == 'disks')
+        result[kind] = sorted(projected, key=lambda item: item['uuid'])
+    _ids([item['volume_id'] for item in result['disks']], nonempty=True)
+    for disk in result['disks']:
+        _string(disk['serial'])
+        _string(disk['device_name'])
+        _integer(disk['boot_index'], minimum=-1)
+    for port in result['ports']:
+        _uuid(port['network_uuid'])
+        for key in ('mac', 'vnic_type', 'model'):
+            _string(port[key])
+    _ids(result['shares'])
+    result['shares'].sort()
+    _require(type(result['runtime_key_fingerprints']) is list)
+    for key in result['runtime_key_fingerprints']:
+        _string(key)
+    result['runtime_key_fingerprints'] = sorted(set(
+        result['runtime_key_fingerprints']))
+    return result
+
+
+def device_fingerprint(manifest):
+    return canonical_payload_hash(device_projection(manifest))
+
+
+class _Contract:
+    def __post_init__(self):
+        for field in dataclasses.fields(self):
+            value = getattr(self, field.name)
+            if not isinstance(value, _Contract):
+                value = _freeze(_json(value))
+            object.__setattr__(self, field.name, value)
+        self._validate()
+
+    def to_primitive(self):
+        value = {'schema_version': 1}
+        for field in dataclasses.fields(self):
+            item = getattr(self, field.name)
+            value[field.name] = (item.to_primitive()
+                                 if isinstance(item, _Contract)
+                                 else _json(item))
+        return value
+
+    @classmethod
+    def from_primitive(cls, value):
+        _require(type(value) is dict)
+        names = {field.name for field in dataclasses.fields(cls)}
+        _keys(value, names | {'schema_version'})
+        _integer(value['schema_version'], minimum=1, maximum=1)
+        values = {key: _json(value[key]) for key in names}
+        if cls is Admission:
+            values['key'] = RequestKey.from_primitive(values['key'])
+        return cls(**values)
+
+
+@dataclasses.dataclass(frozen=True)
+class RequestKey(_Contract):
+    project_id: str
+    instance_uuid: str
+    request_id: str
+    actor_user_id: str
+    kind: str
+    payload_hash: str
+
+    def _validate(self):
+        _string(self.project_id)
+        _string(self.actor_user_id)
+        _uuid(self.instance_uuid)
+        _uuid(self.request_id)
+        _require(self.kind in ('create', 'revert', 'delete'))
+        _digest(self.payload_hash)
+
+
+@dataclasses.dataclass(frozen=True)
+class Admission(_Contract):
+    key: RequestKey
+    operation_id: str
+    checkpoint_id: str
+    cell_uuid: str
+    host: str
+    node: str
+    fingerprint: str
+    device_manifest: dict
+    artifact_upper_bound: int
+
+    def _validate(self):
+        _require(type(self.key) is RequestKey)
+        for value in (self.operation_id, self.checkpoint_id, self.cell_uuid):
+            _uuid(value)
+        _integer(self.artifact_upper_bound, minimum=1)
+        _digest(self.fingerprint)
+        _require(self.fingerprint == device_fingerprint(self.device_manifest))
+        _require(self.key.instance_uuid ==
+                 self.device_manifest['instance_uuid'])
+        _require(self.host == self.device_manifest['host'])
+        _require(self.node == self.device_manifest['node'])
+
+
+@dataclasses.dataclass(frozen=True)
+class Probe(_Contract):
+    supported: bool
+    reasons: tuple
+    executor_id: str
+    executor_profile: str
+    fingerprint: str
+    device_manifest: dict
+    artifact_upper_bound: int
+    contract_version: int = 1
+
+    def _validate(self):
+        _require(type(self.supported) is bool)
+        _require(type(self.reasons) is tuple)
+        _require(all(type(code) is str and code in REASONS
+                     for code in self.reasons))
+        _integer(self.contract_version, minimum=1, maximum=1)
+        if self.supported:
+            _require(not self.reasons)
+            _string(self.executor_id)
+            _require(self.executor_profile == PROFILE)
+            _digest(self.fingerprint)
+            _require(self.fingerprint == device_fingerprint(
+                self.device_manifest))
+            _integer(self.artifact_upper_bound, minimum=1)
+        else:
+            _require(bool(self.reasons))
+            _require(self.executor_id == self.executor_profile ==
+                     self.fingerprint == '')
+            _require(isinstance(self.device_manifest, Mapping) and
+                     not self.device_manifest)
+            _integer(self.artifact_upper_bound, maximum=0)
+
+
+def unsupported(reason='executor_unsupported'):
+    return Probe(False, (reason_code(reason),), '', '', '', {}, 0)
+
+
+def validate_probe(value):
+    try:
+        return Probe.from_primitive(value)
+    except (ValueError, TypeError, KeyError, AttributeError):
+        return unsupported('invalid_executor_result')
+
+
+@dataclasses.dataclass(frozen=True)
+class Scope(_Contract):
+    instance_uuid: str
+    kind: str
+    owner_uuid: str
+    generation: int
+    action: str
+    token: str
+
+    def _validate(self):
+        _uuid(self.instance_uuid)
+        _uuid(self.owner_uuid)
+        _integer(self.generation, minimum=1, maximum=1)
+        _require(self.kind in ('checkpoint', 'ordinary'))
+        _string(self.action)
+        _digest(self.token)
+
+
+@dataclasses.dataclass(frozen=True)
+class StepIntent(_Contract):
+    id: str
+    operation_id: str
+    generation: int
+    phase: str
+    executor_id: str
+    payload_hash: str
+    payload: dict
+
+    def _validate(self):
+        _uuid(self.id)
+        _uuid(self.operation_id)
+        _integer(self.generation, minimum=1, maximum=1)
+        _require(self.phase in workflow.PHASES)
+        _string(self.executor_id)
+        _digest(self.payload_hash)
+        _require(self.payload_hash == canonical_payload_hash(self.payload))
+
+
+@dataclasses.dataclass(frozen=True)
+class StepResult(_Contract):
+    status: str
+    evidence: dict
+    error_code: str | None
+
+    def _validate(self):
+        _require(self.status in ('pending', 'succeeded', 'failed_no_effect',
+                                 'unknown'))
+        _require(isinstance(self.evidence, Mapping))
+        _require(self.error_code is None or
+                 (type(self.error_code) is str and self.error_code in REASONS))
+        if self.status == 'succeeded':
+            _require(self.error_code is None)
+
+
+@dataclasses.dataclass(frozen=True)
+class CloseProof(_Contract):
+    create_operation_id: str
+    closing_operation_id: str
+    checkpoint_id: str
+    cell_uuid: str
+    kind: str
+    proof_version: int = 1
+
+    def _validate(self):
+        for value in (self.create_operation_id, self.closing_operation_id,
+                      self.checkpoint_id, self.cell_uuid):
+            _uuid(value)
+        _integer(self.proof_version, minimum=1, maximum=1)
+        _require(self.kind in ('admission_cancelled', 'resources_deleted'))
+        if self.kind == 'admission_cancelled':
+            _require(self.create_operation_id == self.closing_operation_id)
+
+
+def _artifacts(items):
+    _require(type(items) in (tuple, list) and bool(items))
+    ids = []
+    for item in items:
+        _keys(item, ('id', 'kind', 'logical_id', 'checksum', 'bytes'))
+        ids.append(item['id'])
+        _require(item['kind'] in ('ram', 'runtime', 'config'))
+        _string(item['logical_id'])
+        _require('/' not in item['logical_id'] and
+                 '\\' not in item['logical_id'])
+        _digest(item['checksum'])
+        _integer(item['bytes'], minimum=1)
+    _ids(ids, nonempty=True)
+
+
+def _same_ids(first, second, nonempty=False):
+    _ids(first, nonempty=nonempty)
+    _ids(second, nonempty=nonempty)
+    _require(set(first) == set(second))
+
+
+def _success_evidence(phase, evidence):
+    if phase == 'preflight':
+        _keys(evidence, ('fingerprint', 'host', 'node'))
+        _digest(evidence['fingerprint'])
+        _string(evidence['host'])
+        _string(evidence['node'])
+    elif phase == 'cinder_reserve':
+        _keys(evidence, ('operation_id', 'generation', 'volume_ids', 'state'))
+        _uuid(evidence['operation_id'])
+        _integer(evidence['generation'], minimum=1, maximum=1)
+        _ids(evidence['volume_ids'], nonempty=True)
+        _require(evidence['state'] == 'reserved')
+    elif phase in ('cinder_release', 'cleanup_cinder_release'):
+        _keys(evidence, ('operation_id', 'generation', 'state', 'outcome'))
+        _uuid(evidence['operation_id'])
+        _integer(evidence['generation'], minimum=1, maximum=1)
+        _require(evidence['state'] == 'released')
+        _require(evidence['outcome'] in ('succeeded', 'failed_no_effect'))
+    elif phase == 'runtime_save':
+        _keys(evidence, ('writes_stopped', 'artifacts'))
+        _require(evidence['writes_stopped'] is True)
+        _artifacts(evidence['artifacts'])
+    elif phase == 'runtime_stop':
+        _keys(evidence, ('writes_stopped', 'power_state'))
+        _require(evidence['writes_stopped'] is True)
+        _require(evidence['power_state'] == 'SHUTOFF')
+    elif phase in ('runtime_restore_current', 'runtime_restore_checkpoint',
+                    'cleanup_runtime_restore_current'):
+        _keys(evidence, ('fingerprint', 'power_state'))
+        _digest(evidence['fingerprint'])
+        _require(evidence['power_state'] == 'RUNNING')
+    elif phase in ('disk_snapshot', 'disk_revert', 'disk_snapshot_delete',
+                    'cleanup_disk_snapshots'):
+        _keys(evidence, ('volume_ids', 'snapshots'))
+        _require(type(evidence['snapshots']) in (tuple, list))
+        status = {'disk_snapshot': 'available', 'disk_revert': 'reverted'}.get(
+            phase, 'deleted')
+        volumes, snapshots = [], []
+        for item in evidence['snapshots']:
+            _keys(item, ('volume_id', 'snapshot_id', 'status'))
+            _require(item['status'] == status)
+            volumes.append(item['volume_id'])
+            snapshots.append(item['snapshot_id'])
+        _same_ids(evidence['volume_ids'], volumes,
+                  nonempty=phase != 'cleanup_disk_snapshots')
+        _ids(snapshots)
+    elif phase == 'volume_disconnect':
+        _keys(evidence, ('volume_ids', 'disconnected_volume_ids'))
+        _same_ids(evidence['volume_ids'], evidence['disconnected_volume_ids'],
+                  nonempty=True)
+    elif phase == 'volume_reconnect':
+        _keys(evidence, ('volume_ids', 'port_ids', 'attachments'))
+        _ids(evidence['port_ids'])
+        _require(type(evidence['attachments']) in (tuple, list))
+        volumes, attachments = [], []
+        for item in evidence['attachments']:
+            _keys(item, ('volume_id', 'attachment_id'))
+            volumes.append(item['volume_id'])
+            attachments.append(item['attachment_id'])
+        _ids(attachments, nonempty=True)
+        _same_ids(evidence['volume_ids'], volumes, nonempty=True)
+    elif phase == 'artifact_publish':
+        _keys(evidence, ('artifacts', 'staging_deleted'))
+        _artifacts(evidence['artifacts'])
+        _require(evidence['staging_deleted'] is True)
+    elif phase in ('artifact_delete', 'cleanup_artifacts'):
+        _keys(evidence, ('artifact_ids', 'deleted_artifact_ids'))
+        _same_ids(evidence['artifact_ids'], evidence['deleted_artifact_ids'])
+    else:
+        raise ValueError('Invalid checkpoint phase')
+
+
+def validate_result(phase, value):
+    try:
+        _require(phase in workflow.PHASES)
+        result = StepResult.from_primitive(value)
+        if result.status == 'succeeded':
+            _success_evidence(phase, result.evidence)
+        elif result.status == 'failed_no_effect':
+            _keys(result.evidence, ('no_effect', 'late_effect_impossible'))
+            _require(result.evidence['no_effect'] is True and
+                     result.evidence['late_effect_impossible'] is True)
+            _require(result.error_code is not None)
+        else:
+            _keys(result.evidence, ())
+        return result
+    except (ValueError, TypeError, KeyError, AttributeError):
+        return StepResult('unknown', {}, 'invalid_executor_result')
