+#    Licensed under the Apache License, Version 2.0 (the "License"); you may
+#    not use this file except in compliance with the License. You may obtain
+#    a copy of the License at
+#
+#         http://www.apache.org/licenses/LICENSE-2.0
+#
+#    Unless required by applicable law or agreed to in writing, software
+#    distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+#    WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+#    License for the specific language governing permissions and limitations
+#    under the License.
+
+from oslo_config import cfg
+
+checkpoint_group = cfg.OptGroup('checkpoint', title='Instance checkpoints')
+checkpoint_opts = [
+    cfg.BoolOpt('enabled', default=False,
+                help='Allow new checkpoints with a supported executor. '
+                     'Disabling this does not release existing ownership.'),
+    cfg.IntOpt('max_checkpoints_per_instance', default=8, min=0,
+               help='Maximum retained checkpoints per instance, including '
+                    'pending operations and resources awaiting cleanup.'),
+    cfg.IntOpt('max_checkpoints_per_project', default=100, min=0,
+               help='Maximum retained checkpoints across all project cells.'),
+    cfg.IntOpt('max_artifact_bytes_per_project', default=0, min=0,
+               max=2 ** 63 - 1,
+               help='Artifact and staging byte budget across project cells. '
+                    'Zero denies new checkpoints; unlimited is unsupported.'),
+    cfg.IntOpt('reconcile_interval', default=60, min=1,
+               help='Seconds between journal reconciliation passes. '
+                    'Also runs when checkpoint creation is disabled.'),
+]
+
+
+def register_opts(conf):
+    conf.register_group(checkpoint_group)
+    conf.register_opts(checkpoint_opts, group=checkpoint_group)
+
+
+def list_opts():
+    return {checkpoint_group.name: checkpoint_opts}
diff --git a/nova/exception.py b/nova/exception.py
index cef454e..27f74d2 100644
--- a/nova/exception.py
+++ b/nova/exception.py
@@ -113,6 +113,36 @@ class EncryptionFailure(NovaException):
     msg_fmt = _("Failed to encrypt text: %(reason)s")
 
 
+class CheckpointConflict(NovaException):
+    msg_fmt = _("Instance checkpoint request rejected: %(reason)s")
+    code = 409
+    safe = True
+
+    def __init__(self, reason='operation_conflict', **kwargs):
+        # Never echo a backend exception, token or caller-supplied message.
+        from nova.checkpoints import contracts
+        super().__init__(reason=contracts.reason_code(reason))
+
+
+class CheckpointNotSupported(CheckpointConflict):
+    def __init__(self, reason='executor_unsupported', **kwargs):
+        super().__init__(reason=reason)
+
+
+class CheckpointUnavailable(CheckpointConflict):
+    code = 503
+
+    def __init__(self, reason='executor_unavailable', **kwargs):
+        super().__init__(reason=reason)
+
+
+class CheckpointQuotaExceeded(CheckpointConflict):
+    code = 413
+
+    def __init__(self, reason='quota_exceeded', **kwargs):
+        super().__init__(reason=reason)
+
+
 class VirtualInterfaceCreateException(NovaException):
     msg_fmt = _("Virtual Interface creation failed")
 
