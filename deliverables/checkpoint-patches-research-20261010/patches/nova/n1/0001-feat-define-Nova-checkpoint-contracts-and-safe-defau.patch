+"""Allowed effects, excluding local journal and quota transitions."""
+
+_STEPS = {
+    'create': ('preflight', 'cinder_reserve', 'runtime_save', 'disk_snapshot',
+               'artifact_publish', 'runtime_restore_current',
+               'cinder_release'),
+    'revert': ('preflight', 'cinder_reserve', 'runtime_stop',
+               'volume_disconnect',
+               'disk_revert', 'volume_reconnect', 'runtime_restore_checkpoint',
+               'cinder_release'),
+    'delete': ('cinder_reserve', 'disk_snapshot_delete', 'artifact_delete',
+               'cinder_release'),
+    'cleanup': ('cleanup_runtime_restore_current', 'cleanup_disk_snapshots',
+                'cleanup_artifacts', 'cleanup_cinder_release'),
+}
+PHASES = frozenset(phase for steps in _STEPS.values() for phase in steps)
+
+
+def steps_for(kind):
+    try:
+        return _STEPS[kind]
+    except (KeyError, TypeError):
+        raise ValueError('Invalid checkpoint operation kind') from None
