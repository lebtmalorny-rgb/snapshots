             context, existing, target
         )
+    elif migration_id is not None:
+        value = objects.InstanceCheckpointGuard.acquire_control(
+            context, instance_uuid, action, migration_id
+        )
     else:
         value = objects.InstanceCheckpointGuard.acquire(
             context, instance_uuid, action
@@ -89,6 +99,41 @@ def worker(context, instance_uuid, action, target=None):
             objects.InstanceCheckpointGuard.release(ctx, value)
 
 
+@contextlib.contextmanager
+def migration_control(context, instance, action, migration_id):
+    """Control an existing migration after the API's pure validation."""
+    with worker(
+        context, instance.uuid, action, migration_id=migration_id
+    ) as owned:
+        with _bound_objects(instance, owned):
+            yield owned
+
+
+def control_active(context, migration_id=None):
+    value = getattr(context, 'checkpoint_scope', None)
+    if value is None or value['kind'] != 'control':
+        return True
+    return objects.InstanceCheckpointGuard.control_active(
+        context, value, migration_id
+    )
+
+
+def bind_migration(context, migration_uuid):
+    value = getattr(context, 'checkpoint_scope', None)
+    if value is not None:
+        objects.InstanceCheckpointGuard.bind_migration(
+            context, value, migration_uuid
+        )
+
+
+def cancel_queued_migration(context, migration_id):
+    value = getattr(context, 'checkpoint_scope', None)
+    if value is not None and value['kind'] == 'control':
+        objects.InstanceCheckpointGuard.cancel_queued_migration(
+            context, value, migration_id
+        )
+
+
 def handoff(context, target):
     if not getattr(context, 'checkpoint_scope', None):
         return context
@@ -231,10 +276,20 @@ class RPCClient:
             guard = objects.InstanceCheckpointGuard.get_by_instance_uuid(
                 context, value['instance_uuid']
             )
+            state = (
+                (guard.ordinary_control or {})
+                if (guard is not None and value['kind'] == 'control')
+                else (
+                    dict(
+                        token=guard.ordinary_token, state=guard.ordinary_state
+                    )
+                    if guard
+                    else {}
+                )
+            )
             if (
-                guard is None or
-                guard.ordinary_token != value['token'] or
-                guard.ordinary_state != 'running'
+                state.get('token') != value['token'] or
+                state.get('state') != 'running'
             ):
                 context._checkpoint_handed_off = True
         return result
