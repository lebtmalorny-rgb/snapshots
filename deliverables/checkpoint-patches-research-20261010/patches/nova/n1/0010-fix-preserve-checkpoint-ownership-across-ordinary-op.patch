+    def _queued_migration(self, ctx, running=False):
+        primary = db.guard_acquire(ctx, self.servers[0], 'live_migrate')
+        with guards.scope(ctx, primary) as owned:
+            instance = objects.Instance.get_by_uuid(owned, self.servers[0])
+            instance.task_state = task_states.MIGRATING
+            instance.save()
+            migration = objects.Migration(
+                owned,
+                instance_uuid=instance.uuid,
+                source_compute='compute0',
+                dest_compute='compute1',
+                migration_type='live-migration',
+                status='preparing',
