+            ) as submit:
+                compute_api.API().compute_rpcapi.live_migration(
+                    owned, instance, 'compute1', False, 'compute0', migration
+                )
+            queued_ctx = submit.call_args.args[1]
+        if running:
+            primary = objects.InstanceCheckpointGuard.adopt(
+                ctx,
+                queued_ctx.checkpoint_scope,
+                'compute:_do_live_migration:compute0',
+            )
+            migration.status = 'running'
+            migration.save()
+            self.managers[0]._waiting_live_migrations.pop(instance.uuid)
+        return objects.Instance.get_by_uuid(ctx, instance.uuid), migration
