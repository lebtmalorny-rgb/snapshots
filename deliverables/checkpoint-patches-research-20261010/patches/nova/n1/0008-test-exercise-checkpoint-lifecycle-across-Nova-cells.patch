+
+@ddt.ddt
+class CheckpointLifecycleTest(checkpoints.CheckpointTestCase):
+    def test_probe_transport(self):
+        from nova.compute import rpcapi
+
+        with context.target_cell(self.ctx, self.cells[0]) as ctx:
+            service = objects.Service.get_by_host_and_binary(
+                ctx, 'compute0', 'nova-compute'
+            )
+            self.assertEqual(69, service.version)
+            api = rpcapi.ComputeAPI()
+            client = api.router.client(ctx)
+            self.assertTrue(
+                client.can_send_version('6.5'), str(client.version_cap)
+            )
+            instance = objects.Instance.get_by_uuid(ctx, self.servers[0])
+            result = api.checkpoint_probe(
+                ctx, instance, db.device_manifest(ctx, instance.uuid)
+            )
+            self.assertTrue(result['supported'], str(result))
+
+    def test_independent_points_and_cells_keep_resource_identity(self):
+        driver = self.drivers[0]
+        driver.runtime = 'RAM-A'
+        driver.volumes[self.volumes[0]] = 'DISK-A'
+        first = self.create('A')
+        self.assertEqual('succeeded', self.operation(first)['state'])
+        first_id = first['checkpoint']['id']
+        driver.runtime = 'RAM-B'
+        driver.volumes[self.volumes[0]] = 'DISK-B'
+        second = self.create('B')
+        second_id = second['checkpoint']['id']
+        other_cell = self.create('other-cell', index=1)
+        self.assertEqual('succeeded', self.operation(other_cell, 1)['state'])
+        self.assertEqual(3, self.usage()['checkpoint_count'])
+        self.action(first_id, 'revert')
+        self.assertEqual('RAM-A', driver.runtime)
+        self.assertEqual('DISK-A', driver.volumes[self.volumes[0]])
+        self.action(first_id, 'delete')
+        self.assertEqual(2, self.usage()['checkpoint_count'])
+        remaining = self.request('GET', 'checkpoints')['checkpoints']
+        self.assertEqual([second_id], [x['id'] for x in remaining])
+        self.action(second_id, 'revert')
+        self.assertEqual('RAM-B', driver.runtime)
+        self.assertEqual('DISK-B', driver.volumes[self.volumes[0]])
+        self.assertEqual('RUNNING', driver.power_state)
+        for index, cell in enumerate(self.cells):
+            with context.target_cell(self.ctx, cell) as ctx:
+                manifest = db.device_manifest(ctx, self.servers[index])
+                self.assertEqual(
+                    self.volumes[index], manifest['disks'][0]['volume_id']
+                )
+                self.assertEqual(
+                    self.ports[index], manifest['ports'][0]['uuid']
+                )
+                self.assertEqual(
+                    'fa:16:3e:00:00:%02d' % index, manifest['ports'][0]['mac']
+                )
+
+    @ddt.data(
+        *[
+            (kind, phase)
+            for kind in ('create', 'revert', 'delete')
+            for phase in workflow.steps_for(kind)
+        ]
+    )
+    @ddt.unpack
+    def test_lost_effect_reply_recovers_without_reexecution(self, kind, phase):
+        driver = self.drivers[0]
+        if kind != 'create':
+            original = self.create()
+        driver.lose_reply.add(phase)
+        result = (
+            self.create()
+            if kind == 'create'
+            else self.action(original['checkpoint']['id'], kind)
+        )
+        self.assertEqual('recovery_required', self.operation(result)['state'])
+        claimed = list(driver.executed)
+        self.flags(enabled=False, group='checkpoint')
+        self.recover()
+        self.assertEqual(claimed, driver.executed)
+        self.assertIn(claimed[-1], driver.queried)
+        self.recover()
+        self.assertEqual(
+            'released' if kind == 'delete' else 'succeeded',
+            self.operation(result)['state'],
+        )
+        self.assertEqual(
+            len(driver.executed),
+            len({ident for phase, ident in driver.executed}),
+        )
+
+    def test_lost_dispatch_before_claim_recovers_same_operation(self):
+        with mock.patch.object(
+            self.conductor.compute_task_mgr,
+            'checkpoint_run',
+            side_effect=TimeoutError(),
+        ):
+            result = self.create(request_id=uuids.request)
+        self.assertEqual([], self.drivers[0].executed)
+        self.recover()
+        replay = self.create(request_id=uuids.request)
+        self.assertEqual(result['operation']['id'], replay['operation']['id'])
+        self.assertEqual('succeeded', self.operation(result)['state'])
+        self.assertEqual(1, self.usage()['checkpoint_count'])
+
+    @ddt.data(
+        *[
+            (kind, phase)
+            for kind in ('create', 'revert', 'delete')
+            for phase in workflow.steps_for(kind)
+        ]
+    )
+    @ddt.unpack
+    def test_delivery_lost_before_step_claim(self, kind, phase):
+        if kind != 'create':
+            original = self.create()
+        before = len(self.drivers[0].executed)
+        claim = objects.InstanceCheckpointOperation.claim_step
+
+        def lose_delivery(ctx, operation_id, generation, current, executor):
+            if current == phase:
+                raise TimeoutError('delivery lost before claim')
+            return claim(ctx, operation_id, generation, current, executor)
+
+        with mock.patch.object(
+            objects.InstanceCheckpointOperation,
+            'claim_step',
+            side_effect=lose_delivery,
+        ):
+            result = (
+                self.create()
+                if kind == 'create'
+                else self.action(original['checkpoint']['id'], kind)
+            )
+        phases = [p for p, ident in self.drivers[0].executed[before:]]
+        self.assertNotIn(phase, phases)
+        self.recover()
+        self.assertEqual(
+            'released' if kind == 'delete' else 'succeeded',
+            self.operation(result)['state'],
+        )
+        executed = self.drivers[0].executed
+        self.assertEqual(len(executed), len({ident for p, ident in executed}))
+
+    def test_unknown_cleanup_retains_quota_until_deletion_proven(self):
+        driver = self.drivers[0]
+        driver.responses['artifact_publish'] = c.StepResult(
+            'failed_no_effect',
+            {'no_effect': True, 'late_effect_impossible': True},
+            'executor_unavailable',
+        )
+        driver.lose_reply.add('cleanup_artifacts')
+        result = self.create()
+        self.assertEqual('recovery_required', self.operation(result)['state'])
+        self.assertEqual(1, self.usage()['checkpoint_count'])
+        self.assertEqual(4096, self.usage()['artifact_bytes'])
+        self.recover()
+        self.recover()
+        self.assertEqual('released', self.operation(result)['state'])
+        self.assertEqual(0, self.usage()['checkpoint_count'])
+        self.assertEqual({}, driver.artifacts)
