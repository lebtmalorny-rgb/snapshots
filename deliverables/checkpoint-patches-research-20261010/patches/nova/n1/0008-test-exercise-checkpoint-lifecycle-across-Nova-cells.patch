+import datetime
+import os
+from pathlib import Path
+import uuid
+
+from oslo_serialization import jsonutils
+from oslo_utils import uuidutils
+
+from nova.tests.fixtures import checkpoints
+
+
+class CheckpointSamplesTest(checkpoints.CheckpointTestCase):
+    """Check literal public fields against real WSGI and RPC responses."""
+
+    templates = Path(__file__).parent / 'api_samples/server-checkpoints/v2.106'
+    samples = Path(__file__).parents[4] / 'doc/api_samples/server-checkpoints'
+
+    def assert_sample(self, name, response):
+        template = jsonutils.loads(
+            (self.templates / (name + '.json.tpl')).read_text()
+        )
+
+        def compare(expected, actual):
+            if expected == '$uuid':
+                self.assertEqual(actual, str(uuid.UUID(actual)))
+            elif expected == '$timestamp':
+                datetime.datetime.fromisoformat(actual)
+            elif isinstance(expected, dict):
+                self.assertEqual(set(expected), set(actual))
+                for key in expected:
+                    compare(expected[key], actual[key])
+            elif isinstance(expected, list):
+                self.assertEqual(len(expected), len(actual))
+                for left, right in zip(expected, actual):
+                    compare(left, right)
+            else:
+                self.assertEqual(expected, actual)
+
+        compare(template, response)
+        path = self.samples / (name + '.json')
+        if os.getenv('GENERATE_SAMPLES'):
+            path.parent.mkdir(parents=True, exist_ok=True)
+            path.write_text(jsonutils.dumps(response, indent=2) + '\n')
+        else:
+            compare(template, jsonutils.loads(path.read_text()))
+
+    def test_checkpoint_samples(self):
+        self.assert_sample(
+            'capabilities', self.request('GET', 'checkpoint-capabilities')
+        )
+        body = jsonutils.loads(
+            (self.templates / 'create-req.json.tpl').read_text()
+        )
+        body['checkpoint']['request_id'] = uuidutils.generate_uuid()
+        self.assert_sample('create-req', body)
+        created = self.request('POST', 'checkpoints', body, expected=202)
+        self.assert_sample('create-resp', created)
+        checkpoint_id = created['checkpoint']['id']
+        self.assert_sample(
+            'show-resp', self.request('GET', 'checkpoints/' + checkpoint_id)
+        )
+        self.assert_sample('list-resp', self.request('GET', 'checkpoints'))
+        body = jsonutils.loads(
+            (self.templates / 'revert-req.json.tpl').read_text()
+        )
+        body['revert']['request_id'] = uuidutils.generate_uuid()
+        self.assert_sample('revert-req', body)
+        reverted = self.request(
+            'POST', 'checkpoints/%s/action' % checkpoint_id, body, expected=202
+        )
+        self.assert_sample('action-resp', reverted)
+        self.assert_sample(
+            'operation-resp', {'operation': self.operation(reverted)}
+        )
+        deleted = self.action(checkpoint_id, 'delete')
+        self.assert_sample(
+            'deleted-operation-resp', {'operation': self.operation(deleted)}
+        )
