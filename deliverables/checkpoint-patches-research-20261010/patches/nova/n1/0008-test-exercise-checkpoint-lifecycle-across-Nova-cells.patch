diff --git a/nova/tests/fixtures/checkpoints.py b/nova/tests/fixtures/checkpoints.py
new file mode 100644
index 0000000..2aeeecc
--- /dev/null
+++ b/nova/tests/fixtures/checkpoints.py
@@ -0,0 +1,199 @@
+#    Licensed under the Apache License, Version 2.0 (the "License"); you may
+#    not use this file except in compliance with the License. You may obtain
+#    a copy of the License at
+#
+#         http://www.apache.org/licenses/LICENSE-2.0
+#
+#    Unless required by applicable law or agreed to in writing, software
+#    distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+#    WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+#    License for the specific language governing permissions and limitations
+#    under the License.
+
+"""Two SQL cells, real WSGI/RPC managers, and test-only N2 effects."""
+
+import oslo_messaging as messaging
+from oslo_serialization import jsonutils
+from oslo_utils.fixture import uuidsentinel as uuids
+from oslo_utils import uuidutils
+import webob
+
+from nova.checkpoints import recovery
+from nova.compute import manager as compute_manager
+from nova.conductor import manager as conductor_manager
+from nova import context
+from nova.db.api import checkpoints as quota_db
+from nova.db.main import api as db_api
+from nova import objects
+from nova import rpc
+from nova import test
+from nova.tests import fixtures
+from nova.tests.unit.api.openstack import fakes
+from nova.tests.unit.checkpoints import fake_executor
+from nova.tests.unit.checkpoints import test_cell_db
+
+
+class CheckpointTestCase(test.TestCase):
+    NUMBER_OF_CELLS = 2
+
+    def setUp(self):
+        super().setUp()
+        self.flags(
+            enabled=True,
+            max_artifact_bytes_per_project=65536,
+            group='checkpoint',
+        )
+        self.useFixture(fixtures.RealPolicyFixture())
+        self.useFixture(fixtures.CastAsCallFixture(self))
+        self.ctx = context.RequestContext(
+            'actor', 'project', roles=['member', 'reader']
+        )
+        self.servers = [uuids.instance1, uuids.instance2]
+        self.volumes = [uuids.volume1, uuids.volume2]
+        self.ports = [uuids.port1, uuids.port2]
+        self.cells = [self.cell_mappings['cell1'], self.cell_mappings['cell2']]
+        self.drivers = []
+        self.managers = []
+        self.conductor = conductor_manager.ConductorManager()
+        self._serve(
+            'conductor',
+            'conductor',
+            [self.conductor, self.conductor.compute_task_mgr],
+        )
+        for index, cell in enumerate(self.cells):
+            host = 'compute%d' % index
+            with context.target_cell(self.ctx, cell) as ctx:
+                test_cell_db.make_instance(
+                    ctx,
+                    self.servers[index],
+                    getattr(uuids, 'bdm%d' % index),
+                    self.volumes[index],
+                )
+                db_api.instance_update(
+                    ctx, self.servers[index], {'host': host}
+                )
+                db_api.virtual_interface_create(
+                    ctx,
+                    dict(
+                        uuid=self.ports[index],
+                        instance_uuid=self.servers[index],
+                        address='fa:16:3e:00:00:%02d' % index,
+                    ),
+                )
+                db_api.instance_info_cache_update(
+                    ctx,
+                    self.servers[index],
+                    {
+                        'network_info': jsonutils.dumps(
+                            [
+                                {
+                                    'id': self.ports[index],
+                                    'address': 'fa:16:3e:00:00:%02d' % index,
+                                    'network': {'id': uuids.network},
+                                    'vnic_type': 'normal',
+                                    'model': 'virtio',
+                                }
+                            ]
+                        )
+                    },
+                )
+                objects.Service(
+                    ctx, host=host, binary='nova-compute', topic='compute'
+                ).create()
+            objects.InstanceMapping(
+                self.ctx,
+                instance_uuid=self.servers[index],
+                cell_mapping=cell,
+                project_id='project',
+            ).create()
+            manager = compute_manager.ComputeManager(host=host)
+            manager.driver = fake_executor.FakeCheckpointDriver()
+            self.managers.append(manager)
+            self.drivers.append(manager.driver)
+            self._serve('compute', host, [manager])
+        # Only authentication is simulated. Controller/API/DB/RPC are real.
+        self.app = fakes.wsgi_app_v21(fake_auth_context=self.ctx)
+
+    def _serve(self, topic, host, endpoints):
+        server = rpc.get_server(
+            messaging.Target(topic=topic, server=host),
+            endpoints,
+            serializer=objects.base.NovaObjectSerializer(),
+        )
+        server.start()
+        self.addCleanup(server.wait)
+        self.addCleanup(server.stop)
+        return server
+
+    def request(
+        self,
+        method,
+        suffix,
+        body=None,
+        index=0,
+        headers=None,
+        version='2.106',
+        expected=200,
+    ):
+        req = webob.Request.blank(
+            '/v2.1/servers/%s/%s' % (self.servers[index], suffix)
+        )
+        req.method = method
+        req.headers['OpenStack-API-Version'] = 'compute ' + version
+        if headers:
+            req.headers.update(headers)
+        if body is not None:
+            req.content_type = 'application/json'
+            req.body = jsonutils.dump_as_bytes(body)
+        response = req.get_response(self.app)
+        self.assertEqual(expected, response.status_int, response.text)
+        return response.json
+
+    def create(self, name='A', index=0, request_id=None, expected=202):
+        return self.request(
+            'POST',
+            'checkpoints',
+            {
+                'checkpoint': {
+                    'name': name,
+                    'request_id': request_id or uuidutils.generate_uuid(),
+                }
+            },
+            index=index,
+            expected=expected,
+        )
+
+    def action(self, checkpoint_id, kind, index=0, request_id=None):
+        request_id = request_id or uuidutils.generate_uuid()
+        if kind == 'delete':
+            return self.request(
+                'DELETE',
+                'checkpoints/' + checkpoint_id,
+                index=index,
+                headers={'OpenStack-Checkpoint-Request-ID': request_id},
+                expected=202,
+            )
+        return self.request(
+            'POST',
+            'checkpoints/%s/action' % checkpoint_id,
+            {'revert': {'request_id': request_id}},
+            index=index,
+            expected=202,
+        )
+
+    def operation(self, result, index=0):
+        return self.request(
+            'GET',
+            'checkpoint-operations/' + result['operation']['id'],
+            index=index,
+        )['operation']
+
+    def recover(self, index=0):
+        # New manager, retained SQL and external fake backend state.
+        with context.target_cell(self.ctx, self.cells[index]) as ctx:
+            return recovery.RecoveryManager().reconcile_instance(
+                ctx, self.servers[index]
+            )
+
+    def usage(self):
+        return quota_db.get_usage(self.ctx, 'project')
