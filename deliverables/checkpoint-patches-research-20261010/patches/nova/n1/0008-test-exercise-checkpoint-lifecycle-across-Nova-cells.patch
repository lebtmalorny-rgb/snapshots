+        first = self.create('A')
+        with context.target_cell(self.ctx, self.cells[0]) as ctx:
+            old = db.checkpoint_get(ctx, first['checkpoint']['id'])
+            old_artifacts = db.artifacts_get(ctx, old['uuid'])
+            old_disks = db.disks_get(ctx, old['uuid'])
+        phase = {
+            'artifact_kind': 'artifact_publish',
+            'artifact_logical_id': 'runtime_save',
+            'snapshot_id': 'disk_snapshot',
+        }[variant]
+
+        def corrupt(intent):
+            evidence = driver._effect(intent)
+            if variant == 'artifact_kind':
+                evidence['artifacts'][0]['kind'] = 'config'
+            elif variant == 'artifact_logical_id':
+                evidence['artifacts'][0]['logical_id'] = old_artifacts[0][
