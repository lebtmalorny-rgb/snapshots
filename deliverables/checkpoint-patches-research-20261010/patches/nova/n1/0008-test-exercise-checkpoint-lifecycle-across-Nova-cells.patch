+from dataclasses import replace
+
+from oslo_db.sqlalchemy import test_fixtures
+from oslo_utils.fixture import uuidsentinel as uuids
+
+from nova.checkpoints import compute
+from nova.checkpoints import contracts as c
+from nova.db.main import checkpoints as db
+from nova import exception
+from nova import objects
+from nova import test
+from nova.tests.unit.checkpoints import fake_executor
+from nova.tests.unit.checkpoints import test_cell_db
+
+
+class CheckpointDatabaseMixin(test_cell_db.CellDBRaceMixin):
+    def test_stale_worker_completion_cannot_unlock_new_consumer(self):
+        self.flags(enabled=True, group='checkpoint')
+        first = db.guard_acquire(self.ctx, uuids.instance, 'stop')
+        queued = db.guard_handoff(self.ctx, first, 'compute:stop:compute')
+        current = db.guard_adopt(self.ctx, queued, 'compute:stop:compute')
+        self.assertRaises(
+            exception.CheckpointConflict, db.guard_release, self.ctx, first
+        )
+        self.assertRaises(
+            exception.CheckpointConflict,
+            db.admit,
+            self.ctx,
+            test_cell_db.admission(self.ctx),
+            uuids.ticket,
+        )
+        db.guard_release(self.ctx, current)
+        db.admit(self.ctx, test_cell_db.admission(self.ctx), uuids.ticket)
+        self.assertEqual(
+            uuids.operation,
+            db.guard_get(self.ctx, uuids.instance)['operation_id'],
+        )
+
+    def test_snapshot_proof_cannot_reuse_another_live_point(self):
+        self.flags(enabled=True, group='checkpoint')
+        first = test_cell_db.admission(self.ctx)
+        driver = fake_executor.FakeCheckpointDriver()
+        executor = compute.ComputeExecutor(driver, 'compute')
+        instance = objects.Instance.get_by_uuid(self.ctx, uuids.instance)
+        db.admit(self.ctx, first, uuids.ticket)
+        db.mark_quota_ready(self.ctx, first.operation_id, uuids.ticket)
+        executor.execute(self.ctx, instance, first.operation_id, 1)
+        snapshot = db.disks_get(self.ctx, first.checkpoint_id)[0][
+            'snapshot_id'
+        ]
+        second = replace(
+            first,
+            operation_id=uuids.op2,
+            checkpoint_id=uuids.checkpoint2,
+            key=replace(first.key, request_id=uuids.request2),
+        )
+        db.admit(self.ctx, second, uuids.ticket2)
+        db.mark_quota_ready(self.ctx, second.operation_id, uuids.ticket2)
+        driver.responses['disk_snapshot'] = c.StepResult(
+            'succeeded',
+            {
+                'volume_ids': [uuids.volume],
+                'snapshots': [
+                    {
+                        'volume_id': uuids.volume,
+                        'snapshot_id': snapshot,
+                        'status': 'available',
+                    }
+                ],
+            },
+            None,
+        )
+        executor.execute(self.ctx, instance, second.operation_id, 1)
+        self.assertEqual(
+            'recovery_required',
+            db.get_by_uuid(self.ctx, second.operation_id)['state'],
+        )
+        self.assertEqual(
+            'available',
+            db.checkpoint_get(self.ctx, first.checkpoint_id)['status'],
+        )
+
+
+class CheckpointMySQLTest(
+    CheckpointDatabaseMixin,
+    test_fixtures.OpportunisticDBTestMixin,
+    test.NoDBTestCase,
+):
+    FIXTURE = test_fixtures.MySQLOpportunisticFixture
+
+
+class CheckpointPostgreSQLTest(
+    CheckpointDatabaseMixin,
+    test_fixtures.OpportunisticDBTestMixin,
+    test.NoDBTestCase,
+):
+    FIXTURE = test_fixtures.PostgresqlOpportunisticFixture
