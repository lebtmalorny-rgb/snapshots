+                ]
+            else:
+                evidence['snapshots'][0]['snapshot_id'] = old_disks[0][
+                    'snapshot_id'
+                ]
+            return c.StepResult('succeeded', evidence, None)
+
+        driver.responses[phase] = corrupt
+        second = self.create('B')
+        self.assertEqual('recovery_required', self.operation(second)['state'])
+        self.assertEqual(
+            'available',
+            self.request('GET', 'checkpoints/' + first['checkpoint']['id'])[
+                'checkpoint'
+            ]['status'],
+        )
