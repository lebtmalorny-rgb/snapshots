+#    Unless required by applicable law or agreed to in writing, software
+#    distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+#    WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+#    License for the specific language governing permissions and limitations
+#    under the License.
+
+"""Compute journal consumer using remotable Nova objects for persistence."""
+
+from nova.checkpoints import contracts as c
+from nova.checkpoints import guards
+from nova.checkpoints import workflow
+from nova import conf
+from nova import exception
+from nova import objects
+
+
+class ComputeExecutor:
+    def __init__(self, driver, host):
+        self.driver = driver
+        self.host = host
+
+    def probe(self, context, instance, manifest, existing=False):
+        if not existing and not conf.CONF.checkpoint.enabled:
+            return c.unsupported('disabled')
+        if instance.host != self.host or manifest.get('host') != self.host:
+            return c.unsupported('identity_changed')
+        try:
+            value = self.driver.checkpoint_probe(context, instance, manifest)
+            probe = c.validate_probe(value)
+            if probe.supported and (
+                probe.fingerprint != c.device_fingerprint(manifest) or
+                probe.executor_profile != c.PROFILE or
+                probe.device_manifest['node'] != instance.node
+            ):
+                return c.unsupported('identity_changed')
+            return probe
+        except Exception:
+            return c.unsupported('executor_unavailable')
+
+    def _load(self, context, instance, operation_id, generation):
+        operation = objects.InstanceCheckpointOperation.get_by_uuid(
+            context, operation_id
+        )
+        if (
+            type(generation) is not int or
+            generation != 1 or
+            operation.generation != generation or
+            instance.uuid != operation.instance_uuid or
+            operation.host != self.host or
+            instance.host != self.host or
+            instance.node != operation.node
+        ):
+            raise exception.CheckpointConflict(reason='identity_changed')
+        current = objects.Instance.get_by_uuid(context, instance.uuid)
+        if (current.host, current.node) != (operation.host, operation.node):
+            raise exception.CheckpointConflict(reason='identity_changed')
+        if operation.state in ('succeeded', 'released'):
+            return operation, current
+        if not operation.quota_ready:
+            raise exception.CheckpointConflict()
+        manifest = objects.InstanceCheckpointOperation.device_manifest(
+            context, instance.uuid
+        )
+        if (
+            c.device_fingerprint(manifest) !=
+            operation.admission['fingerprint']
+        ):
+            raise exception.CheckpointConflict(reason='identity_changed')
+        probe = self.probe(context, current, manifest, existing=True)
+        if not probe.supported:
+            raise exception.CheckpointNotSupported(reason=probe.reasons[0])
+        if probe.executor_id != operation.executor_id:
+            raise exception.CheckpointConflict(reason='identity_changed')
+        return operation, current
+
+    @staticmethod
+    def _intent(step):
+        return c.StepIntent(
+            step.uuid,
+            step.operation_id,
+            step.generation,
+            step.phase,
+            step.executor_id,
+            step.payload_hash,
+            step.payload,
+        )
+
+    def _effect(self, context, instance, operation, intent, query=False):
+        guard = objects.InstanceCheckpointGuard.get_by_instance_uuid(
+            context, instance.uuid
+        )
+        value = c.Scope(
+            instance.uuid,
+            'checkpoint',
+            operation.uuid,
+            operation.generation,
+            intent.phase,
+            guard.token,
+        )
+        try:
+            with guards.scope(context, value) as ctx:
+                with guards._bound_objects(instance, ctx):
+                    method = (
+                        self.driver.checkpoint_query
+                        if query
+                        else self.driver.checkpoint_execute
+                    )
+                    result = c.validate_result(
+                        intent.phase,
+                        method(ctx, instance, intent.to_primitive()),
+                    )
+        except Exception:
+            # A thrown exception after durable claim is never no-effect proof.
+            result = c.StepResult('unknown', {}, 'executor_unavailable')
+        objects.InstanceCheckpointOperation.finish_step(
+            context, intent.id, operation.generation, result.to_primitive()
+        )
+        return objects.InstanceCheckpointStep.get_by_uuid(context, intent.id)
+
+    @staticmethod
+    def _report(operation):
+        return dict(
+            schema_version=1,
+            operation_id=operation.uuid,
+            generation=operation.generation,
+            state=operation.state,
+            phase=operation.phase,
+            error_code=operation.error_code,
+        )
+
+    def _advance(
+        self, context, instance, operation_id, generation, query_only
+    ):
+        operation, current = self._load(
+            context, instance, operation_id, generation
+        )
+        if operation.state in ('succeeded', 'released'):
+            return self._report(operation)
+        operation_obj = objects.InstanceCheckpointOperation
+        step_list = objects.InstanceCheckpointStepList
+        # One normal pass and, only after a proven create failure, cleanup.
+        for attempt in range(2):
+            steps = {
+                step.phase: step
+                for step in step_list.get_by_operation(
+                    context, operation_id
+                )
+            }
+            phases, cleaning = workflow.execution_plan(
+                operation.kind,
+                {name: step.status for name, step in steps.items()},
+            )
+            for phase in phases:
+                step = steps.get(phase)
+                if step and step.status == 'succeeded':
+                    if phase == 'artifact_publish':
+                        operation_obj.confirm_artifact_usage(
+                            context, operation_id, step.result['evidence']
+                        )
+                    continue
+                if step and step.status == 'failed_no_effect':
+                    break
+                if step is None:
+                    if query_only:
+                        break
+                    primitive = operation_obj.claim_step(
+                        context,
+                        operation_id,
+                        generation,
+                        phase,
+                        operation.executor_id,
+                    )
+                    if primitive is not None:
+                        intent = c.StepIntent.from_primitive(primitive)
+                        step = self._effect(
+                            context, current, operation, intent
+                        )
+                    else:
+                        # Another request claimed it. Only query that intent.
+                        concurrent = step_list.get_by_operation(
+                            context, operation_id
+                        )
+                        step = next(
+                            item for item in concurrent if item.phase == phase
+                        )
+                        if step.status in (
+                            'dispatching',
+                            'pending',
+                            'unknown',
+                        ):
+                            step = self._effect(
+                                context,
+                                current,
+                                operation,
+                                self._intent(step),
+                                query=True,
+                            )
+                else:
+                    step = self._effect(
+                        context,
+                        current,
+                        operation,
+                        self._intent(step),
+                        query=True,
+                    )
+                if step.status != 'succeeded':
+                    break
+                if phase == 'artifact_publish':
+                    operation_obj.confirm_artifact_usage(
+                        context, operation_id, step.result['evidence']
+                    )
+            else:
+                operation_obj.finalize(
+                    context, operation_id, generation, 'succeeded'
+                )
+                break
+            if (
+                cleaning or
+                query_only or
+                operation.kind != 'create' or
+                step is None or
+                step.status != 'failed_no_effect'
+            ):
+                break
+        return self._report(
+            operation_obj.get_by_uuid(
+                context, operation_id
+            )
+        )
+
+    def execute(self, context, instance, operation_id, generation):
+        self._advance(context, instance, operation_id, generation, False)
+
+    def query(self, context, instance, operation_id, generation):
+        return self._advance(context, instance, operation_id, generation, True)
