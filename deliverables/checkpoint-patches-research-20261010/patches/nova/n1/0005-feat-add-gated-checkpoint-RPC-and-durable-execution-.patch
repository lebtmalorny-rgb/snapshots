+from nova.virt import driver as virt_driver
+
+
+@ddt.ddt
+class ExecutionTest(test.TestCase):
+    def setUp(self):
+        super().setUp()
+        from nova.checkpoints import compute
+
+        self.flags(
+            enabled=True,
+            max_artifact_bytes_per_project=16384,
+            group='checkpoint',
+        )
+        self.ctx = context.RequestContext('actor', 'project')
+        test_cell_db.make_instance(self.ctx)
+        self.admission = test_cell_db.admission(self.ctx)
+        self.instance = objects.Instance.get_by_uuid(self.ctx, uuids.instance)
+        self.driver = fake_executor.FakeCheckpointDriver()
+        self.executor = compute.ComputeExecutor(self.driver, host='compute')
+
+    def ready(self, ready=True):
+        db.admit(self.ctx, self.admission, uuids.ticket)
+        if ready:
+            db.mark_quota_ready(self.ctx, uuids.operation, uuids.ticket)
+
+    def execute(self, generation=1):
+        return self.executor.execute(
+            self.ctx, self.instance, uuids.operation, generation
+        )
+
+    def test_default_driver_unsupported_even_enabled(self):
+        driver = virt_driver.ComputeDriver(mock.sentinel.virtapi)
+        result = driver.checkpoint_probe(
+            self.ctx,
+            self.instance,
+            self.admission.to_primitive()['device_manifest'],
+        )
+        self.assertFalse(c.validate_probe(result).supported)
+
+    def test_execute_twice_calls_effect_once(self):
+        self.ready()
+        self.execute()
+        self.execute()
+        self.assertEqual(
+            list(workflow.steps_for('create')),
+            [phase for phase, ident in self.driver.executed],
+        )
+        self.assertEqual(
+            'available',
+            db.checkpoint_get(self.ctx, uuids.checkpoint)['status'],
+        )
+        self.assertIsNone(
+            db.guard_get(self.ctx, uuids.instance)['operation_id']
+        )
+
+    def test_lost_reply_queries_same_step_uuid(self):
+        self.ready()
+        self.driver.lose_reply.add('runtime_save')
+        self.execute()
+        self.assertEqual('SHUTOFF', self.driver.power_state)
+        first_id = self.driver.executed[-1][1]
+        self.execute()
+        self.assertIn(('runtime_save', first_id), self.driver.queried)
+        self.assertEqual(
+            1,
+            [
+                ident
+                for phase, ident in self.driver.executed
+                if phase == 'runtime_save'
+            ].count(first_id),
+        )
+        self.assertEqual(
+            'available',
+            db.checkpoint_get(self.ctx, uuids.checkpoint)['status'],
+        )
+
+    def test_wrong_host_generation_profile_never_calls_driver(self):
+        from nova.checkpoints import compute
+
+        self.ready()
+        foreign = compute.ComputeExecutor(self.driver, host='elsewhere')
+        self.assertRaises(
+            exception.CheckpointConflict,
+            foreign.execute,
+            self.ctx,
+            self.instance,
+            uuids.operation,
+            1,
+        )
+        self.assertRaises(exception.CheckpointConflict, self.execute, 2)
+        self.driver.executor_profile = 'unknown-profile'
+        self.assertRaises(exception.CheckpointNotSupported, self.execute)
+        self.assertEqual([], self.driver.executed)
+
+    def test_success_missing_disk_proof_is_unknown(self):
+        self.ready()
+        self.driver.responses['disk_snapshot'] = c.StepResult(
+            'succeeded', {'volume_ids': [], 'snapshots': []}, None
+        )
+        self.execute()
+        self.assertEqual('SHUTOFF', self.driver.power_state)
+        operation = db.get_by_uuid(self.ctx, uuids.operation)
+        self.assertEqual('recovery_required', operation['state'])
+        self.assertEqual('disk_snapshot', operation['phase'])
+        self.assertEqual(
+            uuids.operation,
+            db.guard_get(self.ctx, uuids.instance)['operation_id'],
+        )
+
+    def test_quota_not_ready_never_claims(self):
+        self.ready(ready=False)
+        self.assertRaises(exception.CheckpointConflict, self.execute)
+        self.assertEqual([], self.driver.executed)
+        self.assertEqual([], db.steps_get(self.ctx, uuids.operation))
+
+    def test_partial_revert_never_reaches_runtime_restore(self):
+        self.ready()
+        self.execute()
+        revert = replace(
+            self.admission,
+            operation_id=uuids.revert,
+            key=replace(
+                self.admission.key,
+                kind='revert',
+                request_id=uuids.revert_request,
+            ),
+        )
+        db.admit(self.ctx, revert, uuids.ticket)
+        db.mark_quota_ready(self.ctx, uuids.revert, uuids.ticket)
+        self.driver.responses['disk_revert'] = c.StepResult(
+            'unknown', {}, 'executor_unavailable'
+        )
+        self.executor.execute(self.ctx, self.instance, uuids.revert, 1)
+        self.assertEqual('SHUTOFF', self.driver.power_state)
+        self.assertNotIn(
+            'runtime_restore_checkpoint',
+            [phase for phase, ident in self.driver.executed],
+        )
+        self.assertEqual(
+            uuids.revert,
+            db.guard_get(self.ctx, uuids.instance)['operation_id'],
+        )
+
+    def test_no_sql_access_from_compute(self):
+        self.ready()
+        factory = enginefacade._TransactionFactory
+        create_session, start = factory._create_session, factory._start
+
+        class Conductor(test_objects.FakeIndirectionHack):
+            # Only the actual serialized OVO request handler may access SQL.
+            # A direct compute/helper SQL call still hits DatabasePoison.
+            def object_class_action(self, *args, **kwargs):
+                with mock.patch.object(
+                    factory, '_create_session', create_session
+                ), mock.patch.object(factory, '_start', start):
+                    return super().object_class_action(*args, **kwargs)
+
+            def object_action(self, *args, **kwargs):
+                with mock.patch.object(
+                    factory, '_create_session', create_session
+                ), mock.patch.object(factory, '_start', start):
+                    return super().object_action(*args, **kwargs)
+
+            def object_class_action_versions(self, *args, **kwargs):
+                with mock.patch.object(
+                    factory, '_create_session', create_session
+                ), mock.patch.object(factory, '_start', start):
+                    return super().object_class_action_versions(
+                        *args, **kwargs
+                    )
+
+        remote = Conductor(serializer=objects.base.NovaObjectSerializer())
+        with fixtures.DatabasePoisonFixture(), fixtures.IndirectionAPIFixture(
+            remote
+        ):
+            self.execute()
+        self.assertEqual(
+            'available',
+            db.checkpoint_get(self.ctx, uuids.checkpoint)['status'],
+        )
+
+    def test_known_create_failure_cleans_with_distinct_ids_before_refund(self):
+        self.ready()
+        self.driver.responses['artifact_publish'] = c.StepResult(
+            'failed_no_effect',
+            dict(no_effect=True, late_effect_impossible=True),
+            'executor_unavailable',
+        )
+        self.execute()
+        steps = db.steps_get(self.ctx, uuids.operation)
+        phases = [phase for phase, ident in self.driver.executed]
+        self.assertEqual(list(workflow.steps_for('cleanup')), phases[-4:])
+        self.assertEqual(len(steps), len({step['uuid'] for step in steps}))
+        self.assertEqual('RUNNING', self.driver.power_state)
+        self.assertEqual({}, self.driver.artifacts)
+        self.assertEqual({}, self.driver.snapshots)
+        self.assertIsNotNone(db.close_proof(self.ctx, uuids.operation))
+        self.assertEqual(
+            uuids.operation,
+            db.guard_get(self.ctx, uuids.instance)['operation_id'],
+        )
+        db.mark_quota_released(self.ctx, uuids.operation, uuids.ticket)
+        db.finalize(self.ctx, uuids.operation, 1, 'succeeded')
+        self.assertEqual(
+            'deleted', db.checkpoint_get(self.ctx, uuids.checkpoint)['status']
+        )
+        self.assertEqual(
+            0, db.guard_get(self.ctx, uuids.instance)['checkpoint_count']
+        )
+
+    def test_unknown_create_cannot_claim_cleanup(self):
+        self.ready()
+        self.driver.lose_reply.add('runtime_save')
+        self.execute()
+        for phase in workflow.steps_for('cleanup'):
+            self.assertRaises(
+                exception.CheckpointConflict,
+                db.claim_step,
+                self.ctx,
+                uuids.operation,
+                1,
+                phase,
+                'test-executor',
+            )
+        self.assertIsNone(db.close_proof(self.ctx, uuids.operation))
+
+    def test_query_resolves_existing_step_without_claiming_next(self):
+        self.ready()
+        self.driver.lose_reply.add('runtime_save')
+        self.execute()
+        before = list(self.driver.executed)
+        self.executor.query(self.ctx, self.instance, uuids.operation, 1)
+        self.assertEqual(before, self.driver.executed)
+        self.assertEqual(
+            ['preflight', 'cinder_reserve', 'runtime_save'],
+            [phase for phase, ident in self.driver.executed],
+        )
+
+    def test_intent_carries_durable_artifact_budget(self):
+        self.ready()
+        self.execute()
+        save = next(
+            step
+            for step in db.steps_get(self.ctx, uuids.operation)
+            if step['phase'] == 'runtime_save'
