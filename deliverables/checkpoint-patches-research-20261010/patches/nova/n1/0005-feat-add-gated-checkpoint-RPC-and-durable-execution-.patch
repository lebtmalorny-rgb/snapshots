+"""Conductor coordination; cell/RPC/API DB transitions are separate calls."""
+
+from nova.checkpoints import contracts as c
+from nova.checkpoints import quota
+from nova.compute import rpcapi
+from nova import conf
+from nova import context as nova_context
+from nova import exception
+from nova import objects
+
+
+class Coordinator:
+    def __init__(self, compute_rpc=None, ledger=None):
+        self.compute_rpc = compute_rpc or rpcapi.ComputeAPI()
+        self.ledger = ledger or quota.QuotaLedger()
+
+    @staticmethod
+    def _cell(context, instance_uuid):
+        mapping = objects.InstanceMapping.get_by_instance_uuid(
+            context, instance_uuid
+        )
+        if mapping.cell_mapping is None or mapping.cell_mapping.is_cell0():
+            raise exception.CheckpointUnavailable(reason='cell_unavailable')
+        return mapping.cell_mapping
+
+    def probe(self, context, instance_uuid):
+        if not conf.CONF.checkpoint.enabled:
+            return c.unsupported('disabled')
+        try:
+            cell = self._cell(context, instance_uuid)
+            with nova_context.target_cell(context, cell) as ctx:
+                instance = objects.Instance.get_by_uuid(ctx, instance_uuid)
+                service = objects.Service.get_by_host_and_binary(
+                    ctx, instance.host, 'nova-compute'
+                )
+                if service.version < 69:
+                    return c.unsupported('incompatible_service')
+                manifest = objects.InstanceCheckpointOperation.device_manifest(
+                    ctx, instance_uuid
+                )
+                # A supported version cap is not a positive live probe.
+                probe = c.validate_probe(
+                    self.compute_rpc.checkpoint_probe(ctx, instance, manifest)
+                )
+                if probe.supported and probe.fingerprint != (
+                    c.device_fingerprint(manifest)
+                ):
+                    return c.unsupported('identity_changed')
+                return probe
+        except exception.CheckpointNotSupported:
+            return c.unsupported('incompatible_service')
+        except exception.CheckpointUnavailable:
+            return c.unsupported('cell_unavailable')
+        except Exception:
+            return c.unsupported('executor_unavailable')
+
+    def run(self, context, instance_uuid, operation_id, generation):
+        cell = self._cell(context, instance_uuid)
+        with nova_context.target_cell(context, cell) as ctx:
+            operation = objects.InstanceCheckpointOperation.get_by_uuid(
+                ctx, operation_id
+            )
+            if (
+                operation.instance_uuid != instance_uuid or
+                operation.cell_uuid != cell.uuid
+            ):
+                raise exception.CheckpointConflict(reason='identity_changed')
+            instance = objects.Instance.get_by_uuid(ctx, instance_uuid)
+            self.compute_rpc.checkpoint_execute(
+                ctx, instance, operation_id, generation
+            )
+            operation = objects.InstanceCheckpointOperation.get_by_uuid(
+                ctx, operation_id
+            )
+            checkpoint = objects.InstanceCheckpoint.get_by_uuid(
+                ctx, operation.checkpoint_id
+            )
+            proof = objects.InstanceCheckpointOperation.close_proof(
+                ctx, checkpoint.create_operation_id
+            )
+        if proof:
+            self.ledger.release(context, operation.quota_ticket_id)
+            with nova_context.target_cell(context, cell) as ctx:
+                objects.InstanceCheckpointOperation.mark_quota_released(
+                    ctx, operation_id, operation.quota_ticket_id
+                )
+                objects.InstanceCheckpointOperation.finalize(
+                    ctx, operation_id, generation, 'succeeded'
+                )
+        elif operation.kind == 'create' and operation.state == 'succeeded':
+            self.ledger.settle(context, operation.quota_ticket_id)
