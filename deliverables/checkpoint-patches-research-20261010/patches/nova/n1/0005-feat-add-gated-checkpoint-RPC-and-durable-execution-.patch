+"""Test-only N2 protocol backend; no hypervisor/storage registration."""
+
+import copy
+import hashlib
+import uuid
+
+from nova.checkpoints import contracts as c
+
+
+def stable_id(owner, name):
+    return str(uuid.uuid5(uuid.UUID(owner), name))
+
+
+class FakeCheckpointDriver:
+    executor_id = 'test-executor'
+    executor_profile = c.PROFILE
+
+    def __init__(self):
+        self.executed = []
+        self.queried = []
+        self.results = {}
+        self.responses = {}
+        self.lose_reply = set()
+        self.volumes = {}
+        self.snapshots = {}
+        self.artifacts = {}
+        self.current_runtime = {}
+        self.runtime = 'initial-ram'
+        self.power_state = 'RUNNING'
+
+    def checkpoint_probe(self, context, instance, manifest):
+        return c.Probe(
+            True,
+            (),
+            self.executor_id,
+            self.executor_profile,
+            c.device_fingerprint(manifest),
+            manifest,
+            4096,
+        ).to_primitive()
+
+    def checkpoint_execute(self, context, instance, primitive):
+        intent = c.StepIntent.from_primitive(primitive)
+        assert intent.id not in self.results, 'effect executed twice'
+        self.executed.append((intent.phase, intent.id))
+        if intent.phase in self.responses:
+            result = self.responses[intent.phase]
+            if callable(result):
+                result = result(intent)
+        else:
+            result = c.StepResult('succeeded', self._effect(intent), None)
+        if isinstance(result, c.StepResult):
+            result = result.to_primitive()
+        self.results[intent.id] = copy.deepcopy(result)
+        if intent.phase in self.lose_reply:
+            self.lose_reply.remove(intent.phase)
+            raise TimeoutError('fake reply lost after effect')
+        return result
+
+    def checkpoint_query(self, context, instance, primitive):
+        intent = c.StepIntent.from_primitive(primitive)
+        self.queried.append((intent.phase, intent.id))
+        return copy.deepcopy(
+            self.results.get(
+                intent.id,
+                c.StepResult(
+                    'unknown', {}, 'executor_unavailable'
+                ).to_primitive(),
+            )
+        )
+
+    def _effect(self, intent):
+        p, phase = intent.payload, intent.phase
+        volumes = [disk['volume_id'] for disk in p['disks']]
+        fingerprint = p['fingerprint']
+        checkpoint_id = p['checkpoint_id']
+        reservation_id = stable_id(intent.operation_id, 'cinder')
+        if phase == 'preflight':
+            return dict(
+                fingerprint=fingerprint, host=p['host'], node=p['node']
+            )
+        if phase == 'cinder_reserve':
+            return dict(
+                operation_id=reservation_id,
+                generation=1,
+                volume_ids=volumes,
+                state='reserved',
+            )
+        if phase == 'runtime_save':
+            self.current_runtime[intent.operation_id] = self.runtime
+            artifact_id = stable_id(checkpoint_id, 'ram')
+            self.artifacts[artifact_id] = self.runtime
+            self.power_state = 'SHUTOFF'
+            return dict(
+                writes_stopped=True,
+                artifacts=[
+                    dict(
+                        id=artifact_id,
+                        kind='ram',
+                        logical_id=artifact_id,
+                        bytes=1024,
+                        checksum=hashlib.sha256(
+                            self.runtime.encode()
+                        ).hexdigest(),
+                    )
+                ],
+            )
+        if phase == 'disk_snapshot':
+            snapshots = []
+            for volume in volumes:
+                snapshot = stable_id(checkpoint_id, volume)
+                self.snapshots[snapshot] = self.volumes.get(volume, 'initial')
+                snapshots.append(
+                    dict(
+                        volume_id=volume,
+                        snapshot_id=snapshot,
+                        status='available',
+                    )
+                )
+            return dict(volume_ids=volumes, snapshots=snapshots)
+        if phase == 'artifact_publish':
+            return dict(
+                staging_deleted=True,
+                artifacts=[
+                    dict(
+                        id=a['uuid'],
+                        kind=a['kind'],
+                        logical_id=a['logical_id'],
+                        bytes=a['actual_bytes'],
+                        checksum=a['checksum'],
+                    )
+                    for a in p['artifacts']
+                ],
+            )
+        if phase in (
+            'runtime_restore_current',
+            'cleanup_runtime_restore_current',
+        ):
+            self.runtime = self.current_runtime[intent.operation_id]
+            self.power_state = 'RUNNING'
+            return dict(fingerprint=fingerprint, power_state='RUNNING')
+        if phase == 'runtime_stop':
+            self.power_state = 'SHUTOFF'
+            return dict(writes_stopped=True, power_state='SHUTOFF')
+        if phase == 'volume_disconnect':
+            return dict(volume_ids=volumes, disconnected_volume_ids=volumes)
+        if phase == 'disk_revert':
+            snapshots = []
+            for disk in p['disks']:
+                self.volumes[disk['volume_id']] = self.snapshots[
+                    disk['snapshot_id']
+                ]
+                snapshots.append(
+                    dict(
+                        volume_id=disk['volume_id'],
+                        snapshot_id=disk['snapshot_id'],
+                        status='reverted',
+                    )
+                )
+            return dict(volume_ids=volumes, snapshots=snapshots)
+        if phase == 'volume_reconnect':
+            return dict(
+                volume_ids=volumes,
+                port_ids=[
+                    port['uuid'] for port in p['device_manifest']['ports']
+                ],
+                attachments=[
+                    dict(
+                        volume_id=volume,
+                        attachment_id=stable_id(intent.id, volume),
+                    )
+                    for volume in volumes
+                ],
+            )
+        if phase == 'runtime_restore_checkpoint':
+            self.runtime = self.artifacts[p['artifacts'][0]['uuid']]
+            self.power_state = 'RUNNING'
+            return dict(fingerprint=fingerprint, power_state='RUNNING')
+        if phase in ('disk_snapshot_delete', 'cleanup_disk_snapshots'):
+            snapshots = []
+            for disk in p['disks']:
+                if disk['snapshot_id']:
+                    self.snapshots.pop(disk['snapshot_id'], None)
+                    snapshots.append(
+                        dict(
+                            volume_id=disk['volume_id'],
+                            snapshot_id=disk['snapshot_id'],
+                            status='deleted',
+                        )
+                    )
+            return dict(
+                volume_ids=[s['volume_id'] for s in snapshots],
+                snapshots=snapshots,
+            )
+        if phase in ('artifact_delete', 'cleanup_artifacts'):
+            ids = [a['uuid'] for a in p['artifacts']]
+            for artifact_id in ids:
+                self.artifacts.pop(artifact_id, None)
+            return dict(artifact_ids=ids, deleted_artifact_ids=ids)
+        if phase in ('cinder_release', 'cleanup_cinder_release'):
+            return dict(
+                operation_id=reservation_id,
+                generation=1,
+                state='released',
+                outcome=(
+                    'succeeded'
+                    if phase == 'cinder_release'
+                    else 'failed_no_effect'
+                ),
+            )
+        raise AssertionError('unexpected phase %s' % phase)
