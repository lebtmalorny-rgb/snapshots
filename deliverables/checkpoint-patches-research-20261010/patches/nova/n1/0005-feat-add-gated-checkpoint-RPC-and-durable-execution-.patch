--- a/nova/checkpoints/workflow.py
+++ b/nova/checkpoints/workflow.py
@@ -13,17 +13,37 @@
 """Allowed effects, excluding local journal and quota transitions."""
 
 _STEPS = {
-    'create': ('preflight', 'cinder_reserve', 'runtime_save', 'disk_snapshot',
-               'artifact_publish', 'runtime_restore_current',
-               'cinder_release'),
-    'revert': ('preflight', 'cinder_reserve', 'runtime_stop',
-               'volume_disconnect',
-               'disk_revert', 'volume_reconnect', 'runtime_restore_checkpoint',
-               'cinder_release'),
-    'delete': ('cinder_reserve', 'disk_snapshot_delete', 'artifact_delete',
-               'cinder_release'),
-    'cleanup': ('cleanup_runtime_restore_current', 'cleanup_disk_snapshots',
-                'cleanup_artifacts', 'cleanup_cinder_release'),
+    'create': (
+        'preflight',
+        'cinder_reserve',
+        'runtime_save',
+        'disk_snapshot',
+        'artifact_publish',
+        'runtime_restore_current',
+        'cinder_release',
+    ),
+    'revert': (
+        'preflight',
+        'cinder_reserve',
+        'runtime_stop',
+        'volume_disconnect',
+        'disk_revert',
+        'volume_reconnect',
+        'runtime_restore_checkpoint',
+        'cinder_release',
+    ),
+    'delete': (
+        'cinder_reserve',
+        'disk_snapshot_delete',
+        'artifact_delete',
+        'cinder_release',
+    ),
+    'cleanup': (
+        'cleanup_runtime_restore_current',
+        'cleanup_disk_snapshots',
+        'cleanup_artifacts',
+        'cleanup_cinder_release',
+    ),
 }
 PHASES = frozenset(phase for steps in _STEPS.values() for phase in steps)
 
@@ -33,3 +53,30 @@ def steps_for(kind):
         return _STEPS[kind]
     except (KeyError, TypeError):
         raise ValueError('Invalid checkpoint operation kind') from None
+
+
+def execution_plan(kind, statuses):
+    """Derive cleanup only from terminal, late-effect-fenced create results."""
+    normal = steps_for(kind)
+    failed = any(statuses.get(p) == 'failed_no_effect' for p in normal)
+    unresolved = any(
+        statuses[p] not in ('succeeded', 'failed_no_effect')
+        for p in normal
+        if p in statuses
+    )
+    if kind != 'create' or not failed or unresolved:
+        return normal, False
+
+    def succeeded(phase):
+        return statuses.get(phase) == 'succeeded'
+
+    cleanup = []
+    if succeeded('runtime_save') and not succeeded('runtime_restore_current'):
+        cleanup.append('cleanup_runtime_restore_current')
+    if succeeded('disk_snapshot'):
+        cleanup.append('cleanup_disk_snapshots')
+    if succeeded('runtime_save'):
+        cleanup.append('cleanup_artifacts')
+    if succeeded('cinder_reserve') and not succeeded('cinder_release'):
+        cleanup.append('cleanup_cinder_release')
+    return tuple(cleanup), True
