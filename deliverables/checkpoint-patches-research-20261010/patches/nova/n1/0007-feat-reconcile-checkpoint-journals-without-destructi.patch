+@require_context
+@db.pick_context_manager_reader
+def operations_recovery_page(context, marker=None, limit=100):
+    c._integer(limit, minimum=1, maximum=1000)
+    model = m.InstanceCheckpointOperation
+    stamp = sa.func.coalesce(model.updated_at, model.created_at)
+    query = context.session.query(model).filter(
+        model.state.in_(('reserved', 'running', 'recovery_required', 'failed'))
+    )
+    if not context.is_admin:
+        query = query.filter_by(project_id=context.project_id)
+    if marker:
+        c._uuid(marker['uuid'])
+        when = timeutils.normalize_time(
+            timeutils.parse_isotime(marker['updated_at'])
+        )
+        query = query.filter(
+            sa.or_(
+                stamp > when,
+                sa.and_(stamp == when, model.uuid > marker['uuid']),
+            )
+        )
+    return [
+        _row(row) for row in query.order_by(stamp, model.uuid).limit(limit)
+    ]
