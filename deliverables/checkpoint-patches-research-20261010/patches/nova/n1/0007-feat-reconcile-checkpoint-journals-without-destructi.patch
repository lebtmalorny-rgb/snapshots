+#    distributed under the License is distributed on an "AS IS" BASIS, WITHOUT
+#    WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the
+#    License for the specific language governing permissions and limitations
+#    under the License.
+
+"""Bounded recovery that queries claimed effects without redispatching them."""
+
+from nova.checkpoints import coordinator
+from nova.checkpoints import quota
+from nova import context as nova_context
+from nova import objects
+
+
+class RecoveryManager:
+    def __init__(self, compute_rpc=None, ledger=None):
+        self.ledger = ledger or quota.QuotaLedger()
+        self.coordinator = coordinator.Coordinator(compute_rpc, self.ledger)
+        self.cell_markers = {}
+        self.quota_marker = None
+
+    @staticmethod
+    def _service_context(context):
+        # Never resurrect a stored/requesting user's expired token or plugin.
+        ctx = nova_context.get_admin_context()
+        if context.cell_uuid:
+            cell = objects.CellMapping.get_by_uuid(ctx, context.cell_uuid)
+            nova_context.set_target_cell(ctx, cell)
+        return ctx
+
+    def _operation(self, context, operation):
+        self.coordinator.run(
+            context,
+            operation.instance_uuid,
+            operation.uuid,
+            operation.generation,
+            recovery=True,
+        )
+
+    def reconcile_instance(self, context, instance_uuid):
+        ctx = self._service_context(context)
+        guard = objects.InstanceCheckpointGuard.get_by_instance_uuid(
+            ctx, instance_uuid
+        )
+        if guard is None or not guard.operation_id:
+            return dict(
+                processed=0,
+                failed=0,
+                ordinary_owner=bool(guard and guard.ordinary_claim_uuid),
+            )
+        try:
+            operation = objects.InstanceCheckpointOperation.get_by_uuid(
+                ctx, guard.operation_id
+            )
+            self._operation(ctx, operation)
+        except Exception:
+            return dict(processed=0, failed=1, reason='recovery_required')
+        return dict(processed=1, failed=0)
+
+    def reconcile_cell(self, context, limit=100):
+        ctx = self._service_context(context)
+        marker_key = ctx.cell_uuid or 'local'
+        operations = objects.InstanceCheckpointOperationList.get_recovery_page(
+            ctx, marker=self.cell_markers.get(marker_key), limit=limit
+        )
+        report = dict(processed=0, failed=0)
+        for operation in operations:
+            try:
+                self._operation(ctx, operation)
+                report['processed'] += 1
+            except Exception:
+                report['failed'] += 1
+        if len(operations) == limit:
+            last = operations[-1]
+            self.cell_markers[marker_key] = dict(
+                uuid=last.uuid,
+                updated_at=(last.updated_at or last.created_at).isoformat(),
+            )
+        else:
+            self.cell_markers[marker_key] = None
+        return report
+
+    def reconcile_quota(self, context, limit=100):
+        ctx = nova_context.get_admin_context()
+        report = self.ledger.reconcile(
+            ctx, limit=limit, marker=self.quota_marker
+        )
+        self.quota_marker = report['next_marker']
+        return report
