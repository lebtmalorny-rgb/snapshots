+def _checkpoint_archive_filter(table, metadata):
+    """Retain rows belonging to any live checkpoint or ordinary owner."""
+    guard = metadata.tables.get('instance_checkpoint_guards')
+    if guard is None:
+        return sa.true()
+    protected = sa.select(guard.c.instance_uuid).where(sa.or_(
+        guard.c.operation_id.is_not(None),
+        guard.c.ordinary_claim_uuid.is_not(None),
+        guard.c.checkpoint_count > 0))
+    name = table.name.removeprefix(_SHADOW_TABLE_PREFIX)
+    if name == 'instances':
+        return ~table.c.uuid.in_(protected)
+    if 'instance_uuid' in table.c:
+        return ~table.c.instance_uuid.in_(protected)
+    if name == 'instance_actions_events':
+        prefix = _SHADOW_TABLE_PREFIX if table.name.startswith(
+            _SHADOW_TABLE_PREFIX) else ''
+        actions = metadata.tables.get(prefix + 'instance_actions')
+        if actions is not None:
+            owned_actions = sa.select(actions.c.id).where(
+                actions.c.instance_uuid.in_(protected))
+            return ~table.c.action_id.in_(owned_actions)
+    return sa.true()
+
