     def __getattr__(self, name):
         return getattr(self._router, name)
+
+
+def background(action, instance_arg=1, instance_name='instance'):
+    """Defer background work if a durable owner prevents acquisition."""
+
+    def decorate(function):
+        guarded = entrypoint(
+            action,
+            service='compute',
+            instance_arg=instance_arg,
+            instance_name=instance_name,
+        )(function)
+
+        @functools.wraps(function)
+        def wrapped(*args, **kwargs):
+            try:
+                return guarded(*args, **kwargs)
+            except exception.CheckpointConflict:
+                return None
+
+        return wrapped
+
+    return decorate
+
+
+@contextlib.contextmanager
+def background_batch(context, instances, action):
+    """Hold per-instance claims through a legacy batch driver call."""
+    with contextlib.ExitStack() as stack:
+        ready = []
+        for instance in instances:
+            try:
+                owned = stack.enter_context(
+                    worker(context, instance.uuid, action)
+                )
+            except exception.CheckpointConflict:
+                continue
+            stack.enter_context(_bound_objects(instance, owned))
+            ready.append(instance)
+        yield ready
